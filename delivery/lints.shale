-- This script runs Shale's Roc lints over delivery's Roc that take
-- delivery's own tables, and holds each count at the number in LINTS, so a
-- moved count fails the run.
--
--   cd <roc-apps checkout> && shale delivery/lints.shale
--
-- With `reads=settings` it prints the tables each lint takes, one line
-- `SETTING<tab>recipe<tab>folder<tab>arg` an argument, paths from the
-- checkout's root, for tools/quality.shale, which runs the same recipes over
-- every app and so must judge delivery's files as this script does. This
-- table stays their one home.

const HERE = "delivery"
const GLOB = "roc/*.roc"
const LINTS = {
  {recipe = "hunt_names", args = {"terms=terms.txt"}, counts = {
    {"state_effect", 0}, {"question", 0}, {"vague", 0}, {"name_type", 0}, {"negative", 0},
    {"noun_effect", 0}, {"command_tense", 0}, {"mixed_tense", 0}, {"container", 0},
    {"preposition_split", 0}, {"short_name", 14}, {"worker_name", 0}, {"stacked_preposition", 0},
    {"taken_word", 0}, {"bare_participle", 0}, {"phrase_name", 0},
    {"singular_list", 0}, {"world_verb", 0}, {"where_name", 0}, {"stale_doc_name", 0},
  }},
}

function setting_lines()
  local out = {}
  for lint in LINTS do
    for a in lint.args do
      local m = re_find(a, "^(terms|words|table)=(.+)$")
      if m ~= nil then push(out, "SETTING\t" .. lint.recipe .. "\t" .. HERE .. "\t" .. m.groups[1] .. "=" .. HERE .. "/" .. m.groups[2]) end
    end
  end
  return out
end

-- The number a recipe's last line of counts gives for `check`.
function summary_count(summary, check)
  local found = re_find(summary, "[ ,]" .. check .. " ([0-9]+)")
  if found == nil then return nil end
  return tonumber(found.group)
end

function judge()
  local wrong = {}
  for lint in LINTS do
    local argv = {"shale", real("cookbook:roc/" .. lint.recipe .. ".shale"), "glob=" .. GLOB}
    for a in lint.args do push(argv, a) end
    local r = run(argv, {cwd = HERE, timeout_ms = 300000, whole = 4000000})
    local summary = ""
    for l in lines(trim(r.out)) do
      if starts_with(l, lint.recipe) then summary = l end
    end
    local said = {}
    for c in lint.counts do
      local got = summary_count(summary, c[1])
      if got == nil then
        push(wrong, lint.recipe .. ": no count for " .. c[1] .. " in its last line: " .. summary)
      elseif got ~= c[2] then
        for l in lines(r.out) do
          if contains(l, ": " .. c[1] .. ":") then print(HERE .. "/" .. l) end
        end
        push(wrong, lint.recipe .. ": " .. c[1] .. " is " .. got .. ", held at " .. c[2])
      end
      push(said, c[1] .. " " .. tostring(got))
    end
    print(lint.recipe .. ": " .. join(said, ", "))
  end
  for w in wrong do print("WRONG " .. w) end
  if #wrong > 0 then fail("delivery lints: " .. #wrong .. " count(s) moved; fix the code") end
  print("delivery lints: every count as held")
  return nil
end

const READS = arg("reads", "")
if READS == "settings" then
  print(join(setting_lines(), "\n"))
elseif READS ~= "" then
  fail("delivery lints: reads= is settings")
else
  judge()
end
