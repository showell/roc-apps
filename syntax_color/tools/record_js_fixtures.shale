-- budget: steps=200000000 arena_bytes=1000000000 call_bytes=40000000
-- This records oracle/js_files.jsonl, the JavaScript fixtures. No script
-- colored JavaScript before the package did, so the fixtures are the
-- package's own answers for real JavaScript in roc-apps, each read by eye
-- before it was committed; tools/verify.shale then holds the package to them.
-- Run it from a roc-apps checkout, after tools/verify.shale has built the
-- harness:
--
--   cd <roc-apps checkout> && shale syntax_color/tools/record_js_fixtures.shale
--
-- Re-record only for a deliberate change to the JavaScript lexer, and read
-- every sample that moved in the diff.
const TOOL = ".zig-cache/syntax_color/harness"
const OUT = "syntax_color/oracle/js_files.jsonl"
const MARK = "<!-- syntax_color answer -->\n"
const WANT = "roc-pin: syntax_color's harness, built by its gate"

-- One file of each kind roc-apps has: the canvas apps' runner and painter, a
-- page check in node, the widget embed, the book's script, a generated glue,
-- the site's pages' scripts and tools, and fasttrack's game.
const FILES = {
  "canvas_apps/web/canvas_app_runner.js",
  "canvas_apps/web/shapes_canvas.js",
  "canvas_apps/web/mini_font.mjs",
  "canvas_apps/web/text_check.mjs",
  "canvas_apps/widget_kit/embed.js",
  "canvas_apps/safari/tutorial/book.js",
  "site/live/beacon_widget/roc_glue.js",
  "site/live/breakout/shapewire.js",
  "site/live/markdown/app.js",
  "site/live/markdown/md_wasm.js",
  "site/live/shared/home.js",
  "site/squeeze_png.mjs",
  "fasttrack/web/fasttrack.js",
}

if not exists(TOOL) then fail("record_js_fixtures: no harness at " .. TOOL .. ": run tools/verify.shale first") end
local argv = {real(TOOL)}
for f in FILES do
  push(argv, "js")
  push(argv, read(f))
end
local r = must(run(argv, {timeout_ms = 120000, whole = 20000000, want = WANT}))
local answers = drop(split(r.out, MARK), 1)
if #answers ~= #FILES then fail("record_js_fixtures: " .. #FILES .. " files got " .. #answers .. " answers") end
local out = {}
local i = 1
while i <= #FILES do
  push(out, json_write({name = FILES[i], outcome = "reviewed", html = answers[i]}))
  i = i + 1
end
replace(OUT, join(out, "\n") .. "\n")
print("record_js_fixtures: " .. #FILES .. " files")
