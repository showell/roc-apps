-- budget: steps=400000000 arena_bytes=1500000000 reads=20000 read_bytes=400000000 output_bytes=200000 call_bytes=40000000
-- This records the oracle that syntax_color is held to: what today's two
-- coloring scripts make of every sample they color. It runs from a roc-apps
-- checkout, and needs the books book's checkout and the Shale cookbook:
--
--   cd <roc-apps checkout> && shale syntax_color/tools/record_oracle.shale
--
-- The Roc samples are colored by roc-apps' canvas_apps/safari/tutorial/
-- color_roc.shale, and the Shale samples
-- by the cookbook's color_shale.shale. Each script runs on a scratch copy of
-- what it needs, so nothing in the checkout changes but build/, which the
-- tutorial's own build.shale rewrites first.
--
-- It writes three files to syntax_color/oracle/, a sample a line:
--   roc_blocks.jsonl   every ```roc fence of the Safari book, colored alone;
--   roc_files.jsonl    every Roc file those fences quote, colored whole;
--   shale_files.jsonl  every cookbook recipe, the books book's Shale files and
--                      the Shale functions and line ranges its book quotes.
-- A line is {name, outcome, html}, and a Roc sample's `note` is the part of a
-- file it shows, as build.shale's blocks.jsonl says: a whole file's, all of it.
-- The html is what the script wrote between
-- its <pre><code> tags, and the sample's text is that html with its spans taken
-- away and its five escapes undone, which both scripts check holds. The outcome
-- is `colored`, or `plain` for a Roc block color_roc left uncolored (its reason
-- follows), or `refused` for a Shale file color_shale gave no page.
const ORACLE = "syntax_color/oracle"
const TUTORIAL_BUILD = "canvas_apps/safari/tutorial/build.shale"
const EXPANDED = "canvas_apps/safari/tutorial/build/tutorial.md"
const NOTES = "canvas_apps/safari/tutorial/build/blocks.jsonl"
const COLOR_ROC = "canvas_apps/safari/tutorial/color_roc.shale"
const COLOR_SHALE = "cookbook:color_shale.shale"
const COOKBOOK = "repos:shale/cookbook"
const BOOKS_BOOK = "build:lanes/books-book/books-book"
const ROC_OPEN = "<pre><code class=\"language-roc\">"
const SHALE_OPEN = "<pre><code class=\"language-shale\">"
const CLOSE = "</code></pre>"
const SHALE_CHUNK = 50

function escaped(text)
  local s = join(split(text, "&"), "&amp;")
  s = join(split(s, "<"), "&lt;")
  s = join(split(s, ">"), "&gt;")
  s = join(split(s, "\""), "&quot;")
  return join(split(s, "'"), "&#39;")
end

function padded(i)
  local s = "" .. i
  while #s < 3 do s = "0" .. s end
  return s
end

-- The text of each ```roc fence, in order, with its last newline.
function roc_fences(text)
  local fences = {}
  local body = {}
  local inside = false
  for l in lines(text) do
    if inside then
      if l == "```" then
        push(fences, join(body, "\n") .. "\n")
        inside = false
      else
        push(body, l)
      end
    elseif l == "```roc" or starts_with(l, "```roc ") then
      inside = true
      body = {}
    end
  end
  if inside then fail("record_oracle: a ```roc fence with no end in " .. EXPANDED) end
  return fences
end

-- Runs color_roc on one page a block, in a scratch root that holds a copy of
-- the script, the notes and the files they name. Gives a record a block.
function color_roc_blocks(label, texts, notes, names)
  local root = fresh_dir("scratch:", "syntax-color-" .. label)
  copy(COLOR_ROC, root .. "/color_roc.shale")
  local paths = {}
  local note_lines = {}
  for note in notes do
    push(paths, note.path)
    push(note_lines, json_write(note))
  end
  for p in unique(paths) do copy(p, root .. "/" .. p) end
  replace(root .. "/" .. NOTES, join(note_lines, "\n") .. "\n")
  mkdir(root .. "/pages")
  local order = {}
  local i = 1
  while i <= #texts do
    local page = "b" .. padded(i) .. ".html"
    replace(root .. "/pages/" .. page, ROC_OPEN .. escaped(texts[i]) .. CLOSE .. "\n")
    push(order, page)
    i = i + 1
  end
  local r = run({"shale", "color_roc.shale", "pages=pages", "order=" .. join(order, " ")}, {cwd = root, timeout_ms = 900000, tail = 600})
  if r.code ~= 0 then
    print(r.out)
    fail("record_oracle: color_roc failed on the " .. label)
  end
  local plain = {}
  for l in lines(r.out) do
    local m = re_find(l, "^color_roc: plain, (b[0-9]+\\.html): (.*)$")
    if m ~= nil then plain[m.groups[1]] = m.groups[2] end
  end
  local records = {}
  i = 1
  while i <= #texts do
    local page = read(root .. "/pages/" .. order[i])
    local html = between(page, ROC_OPEN, CLOSE)
    local outcome = "colored"
    if has_key(plain, order[i]) then outcome = "plain: " .. plain[order[i]] end
    push(records, {name = names[i], outcome = outcome, html = html, note = notes[i]})
    i = i + 1
  end
  print("record_oracle: " .. label .. ": " .. #records .. " samples, " .. #keys(plain) .. " plain")
  remove_tree(root)
  return records
end

-- The parts of a note, said short: `12-30` for lines, `cut` for a cut.
function parts_said(note)
  local said = {}
  for part in note.parts do
    if has_key(part, "cut") then push(said, "cut") else push(said, part.from .. "-" .. part.to) end
  end
  return join(said, ",")
end

function roc_block_records()
  local texts = roc_fences(read(EXPANDED))
  local notes = {}
  for l in lines(read(NOTES)) do
    if trim(l) ~= "" then push(notes, json_read(l)) end
  end
  if #notes ~= #texts then fail("record_oracle: " .. #texts .. " fences, and the notes have " .. #notes) end
  local names = {}
  local i = 1
  while i <= #notes do
    push(names, "block " .. padded(i) .. ": " .. notes[i].path .. " " .. parts_said(notes[i]))
    i = i + 1
  end
  return color_roc_blocks("roc-blocks", texts, notes, names)
end

-- A file's lines through its last that isn't empty, as color_roc reads them.
function file_lines(path)
  local ls = split(read(path), "\n")
  while #ls > 0 and ls[#ls] == "" do ls = take(ls, #ls - 1) end
  return ls
end

function roc_file_records()
  local paths = {}
  for l in lines(read(NOTES)) do
    if trim(l) ~= "" then push(paths, json_read(l).path) end
  end
  local texts = {}
  local notes = {}
  local names = {}
  for p in sort(unique(paths)) do
    local ls = file_lines(p)
    push(texts, join(ls, "\n") .. "\n")
    push(notes, {path = p, parts = {{from = 1, to = #ls, indent = 0, end_col = #ls[#ls] + 1}}})
    push(names, p)
  end
  return color_roc_blocks("roc-files", texts, notes, names)
end

-- A top-level Shale function as the books book quotes it: the comment lines
-- right above it, through its `end`.
function function_text(path, name)
  local ls = file_lines(path)
  local first = 0
  local i = 1
  while i <= #ls do
    if starts_with(ls[i], "function " .. name .. "(") then first = i end
    i = i + 1
  end
  if first == 0 then fail("record_oracle: no function " .. name .. " in " .. path) end
  local last = first
  while ls[last] ~= "end" do last = last + 1 end
  while first > 1 and starts_with(ls[first - 1], "--") do first = first - 1 end
  return join(slice(ls, first, last), "\n") .. "\n"
end

-- The lines from the one holding `from` through the one holding `to`.
function lines_text(path, from, to)
  local ls = file_lines(path)
  local first = 0
  local last = 0
  local i = 1
  while i <= #ls do
    if first == 0 and contains(ls[i], from) then first = i end
    if first ~= 0 and last == 0 and contains(ls[i], to) then last = i end
    i = i + 1
  end
  if first == 0 or last == 0 then fail("record_oracle: no lines from [" .. from .. "] to [" .. to .. "] in " .. path) end
  return join(slice(ls, first, last), "\n") .. "\n"
end

-- The Shale the books book quotes in part, each written as a file of its own.
function shale_fragments(folder)
  local build = BOOKS_BOOK .. "/build.shale"
  local fragments = {
    {name = "books-book/build.shale, function anchored_line", text = function_text(build, "anchored_line")},
    {name = "roc-apps/canvas_apps/safari/tutorial/build.shale, function fenced_failure", text = function_text("canvas_apps/safari/tutorial/build.shale", "fenced_failure")},
    {name = "books-book/build.shale, the settings", text = lines_text(build, "-- Where the book's files are", "const CHECK_NEGATIVES = true")},
    {name = "books-book/build.shale, the prose check", text = lines_text(build, "local over = {}", "if #over > 0 then fail(")},
  }
  local files = {}
  local i = 1
  while i <= #fragments do
    local path = folder .. "/fragment" .. i .. ".shale"
    replace(path, fragments[i].text)
    push(files, {path = path, name = fragments[i].name})
    i = i + 1
  end
  return files
end

-- A path as a sample's name: the folder of its repo, without the mount.
function shale_name(path)
  if starts_with(path, COOKBOOK .. "/") then return "cookbook/" .. sub(path, #COOKBOOK + 2) end
  if starts_with(path, BOOKS_BOOK .. "/") then return "books-book/" .. sub(path, #BOOKS_BOOK + 2) end
  return path
end

function shale_records()
  local work = fresh_dir("scratch:", "syntax-color-shale")
  local files = {}
  for p in sort(glob(COOKBOOK .. "/**/*.shale")) do push(files, {path = p, name = shale_name(p)}) end
  for p in sort(glob(BOOKS_BOOK .. "/**/*.shale")) do push(files, {path = p, name = shale_name(p)}) end
  for f in shale_fragments(work) do push(files, f) end
  local out = work .. "/out"
  local at = 1
  while at <= #files do
    local chunk = {}
    local i = at
    while i <= #files and i < at + SHALE_CHUNK do
      push(chunk, files[i].path)
      i = i + 1
    end
    local r = run({"shale", COLOR_SHALE, "files=" .. join(chunk, ","), "out=" .. out}, {timeout_ms = 900000, tail = 200})
    if not contains(r.out, "color_shale: ") then
      print(r.out)
      fail("record_oracle: color_shale said nothing of its files")
    end
    at = i
  end
  local records = {}
  local refused = 0
  for f in files do
    local page = out .. "/" .. substitute(f.path, ":", "/", {missing_ok = true}) .. ".html"
    if exists(page) then
      push(records, {name = f.name, outcome = "colored", html = between(read(page), SHALE_OPEN, CLOSE)})
    else
      push(records, {name = f.name, outcome = "refused", html = escaped(read(f.path))})
      refused = refused + 1
    end
  end
  print("record_oracle: shale: " .. #records .. " samples, " .. refused .. " refused")
  remove_tree(work)
  return records
end

function write_records(file, records)
  local out = {}
  for r in records do
    local line = {name = r.name, outcome = r.outcome, html = r.html}
    if has_key(r, "note") then line.note = r.note end
    push(out, json_write(line))
  end
  replace(ORACLE .. "/" .. file, join(out, "\n") .. "\n")
  return nil
end

must(run({"shale", TUTORIAL_BUILD}, {timeout_ms = 600000, tail = 20}))
mkdir(ORACLE)
write_records("roc_blocks.jsonl", roc_block_records())
write_records("roc_files.jsonl", roc_file_records())
write_records("shale_files.jsonl", shale_records())
