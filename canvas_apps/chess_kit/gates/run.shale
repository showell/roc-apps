-- This is the chess toys' gate: the Knight's Tour and Eight Queens, and the
-- chess kit they share. For each toy it runs, with the pinned Roc and at the
-- lowest priority:
--
--   - `roc test web.roc`, held to the exact count of expects it runs (the
--     toy's own, the kit's and lib's, which a root reaches);
--   - the toy's proof (`KnightProof.roc`, `QueensProof.roc`), built natively
--     on the dev backend and run, its output held byte for byte to the
--     `.expected` file beside it: every start square's move count, which
--     freezes the search order, and the overlay, scrub and page checks.
--
-- check.shale already holds each root to `roc check` and `roc fmt`.
--
--   cd <roc-apps checkout> && shale canvas_apps/chess_kit/gates/run.shale
--
-- A count that moves moves with the change that moved it, and its commit
-- says why. The knight's proof takes about 20 s of CPU, nearly all of it
-- g6's 2,520,884 moves, searched once and played once on the page.
--
-- budget: steps=20000000

const WANT = "roc-pin: roc-apps' pinned nightly"
const WANT_PROOF = "chess-proof: the toy's proof, built by this run"

const TOYS = {
  {folder = "canvas_apps/knights_tour", proof = "KnightProof", expects = 100},
  {folder = "canvas_apps/eight_queens", proof = "QueensProof", expects = 99},
}

-- Nothing, or a stop naming the toy and what its tests said.
function hold_expects(roc, toy)
  local r = run({roc, "test", "web.roc"}, {cwd = toy.folder, timeout_ms = 600000, tail = 40, nice = 19, want = WANT})
  local m = re_find(r.out, "All \\((\\d+)\\) tests passed")
  if r.code ~= 0 or m == nil then
    print(trim(r.out))
    fail("chess gate: " .. toy.folder .. "'s expects failed")
  end
  if tonumber(m.group) ~= toy.expects then fail("chess gate: " .. toy.folder .. " ran " .. m.group .. " expects, and the gate holds " .. toy.expects) end
  print("PASS " .. toy.folder .. ": " .. m.group .. " expects")
  return nil
end

-- Nothing, or a stop naming the toy's proof and where its output differs.
-- `--specialize=yes` because Roc 0.1.0_RC1 lowers a dev build the boxy way
-- unless told otherwise, and KnightProof's search ran 22 times slower so: 344.7 s
-- of CPU, against 15.8 s specialized (15.6 s at nightly-2026-11-03-34bd006).
function hold_proof(roc, toy, work)
  local bin = real(work) .. "/" .. toy.proof
  local b = run({roc, "build", "--opt=dev", "--specialize=yes", toy.proof .. ".roc", "--output=" .. bin}, {cwd = toy.folder, timeout_ms = 600000, tail = 40, nice = 19, want = WANT})
  if contains(b.out, "✗") or contains(b.out, "●") or not exists(work .. "/" .. toy.proof) then
    print(trim(b.out))
    fail("chess gate: " .. toy.proof .. " didn't build clean")
  end
  local r = run({bin}, {timeout_ms = 600000, whole = 100000, nice = 19, want = WANT_PROOF})
  local want = read(toy.folder .. "/" .. toy.proof .. ".expected")
  if r.code ~= 0 or r.out ~= want then
    local got = lines(r.out)
    local wanted = lines(want)
    local i = 1
    while i <= #wanted and i <= #got and got[i] == wanted[i] do i = i + 1 end
    print("line " .. i .. ": got  " .. get(got, i, "(nothing)"))
    print("line " .. i .. ": want " .. get(wanted, i, "(nothing)"))
    fail("chess gate: " .. toy.proof .. " differs from " .. toy.proof .. ".expected")
  end
  print("PASS " .. toy.proof .. ": " .. #lines(want) .. " lines as frozen, " .. r.cpu_ms .. " ms of CPU")
  return nil
end

local roc = pinned_roc("chess gate")
local work = fresh_dir("build:roc-apps", "chess-gate")
for toy in TOYS do
  hold_expects(roc, toy)
  hold_proof(roc, toy, work)
end
remove_tree(work)
print("chess gate: green")
