-- budget: steps=100000000 read_bytes=100000000
-- This is safari's fast tier, for each edit. It stops at its first failure.
--
--   cd <roc-apps checkout> && nice -n 19 shale canvas_apps/safari/gates/fast.shale
--
-- It runs the merge gate's parts for this tier: `part=fast_check` (`roc
-- check`), `part=format`, and `part=fast_expects` (`roc test` from the main
-- expect root); then the one-file lints (lints.shale) on the .roc files changed
-- since this checkout's last green; then `part=fast_frame`, which builds
-- RasterFrame and holds one frame to its line in gates/proof.expected. A
-- changed file that a lint reads outside safari, in lib or a widget, judges
-- every file. Every run names what it left to the merge gate.
-- It takes about ten seconds once its cache is warm and a green is on record.
--
-- The merge gate is the one home of the Roc, the paths and the checks, so
-- this script only names its siblings and keeps the record of the last green.
-- Each checkout has a folder under the box's build folder, named by the merge
-- gate (`part=fast_cache`), with its own Roc cache and that record. The record
-- holds a hash of each file it judged, and of the lints' rules, so a change to
-- the rules judges every file again.

const GATES = "canvas_apps/safari/gates"
-- The lints name files from safari's folder.
const SAFARI = dirname(GATES)
const LINTS = GATES .. "/lints.shale"
const MERGE_GATE = GATES .. "/run.shale"

-- This checkout's fast cache folder, which the merge gate names, since it is
-- the one home of where each checkout's caches live.
function fast_cache_folder()
  local r = must(run({"shale", "--root", ".", MERGE_GATE, "part=fast_cache"}, {timeout_ms = 30000, whole = 4000}))
  for l in lines(r.out) do
    if starts_with(l, "build:") then return trim(l) end
  end
  fail("safari fast: the merge gate named no cache folder: " .. trim(r.out))
end

-- The file's hash, for each path of `paths`.
function hashes_of(paths)
  local r = run({"git", "hash-object", "--stdin-paths"}, {timeout_ms = 30000, whole = 1000000, stdin = join(paths, "\n") .. "\n"})
  local hashes = lines(trim(r.out))
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 or #hashes ~= #paths then
    print(trim(r.out))
    fail("safari fast: git hash-object ended " .. r.ended .. " " .. get(r, "code", -1) .. " with " .. #hashes .. " hashes for " .. #paths .. " paths")
  end
  local found = {}
  local k = 1
  while k <= #paths do
    found[paths[k]] = hashes[k]
    k = k + 1
  end
  return found
end

-- What lints.shale says it reads, `reads=globs` or `reads=rules`, a line each.
function lints_reads(which)
  local g = run({"shale", "--root", ".", LINTS, "reads=" .. which}, {timeout_ms = 30000, whole = 100000})
  local named = {}
  for l in lines(trim(g.out)) do
    if not starts_with(l, "──") then push(named, l) end
  end
  if g.ended ~= "exit" or get(g, "code", -1) ~= 0 or #named == 0 then
    print(trim(g.out))
    fail("safari fast: lints.shale didn't name its " .. which)
  end
  return named
end

-- Every file a lint reads, committed or not, from the globs lints.shale holds:
-- safari's, and the widgets', widget_kit's and lib's too.
function lint_read_files()
  local argv = {"git", "ls-files", "--cached", "--others", "--exclude-standard", "--"}
  for glob in lints_reads("globs") do push(argv, ":(glob)" .. glob) end
  local r = run(argv, {timeout_ms = 30000, whole = 1000000})
  local kept = {}
  for f in lines(trim(r.out)) do
    if exists(f) then push(kept, f) end
  end
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 or #kept == 0 then
    print(trim(r.out))
    fail("safari fast: git ls-files ended " .. r.ended .. " " .. get(r, "code", -1) .. " and named no file a lint reads")
  end
  return kept
end

function record_of(hashes)
  local paths = keys(hashes)
  local text = {}
  for p in sort(paths) do push(text, hashes[p] .. " " .. p) end
  return join(text, "\n") .. "\n"
end

function read_record(path)
  local held = {}
  for l in lines(trim(read_or(path, ""))) do
    local parts = split(l, " ")
    if #parts == 2 then held[parts[2]] = parts[1] end
  end
  return held
end

-- The `files=` that lints.shale needs: the changed files, or `every`.
function changed_files(held, hashes, sources)
  if #keys(held) == 0 then
    print("no green on record for this checkout: judging every file")
    return "every"
  end
  for p in keys(hashes) do
    if not ends_with(p, ".roc") and get(held, p, "") ~= hashes[p] then
      print("the lints' rules changed in " .. p .. ": judging every file")
      return "every"
    end
  end
  local changed = {}
  for p in sources do
    if get(held, p, "") ~= hashes[p] then
      if not starts_with(p, SAFARI .. "/") then
        print(p .. " changed, and only a run over every file judges it: judging every file")
        return "every"
      end
      push(changed, sub(p, #SAFARI + 2))
    end
  end
  return join(changed, ",")
end

-- One of the merge gate's parts for this tier; it stops the run on a failure.
function merge_gate_part(part)
  local r = run({"shale", "--root", ".", MERGE_GATE, "part=" .. part}, {timeout_ms = 600000, tail = 200})
  for l in lines(trim(r.out)) do
    if not starts_with(l, "── ") then print(l) end
  end
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 then
    if r.ended ~= "exit" then print(trim(r.out)) end
    fail("safari fast: the merge gate's part=" .. part .. " failed")
  end
  return nil
end

function lint_changed_files(files)
  if files == "" then
    print("lints: nothing changed since this checkout's last green")
    return nil
  end
  local r = run({"shale", "--root", ".", LINTS, "files=" .. files}, {timeout_ms = 600000, whole = 1000000})
  for l in lines(trim(r.out)) do
    if not starts_with(l, "── budgets") then print(l) end
  end
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 then fail("safari fast: the lints failed") end
  print("lints on " .. files .. ": " .. r.ms .. " ms")
  return nil
end

function main()
  local folder = fast_cache_folder()
  if not exists(folder) then mkdir(folder) end
  local record = folder .. "/green.txt"
  local sources = lint_read_files()
  local judged = {}
  for f in sources do push(judged, f) end
  for f in lints_reads("rules") do push(judged, f) end
  local hashes = hashes_of(judged)
  merge_gate_part("fast_check")
  merge_gate_part("format")
  merge_gate_part("fast_expects")
  lint_changed_files(changed_files(read_record(record), hashes, sources))
  merge_gate_part("fast_frame")
  replace(record, record_of(hashes))
  print("safari fast: green")
  print("NOT RUN, left to the merge gate: the roots web.roc, lib and the tutorial, the widgets, the whole-tree lints, the tutorial's build, the benches' roc check, StepBack, OnRoad, ShapesFrame, the other held depths, the page")
  return nil
end

main()
