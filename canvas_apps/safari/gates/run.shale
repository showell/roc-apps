-- budget: steps=40000000 reads=20000 read_bytes=400000000 output_bytes=200000
-- This is safari's merge gate. It runs everything in safari before a push, and
-- reports every failure. fast.shale is the tier for each edit, and publish.shale
-- runs this one from cold caches.
--
--   cd <roc-apps checkout> && nice -n 19 shale canvas_apps/safari/gates/run.shale
--
-- Run from the roc-apps root: every path is the checkout's, so a worktree
-- gates its own tree. One merge gate runs at a time, on the one cache folder.
-- It takes about 75 seconds, half of that the proof tools.
--
-- Each stage has a CPU budget, about twice its warm time, in CPU_BUDGET_MS. A
-- stage over it stops the run, since a slow gate is a fault to find, and a cold
-- run has no budgets. Stage times go in `build:times/safari.tsv`, and a large
-- change from the recent ones prints a line (cookbook/times.shale).
--
-- The gates run as child runs of this script, `part=expects`, `part=widgets`,
-- `part=tutorial`, `part=book_names`, `part=proof` and `part=page`, one program
-- of this run's each.
-- A child runs alone the same way (`... run.shale part=proof`).
--
-- The lints (gates/lints.shale) run first: shale's Roc lints, each count held
-- to the table there.
--
-- `part=tutorial` runs tutorial/build.shale's self-test, then builds the
-- tutorial, so a name it quotes that is gone from the code fails the gates.
--
-- `part=book_names` runs gates/book_names.shale, which finds a backticked name
-- in the tutorial's prose, or a node name in its diagrams, that is gone from the
-- code. While the book is parked it only prints its counts, marked SKIPPED, and
-- holds none; when the chapters are rewritten, it goes back to holding them.
--
-- `part=expects` runs `roc test --verbose` from each of EXPECT_ROOTS, whose
-- reach together is every expect: gates/CrossModuleExpects.roc reaches nearly
-- all of them, web.roc the game's modules that only the running game imports,
-- and lib's package root all of lib. The source is the count, so no number
-- needs keeping: every line of a `.roc` file in safari, gates/ or lib that
-- starts `expect` must print `PASS` once in a run that reaches it, and a `PASS`
-- must name such a line. An expect sits at the top level of its file. One
-- indented into a block or a function fails here, and so does one in a module
-- no root reaches. The roots overlap, so a line that two roots reach counts
-- once. It also runs `part=format`, `roc fmt --check` over safari, lib,
-- widget_kit and the widgets, the check fast.shale runs too.
--
-- `part=widgets` runs `roc check` and `roc test --verbose` on each widget's
-- web.roc, because the widgets import the game through game.roc and a change to
-- a type they use breaks them. The widgets are the `*_widget` folders of
-- canvas_apps, found by listing it, and finding none fails. Every expect in a
-- widget or in widget_kit must pass, counted as in `part=expects`. `roc test` has
-- no way to run one module's expects, so each widget runs the game's again: that
-- is most of this part's time.
--
-- The proof tools: StepBack passes on "every step back went back one step",
-- OnRoad on "the ride stayed on the road", and ShapesFrame on "differ 0" at
-- every depth. All their output but OnRoad's, and RasterFrame's hash of the
-- frame at each depth, is held exactly to gates/proof.expected. A change that
-- rightly alters the picture changes that file with it, and the commit says
-- why. OnRoad's widest point and finishing step move with every physics
-- change, so they are printed and not held.
-- A depth is there for what its frame shows: at 100 a Roc bird is in flight,
-- at 1570 a cat is frozen in the road, at 1590 it is in mid-leap, at 3742 a
-- distant truck's glow is about a pixel across, at 5700 the truck is ahead at
-- dusk with its lights on, and at 6553 it is braking in plain view with its
-- brake lights on.
--
-- `part=page` runs canvas_apps/build.sh for safari's dev page, into a scratch
-- folder so the dev channel doesn't move, and holds the hash of what it drew to
-- gates/page.expected. With `release=1`, which publish.shale gives it, it builds
-- the release page into the dev channel, held to the same hash.
--
-- Roc is roc-apps' pin, the nightly named in `roc-version`, installed at
-- `tools:roc-<pin>/roc` (`~/tools/` on the box).
--
-- Every Roc here runs on one warm cache, under `build:`. `cold=1`, which
-- publish.shale gives it, runs each child on an empty cache instead. The caches
-- are cleared when they pass CACHE_CEILING_MB.
--
-- Each child's binaries and outputs go in a folder of its own under `scratch:`
-- (`fresh_dir`), removed when the child passes and kept, named, when it fails.
use("cookbook:times.shale")

const SAFARI = "canvas_apps/safari"
const PROOF_EXPECTED = "canvas_apps/safari/gates/proof.expected"
const PAGE_EXPECTED = "canvas_apps/safari/gates/page.expected"
const WANT = "roc-pin: roc-apps' pinned nightly, and the binaries it builds"
const PAGE_WANT = "script: canvas_apps/build.sh builds and checks a page, and refuses another Roc"

-- The tiers' Roc caches, never the user's default one. The merge gate has one
-- folder, and each checkout's fast tier has its own, because two Rocs that write
-- one cache entry at once share its temporary file.
const CACHES = "build:roc-apps/safari-gate-caches"
const MERGE_CACHE = "build:roc-apps/safari-gate-caches/merge"

function roc_path()
  if not exists("roc-version") then fail("safari gates: no roc-version here: run from the roc-apps root") end
  local pin = trim(read("roc-version"))
  local roc = "tools:roc-" .. pin .. "/roc"
  if not exists(roc) then fail("safari gates: no " .. roc .. ": install roc-apps' pinned nightly " .. pin .. " at ~/tools/roc-" .. pin .. "/") end
  local v = run({real(roc), "version"}, {timeout_ms = 30000, whole = 4000, want = WANT})
  if trim(v.out) ~= "Roc compiler version " .. pin then fail("safari gates: " .. roc .. " is " .. trim(v.out) .. ", not " .. pin) end
  return real(roc)
end

-- The environment that points a Roc at the cache `folder`.
function cache_env(folder)
  if not exists(folder) then mkdir(folder) end
  return {XDG_CACHE_HOME = real(folder)}
end

-- One tool of gates/ built into the folder `bin`; whether it built clean.
function tool_build(roc, bin, n, env)
  local b = run({roc, "build", "--opt=dev", n .. ".roc", "--output=" .. real(bin) .. "/" .. n},
    {timeout_ms = 600000, cwd = SAFARI .. "/gates", re = "✗|●", head = 40, want = WANT, env = env})
  print("build " .. n .. ": " .. b.ms .. " ms, " .. b.matched_lines .. " errors or warnings")
  if b.matched_lines > 0 then
    print(trim(b.out))
    return false
  end
  return exists(bin .. "/" .. n)
end

-- Where `roc test`, run in safari's folder, says a source line is.
function printed_at(path, line)
  if starts_with(path, SAFARI .. "/") then return sub(path, #SAFARI + 2) .. ":" .. line end
  return "../" .. sub(path, #"canvas_apps/" + 1) .. ":" .. line
end

-- The set of `expect` lines in the source, each as `roc test` prints it. An
-- indented one is printed and fails the count.
function written_expects(sources)
  local argv = {"git", "grep", "-n", "--untracked", "-E", "^[[:space:]]*expect( |$)", "--"}
  for s in sources do push(argv, s) end
  local r = run(argv, {timeout_ms = 30000, whole = 4000000})
  local written = {}
  local indented = 0
  for l in lines(trim(r.out)) do
    local parts = split(l, ":")
    local text = join(drop(parts, 2), ":")
    if starts_with(text, "expect") then
      written[printed_at(parts[1], parts[2])] = true
    else
      indented = indented + 1
      print("FAIL an expect not at the top level of its file: " .. parts[1] .. ":" .. parts[2])
    end
  end
  return {written = written, indented = indented}
end

-- Nil when build.sh's output `out` draws the held hash, else why not.
function drawn_wrong(out)
  local drawn = re_find(out, "drawn ([0-9]+)")
  if drawn == nil then return "no drawn hash in the page check's output" end
  local held = trim(read(PAGE_EXPECTED))
  if "drawn " .. drawn.group ~= held then return "the page drew " .. drawn.group .. ", and " .. PAGE_EXPECTED .. " holds " .. held end
  print("page drew " .. drawn.group .. ", as held")
  return nil
end

const SELF_PATH = "canvas_apps/safari/gates/run.shale"
const TUTORIAL = "canvas_apps/safari/tutorial/build.shale"
const BOOK_NAMES = "canvas_apps/safari/gates/book_names.shale"
const EXPECT_ROOTS = {"gates/CrossModuleExpects.roc", "web.roc", "../lib/main.roc"}
const SAFARI_SOURCES = {":(glob)canvas_apps/safari/*.roc", ":(glob)canvas_apps/safari/gates/*.roc", ":(glob)canvas_apps/lib/*.roc"}
const WIDGET_SOURCES = {":(glob)canvas_apps/*_widget/*.roc", ":(glob)canvas_apps/widget_kit/*.roc"}
const DEPTHS = {"0", "100", "1570", "1590", "3000", "3742", "5700", "6553", "9000"}
const CACHE_CEILING_MB = 4000
-- The widgets' budget is set from a cold cache after a change to a module they
-- all import: 53 s of CPU for 13 widgets, measured 2026-11-07.
const CPU_BUDGET_MS = {lints = 25000, expects = 30000, widgets = 60000, tutorial = 5000, book_names = 2000, proof = 60000, page = 25000}
const COLD = arg("cold", "") == "1"
const RELEASE = arg("release", "") == "1"

-- The cache a child runs on: empty in a cold run, else the merge gate's.
function child_cache(name)
  if COLD then return fresh_dir("scratch:", "safari-cache-" .. name) end
  return MERGE_CACHE
end

function drop_child_cache(cache)
  if COLD then remove_tree(cache) end
  return nil
end

function clear_full_caches()
  if not exists(CACHES) then return true end
  local du = run({"du", "-sm", real(CACHES)}, {timeout_ms = 60000, whole = 4000, want = "tool: the caches' size"})
  local size = tonumber(split(trim(du.out), "\t")[1])
  if size > CACHE_CEILING_MB then
    print("safari gates: the caches hold " .. size .. " MB, over " .. CACHE_CEILING_MB .. ": cleared, so this run is cold")
    remove_tree(CACHES)
    return true
  end
  return false
end

-- `run`'s options for a stage, with its budget when the caches are warm.
function stage_opts(stage, tail, is_cold)
  local opts = {timeout_ms = 1800000, tail = tail}
  if not is_cold then opts.cpu_budget_ms = CPU_BUDGET_MS[stage] end
  return opts
end

-- One root's run: what it passed goes in `passed`, and the answer is how many
-- things went wrong.
function test_root(roc, env, root, passed)
  local r = run({roc, "test", "--verbose", root},
    {timeout_ms = 300000, cwd = SAFARI, whole = 4000000, want = WANT, env = env})
  local here = {}
  local wrong = 0
  local printed = 0
  for l in lines(r.out) do
    if starts_with(l, "PASS: ") then
      local at = trim(sub(l, 7))
      printed = printed + 1
      if has_key(here, at) then
        wrong = wrong + 1
        print("FAIL passed twice from " .. root .. ": " .. at)
      end
      here[at] = true
      passed[at] = true
    elseif contains(l, "✗") or contains(l, "●") or contains(l, "TEST FAILURE") then
      wrong = wrong + 1
      print("FAIL " .. root .. ": " .. trim(l))
    end
  end
  local summary = re_find(r.out, "All \\(([0-9]+)\\) tests passed")
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 or summary == nil or tonumber(summary.group) ~= printed then
    wrong = wrong + 1
    print("FAIL roc test " .. root .. " ended " .. r.ended .. " " .. get(r, "code", -1) .. " with " .. printed .. " PASS lines: " .. trim(sub(r.out, #r.out - 300)))
  end
  print("roc test " .. root .. ": " .. printed .. " passed, " .. r.ms .. " ms")
  return wrong
end

-- How far the expects in `source` and the ones that `passed` disagree.
function expects_unheld(source, passed)
  local wrong = source.indented
  for at in keys(source.written) do
    if not has_key(passed, at) then
      wrong = wrong + 1
      print("FAIL not passed from any root: " .. at)
    end
  end
  for at in keys(passed) do
    if not has_key(source.written, at) then
      wrong = wrong + 1
      print("FAIL passed, but no top-level expect in the source: " .. at)
    end
  end
  return wrong
end

-- The widget folders of canvas_apps, by listing it, so a new one can't be
-- missed.
function widget_folders()
  local folders = {}
  for name in ls("canvas_apps") do
    if ends_with(name, "_widget") and is_dir("canvas_apps/" .. name) then push(folders, name) end
  end
  if #folders == 0 then fail("safari gates: no *_widget folders in canvas_apps") end
  return folders
end

-- How many things are wrong with the formatting. `roc fmt` keeps no cache.
function format_wrong(roc)
  local argv = {roc, "fmt", "--check", ".", "../lib", "../widget_kit"}
  for folder in widget_folders() do push(argv, "../" .. folder) end
  local fmt = run(argv, {timeout_ms = 60000, cwd = SAFARI, tail = 40, want = WANT})
  if fmt.ended == "exit" and get(fmt, "code", -1) == 0 then return 0 end
  print("FAIL roc fmt would change a file: " .. trim(fmt.out))
  return 1
end

function format()
  if format_wrong(roc_path()) > 0 then fail("safari gates: roc fmt would change a file") end
  return nil
end

function expects()
  local roc = roc_path()
  local cache = child_cache("expects")
  local env = cache_env(cache)
  local passed = {}
  local wrong = format_wrong(roc)
  for root in EXPECT_ROOTS do wrong = wrong + test_root(roc, env, root, passed) end
  drop_child_cache(cache)
  local source = written_expects(SAFARI_SOURCES)
  wrong = wrong + expects_unheld(source, passed)
  print("expects: " .. #keys(source.written) .. " in the source, " .. #keys(passed) .. " passed, " .. wrong .. " wrong")
  if #keys(source.written) == 0 then fail("safari gates: no expects found") end
  if wrong > 0 then fail("safari gates: the expects failed") end
  return nil
end

-- One widget's `roc check`: how many things went wrong.
function check_widget(roc, env, folder)
  local r = run({roc, "check", "web.roc"}, {timeout_ms = 120000, cwd = "canvas_apps/" .. folder, head = 40, want = WANT, env = env})
  print("roc check " .. folder .. ": " .. r.ms .. " ms")
  if r.ended == "exit" and get(r, "code", -1) == 0 and contains(r.out, "No errors found") then return 0 end
  print("FAIL roc check " .. folder .. ": " .. trim(r.out))
  return 1
end

-- The lines of `passed` that a widget or widget_kit holds. The rest are the
-- game's and lib's, which `part=expects` counts.
function widget_lines(passed)
  local kept = {}
  for at in keys(passed) do
    if contains(at, "_widget/") or starts_with(at, "../widget_kit/") then kept[at] = true end
  end
  return kept
end

-- A widget that doesn't check isn't tested, so the count waits for them all.
function widgets()
  local roc = roc_path()
  local cache = child_cache("widgets")
  local env = cache_env(cache)
  local passed = {}
  local wrong = 0
  local folders = widget_folders()
  for folder in folders do
    local broken = check_widget(roc, env, folder)
    wrong = wrong + broken
    if broken == 0 then wrong = wrong + test_root(roc, env, "../" .. folder .. "/web.roc", passed) end
  end
  drop_child_cache(cache)
  local source = written_expects(WIDGET_SOURCES)
  if #keys(source.written) == 0 then fail("safari gates: no expects found in the widgets") end
  if wrong == 0 then wrong = expects_unheld(source, widget_lines(passed)) end
  print("widgets: " .. #folders .. " checked, " .. #keys(source.written) .. " expects in the source, " .. wrong .. " wrong")
  if wrong > 0 then fail("safari gates: the widgets failed") end
  return nil
end

-- A tool's run over the held depths: its output, once it has ended well.
function held_run(bin, n, args)
  local argv = {real(bin .. "/" .. n)}
  for a in args do push(argv, a) end
  local r = run(argv, {timeout_ms = 600000, whole = 100000, want = WANT})
  print(trim(r.out))
  print(n .. ": " .. r.ms .. " ms")
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 then return nil end
  return trim(r.out)
end

function held_args()
  local args = {"held"}
  for d in DEPTHS do push(args, d) end
  return args
end

function proof()
  local roc = roc_path()
  local scratch = fresh_dir("scratch:", "safari-proof")
  local bin = scratch .. "/bin"
  mkdir(bin)
  local cache = child_cache("proof")
  local env = cache_env(cache)
  local bad = 0
  local held = {}
  local tools = {
    {name = "StepBack", args = {}, held = true},
    {name = "OnRoad", args = {}, held = false},
    {name = "ShapesFrame", args = held_args(), held = true},
    {name = "RasterFrame", args = held_args(), held = true},
  }
  local unheld = ""
  for tool in tools do
    local out = nil
    if tool_build(roc, bin, tool.name, env) then out = held_run(bin, tool.name, tool.args) end
    if out == nil then
      bad = bad + 1
    elseif tool.held then
      push(held, out)
    else
      unheld = unheld .. out .. "\n"
    end
  end
  drop_child_cache(cache)
  local got = join(held, "\n") .. "\n"
  if not contains(got, "every step back went back one step") then bad = bad + 1 end
  if not contains(unheld, "the ride stayed on the road") then bad = bad + 1 end
  for l in lines(got) do
    if starts_with(l, "ShapesFrame ") and not contains(l, ": differ 0 ") then bad = bad + 1 end
  end
  if not exists(PROOF_EXPECTED) or read(PROOF_EXPECTED) ~= got then
    replace(scratch .. "/proof.got", got)
    print("FAIL the proof tools' output is not " .. PROOF_EXPECTED .. "; it is in " .. scratch .. "/proof.got")
    bad = bad + 1
  end
  print("proof tools: " .. bad .. " bad")
  if bad > 0 then fail("safari gates: " .. bad .. " proof check(s) failed; binaries kept in " .. scratch) end
  remove_tree(scratch)
  return nil
end

function page()
  local scratch = fresh_dir("scratch:", "safari-page")
  local cache = child_cache("page")
  local argv = {"bash", "canvas_apps/build.sh", "safari"}
  local env = cache_env(cache)
  if RELEASE then
    push(argv, "release")
  else
    env.OUT = real(scratch) .. "/safari"
  end
  local r = run(argv, {timeout_ms = 600000, whole = 200000, want = PAGE_WANT, env = env})
  drop_child_cache(cache)
  print("build.sh safari: " .. r.ms .. " ms")
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 then
    print(trim(r.out))
    fail("safari gates: the page didn't build")
  end
  local wrong = drawn_wrong(r.out)
  if wrong ~= nil then fail("safari gates: " .. wrong) end
  remove_tree(scratch)
  return nil
end

function tutorial()
  local cache = child_cache("tutorial")
  local env = cache_env(cache)
  for argv in {{"shale", "--root", ".", TUTORIAL, "self_test=1"}, {"shale", "--root", ".", TUTORIAL}} do
    print(trim(must(run(argv, {timeout_ms = 60000, tail = 20, env = env})).out))
  end
  drop_child_cache(cache)
  return nil
end

-- The book is parked until its chapters are rewritten (Steve, 2026-11-07), so
-- the stale names are counted and printed, loudly, but no count is held: a held
-- count only tracked how broken the parked prose was, and churned at every merge.
function book_names()
  local r = run({"shale", "--root", ".", BOOK_NAMES, "held=0", "held_diagram=0"}, {timeout_ms = 60000, tail = 100})
  local summary = "no summary line"
  for line in lines(r.out) do
    if starts_with(line, "book_names:") then summary = line end
  end
  print("book_names: SKIPPED while the book is parked: " .. summary)
  return nil
end

-- Every gate, each a child run; a child that fails is named, and the rest
-- still run.
function all()
  roc_path()
  local is_cold = clear_full_caches() or COLD
  local bad = {}
  local times = {}
  local lints = timed_run("safari", "lints", {"shale", "--root", ".", SAFARI .. "/gates/lints.shale"}, stage_opts("lints", 40, is_cold))
  for l in lines(lints.out) do
    if not starts_with(l, "── ") then print(l) end
  end
  push(times, "lints " .. (lints.ms // 1000) .. " s")
  if lints.ended ~= "exit" or lints.code ~= 0 then push(bad, "lints") end
  for part in {"expects", "widgets", "tutorial", "book_names", "proof", "page"} do
    -- A child, and every roc under it, inherits this run's niceness.
    local argv = {"shale", "--root", ".", SELF_PATH, "part=" .. part}
    if COLD then push(argv, "cold=1") end
    local r = timed_run("safari", "part=" .. part, argv, stage_opts(part, 200, is_cold))
    for l in lines(r.out) do
      if not starts_with(l, "── budgets") then print(l) end
    end
    push(times, "part=" .. part .. " " .. (r.ms // 1000) .. " s")
    if r.ended ~= "exit" or r.code ~= 0 then push(bad, "part=" .. part) end
  end
  print("safari gates: " .. join(times, ", "))
  if #bad > 0 then fail("safari gates: " .. #bad .. " failed: " .. join(bad, ", ")) end
  print("safari gates: expects held, widgets checked, tutorial built, book names held, proof tools ok, page drawn")
  if not COLD then print("NOT RUN, left to publish: check.shale, cold caches, release wasm, the widgets' page builds") end
end

const PART = arg("part", "")
if PART == "" then
  all()
elseif PART == "expects" then
  expects()
elseif PART == "widgets" then
  widgets()
elseif PART == "format" then
  format()
elseif PART == "proof" then
  proof()
elseif PART == "tutorial" then
  tutorial()
elseif PART == "book_names" then
  book_names()
elseif PART == "page" then
  page()
else
  fail("safari gates: part= is expects, widgets, format, proof, tutorial, book_names or page (none runs them all)")
end
