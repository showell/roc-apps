-- budget: steps=40000000 reads=20000 read_bytes=400000000 output_bytes=200000
-- This is safari's merge gate. It runs everything in safari before a push, and
-- reports every failure. fast.shale is the tier for each edit, and
-- publish.shale runs this one from cold caches.
--
--   cd <roc-apps checkout> && nice -n 19 shale canvas_apps/safari/gates/run.shale
--
-- Run it from the roc-apps root: every path is the checkout's, so a worktree
-- gates its own tree on its own caches, and gates in several worktrees can run
-- at once. It takes about two minutes warm (112 s, 2026-11-08), most of it in
-- the lints, the expects and the proof tools. This header is the one home of
-- that figure; the docs point here.
--
-- The lints (gates/lints.shale) run first. Then each gate is a child run of
-- this script, `part=expects`, `part=widgets`, `part=tutorial`,
-- `part=book_names`, `part=proof` and `part=page`, which also runs alone
-- (`... run.shale part=proof`); each part's function says what it holds.
-- fast.shale and lints.shale ask this script for what they share with it, by
-- the parts at the bottom.
--
-- Each stage has a CPU budget, about twice its warm time, in CPU_BUDGET_MS. A
-- stage over it stops the run, since a slow gate is a fault to find.
-- cookbook/times.shale keeps the stages' times in `build:times/safari.tsv`,
-- prints a line for a large change, and holds a cold run to no budget.
--
-- Roc is roc-apps' pin, the nightly named in `roc-version`, installed at
-- `tools:roc-<pin>/roc` (`~/tools/` on the box), which the repository's
-- prelude, `.shale/prelude.shale`, finds and checks. Every Roc here runs on the
-- checkout's warm cache, under `build:` (CACHES); `cold=1`, which
-- publish.shale gives it, runs each child on an empty cache instead.
-- Each child's binaries and outputs go in a folder of its own under `scratch:`
-- (`fresh_dir`), removed when the child passes and kept, named, when it fails.
use("cookbook:times.shale")

const SAFARI = "canvas_apps/safari"
const GATES = SAFARI .. "/gates"
const LINTS = GATES .. "/lints.shale"
-- The folder of the proof tools' sources, StepBack, OnRoad, ShapesFrame and
-- RasterFrame, where they build, with the modules only they use and the
-- benches, the tools for measuring a frame's cost, which `part=proof` checks
-- but never builds or runs.
const PROOF_TOOLS = GATES .. "/proof"
const BENCHES = {"FrameBench", "FramePartsBench"}
const PROOF_EXPECTED = GATES .. "/proof.expected"
const PAGE_EXPECTED = GATES .. "/page.expected"
-- The widgets: each folder of canvas_apps that WIDGET_APPS matches is one,
-- with a web.roc, and WIDGET_KIT is what they share. Every list here of the
-- widgets' folders or sources comes from these two, and so does lints.shale's,
-- which it asks for with `part=widget_globs`.
const WIDGET_APPS = "canvas_apps/*_widget"
const WIDGET_KIT = "canvas_apps/widget_kit"
const WIDGET_SOURCE_GLOBS = {WIDGET_APPS .. "/**/*.roc", WIDGET_KIT .. "/**/*.roc"}
const WANT = "roc-pin: roc-apps' pinned nightly, and the binaries it builds"
-- What Roc prints at an error or a warning, the verdict for a build, since
-- Roc exits non-zero for a warning; and what a clean `roc check` says.
const ROC_ERROR_MARK = "✗|●"
const ROC_CHECK_CLEAN = "No errors found"
-- What `roc test` says when every expect passed, with their count.
const ROC_TEST_PASSED = "All \\(([0-9]+)\\) tests passed"
const PAGE_WANT = "script: canvas_apps/build.sh builds and checks a page, and refuses another Roc"

-- The tiers' Roc caches, never the user's default one. Each checkout has a
-- folder of its own under CACHES, named for the checkout's path, so a gate in
-- one worktree never reads, clears or races on another's. In it this gate has
-- `merge` and fast.shale has `fast`, which it asks for with
-- `part=fast_cache`, apart because two Rocs that write one cache entry at once
-- share its temporary file. The folder is cleared when it passes
-- CHECKOUT_CEILING_MB, and a removed worktree's folder goes at the next merge
-- gate run in any checkout.
const CACHES = "build:roc-apps/safari-checkout-caches"
-- The merge cache is about 900 MB warm and a fast one 100 to 450 MB
-- (2026-11-07), so this leaves room for both to grow.
const CHECKOUT_CEILING_MB = 2000

function cache_folder_name(checkout_path)
  return substitute(checkout_path, "/", "-")
end

-- This checkout's folder, for a gate run from its root.
function checkout_caches()
  return CACHES .. "/" .. cache_folder_name(real("."))
end

-- The environment that points a Roc at the cache `folder`.
function cache_env(folder)
  if not exists(folder) then mkdir(folder) end
  return {XDG_CACHE_HOME = real(folder)}
end

-- One proof tool built into the folder `bin`; whether it built clean.
function tool_build(roc, bin, n, env)
  local b = run({roc, "build", "--opt=dev", n .. ".roc", "--output=" .. real(bin) .. "/" .. n},
    {timeout_ms = 600000, cwd = PROOF_TOOLS, re = ROC_ERROR_MARK, head = 40, want = WANT, env = env})
  print("build " .. n .. ": " .. b.ms .. " ms, " .. b.matched_lines .. " errors or warnings")
  if b.matched_lines > 0 then
    print(trim(b.out))
    return false
  end
  return exists(bin .. "/" .. n)
end

-- One `roc check` of `file`, run in the folder `cwd`: the run, and whether it
-- is clean, which takes both an exit of 0 and ROC_CHECK_CLEAN in its output.
function roc_check(roc, env, cwd, file)
  local r = run({roc, "check", file}, {timeout_ms = 120000, cwd = cwd, whole = 4000000, want = WANT, env = env})
  return {run = r, is_clean = r.ended == "exit" and get(r, "code", -1) == 0 and contains(r.out, ROC_CHECK_CLEAN)}
end

-- One bench's `roc check`: how many things went wrong.
function check_bench(roc, env, n)
  local checked = roc_check(roc, env, PROOF_TOOLS, n .. ".roc")
  print("roc check " .. n .. ": " .. checked.run.ms .. " ms")
  if checked.is_clean then return 0 end
  print("FAIL roc check " .. n .. ": " .. trim(checked.run.out))
  return 1
end

-- Where `roc test`, run in safari's folder, says a source line is.
function printed_at(path, line)
  if starts_with(path, SAFARI .. "/") then return sub(path, #SAFARI + 2) .. ":" .. line end
  return "../" .. sub(path, #"canvas_apps/" + 1) .. ":" .. line
end

-- The set of `expect` lines in the source, each as `roc test` prints it. An
-- indented one is printed and fails the count.
function written_expects(sources)
  local argv = {"git", "grep", "-n", "--untracked", "-E", "^[[:space:]]*expect( |$)", "--"}
  for s in sources do push(argv, s) end
  local r = run(argv, {timeout_ms = 30000, whole = 4000000})
  local written = {}
  local indented = 0
  for l in lines(trim(r.out)) do
    local parts = split(l, ":")
    local text = join(drop(parts, 2), ":")
    if starts_with(text, "expect") then
      written[printed_at(parts[1], parts[2])] = true
    else
      indented = indented + 1
      print("FAIL an expect not at the top level of its file: " .. parts[1] .. ":" .. parts[2])
    end
  end
  return {written = written, indented = indented}
end

-- Nil when build.sh's output `out` draws the held hash, else why not.
function drawn_wrong(out)
  local drawn = re_find(out, "drawn ([0-9]+)")
  if drawn == nil then return "no drawn hash in the page check's output" end
  local held = trim(read(PAGE_EXPECTED))
  if "drawn " .. drawn.group ~= held then return "the page drew " .. drawn.group .. ", and " .. PAGE_EXPECTED .. " holds " .. held end
  print("page drew " .. drawn.group .. ", as held")
  return nil
end

const SELF_PATH = GATES .. "/run.shale"
const TUTORIAL = "canvas_apps/safari/tutorial/build.shale"
const COLOR_ROC = "canvas_apps/safari/tutorial/color_roc.shale"
const BOOK_NAMES = GATES .. "/book_names.shale"
const INPUT_BITS = GATES .. "/input_bits.shale"
-- The root that reaches nearly every expect, the one fast.shale runs.
const MAIN_EXPECT_ROOT = "gates/expects/main.roc"
const EXPECT_ROOTS = {MAIN_EXPECT_ROOT, "web.roc", "../lib/main.roc", "tutorial/make_book.roc"}
-- The packages of other repos that a root reaches. Their expects run, and are
-- that repo's to count, so they are neither held here nor a failure. A `PASS`
-- outside the checkout from any other folder fails.
const OTHER_REPO_PACKAGES = {"../../../roc-markdown/package/"}
-- The widgets' expect root, from safari's folder, where `roc test` runs, and
-- from the checkout's root, for git. Its own expects are the widgets', since
-- only it reaches them.
const WIDGET_ROOT_FROM_SAFARI = "gates/WidgetExpects.roc"
const WIDGET_ROOT_FROM_CHECKOUT = SAFARI .. "/" .. WIDGET_ROOT_FROM_SAFARI
-- The tutorial's fails/ are apps that must not compile, so no root reaches them.
const SAFARI_SOURCES = {":(glob)canvas_apps/safari/**/*.roc", ":(exclude,glob)canvas_apps/safari/tutorial/fails/**", ":(glob)canvas_apps/lib/*.roc", ":(exclude)" .. WIDGET_ROOT_FROM_CHECKOUT}
-- A depth is there for what its frame shows: at 100 a Roc bird is in flight,
-- at 1529 a cat is frozen in the road, at 1542 it is in mid-leap, at 3698 the
-- truck brakes about 600 m off and its glow is about a pixel across, at 5700
-- the truck is ahead at dusk with its lights on, and at 6250 it is braking in
-- plain view with its brake lights on. Each is a step of the ride's timing, so
-- a physics change that moves the ride can empty a frame: check each scene
-- again after one.
const DEPTHS = {"0", "100", "1529", "1542", "3000", "3698", "5700", "6250", "9000"}
-- fast.shale's one frame stands in for the other depths, because an
-- arithmetic slip no expect covers moves the picture. It's 5700, the truck
-- ahead at dusk with its lights on, because that scene shows the most of the
-- game: a constant nudged in one drawing module moved it for 12 of 17
-- modules, where 3000 moved for 9 and 1586 for 7.
const FAST_FRAME_DEPTH = "5700"
-- The widgets' budget is about twice their warm time: 25 s of CPU for 13
-- widgets' checks, their one test run and their 13 wasm builds, which cost about
-- 7 s of it, measured 2026-11-08. A cold run of the checks and the test took
-- 23 s on 2026-11-07, before the builds.
const CPU_BUDGET_MS = {lints = 25000, expects = 50000, widgets = 50000, tutorial = 5000, book_names = 2000, proof = 60000, page = 25000}
const COLD = arg("cold", "") == "1"
const RELEASE = arg("release", "") == "1"

-- The cache a child runs on: empty in a cold run, else the merge gate's.
function child_cache(name)
  if COLD then return fresh_dir("scratch:", "safari-cache-" .. name) end
  return checkout_caches() .. "/merge"
end

function drop_child_cache(cache)
  if COLD then remove_tree(cache) end
  return nil
end

-- The size of `folder` in MB, or a failure naming why du couldn't say.
function size_mb(folder)
  local du = run({"du", "-sm", real(folder)}, {timeout_ms = 60000, whole = 4000, want = "any: du, the caches' size"})
  local size = nil
  if du.ended == "exit" and get(du, "code", -1) == 0 then size = tonumber(split(trim(du.out), "\t")[1]) end
  if size == nil then fail("safari gates: du of " .. folder .. " ended " .. du.ended .. " " .. get(du, "code", -1) .. ": " .. trim(du.out)) end
  return size
end

-- Removes the folder of each checkout that `git worktree list` no longer has.
function prune_removed_checkouts()
  if not exists(CACHES) then return nil end
  local r = must(run({"git", "worktree", "list", "--porcelain"}, {timeout_ms = 30000, whole = 100000}))
  local live = {}
  for l in lines(r.out) do
    if starts_with(l, "worktree ") then live[cache_folder_name(sub(l, #"worktree " + 1))] = true end
  end
  for name in ls(CACHES) do
    if not has_key(live, name) then
      -- Two gates may prune one folder at once, and `remove_tree` stops on an
      -- entry the other already removed, where `rm -rf` passes over it.
      local rm = run({"rm", "-rf", real(CACHES .. "/" .. name)}, {timeout_ms = 120000, whole = 4000, want = "any: rm, a removed checkout's caches, which two gates may prune at once"})
      if rm.ended ~= "exit" or get(rm, "code", -1) ~= 0 then fail("safari gates: rm -rf " .. CACHES .. "/" .. name .. " failed: " .. trim(rm.out)) end
      print("safari gates: " .. CACHES .. "/" .. name .. " names no checkout: removed")
    end
  end
  return nil
end

-- Clears this checkout's caches when they pass the ceiling; whether the merge
-- gate's cache is empty now, so the run is cold. The checkout's folder also
-- holds fast.shale's cache, so it can be there while the merge cache isn't.
function clear_full_caches()
  local folder = checkout_caches()
  if not exists(folder) then return true end
  local size = size_mb(folder)
  if size > CHECKOUT_CEILING_MB then
    print("safari gates: " .. folder .. " holds " .. size .. " MB, over " .. CHECKOUT_CEILING_MB .. ": cleared, so this run is cold")
    remove_tree(folder)
    return true
  end
  local merge = folder .. "/merge"
  return not exists(merge) or #ls(merge) == 0
end

-- `run`'s options for a stage. A cold one goes to `timed_run`, which drops
-- the budget and keeps the run out of the times history.
function stage_opts(stage, tail, is_cold)
  return {timeout_ms = 1800000, tail = tail, cpu_budget_ms = CPU_BUDGET_MS[stage], cold = is_cold}
end

-- Whether `at`, a `PASS` line's place, is in a package of OTHER_REPO_PACKAGES.
function other_repo_package(at)
  for p in OTHER_REPO_PACKAGES do
    if starts_with(at, p) then return true end
  end
  return false
end

-- One root's run: what it passed goes in `passed`, and the answer is how many
-- things went wrong.
function test_root(roc, env, root, passed)
  local r = run({roc, "test", "--verbose", root},
    {timeout_ms = 300000, cwd = SAFARI, whole = 4000000, want = WANT, env = env})
  local here = {}
  local wrong = 0
  local printed = 0
  local other_repos = 0
  for l in lines(r.out) do
    if starts_with(l, "PASS: ") then
      local at = trim(sub(l, 7))
      printed = printed + 1
      if starts_with(at, "../../../") then
        if other_repo_package(at) then
          other_repos = other_repos + 1
        else
          wrong = wrong + 1
          print("FAIL passed from outside the checkout, in no package of OTHER_REPO_PACKAGES: " .. at)
        end
      else
        if has_key(here, at) then
          wrong = wrong + 1
          print("FAIL passed twice from " .. root .. ": " .. at)
        end
        here[at] = true
        passed[at] = true
      end
    elseif re_match(l, ROC_ERROR_MARK) or contains(l, "TEST FAILURE") then
      wrong = wrong + 1
      print("FAIL " .. root .. ": " .. trim(l))
    end
  end
  local summary = re_find(r.out, ROC_TEST_PASSED)
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 or summary == nil or tonumber(summary.group) ~= printed then
    wrong = wrong + 1
    print("FAIL roc test " .. root .. " ended " .. r.ended .. " " .. get(r, "code", -1) .. " with " .. printed .. " PASS lines: " .. trim(sub(r.out, #r.out - 300)))
  end
  local others = ""
  if other_repos > 0 then others = " (" .. other_repos .. " of them other repos', not counted)" end
  print("roc test " .. root .. ": " .. printed .. " passed" .. others .. ", " .. r.ms .. " ms")
  return wrong
end

-- How far the expects in `source` and the ones that `passed` disagree.
function expects_unheld(source, passed)
  local wrong = source.indented
  for at in keys(source.written) do
    if not has_key(passed, at) then
      wrong = wrong + 1
      print("FAIL not passed from any root: " .. at)
    end
  end
  for at in keys(passed) do
    if not has_key(source.written, at) then
      wrong = wrong + 1
      print("FAIL passed, but no top-level expect in the source: " .. at)
    end
  end
  return wrong
end

-- The widget folders of canvas_apps, by listing it, so a new one can't be
-- missed.
function widget_folders()
  local folders = {}
  for name in ls("canvas_apps") do
    if match_path("canvas_apps/" .. name, WIDGET_APPS) and is_dir("canvas_apps/" .. name) then push(folders, name) end
  end
  if #folders == 0 then fail("safari gates: no folders " .. WIDGET_APPS) end
  return folders
end

-- The widgets' sources, as git pathspecs.
function widget_sources()
  local sources = {}
  for g in WIDGET_SOURCE_GLOBS do push(sources, ":(glob)" .. g) end
  push(sources, WIDGET_ROOT_FROM_CHECKOUT)
  return sources
end

-- Whether `at`, a place `roc test` printed from safari's folder, is in a
-- widget or in widget_kit.
function is_widget_source(at)
  local m = re_find(at, "^\\.\\./(.+):[0-9]+$")
  if m == nil then return false end
  for g in WIDGET_SOURCE_GLOBS do
    if match_path("canvas_apps/" .. m.group, g) then return true end
  end
  return false
end

-- How many things are wrong with the formatting. `roc fmt` keeps no cache.
function format_wrong(roc)
  local argv = {roc, "fmt", "--check", ".", "../lib", "../" .. basename(WIDGET_KIT)}
  for folder in widget_folders() do push(argv, "../" .. folder) end
  local fmt = run(argv, {timeout_ms = 60000, cwd = SAFARI, tail = 40, want = WANT})
  if fmt.ended == "exit" and get(fmt, "code", -1) == 0 then return 0 end
  print("FAIL roc fmt would change a file: " .. trim(fmt.out))
  return 1
end

function format()
  if format_wrong(pinned_roc("safari gates")) > 0 then fail("safari gates: roc fmt would change a file") end
  print("roc fmt --check: clean")
  return nil
end

-- `roc test --verbose` from each of EXPECT_ROOTS, whose reach together is
-- every expect: gates/expects/main.roc reaches nearly all of them,
-- web.roc the game's modules that only the running game imports, lib's
-- package root all of lib, and make_book.roc the tutorial's. The source is the
-- count, so no number needs keeping: every line of a `.roc` file in
-- SAFARI_SOURCES that starts `expect` must print `PASS` once in a run that
-- reaches it, and a `PASS` must name such a line. An expect sits at the top
-- level of its file. One indented into a block or a function fails here, and
-- so does one in a module no root reaches. The roots overlap, so a line that
-- two roots reach counts once. It also runs `part=format`'s check.
function expects()
  local roc = pinned_roc("safari gates")
  local cache = child_cache("expects")
  local env = cache_env(cache)
  local passed = {}
  local wrong = format_wrong(roc)
  for root in EXPECT_ROOTS do wrong = wrong + test_root(roc, env, root, passed) end
  drop_child_cache(cache)
  local source = written_expects(SAFARI_SOURCES)
  wrong = wrong + expects_unheld(source, passed)
  print("expects: " .. #keys(source.written) .. " in the source, " .. #keys(passed) .. " passed, " .. wrong .. " wrong")
  if #keys(source.written) == 0 then fail("safari gates: no expects found") end
  if wrong > 0 then fail("safari gates: the expects failed") end
  return nil
end

-- One widget's `roc check`: how many things went wrong.
function check_widget(roc, env, folder)
  local checked = roc_check(roc, env, "canvas_apps/" .. folder, "web.roc")
  print("roc check " .. folder .. ": " .. checked.run.ms .. " ms")
  if checked.is_clean then return 0 end
  print("FAIL roc check " .. folder .. ": " .. trim(checked.run.out))
  return 1
end

-- The web platform's host, which every widget's wasm links against, and the
-- script that builds it, which canvas_apps/build.sh runs too.
const WEB_HOST = "canvas_apps/web/platform/targets/wasm32/host.wasm"
const BUILD_WEB_HOST = "canvas_apps/web/build_host.sh"

-- Builds WEB_HOST when it is missing, as in a fresh worktree; a build that
-- fails, or leaves no host, fails the gate.
function ensure_web_host()
  if exists(WEB_HOST) then return nil end
  local h = run({"bash", BUILD_WEB_HOST}, {timeout_ms = 600000, tail = 40, want = "script: canvas_apps/web/build_host.sh builds the canvas_apps' wasm host with Zig"})
  print("build_host.sh: " .. h.ms .. " ms")
  if h.ended ~= "exit" or get(h, "code", -1) ~= 0 or not exists(WEB_HOST) then
    print(trim(h.out))
    fail("safari gates: " .. BUILD_WEB_HOST .. " ended " .. h.ended .. " " .. get(h, "code", -1) .. ", and the widgets' wasm links against " .. WEB_HOST)
  end
  return nil
end

-- One widget's web.roc built to wasm on the dev backend into the folder `bin`:
-- how many things went wrong. `roc check` passing says nothing about this, since
-- a build can still crash the compiler.
function build_widget(roc, env, bin, folder)
  local wasm = bin .. "/" .. folder .. ".wasm"
  local b = run({roc, "build", "web.roc", "--target=wasm32", "--opt=dev", "--output=" .. real(bin) .. "/" .. folder .. ".wasm"},
    {timeout_ms = 300000, cwd = "canvas_apps/" .. folder, whole = 200000, want = WANT, env = env})
  print("roc build " .. folder .. " (wasm, dev): " .. b.ms .. " ms")
  if b.ended == "exit" and re_find(b.out, ROC_ERROR_MARK) == nil and exists(wasm) then return 0 end
  print("FAIL roc build " .. folder .. " (wasm, dev) ended " .. b.ended .. " " .. get(b, "code", -1) .. ": " .. trim(sub(b.out, 1, 2000)))
  return 1
end

-- The lines of `passed` that a widget, widget_kit or WidgetExpects.roc holds.
-- The rest are the game's and lib's, which `part=expects` counts.
function widget_lines(passed)
  local kept = {}
  for at in keys(passed) do
    if is_widget_source(at) or starts_with(at, WIDGET_ROOT_FROM_SAFARI .. ":") then kept[at] = true end
  end
  return kept
end

-- How many widget folders the widgets' expect root leaves out, each named. A
-- widget with no expects of its own would otherwise go untested unnoticed.
function widgets_unrooted(folders)
  local root = read(WIDGET_ROOT_FROM_CHECKOUT)
  local missing = 0
  for folder in folders do
    if not contains(root, "\"../../" .. folder .. "/package.roc\"") then
      missing = missing + 1
      print("FAIL " .. WIDGET_ROOT_FROM_SAFARI .. " doesn't reach " .. folder .. "/package.roc")
    end
  end
  return missing
end

-- `roc check` on each widget's web.roc, because the widgets import the game
-- through game.roc and a change to a type they use breaks them. Then `roc test
-- --verbose` once, on gates/WidgetExpects.roc, which reaches every widget's app
-- module through the package.roc in its folder. Finding no widget fails, as
-- does a widget the root doesn't name. Every expect in a widget, in widget_kit
-- or in WidgetExpects.roc itself must pass, counted as in `part=expects`.
-- `roc test` runs the expects of every module a root reaches, packages on a
-- path included, and has no way to run only some, so the game's expects run
-- here too, once. A widget that doesn't check isn't tested, so the test waits
-- for them all. Last, each widget's web.roc is built to wasm on the dev
-- backend, which links against WEB_HOST, built first if missing, because a widget can check clean and
-- still crash the compiler's build. The page check build.sh adds is left to
-- publish: it took 146 s for the 13 widgets (2026-11-08).
function widgets()
  local roc = pinned_roc("safari gates")
  local cache = child_cache("widgets")
  local env = cache_env(cache)
  local passed = {}
  local folders = widget_folders()
  local wrong = widgets_unrooted(folders)
  for folder in folders do wrong = wrong + check_widget(roc, env, folder) end
  if wrong == 0 then wrong = test_root(roc, env, WIDGET_ROOT_FROM_SAFARI, passed) end
  local built = 0
  if wrong == 0 then
    ensure_web_host()
    local bin = fresh_dir("scratch:", "safari-widget-wasm")
    for folder in folders do
      local bad = build_widget(roc, env, bin, folder)
      if bad == 0 then built = built + 1 end
      wrong = wrong + bad
    end
    if wrong > 0 then print("safari gates: the widgets' wasm kept in " .. bin) else remove_tree(bin) end
  end
  drop_child_cache(cache)
  local source = written_expects(widget_sources())
  if #keys(source.written) == 0 then fail("safari gates: no expects found in the widgets") end
  if wrong == 0 then wrong = expects_unheld(source, widget_lines(passed)) end
  print("widgets: " .. #folders .. " checked, " .. built .. " built to wasm, " .. #keys(source.written) .. " expects in the source, " .. #keys(passed) .. " passed in one roc test, " .. wrong .. " wrong")
  if wrong > 0 then fail("safari gates: the widgets failed") end
  return nil
end

-- A proof tool's run: its output, once it has ended well.
function held_run(bin, n, args)
  local argv = {real(bin .. "/" .. n)}
  for a in args do push(argv, a) end
  local r = run(argv, {timeout_ms = 600000, whole = 100000, want = WANT})
  print(trim(r.out))
  print(n .. ": " .. r.ms .. " ms")
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 then return nil end
  return trim(r.out)
end

function held_args()
  local args = {"held"}
  for d in DEPTHS do push(args, d) end
  return args
end

-- The proof tools: StepBack passes on "every step back went back one step",
-- OnRoad on "the ride stayed on the road", and ShapesFrame on "differ 0" at
-- every depth. All their output but OnRoad's, and RasterFrame's hash of the
-- frame at each depth, is held exactly to PROOF_EXPECTED. A change that
-- rightly alters the picture changes that file with it, and the commit says
-- why. OnRoad's widest point and finishing step move with every physics
-- change, so they are printed and not held. Each of BENCHES must pass `roc
-- check` with no error or warning, so a change to the game can't leave them
-- broken unseen.
function proof()
  local roc = pinned_roc("safari gates")
  local scratch = fresh_dir("scratch:", "safari-proof")
  local bin = scratch .. "/bin"
  mkdir(bin)
  local cache = child_cache("proof")
  local env = cache_env(cache)
  local bad = 0
  local held = {}
  local tools = {
    {name = "StepBack", args = {}, held = true},
    {name = "OnRoad", args = {}, held = false},
    {name = "ShapesFrame", args = held_args(), held = true},
    {name = "RasterFrame", args = held_args(), held = true},
  }
  local unheld = ""
  for n in BENCHES do bad = bad + check_bench(roc, env, n) end
  for tool in tools do
    local out = nil
    if tool_build(roc, bin, tool.name, env) then out = held_run(bin, tool.name, tool.args) end
    if out == nil then
      bad = bad + 1
    elseif tool.held then
      push(held, out)
    else
      unheld = unheld .. out .. "\n"
    end
  end
  drop_child_cache(cache)
  local got = join(held, "\n") .. "\n"
  if not contains(got, "every step back went back one step") then bad = bad + 1 end
  if not contains(unheld, "the ride stayed on the road") then bad = bad + 1 end
  for l in lines(got) do
    if starts_with(l, "ShapesFrame ") and not contains(l, ": differ 0 ") then bad = bad + 1 end
  end
  if not exists(PROOF_EXPECTED) or read(PROOF_EXPECTED) ~= got then
    replace(scratch .. "/proof.got", got)
    print("FAIL the proof tools' output is not " .. PROOF_EXPECTED .. "; it is in " .. scratch .. "/proof.got")
    bad = bad + 1
  end
  print("proof tools: " .. bad .. " bad")
  if bad > 0 then fail("safari gates: " .. bad .. " proof check(s) failed; binaries kept in " .. scratch) end
  remove_tree(scratch)
  return nil
end

-- gates/input_bits.shale first, which holds the page's key and button bits
-- equal to lib's. Then canvas_apps/build.sh builds safari's dev page into a
-- scratch folder, so the dev channel doesn't move, and the hash of what it drew
-- is held to PAGE_EXPECTED. With `release=1`, which tutorial/book.shale gives
-- it, it builds the release page into the dev channel, held to the same hash.
function page()
  print(trim(must(run({"shale", "--root", ".", INPUT_BITS}, {timeout_ms = 60000, whole = 100000})).out))
  local scratch = fresh_dir("scratch:", "safari-page")
  local cache = child_cache("page")
  local argv = {"bash", "canvas_apps/build.sh", "safari"}
  local env = cache_env(cache)
  if RELEASE then
    push(argv, "release")
  else
    env.OUT = real(scratch) .. "/safari"
  end
  local r = run(argv, {timeout_ms = 600000, whole = 200000, want = PAGE_WANT, env = env})
  drop_child_cache(cache)
  print("build.sh safari: " .. r.ms .. " ms")
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 then
    print(trim(r.out))
    fail("safari gates: the page didn't build")
  end
  local wrong = drawn_wrong(r.out)
  if wrong ~= nil then fail("safari gates: " .. wrong) end
  remove_tree(scratch)
  return nil
end

-- tutorial/build.shale's self-test, then the tutorial's build, so a name it
-- includes that is gone from the code fails the gates. Then color_roc.shale's
-- self-test, which book.shale also runs, so a change to it is tested before
-- the next book build.
function tutorial()
  local cache = child_cache("tutorial")
  local env = cache_env(cache)
  for argv in {{"shale", "--root", ".", TUTORIAL, "self_test=1"}, {"shale", "--root", ".", TUTORIAL}, {"shale", "--root", ".", COLOR_ROC, "self_test=1"}} do
    print(trim(must(run(argv, {timeout_ms = 60000, tail = 20, env = env})).out))
  end
  drop_child_cache(cache)
  return nil
end

-- gates/book_names.shale finds a backticked name in the tutorial's prose, or a
-- node name in its diagrams, that is gone from the code.
-- The book is parked until its chapters are rewritten, so the stale names are
-- counted and printed, loudly, but no count is held: a held count would only
-- track how broken the parked prose is, and churn at every merge.
function book_names()
  -- A crash prints no counts, so the run fails without them: the counts go
  -- unheld, but the lint must still run to its verdict.
  local r = run({"shale", "--root", ".", BOOK_NAMES, "held=0", "held_diagram=0"}, {timeout_ms = 60000, tail = 100})
  local summary = nil
  for line in lines(r.out) do
    if re_match(line, "^book_names: stale_name [0-9]+, ") then summary = line end
  end
  if r.ended ~= "exit" or summary == nil then
    print(trim(r.out))
    fail("safari gates: book_names ended " .. r.ended .. " " .. get(r, "code", -1) .. " with no `book_names: stale_name N, ...` line")
  end
  print("book_names: SKIPPED while the book is parked: " .. summary)
  return nil
end

-- fast.shale's parts. Each runs on the checkout's fast cache, which also
-- holds fast's record of its last green and its RasterFrame.
function fast_cache()
  return checkout_caches() .. "/fast"
end

function fast_check()
  local roc = pinned_roc("safari gates")
  local checked = roc_check(roc, cache_env(fast_cache()), SAFARI, "web.roc")
  if not checked.is_clean then
    print(trim(checked.run.out))
    fail("safari gates: roc check web.roc failed")
  end
  print("roc check web.roc: clean, " .. checked.run.ms .. " ms")
  return nil
end

function fast_expects()
  local roc = pinned_roc("safari gates")
  local r = run({roc, "test", MAIN_EXPECT_ROOT}, {timeout_ms = 120000, cwd = SAFARI, whole = 4000000, want = WANT, env = cache_env(fast_cache())})
  local summary = re_find(r.out, ROC_TEST_PASSED)
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 or summary == nil or tonumber(summary.group) == 0 then
    print(trim(r.out))
    fail("safari gates: roc test " .. MAIN_EXPECT_ROOT .. " failed")
  end
  print("roc test " .. MAIN_EXPECT_ROOT .. ": " .. summary.group .. " passed, " .. r.ms .. " ms")
  return nil
end

-- The line of PROOF_EXPECTED that RasterFrame draws at FAST_FRAME_DEPTH.
function held_fast_frame()
  local mark = "RasterFrame " .. FAST_FRAME_DEPTH .. ": "
  for l in lines(read(PROOF_EXPECTED)) do
    if starts_with(l, mark) then return l end
  end
  fail("safari gates: " .. PROOF_EXPECTED .. " holds no line for " .. mark)
end

function fast_frame()
  local roc = pinned_roc("safari gates")
  local folder = fast_cache()
  local env = cache_env(folder)
  local tool = folder .. "/RasterFrame"
  if exists(tool) then remove(tool) end
  if not tool_build(roc, folder, "RasterFrame", env) then fail("safari gates: RasterFrame didn't build") end
  local r = run({real(tool), "held", FAST_FRAME_DEPTH}, {timeout_ms = 120000, whole = 1000, want = WANT})
  local got = trim(r.out)
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 or got ~= held_fast_frame() then
    fail("safari gates: the frame moved: this tree draws `" .. got .. "`, and " .. PROOF_EXPECTED .. " holds `" .. held_fast_frame() .. "`")
  end
  print(got .. ", as held; drawn in " .. r.ms .. " ms")
  return nil
end

-- Every gate, each a child run; a child that fails is named, and the rest
-- still run.
function all()
  pinned_roc("safari gates")
  prune_removed_checkouts()
  local is_cold = clear_full_caches() or COLD
  local bad = {}
  local times = {}
  local lints = timed_run("safari", "lints", {"shale", "--root", ".", LINTS}, stage_opts("lints", 40, is_cold))
  for l in lines(lints.out) do
    if not starts_with(l, "── ") then print(l) end
  end
  push(times, "lints " .. (lints.ms // 1000) .. " s")
  if lints.ended ~= "exit" or lints.code ~= 0 then push(bad, "lints") end
  for part in {"expects", "widgets", "tutorial", "book_names", "proof", "page"} do
    -- A child, and every roc under it, inherits this run's niceness.
    local argv = {"shale", "--root", ".", SELF_PATH, "part=" .. part}
    if COLD then push(argv, "cold=1") end
    local r = timed_run("safari", "part=" .. part, argv, stage_opts(part, 200, is_cold))
    for l in lines(r.out) do
      if not starts_with(l, "── budgets") then print(l) end
    end
    push(times, "part=" .. part .. " " .. (r.ms // 1000) .. " s")
    if r.ended ~= "exit" or r.code ~= 0 then push(bad, "part=" .. part) end
  end
  print("safari gates: " .. join(times, ", "))
  if #bad > 0 then fail("safari gates: " .. #bad .. " failed: " .. join(bad, ", ")) end
  print("safari gates: expects held, widgets checked, tutorial built, book names SKIPPED (the book is parked), proof tools ok, page drawn")
  if not COLD then print("NOT RUN, left to publish: check.shale, cold caches, release wasm, the widgets' page builds") end
end

-- `part=caches` runs only the cache upkeep the full gate starts with.
const PART = arg("part", "")
if PART == "" then
  all()
elseif PART == "expects" then
  expects()
elseif PART == "widgets" then
  widgets()
elseif PART == "format" then
  format()
elseif PART == "proof" then
  proof()
elseif PART == "tutorial" then
  tutorial()
elseif PART == "book_names" then
  book_names()
elseif PART == "page" then
  page()
elseif PART == "widget_globs" then
  print(join(WIDGET_SOURCE_GLOBS, "\n"))
elseif PART == "fast_cache" then
  print(fast_cache())
elseif PART == "fast_check" then
  fast_check()
elseif PART == "fast_expects" then
  fast_expects()
elseif PART == "fast_frame" then
  fast_frame()
elseif PART == "caches" then
  prune_removed_checkouts()
  if clear_full_caches() then print("safari gates: caches empty, a run would be cold") else print("safari gates: caches warm, under " .. CHECKOUT_CEILING_MB .. " MB") end
else
  fail("safari gates: part= is expects, widgets, format, proof, tutorial, book_names, page, caches, lints.shale's widget_globs, or fast.shale's fast_cache, fast_check, fast_expects or fast_frame (none runs them all)")
end
