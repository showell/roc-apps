-- budget: steps=40000000 reads=20000 read_bytes=400000000 output_bytes=200000
-- SAFARI'S GATES: the lints, every module's expects, the tutorial, then the
-- native proof tools.
--
--   cd <roc-apps checkout> && nice -n 19 shale canvas_apps/safari/gates/run.shale
--
-- Run from the roc-apps root: every path is the checkout's, so a worktree
-- gates its own tree. About two minutes on the box (the proof tools ~65 s, the
-- expects ~35 s).
--
-- The gates run as child runs of this script, `part=expects`, `part=proof` and
-- `part=tutorial`, one program of this run's each. A child runs alone the same
-- way (`... run.shale part=proof`).
--
-- **THE LINTS** (gates/lints.shale) run first: shale's Roc lints, each count
-- held exactly, lowered as the code is fixed.
--
-- `part=tutorial` runs tutorial/build.shale's self-test, then builds the
-- tutorial, so a name it quotes that is gone from the code fails the gates.
--
-- `part=expects` runs `roc test --verbose` from each of EXPECT_ROOTS, whose
-- reach together is every module: web.roc reaches the game, gates/ShapesFrame.roc
-- the modules only the proof tools use, gates/CrossModuleExpects.roc the expects
-- that can't sit beside their code, and lib's package root all of lib, where
-- Trig lives. The source is the count, so no number needs keeping: every line
-- of a `.roc` file in safari, gates/ or lib that starts `expect` must print
-- `PASS` once in a run that reaches it, and a `PASS` must name such a line. An
-- expect sits at the top level of its file. One indented into a block or a
-- function fails here, and so does one in a module no root reaches. The roots
-- overlap, and share a fresh cache, so a line that two roots reach runs once
-- and counts once.
--
-- The proof tools: StepBack passes on "every step back went back one step",
-- and ShapesFrame on "differ 0" at every depth. All their
-- output, and RasterFrame's hash of the frame at each depth, is held exactly
-- to gates/proof.expected. A change that rightly alters the picture changes
-- that file with it, and the commit says why.
-- A depth is there for what its frame shows: at 100 a Roc bird is in flight,
-- at 1570 a cat is frozen in the lane, at 1586 it is in mid-leap, at 3742 a
-- distant truck's glow is too small to draw, at 5700 the truck is ahead at
-- dusk with its lights on, and at 6520 it is braking in plain view with its
-- brake lights on.
--
-- **THE ROC IS roc-apps' PIN**, the nightly named in `roc-version`, installed
-- at `tools:roc-<pin>/roc` (`~/tools/` on the box).
--
-- **EACH BUILD GETS A FRESH CACHE** (`XDG_CACHE_HOME`): nightly 09-22 can
-- SIGSEGV on a build that reuses the cache of earlier ones, leaving no
-- binary.
--
-- Each child's binaries, outputs and caches go in a folder of its own under
-- `scratch:` (`fresh_dir`), removed when the child passes and kept, named,
-- when it fails.
const SAFARI = "canvas_apps/safari"
const SELF_PATH = "canvas_apps/safari/gates/run.shale"
const TUTORIAL = "canvas_apps/safari/tutorial/build.shale"
const EXPECT_ROOTS = {"web.roc", "gates/ShapesFrame.roc", "gates/CrossModuleExpects.roc", "../lib/main.roc"}
const PROOF_EXPECTED = "canvas_apps/safari/gates/proof.expected"
const WANT = "roc-pin: roc-apps' pinned nightly, and the binaries it builds under scratch:"

function roc_path()
  if not exists("roc-version") then fail("safari gates: no roc-version here: run from the roc-apps root") end
  local pin = trim(read("roc-version"))
  local roc = "tools:roc-" .. pin .. "/roc"
  if not exists(roc) then fail("safari gates: no " .. roc .. ": install roc-apps' pinned nightly " .. pin .. " at ~/tools/roc-" .. pin .. "/") end
  local v = run({real(roc), "version"}, {timeout_ms = 30000, whole = 4000, want = WANT})
  if trim(v.out) ~= "Roc compiler version " .. pin then fail("safari gates: " .. roc .. " is " .. trim(v.out) .. ", not " .. pin) end
  return real(roc)
end

-- One app, from the folder `dir`, built into `bin` on a cache made for it
-- alone; the build's answer.
function build(roc, scratch, dir, n, re)
  local cache = scratch .. "/cache_" .. n
  mkdir(cache)
  local b = run({roc, "build", "--opt=dev", n .. ".roc", "--output=" .. real(scratch) .. "/bin/" .. n},
    {timeout_ms = 600000, cwd = dir, re = re, head = 4, want = WANT, env = {XDG_CACHE_HOME = real(cache)}})
  remove_tree(cache)
  return b
end

-- Where `roc test`, run in safari's folder, says a source line is.
function printed_at(path, line)
  if starts_with(path, SAFARI .. "/") then return sub(path, #SAFARI + 2) .. ":" .. line end
  return "../" .. sub(path, #"canvas_apps/" + 1) .. ":" .. line
end

-- The set of `expect` lines in the source, each as `roc test` prints it. An
-- indented one is printed and fails the count.
function written_expects()
  local r = run({"git", "grep", "-n", "--untracked", "-E", "^[[:space:]]*expect( |$)", "--",
    ":(glob)" .. SAFARI .. "/*.roc", ":(glob)" .. SAFARI .. "/gates/*.roc", ":(glob)canvas_apps/lib/*.roc"},
    {timeout_ms = 30000, whole = 4000000})
  local written = {}
  local indented = 0
  for l in lines(trim(r.out)) do
    local parts = split(l, ":")
    local text = join(drop(parts, 2), ":")
    if starts_with(text, "expect") then
      written[printed_at(parts[1], parts[2])] = true
    else
      indented = indented + 1
      print("FAIL an expect not at the top level of its file: " .. parts[1] .. ":" .. parts[2])
    end
  end
  return {written = written, indented = indented}
end

-- One root's run: what it passed goes in `passed`, and the answer is how many
-- things went wrong.
function test_root(roc, cache, root, passed)
  local r = run({roc, "test", "--verbose", root},
    {timeout_ms = 300000, cwd = SAFARI, whole = 4000000, want = WANT, env = {XDG_CACHE_HOME = real(cache)}})
  local here = {}
  local wrong = 0
  local printed = 0
  for l in lines(r.out) do
    if starts_with(l, "PASS: ") then
      local at = trim(sub(l, 7))
      printed = printed + 1
      if has_key(here, at) then
        wrong = wrong + 1
        print("FAIL passed twice from " .. root .. ": " .. at)
      end
      here[at] = true
      passed[at] = true
    elseif contains(l, "✗") or contains(l, "●") or contains(l, "TEST FAILURE") then
      wrong = wrong + 1
      print("FAIL " .. root .. ": " .. trim(l))
    end
  end
  local summary = re_find(r.out, "All \\(([0-9]+)\\) tests passed")
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 or summary == nil or tonumber(summary.group) ~= printed then
    wrong = wrong + 1
    print("FAIL roc test " .. root .. " ended " .. r.ended .. " " .. get(r, "code", -1) .. " with " .. printed .. " PASS lines: " .. trim(sub(r.out, #r.out - 300)))
  end
  print("roc test " .. root .. ": " .. printed .. " passed, " .. r.ms .. " ms")
  return wrong
end

function expects()
  local roc = roc_path()
  local cache = fresh_dir("scratch:", "safari-expects")
  local passed = {}
  local wrong = 0
  for root in EXPECT_ROOTS do wrong = wrong + test_root(roc, cache, root, passed) end
  remove_tree(cache)
  local source = written_expects()
  wrong = wrong + source.indented
  for at in keys(source.written) do
    if not has_key(passed, at) then
      wrong = wrong + 1
      print("FAIL not passed from any root: " .. at)
    end
  end
  for at in keys(passed) do
    if not has_key(source.written, at) then
      wrong = wrong + 1
      print("FAIL passed, but no top-level expect in the source: " .. at)
    end
  end
  print("expects: " .. #keys(source.written) .. " in the source, " .. #keys(passed) .. " passed, " .. wrong .. " wrong")
  if #keys(source.written) == 0 then fail("safari gates: no expects found") end
  if wrong > 0 then fail("safari gates: the expects failed") end
  return nil
end

function proof_build(roc, scratch, n)
  local b = build(roc, scratch, SAFARI .. "/gates", n, "✗|●")
  print("build " .. n .. ": " .. b.ms .. " ms, " .. b.matched_lines .. " errors or warnings")
  if b.matched_lines > 0 then return false end
  return exists(scratch .. "/bin/" .. n)
end

function proof()
  local roc = roc_path()
  local scratch = fresh_dir("scratch:", "safari-proof")
  local bin = scratch .. "/bin"
  mkdir(bin)
  local bad = 0
  local depths = {"0", "100", "1570", "1586", "3000", "3742", "5700", "6520", "9000"}
  local held = {}
  if proof_build(roc, scratch, "StepBack") then
    local r = run({real(bin .. "/StepBack")}, {timeout_ms = 600000, tail = 20, want = WANT})
    print(trim(r.out))
    print("StepBack: " .. r.ms .. " ms")
    push(held, trim(r.out))
    if not contains(r.out, "every step back went back one step") then bad = bad + 1 end
  else
    bad = bad + 1
  end
  if proof_build(roc, scratch, "ShapesFrame") then
    for d in depths do
      local r = run({real(bin .. "/ShapesFrame"), d}, {timeout_ms = 600000, head = 1, want = WANT})
      print("ShapesFrame " .. d .. ": " .. trim(r.out) .. " (" .. r.ms .. " ms)")
      push(held, "ShapesFrame " .. d .. ": " .. lines(r.out)[1])
      if not starts_with(r.out, "differ 0 ") then bad = bad + 1 end
    end
  else
    bad = bad + 1
  end
  if proof_build(roc, scratch, "RasterFrame") then
    for d in depths do
      local r = run({real(bin .. "/RasterFrame"), d}, {timeout_ms = 600000, head = 1, want = WANT})
      print("RasterFrame " .. d .. ": " .. trim(r.out) .. " (" .. r.ms .. " ms)")
      push(held, "RasterFrame " .. d .. ": " .. lines(r.out)[1])
      if r.ended ~= "exit" or get(r, "code", -1) ~= 0 then bad = bad + 1 end
    end
  else
    bad = bad + 1
  end
  local got = join(held, "\n") .. "\n"
  if not exists(PROOF_EXPECTED) or read(PROOF_EXPECTED) ~= got then
    replace(scratch .. "/proof.got", got)
    print("FAIL the proof tools' output is not " .. PROOF_EXPECTED .. "; it is in " .. scratch .. "/proof.got")
    bad = bad + 1
  end
  print("proof tools: " .. bad .. " bad")
  if bad > 0 then fail("safari gates: " .. bad .. " proof check(s) failed; binaries kept in " .. scratch) end
  remove_tree(scratch)
  return nil
end

function tutorial()
  for argv in {{"shale", "--root", ".", TUTORIAL, "self_test=1"}, {"shale", "--root", ".", TUTORIAL}} do
    print(trim(must(run(argv, {timeout_ms = 60000, tail = 20})).out))
  end
  return nil
end

-- Every gate, each a child run; a child that fails is named, and the rest
-- still run.
function all()
  roc_path()
  local bad = {}
  local times = {}
  local lints = run({"shale", "--root", ".", SAFARI .. "/gates/lints.shale"}, {timeout_ms = 1800000, tail = 40})
  for l in lines(lints.out) do
    if not starts_with(l, "── ") then print(l) end
  end
  push(times, "lints " .. (lints.ms // 1000) .. " s")
  if lints.ended ~= "exit" or lints.code ~= 0 then push(bad, "lints") end
  for part in {"expects", "tutorial", "proof"} do
    -- A child, and every roc under it, inherits this run's niceness.
    local r = run({"shale","--root", ".", SELF_PATH, "part=" .. part}, {timeout_ms = 1800000, tail = 200})
    for l in lines(r.out) do
      if not starts_with(l, "── budgets") then print(l) end
    end
    push(times, "part=" .. part .. " " .. (r.ms // 1000) .. " s")
    if r.ended ~= "exit" or r.code ~= 0 then push(bad, "part=" .. part) end
  end
  print("safari gates: " .. join(times, ", "))
  if #bad > 0 then fail("safari gates: " .. #bad .. " failed: " .. join(bad, ", ")) end
  print("safari gates: expects held, proof tools ok, tutorial built")
end

const PART = arg("part", "")
if PART == "" then
  all()
elseif PART == "expects" then
  expects()
elseif PART == "proof" then
  proof()
elseif PART == "tutorial" then
  tutorial()
else
  fail("safari gates: part= is expects, proof or tutorial (none runs them all)")
end
