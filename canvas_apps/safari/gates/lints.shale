-- This script runs shale's Roc lints over safari and holds each count to the
-- exact number below. Safari came from an emitter and had never been linted,
-- so most counts start above zero. When a change lowers a count, lower its
-- number here in the same commit; a count that rises, or falls without its
-- number following, fails the run. Each count comes down to zero over time.
--
--   cd <roc-apps checkout> && shale canvas_apps/safari/gates/lints.shale
--
-- It takes about ten seconds, and run.shale runs it first.

const SAFARI = "canvas_apps/safari"

-- Each lint, its arguments, and the exact count of each check it prints.
const LINTS = {
  {recipe = "name_hunt", args = {}, budget = {}, counts = {
    {"state_effect", 0}, {"question", 0}, {"vague", 0}, {"name_type", 0}, {"negative", 0},
    {"noun_effect", 0}, {"command_tense", 0}, {"mixed_tense", 0}, {"container", 0},
    {"preposition_split", 0}, {"short_name", 0}, {"worker_name", 0}, {"stacked_preposition", 0},
    {"taken_word", 5}, {"bare_participle", 7},
  }},
  {recipe = "errors", args = {}, budget = {}, counts = {
    {"error_alias", 0}, {"optional_tag", 0}, {"set_fallback", 0}, {"placeholder", 3},
  }},
  {recipe = "nest_depth", args = {"min=4"}, budget = {}, counts = {{"nested", 60}}},
  {recipe = "boundaries", args = {}, budget = {}, counts = {
    {"single", 4}, {"fixed", 0}, {"entry", 0}, {"constant", 0}, {"bool_param", 0},
  }},
  {recipe = "stack", args = {}, budget = {"--budget", "steps=4000000000"}, counts = {{"to stack", 2613}}},
}

-- The number a summary line gives for `check`: "check N", or "N check" for
-- stack's "N to stack".
function count_in(line, check)
  local after = re_find(line, check .. " ([0-9]+)")
  if after ~= nil then return tonumber(after.group) end
  local before = re_find(line, "([0-9]+) " .. check)
  if before ~= nil then return tonumber(before.group) end
  return nil
end

local wrong = {}
for lint in LINTS do
  local argv = {"shale"}
  for b in lint.budget do push(argv, b) end
  push(argv, real("cookbook:roc/" .. lint.recipe .. ".shale"))
  push(argv, "glob=*.roc")
  for a in lint.args do push(argv, a) end
  -- `whole`, not `tail`: name_hunt's summary is one long line.
  local r = run(argv, {cwd = SAFARI, timeout_ms = 600000, whole = 4000000})
  local summary = ""
  for l in lines(trim(r.out)) do
    if not starts_with(l, "──") and trim(l) ~= "" then summary = l end
  end
  local said = {}
  for c in lint.counts do
    local got = count_in(summary, c[1])
    if got == nil then
      push(wrong, lint.recipe .. ": no count for " .. c[1] .. " in its last line: " .. summary)
    elseif got ~= c[2] then
      push(wrong, lint.recipe .. ": " .. c[1] .. " is " .. got .. ", held at " .. c[2])
    end
    push(said, c[1] .. " " .. tostring(got))
  end
  print(lint.recipe .. ": " .. join(said, ", "))
end
if #wrong > 0 then
  for w in wrong do print("WRONG " .. w) end
  fail("safari lints: " .. #wrong .. " count(s) moved; fix the code, or set the new number here if it fell")
end
print("safari lints: every count as held")
