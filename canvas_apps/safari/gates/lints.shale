-- This script runs shale's Roc lints over safari and holds each count at the
-- number in LINTS, so a moved count fails the run.
--
--   cd <roc-apps checkout> && shale canvas_apps/safari/gates/lints.shale
--
-- It takes about 15 seconds (2026-11-08), and run.shale runs it first. This
-- header is the one home of that figure; the docs point here.
--
-- With `files=`, which fast.shale gives it, it judges only those files, named
-- from safari's folder and separated by commas, or `files=every`, and only by
-- the checks one file can answer. A check held at zero fails on its first
-- finding. A count held above zero can't be judged from part of the tree, so
-- its findings are reported and pass.

const SAFARI = "canvas_apps/safari"
const GATES = SAFARI .. "/gates"
const FILES = arg("files", "")
-- The glob, from safari's folder, that stands for the whole tree.
const WHOLE_TREE = "**/*.roc"

-- The globs of the widgets' sources, which the merge gate holds.
function widget_globs()
  local r = run({"shale", "--root", ".", GATES .. "/run.shale", "part=widget_globs"}, {timeout_ms = 30000, whole = 10000})
  local globs = {}
  for l in lines(trim(r.out)) do
    if not starts_with(l, "──") then push(globs, l) end
  end
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 or #globs == 0 then
    print(trim(r.out))
    fail("safari lints: the merge gate named no widget globs")
  end
  return globs
end

-- The game's clients, which import its modules: a member only a widget calls
-- has a real caller. The gates test the game, so their calls are a test's.
const CLIENT_GLOBS = widget_globs()
const GATE_GLOB = GATES .. "/**/*.roc"

-- Every file any lint here reads, as globs from the checkout's root. With
-- `reads=globs` this script prints them and stops, so fast.shale's record of
-- the last green covers each file a lint reads, not only safari's.
local tree_globs = {SAFARI .. "/**/*.roc"}
for g in CLIENT_GLOBS do push(tree_globs, g) end
push(tree_globs, "canvas_apps/lib/**/*.roc")
const TREE_GLOBS = tree_globs

-- More files than this go through each recipe at once, because a run may start
-- only 64 programs.
const MOST_ONE_AT_A_TIME = 6

-- The shared code under safari, from the checkout's root. A lint that names
-- these as its `folders` runs once more in each, over its own files, and is
-- held there to the same counts as in safari.
const SHARED_FOLDERS = {"canvas_apps/lib", "canvas_apps/widget_kit"}

-- The tutorial's widgets, one glob from the checkout's root over every widget
-- folder, which the merge gate names among CLIENT_GLOBS. A lint that names it
-- among its `folders` runs once over all of them, from the root, held to the
-- same counts as in safari.
const WIDGETS = "canvas_apps/*_widget/**/*.roc"
if not has_item(CLIENT_GLOBS, WIDGETS) then
  fail("safari lints: the merge gate's widget globs no longer name " .. WIDGETS)
end
local shared_and_widgets = {}
for f in SHARED_FOLDERS do push(shared_and_widgets, f) end
push(shared_and_widgets, WIDGETS)
const SHARED_AND_WIDGETS = shared_and_widgets

-- `bool_param` has types only for what types_root.roc reaches, which is every
-- game module. roc-types can't read the rest, so a file here is judged without
-- types, and a game module types_root.roc stops reaching fails the run. The
-- gates and the book's apps have no platform, and their `game:` package has a
-- `lib:` of its own, which roc-types doesn't follow; nor does it follow the
-- web platform's own `lib:`, so web.roc, which reaches what types_root.roc does,
-- has no types. The tutorial's fails/ don't compile, on purpose. game.roc is
-- only a package header, and main.roc needs roc-ray beside the checkout.
const UNTYPED_PATHS = {"game.roc", "main.roc", "web.roc", "gates/", "tutorial/"}

-- `whole_tree` names the checks that one file can't answer, because they read
-- across files. The fast tier skips them, and a recipe with nothing else in it.
-- `skip` names files of drawing data, tables of points that read better side
-- by side than one number to a line. `from_repo_root` runs a recipe from the
-- checkout's root, where `types=1` finds `roc-version`. `tree_globs`, from the
-- root, stands for the whole tree in place of safari's folder: find_unused_imports
-- reads the widgets, widget_kit and lib too, because Roc doesn't warn of an
-- unused import, and the widgets import the game. `folders` names the shared
-- folders a lint also judges, each in a run of its own, since these recipes
-- take one glob and a glob can't climb out of safari's folder.
-- The stack lint judges lib once CanvasApp's step takes a record in place of
-- its three bare arguments, its last two findings there.
-- `folder_args` gives a folder's run arguments of its own: lib's Font.roc is
-- a table of glyph strokes, and lib's functions whose arguments something
-- outside the file dictates are in STACK_DICTATED.
--
-- The table, in lib beside the files it names, of lib's functions whose bare
-- arguments are dictated: roc-ray's Math API, and the wasm edge, which has no
-- records. lib's run reads it from lib's folder.
const STACK_DICTATED = "stack_dictated.txt"
const LINTS = {
  {recipe = "hunt_names", args = {}, budget = {}, counts = {
    {"state_effect", 0}, {"question", 0}, {"vague", 0}, {"name_type", 0}, {"negative", 0},
    {"noun_effect", 0}, {"command_tense", 0}, {"mixed_tense", 0}, {"container", 0},
    {"preposition_split", 0}, {"short_name", 0}, {"worker_name", 0}, {"stacked_preposition", 0},
    {"taken_word", 0}, {"bare_participle", 0},
    {"phrase_name", 0},
    {"singular_list", 0}, {"world_verb", 0}, {"where_name", 0},
  }, whole_tree = {"command_tense", "mixed_tense"}, folders = SHARED_AND_WIDGETS},
  {recipe = "check_errors", args = {}, budget = {}, counts = {
    {"error_alias", 0}, {"optional_tag", 0}, {"set_fallback", 0}, {"placeholder", 0},
  }, whole_tree = {"error_alias"}, folders = SHARED_AND_WIDGETS},
  {recipe = "find_deep_calls", args = {"min=4"}, budget = {}, counts = {{"nested", 0}}, folders = {WIDGETS}},
  {recipe = "find_extra_parens", args = {}, budget = {}, counts = {{"paren_if", 0}, {"wrapped_body", 0}, {"else_block", 0}, {"lambda_if", 0}},
    folders = {WIDGETS}},
  {recipe = "check_boundaries", args = {"types=1", "root=" .. SAFARI .. "/types_root.roc", "clients=" .. join(CLIENT_GLOBS, ","), "tests=" .. GATE_GLOB, "test_reach=dead"}, budget = {}, from_repo_root = true, counts = {
    {"single", 0}, {"fixed", 0}, {"entry", 0}, {"constant", 0}, {"bool_param", 0}, {"dead", 0},
  }, whole_tree = {"single", "fixed", "entry", "constant", "bool_param", "dead"}},
  {recipe = "check_stacking", args = {}, budget = {"--budget", "steps=4000000000"}, counts = {{"to stack", 0}, {"to unstack", 0}, {"long", 0}},
    skip = {"BirdStills.roc", "CatStills.roc", "EmojiStill.roc"}, folders = {"canvas_apps/widget_kit", WIDGETS},
    folder_args = {{"canvas_apps/lib", {"skip=Font.roc", "dictated=" .. STACK_DICTATED}}}},
  {recipe = "check_vocabulary", args = {"words=vocabulary.txt"}, budget = {}, counts = {{"retired_name", 0}, {"retired_comment", 0}},
    folders = {WIDGETS}},
  {recipe = "check_name_types", args = {"table=name_types.txt"}, budget = {}, counts = {{"name_type", 0}, {"bare_beside_unit", 0}, {"no_value", 0}},
    whole_tree = {"bare_beside_unit"}},
  {recipe = "find_bare_floats", args = {"table=bare_floats.txt"}, budget = {}, counts = {{"bare_float", 0}, {"unused_exception", 0}}},
  {recipe = "check_families", args = {}, budget = {}, counts = {{"family", 0}, {"twin_name", 0}}, whole_tree = {"family", "twin_name"}},
  {recipe = "find_unclear_names", args = {}, budget = {}, counts = {{"pure_mutator", 0}, {"abbreviation", 0}, {"module_doc", 0}},
    folders = SHARED_AND_WIDGETS},
  {recipe = "find_unused_imports", args = {}, budget = {}, from_repo_root = true, counts = {{"unused_import", 0}},
    tree_globs = TREE_GLOBS},
}

-- What the lints' verdicts rest on, beside the files judged: this script, the
-- tables its lints read (a `words=` or `table=` argument, from safari's
-- folder), and the cookbook's Roc recipes. With `reads=rules` this script
-- prints them and stops, so fast.shale judges every file again when one
-- changes.
function rule_files()
  local rules = {GATES .. "/lints.shale"}
  for lint in LINTS do
    for a in lint.args do
      local m = re_find(a, "^(?:words|table)=(.+)$")
      if m ~= nil then push(rules, SAFARI .. "/" .. m.group) end
    end
  end
  push(rules, "canvas_apps/lib/" .. STACK_DICTATED)
  for f in rules do
    if not exists(f) then fail("safari lints: no rule file " .. f) end
  end
  local recipes = glob("cookbook:roc/*.shale")
  if #recipes == 0 then fail("safari lints: no recipes in cookbook:roc/") end
  for f in recipes do push(rules, real(f)) end
  return rules
end

function runs_from_repo_root(lint)
  return get(lint, "from_repo_root", false)
end

-- The command that runs `lint` over `glob`, a glob from safari's folder.
function lint_argv(lint, glob)
  local argv = {"shale"}
  for b in lint.budget do push(argv, b) end
  push(argv, real("cookbook:roc/" .. lint.recipe .. ".shale"))
  local tree_globs = get(lint, "tree_globs", {})
  if #tree_globs > 0 and glob == WHOLE_TREE then
    push(argv, "glob=" .. join(tree_globs, ","))
  else
    push(argv, "glob=" .. (runs_from_repo_root(lint) and (SAFARI .. "/") or "") .. glob)
  end
  for a in lint.args do push(argv, a) end
  local skip = get(lint, "skip", {})
  if #skip > 0 and glob == WHOLE_TREE then push(argv, "skip=" .. join(skip, ",")) end
  return argv
end

-- `whole`, not `tail`: hunt_names's summary is one long line.
function lint_run(lint, glob)
  local opts = {timeout_ms = 600000, whole = 4000000}
  if not runs_from_repo_root(lint) then opts.cwd = SAFARI end
  return run(lint_argv(lint, glob), opts)
end

-- The run of `lint` over the Roc files of `folder`, one of its `folders`.
-- WIDGETS runs from the checkout's root, so a table it reads is named from
-- there.
function folder_run(lint, folder)
  local argv = {"shale"}
  for b in lint.budget do push(argv, b) end
  push(argv, real("cookbook:roc/" .. lint.recipe .. ".shale"))
  if folder == WIDGETS then
    push(argv, "glob=" .. WIDGETS)
    for a in lint.args do
      local m = re_find(a, "^(?:words|table)=(.+)$")
      if m == nil then push(argv, a) else push(argv, sub(a, 1, #a - #m.group) .. SAFARI .. "/" .. m.group) end
    end
    return run(argv, {timeout_ms = 600000, whole = 4000000})
  end
  push(argv, "glob=*.roc")
  for a in lint.args do push(argv, a) end
  for fa in get(lint, "folder_args", {}) do
    if fa[1] == folder then
      for a in fa[2] do push(argv, a) end
    end
  end
  return run(argv, {timeout_ms = 600000, whole = 4000000, cwd = folder})
end

-- How a finding's line from `folder_run` names its file: a folder's run names
-- it from the folder, and WIDGETS's from the checkout's root.
function folder_finding(folder, line)
  if folder == WIDGETS then return line end
  return folder .. "/" .. line
end

const NOT_REACHED = "not reached by "

-- A recipe's last line of counts, which comes before any list of files no root
-- reaches. A refusal comes last instead, and it has no counts.
function lint_summary(out)
  local summary = ""
  for l in lines(trim(out)) do
    if starts_with(l, NOT_REACHED) then break end
    if not starts_with(l, "──") and trim(l) ~= "" then summary = l end
  end
  return summary
end

-- The files that `out` says no root of the types reaches.
function files_not_reached(out)
  local found = {}
  for l in lines(out) do
    if starts_with(l, NOT_REACHED) then
      local parts = split(l, ": ")
      push(found, parts[#parts])
    end
  end
  return found
end

function is_untyped_path(path)
  for p in UNTYPED_PATHS do
    if starts_with(path, SAFARI .. "/" .. p) then return true end
  end
  return false
end

-- What's wrong with the files `out` says no root reaches, and a line saying how
-- many of them had types. The recipe exits non-zero on such files, so
-- UNTYPED_PATHS is what judges them. Nothing for a recipe without types.
function judge_reach(lint, out, summary, wrong)
  if not has_item(lint.args, "types=1") then return nil end
  local missed = files_not_reached(out)
  for f in missed do
    if not is_untyped_path(f) then push(wrong, lint.recipe .. ": no root reaches " .. f .. ", so it has no types") end
  end
  local files = re_find(summary, "([0-9]+) files")
  if files ~= nil then print(lint.recipe .. ": types for " .. (tonumber(files.group) - #missed) .. " of " .. files.group .. " files") end
  return nil
end

-- The number a summary line gives for `check`: "check N", or "N check" for
-- stack's "N to stack" and "N long".
function count_in_summary(line, check)
  local after = re_find(line, check .. " ([0-9]+)")
  if after ~= nil then return tonumber(after.group) end
  local before = re_find(line, "([0-9]+) " .. check)
  if before ~= nil then return tonumber(before.group) end
  return nil
end

function is_whole_tree(lint, check)
  return has_item(get(lint, "whole_tree", {}), check)
end

function named_checks(lint)
  local named = {}
  for c in lint.counts do
    if not is_whole_tree(lint, c[1]) then push(named, c[1]) end
  end
  return named
end

-- The lines of `out` that are findings of `check`.
function findings_of(out, check)
  local mark = ": " .. substitute(substitute(check, "to stack", "stack", {missing_ok = true}), "to unstack", "unstack", {missing_ok = true}) .. ":"
  local found = {}
  for l in lines(out) do
    if contains(l, mark) then push(found, l) end
  end
  return found
end

-- One recipe's run over `glob`, judged by the checks one file can answer.
function judge_part(lint, glob)
  local r = lint_run(lint, glob)
  if contains(r.out, "refused: ") then fail("safari lints: " .. lint.recipe .. " refused " .. glob .. ": " .. trim(r.out)) end
  local summary = lint_summary(r.out)
  for c in lint.counts do
    if not is_whole_tree(lint, c[1]) then
      local got = count_in_summary(summary, c[1])
      if got == nil then fail("safari lints: " .. lint.recipe .. ": no count for " .. c[1] .. " in its last line: " .. summary) end
      if got > 0 then
        if c[2] == 0 or glob ~= WHOLE_TREE then
          for l in findings_of(r.out, c[1]) do print(l) end
        end
        if c[2] == 0 then fail("safari lints: " .. lint.recipe .. ": " .. got .. " " .. c[1] .. " in " .. glob .. ", held at zero") end
        print("safari lints: " .. got .. " " .. c[1] .. " in " .. glob .. " reported, not judged: held at " .. c[2] .. " over the whole tree")
      end
    end
  end
  return nil
end

-- One recipe's run over one of its shared `folders`, judged as `judge_part`
-- judges safari's files.
function judge_folder_part(lint, folder)
  local r = folder_run(lint, folder)
  if contains(r.out, "refused: ") then fail("safari lints: " .. lint.recipe .. " refused " .. folder .. ": " .. trim(r.out)) end
  local summary = lint_summary(r.out)
  for c in lint.counts do
    if not is_whole_tree(lint, c[1]) then
      local got = count_in_summary(summary, c[1])
      if got == nil then fail("safari lints: " .. lint.recipe .. " in " .. folder .. ": no count for " .. c[1] .. " in its last line: " .. summary) end
      if got ~= c[2] then
        for l in findings_of(r.out, c[1]) do print(folder_finding(folder, l)) end
        fail("safari lints: " .. lint.recipe .. ": " .. got .. " " .. c[1] .. " in " .. folder .. ", held at " .. c[2])
      end
    end
  end
  return nil
end

function judge_files()
  local files = split(FILES, ",")
  if FILES == "every" or #files > MOST_ONE_AT_A_TIME then files = {WHOLE_TREE} end
  local whole = {}
  for lint in LINTS do
    if #named_checks(lint) == 0 then
      push(whole, lint.recipe)
    else
      for f in files do
        if not has_item(get(lint, "skip", {}), f) then judge_part(lint, f) end
      end
      if files[1] == WHOLE_TREE then
        for folder in get(lint, "folders", {}) do judge_folder_part(lint, folder) end
      end
      for c in get(lint, "whole_tree", {}) do push(whole, c) end
    end
  end
  print("safari lints: not run, they need the whole tree: " .. join(whole, ", "))
  return nil
end

function judge_tree()
  local wrong = {}
  for lint in LINTS do
    local r = lint_run(lint, WHOLE_TREE)
    local summary = lint_summary(r.out)
    judge_reach(lint, r.out, summary, wrong)
    -- A recipe that stopped before its counts says why, as when Roc's checker
    -- rejects types_root.roc.
    local stopped = find(r.out, "── stopped")
    if stopped ~= nil and count_in_summary(summary, lint.counts[1][1]) == nil then print(sub(r.out, stopped)) end
    local said = {}
    for c in lint.counts do
      local got = count_in_summary(summary, c[1])
      if got == nil then
        push(wrong, lint.recipe .. ": no count for " .. c[1] .. " in its last line: " .. summary)
      elseif got ~= c[2] then
        push(wrong, lint.recipe .. ": " .. c[1] .. " is " .. got .. ", held at " .. c[2])
      end
      push(said, c[1] .. " " .. tostring(got))
    end
    print(lint.recipe .. ": " .. join(said, ", "))
    for folder in get(lint, "folders", {}) do
      local fr = folder_run(lint, folder)
      local folder_summary = lint_summary(fr.out)
      local folder_said = {}
      for c in lint.counts do
        local got = count_in_summary(folder_summary, c[1])
        if got == nil then
          push(wrong, lint.recipe .. " in " .. folder .. ": no count for " .. c[1] .. " in its last line: " .. folder_summary)
        elseif got ~= c[2] then
          for l in findings_of(fr.out, c[1]) do print(folder_finding(folder, l)) end
          push(wrong, lint.recipe .. " in " .. folder .. ": " .. c[1] .. " is " .. got .. ", held at " .. c[2])
        end
        push(folder_said, c[1] .. " " .. tostring(got))
      end
      print(lint.recipe .. " in " .. folder .. ": " .. join(folder_said, ", "))
    end
  end
  if #wrong > 0 then
    for w in wrong do print("WRONG " .. w) end
    fail("safari lints: " .. #wrong .. " count(s) moved; fix the code")
  end
  print("safari lints: every count as held")
  return nil
end

if not exists(SAFARI) then
  fail("safari lints: no " .. SAFARI .. " here; run this from the roc-apps root")
end
const READS = arg("reads", "")
if READS == "globs" then
  print(join(TREE_GLOBS, "\n"))
elseif READS == "rules" then
  print(join(rule_files(), "\n"))
elseif READS ~= "" then
  fail("safari lints: reads= is globs or rules")
elseif FILES == "" then
  judge_tree()
else
  judge_files()
end
