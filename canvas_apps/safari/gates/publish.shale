-- budget: steps=40000000 read_bytes=100000000 output_bytes=200000
-- This is safari's publish tier, for before the site moves. It stops at its
-- first failure.
--
--   cd <roc-apps checkout> && nice -n 19 shale canvas_apps/safari/gates/publish.shale
--
-- It runs the merge gate from cold caches, then check.shale from a cold cache,
-- then builds the book's published chapters, which builds safari's page and every widget's as
-- release wasm, each from a cold cache, into the dev channel, where
-- site/publish.sh takes them. Safari's page must draw the hash the dev page
-- draws. It moves nothing to staging. It takes about six minutes.

const RUN = "canvas_apps/safari/gates/run.shale"
const BOOK = "canvas_apps/safari/tutorial/book.shale"
-- The chapters that have passed the loop in MISSION.md, which are the ones
-- published. Each needs a slug in Book.slugs, or the book stops.
const PUBLISHED_CHAPTERS = 13

function report_stage(r, what)
  for l in lines(trim(r.out)) do
    if not starts_with(l, "── budgets") then print(l) end
  end
  print("publish: " .. what .. ": " .. (r.ms // 1000) .. " s")
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 then fail("safari publish: " .. what .. " failed") end
  return nil
end

function main()
  report_stage(run({"shale", "--root", ".", RUN, "cold=1"}, {timeout_ms = 1800000, tail = 200}), "the merge gate, cold")
  local cache = fresh_dir("scratch:", "safari-check-cache")
  report_stage(run({"shale", "--root", ".", "check.shale"}, {timeout_ms = 1800000, tail = 40, env = {XDG_CACHE_HOME = real(cache)}}), "check.shale, cold")
  remove_tree(cache)
  local book = {"shale", "--root", ".", BOOK, "chapters=" .. PUBLISHED_CHAPTERS}
  report_stage(run(book, {timeout_ms = 1800000, tail = 60}), "the book's first " .. PUBLISHED_CHAPTERS .. " chapters, with safari's page and every widget's as release")
  print("safari publish: every stage passed; site/publish.sh takes each page from the dev channel")
  return nil
end

main()
