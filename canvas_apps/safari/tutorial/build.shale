-- budget: steps=100000000 arena_bytes=1000000000
-- This builds the safari tutorial. It reads tutorial.md, prose with lines
-- like `{{code Cat.moment_at}}`, and writes build/tutorial.md, where each
-- such line is a fenced roc block holding that definition as the source has
-- it, with its `##` doc comment and its annotation, dedented.
--
--   cd <roc-apps checkout> && shale canvas_apps/safari/tutorial/build.shale
--
-- `{{code Cat.crossing_timeline from "looks:" to "finally: Holds(Collapse),"}}`
-- keeps only the lines from the one holding the first text through the one
-- holding the second. A `# ...` line stands for each cut, at the indent of
-- the kept line beside it. Each text must occur exactly once in the
-- definition, doc comment included, so an edit that removes one stops the
-- build. An anchor can't hold a `"`.
--
-- `{{fails turn_as_bearing}}` becomes two fenced blocks: the program
-- fails/turn_as_bearing.roc, and what `roc check` says of it, from the
-- pinned compiler. A program in which `roc check` finds no error stops the
-- build, because the tutorial's claim is then false. `roc check` runs in
-- fails/, so it names files relative to that folder, and the checkout's own
-- path is cut from anything else that holds it.
--
-- `{{module Clock}}` becomes one fenced block holding all of Clock.roc.
--
-- `Module.name` looks in Module.roc, beside safari's other modules: at the
-- file's top level, and in the block of the type named for the module. The
-- spans come from Roc's parser through roc_tree, so a local in a function
-- body or a member of another type is not found. The tree holds no comments,
-- so the doc comment is the run of `##` lines directly above the definition.
--
-- An include that can't be expanded stops the build, naming the source's
-- line, and no output is left behind. Any line holding `{{` must be an
-- include, alone on its line, so a mistyped one can't reach the page.
--
-- `self_test=1` proves both sides of each failure on a module written here,
-- and safari's gate runs it.
const SAFARI = "canvas_apps/safari"
const SOURCE = "canvas_apps/safari/tutorial/tutorial.md"
const OUTPUT = "canvas_apps/safari/tutorial/build/tutorial.md"
const PIN_FILE = "roc-version"
const WANT = "roc-pin: roc-apps' pinned nightly, for the tutorial's failing programs"
const INCLUDE = "^\\{\\{code ([A-Z][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*!?)(?: from \"([^\"]+)\" to \"([^\"]+)\")?\\}\\}$"
const FAILS = "^\\{\\{fails ([a-z][a-z0-9_]*)\\}\\}$"
const WHOLE_MODULE = "^\\{\\{module ([A-Z][A-Za-z0-9_]*)\\}\\}$"
const NOT_AN_INCLUDE = "not a line of the form {{code Module.name}}, {{code Module.name from \"text\" to \"text\"}}, {{module Name}} or {{fails name}}"
const CUT = "# ..."

function stop(entry, why)
  fail(entry.source .. ":" .. entry.line .. ": " .. entry.text .. ": " .. why)
end

-- The source's lines, in order. A code include's entry also has its module,
-- its name and its module's path, and its anchors if it has them. A fails
-- include's has its program's path.
function read_entries(source, text, folder)
  local entries = {}
  local number = 0
  for l in split(text, "\n") do
    number = number + 1
    local entry = {source = source, line = number, text = l}
    if contains(l, "{{") then
      local failing = re_find(l, FAILS)
      local whole = re_find(l, WHOLE_MODULE)
      if failing ~= nil then
        entry.program = dirname(source) .. "/fails/" .. failing.groups[1] .. ".roc"
        if not exists(entry.program) then stop(entry, "no program " .. entry.program) end
      elseif whole ~= nil then
        entry.whole_module = folder .. "/" .. whole.groups[1] .. ".roc"
        if not exists(entry.whole_module) then stop(entry, "no module file " .. entry.whole_module) end
      else
        local m = re_find(l, INCLUDE)
        if m == nil then stop(entry, NOT_AN_INCLUDE) end
        entry.module = m.groups[1]
        entry.name = m.groups[2]
        if m.groups[3] ~= "" then
          entry.from = m.groups[3]
          entry.to = m.groups[4]
        end
        entry.path = folder .. "/" .. entry.module .. ".roc"
        if not exists(entry.path) then stop(entry, "no module file " .. entry.path) end
      end
    end
    push(entries, entry)
  end
  return entries
end

-- One roc-ast run for every module, because a run holds 64 programs and a
-- long tutorial quotes more includes than that.
function parse_modules(entries)
  local paths = {}
  for e in entries do
    if has_key(e, "path") then push(paths, e.path) end
  end
  local trees = {}
  if #paths == 0 then return trees end
  for tree in roc_tree(unique(paths)) do trees[tree.path] = tree end
  return trees
end

function searched_blocks(nodes, module)
  local blocks = {}
  for n in nodes do
    if n.kind == "statements" and n.depth == 1 then push(blocks, n) end
    if n.kind == "associated" and nodes[nodes[n.parent].kids[1]].name == module then push(blocks, n) end
  end
  return blocks
end

function defined_name(nodes, statement)
  if statement.kind == "s-type-anno" then return statement.name end
  if statement.kind == "s-type-decl" then return nodes[statement.kids[1]].name end
  if statement.kind == "s-decl" then return get(nodes[statement.kids[1]], "raw", "") end
  return ""
end

-- Each place `name` is defined. An annotation and the definition under it
-- are one place.
function places_of(nodes, module, name)
  local places = {}
  for block in searched_blocks(nodes, module) do
    local annotated = false
    for k in block.kids do
      local s = nodes[k]
      local here = defined_name(nodes, s) == name
      if here and annotated then
        local place = places[#places]
        place.end_line = s.end_line
        place.end_col = s.end_col
      elseif here then
        push(places, {line = s.line, col = s.col, end_line = s.end_line, end_col = s.end_col})
      end
      annotated = here and s.kind == "s-type-anno"
    end
  end
  return places
end

function doc_comment_start(source_lines, line)
  local first = line
  while first > 1 and starts_with(trim(source_lines[first - 1]), "##") do first = first - 1 end
  return first
end

-- The definition's lines, dedented, each with its line in the module.
function definition_lines(entry, place)
  local source_lines = split(read(entry.path), "\n")
  local indent = place.col - 1
  local kept = {}
  local at = doc_comment_start(source_lines, place.line)
  while at <= place.end_line do
    local l = source_lines[at]
    if at == place.end_line then l = sub(l, 1, place.end_col - 1) end
    if trim(sub(l, 1, indent)) ~= "" then
      stop(entry, entry.path .. ":" .. at .. " is not indented as the definition is")
    end
    push(kept, {at = at, text = sub(l, indent + 1, #l)})
    at = at + 1
  end
  return kept
end

-- Where in `kept` the one line holding `anchor` is.
function anchor_index(entry, kept, anchor)
  local hits = {}
  local at = {}
  local i = 1
  while i <= #kept do
    for hit in find_all(kept[i].text, anchor) do
      push(hits, i)
      push(at, "" .. kept[i].at)
    end
    i = i + 1
  end
  local quoted = "\"" .. anchor .. "\""
  if #hits == 0 then stop(entry, quoted .. " is not in the definition") end
  if #hits > 1 then
    stop(entry, quoted .. " found " .. #hits .. " times in " .. entry.path .. ", at lines " .. join(at, ", "))
  end
  return hits[1]
end

-- Roc's formatter indents with tabs.
function indent_of(l)
  local n = 0
  while sub(l, n + 1, n + 1) == "\t" do n = n + 1 end
  return n
end

function cut_beside(kept_line, least)
  return sub(kept_line, least + 1, indent_of(kept_line)) .. CUT
end

function elided_lines(entry, kept)
  local first = anchor_index(entry, kept, entry.from)
  local last = anchor_index(entry, kept, entry.to)
  if last < first then
    stop(entry, "\"" .. entry.to .. "\" is above \"" .. entry.from .. "\", at line " .. kept[last].at .. " and line " .. kept[first].at)
  end
  local least = indent_of(kept[first].text)
  local i = first
  while i <= last do
    if trim(kept[i].text) ~= "" and indent_of(kept[i].text) < least then least = indent_of(kept[i].text) end
    i = i + 1
  end
  local shown = {}
  if first > 1 then push(shown, cut_beside(kept[first].text, least)) end
  i = first
  while i <= last do
    push(shown, sub(kept[i].text, least + 1, #kept[i].text))
    i = i + 1
  end
  if last < #kept then push(shown, cut_beside(kept[last].text, least)) end
  return shown
end

function whole_lines(kept)
  local shown = {}
  for k in kept do push(shown, k.text) end
  return shown
end

function fenced_definition(entry, tree)
  if tree.err ~= "" then stop(entry, "roc-ast refused " .. entry.path .. ": " .. tree.err) end
  local places = places_of(tree.nodes, entry.module, entry.name)
  if #places == 0 then stop(entry, "no such name in " .. entry.path) end
  if #places > 1 then
    local at = {}
    for p in sort(places, "line") do push(at, "" .. p.line) end
    stop(entry, "found " .. #places .. " times in " .. entry.path .. ", at lines " .. join(at, ", "))
  end
  local kept = definition_lines(entry, places[1])
  local shown = {}
  if has_key(entry, "from") then shown = elided_lines(entry, kept) else shown = whole_lines(kept) end
  local text = join(shown, "\n")
  if contains(text, "```") then stop(entry, "its text holds a Markdown fence") end
  return "```roc\n" .. text .. "\n```"
end

function fenced_module(entry)
  local text = trim(read(entry.whole_module))
  if contains(text, "```") then stop(entry, "its text holds a Markdown fence") end
  return "```roc\n" .. text .. "\n```"
end

function check_version(roc, pin, said)
  if trim(said) ~= "Roc compiler version " .. pin then
    fail("tutorial: " .. roc .. " is " .. trim(said) .. ", not " .. pin)
  end
end

function pinned_roc(pin_file)
  if not exists(pin_file) then fail("tutorial: no " .. pin_file .. ": run from the roc-apps root") end
  local pin = trim(read(pin_file))
  local roc = "tools:roc-" .. pin .. "/roc"
  if not exists(roc) then fail("tutorial: no " .. roc .. ": install roc-apps' pinned nightly " .. pin .. " at ~/tools/roc-" .. pin .. "/") end
  check_version(roc, pin, run({real(roc), "version"}, {timeout_ms = 30000, whole = 4000, want = WANT}).out)
  return real(roc)
end

-- How many errors `roc check` reports. A clean run says "No errors found", a
-- run with only warnings reports 0, and a crash reports nothing: all are 0.
function errors_reported(said)
  local m = re_find(said, "── ([0-9]+) errors? and ")
  if m == nil then return 0 end
  return tonumber(m.groups[1])
end

function fenced_failure(entry, roc)
  local checked = run({roc, "check", basename(entry.program)},
    {cwd = dirname(entry.program), timeout_ms = 120000, whole = 1000000, want = WANT})
  local said = get(checked, "out", "")
  if errors_reported(said) == 0 then
    stop(entry, "roc check finds no error in " .. entry.program)
  end
  local program = trim(read(entry.program))
  local message = trim(join(split(said, real(".") .. "/"), ""))
  if contains(program .. message, "```") then stop(entry, "its text holds a Markdown fence") end
  return "```roc\n" .. program .. "\n```\n\n```\n" .. message .. "\n```"
end

function needs_roc(entries)
  for e in entries do
    if has_key(e, "program") then return true end
  end
  return false
end

-- The number of includes expanded.
function build(source, output, folder)
  if exists(output) then remove(output) end
  local entries = read_entries(source, read(source), folder)
  local trees = parse_modules(entries)
  local roc = ""
  if needs_roc(entries) then roc = pinned_roc(PIN_FILE) end
  local kept = {}
  local expanded = 0
  for e in entries do
    if has_key(e, "path") then
      push(kept, fenced_definition(e, trees[e.path]))
      expanded = expanded + 1
    elseif has_key(e, "program") then
      push(kept, fenced_failure(e, roc))
      expanded = expanded + 1
    elseif has_key(e, "whole_module") then
      push(kept, fenced_module(e))
      expanded = expanded + 1
    else
      push(kept, e.text)
    end
  end
  mkdir(dirname(output))
  replace(output, join(kept, "\n"))
  return expanded
end

const ZOO = [=[## The module's doc, which belongs to no definition.
import Other

Zoo :: [].{
	## A cage.
	Cage : {
		size : F64,
	}

	## How much to feed,
	## over two lines.
	feed : Cage -> F64
	feed = |cage| {
		amount = cage.size

		amount * 2.0
	}

	bare = 1.0 # A trailing comment, outside the definition.

	Pen := F64.{
		inside_pen = 1.0
	}

	both = 1.0

	## A fence: ```
	fenced = 1.0
}

Wild :: [].{
	in_wild = 1.0
}

# A plain comment, which isn't a doc comment.
top_function : F64 -> F64
top_function = |x| x

## A constant.
top_constant = 2.0

## A type.
TopType : { a : F64 }

both = 2.0
]=]

const TIGHT = "Tight :: [].{ squeezed = 1.0 }\n"

const BAD = [=[app [main!] {}

half : F64 -> F64
half = |x| x / 2.0

main! = |_args| {
	echo!(half("one").to_str())
	Ok({})
}
]=]

const BAD_MESSAGE = [=[── ✗ type mismatch ──────────────────────────────────────────────── bad.roc:7:13

This string literal is being used where a non-string type is needed.

echo!(half("one").to_str())
           ^^^^^

The type was determined to be:

    F64

── 1 error and 0 warnings ────────────────────────────────────────────── bad.roc]=]

const CLEAN = "app [main!] {}\n\nmain! = |_args| Ok({})\n"
const WARNS = "app [main!] {}\n\nmain! = |_args| {\n\tunused = 1.0\n\tOk({})\n}\n"
const FENCED_BAD = "app [main!] {}\n\n# A fence: ```\nmain! = |_args| 1\n"

-- The source's include is on its line 3, for the messages to name.
function attempt_include(folder, include)
  replace(folder .. "/doc.md", "prose\n\n" .. include .. "\n")
  replace(folder .. "/out/doc.md", "stale")
  return attempt(build, folder .. "/doc.md", folder .. "/out/doc.md", folder)
end

function expect_block(checks, folder, include, block)
  local r = attempt_include(folder, include)
  if not r.ok then fail("self_test: " .. include .. " stopped: " .. r.error) end
  local got = read(folder .. "/out/doc.md")
  local want = "prose\n\n```roc\n" .. block .. "\n```\n"
  if got ~= want then fail("self_test: " .. include .. " gave [" .. got .. "], not [" .. want .. "]") end
  push(checks, include)
end

-- A failing program's two blocks, the program as written.
function expect_failure(checks, folder, name, message)
  local include = "{{fails " .. name .. "}}"
  local r = attempt_include(folder, include)
  if not r.ok then fail("self_test: " .. include .. " stopped: " .. r.error) end
  local got = read(folder .. "/out/doc.md")
  local want = "prose\n\n```roc\n" .. trim(read(folder .. "/fails/" .. name .. ".roc")) .. "\n```\n\n```\n" .. message .. "\n```\n"
  if got ~= want then fail("self_test: " .. include .. " gave [" .. got .. "], not [" .. want .. "]") end
  push(checks, include)
end

function expect_stop(checks, folder, include, why)
  local r = attempt_include(folder, include)
  if r.ok then fail("self_test: " .. include .. " built") end
  local want = folder .. "/doc.md:3: " .. include .. ": " .. why
  if r.class ~= "fail" or r.error ~= want then fail("self_test: " .. include .. " stopped with [" .. r.error .. "], not [" .. want .. "]") end
  if exists(folder .. "/out/doc.md") then fail("self_test: " .. include .. " left an output behind") end
  push(checks, include)
end

function expect_prose(checks, folder, line)
  local r = attempt_include(folder, line)
  if not r.ok then fail("self_test: [" .. line .. "] stopped: " .. r.error) end
  if r.value ~= 0 then fail("self_test: [" .. line .. "] counted as an include") end
  if read(folder .. "/out/doc.md") ~= "prose\n\n" .. line .. "\n" then fail("self_test: [" .. line .. "] changed") end
  push(checks, line)
end

function self_test()
  local folder = fresh_dir("scratch:", "safari-tutorial")
  mkdir(folder .. "/out")
  replace(folder .. "/Zoo.roc", ZOO)
  replace(folder .. "/Tight.roc", TIGHT)
  replace(folder .. "/Broken.roc", "Broken :: [].{\n\tx = = 1\n")
  mkdir(folder .. "/fails")
  replace(folder .. "/fails/bad.roc", BAD)
  replace(folder .. "/fails/clean.roc", CLEAN)
  replace(folder .. "/fails/warns.roc", WARNS)
  replace(folder .. "/fails/fenced.roc", FENCED_BAD)
  local zoo = folder .. "/Zoo.roc"
  local checks = {}

  expect_block(checks, folder, "{{code Zoo.feed}}", "## How much to feed,\n## over two lines.\nfeed : Cage -> F64\nfeed = |cage| {\n\tamount = cage.size\n\n\tamount * 2.0\n}")
  expect_block(checks, folder, "{{code Zoo.Cage}}", "## A cage.\nCage : {\n\tsize : F64,\n}")
  expect_block(checks, folder, "{{code Zoo.bare}}", "bare = 1.0")
  expect_block(checks, folder, "{{code Zoo.top_function}}", "top_function : F64 -> F64\ntop_function = |x| x")
  expect_block(checks, folder, "{{code Zoo.top_constant}}", "## A constant.\ntop_constant = 2.0")
  expect_block(checks, folder, "{{code Zoo.TopType}}", "## A type.\nTopType : { a : F64 }")

  expect_stop(checks, folder, "{{code Zoo.nope}}", "no such name in " .. zoo)
  expect_stop(checks, folder, "{{code Zoo.amount}}", "no such name in " .. zoo)
  expect_stop(checks, folder, "{{code Zoo.inside_pen}}", "no such name in " .. zoo)
  expect_stop(checks, folder, "{{code Zoo.in_wild}}", "no such name in " .. zoo)
  expect_stop(checks, folder, "{{code Zoo.both}}", "found 2 times in " .. zoo .. ", at lines 25, 45")
  expect_stop(checks, folder, "{{code Gone.feed}}", "no module file " .. folder .. "/Gone.roc")
  expect_stop(checks, folder, "{{module Gone}}", "no module file " .. folder .. "/Gone.roc")
  expect_block(checks, folder, "{{module Tight}}", trim(TIGHT))
  expect_stop(checks, folder, "{{code Zoo.fenced}}", "its text holds a Markdown fence")
  expect_stop(checks, folder, "{{code Tight.squeezed}}", folder .. "/Tight.roc:1 is not indented as the definition is")

  expect_block(checks, folder, "{{code Zoo.feed from \"amount = cage.size\" to \"amount * 2.0\"}}", "# ...\namount = cage.size\n\namount * 2.0\n# ...")
  expect_block(checks, folder, "{{code Zoo.feed from \"amount * 2.0\" to \"amount * 2.0\"}}", "# ...\namount * 2.0\n# ...")
  expect_block(checks, folder, "{{code Zoo.feed from \"feed =\" to \"amount = cage.size\"}}", "# ...\nfeed = |cage| {\n\tamount = cage.size\n\t# ...")
  expect_block(checks, folder, "{{code Zoo.feed from \"amount * 2.0\" to \"}\"}}", "\t# ...\n\tamount * 2.0\n}")
  expect_block(checks, folder, "{{code Zoo.feed from \"How much\" to \"feed :\"}}", "## How much to feed,\n## over two lines.\nfeed : Cage -> F64\n# ...")
  expect_block(checks, folder, "{{code Zoo.feed from \"How much\" to \"}\"}}", "## How much to feed,\n## over two lines.\nfeed : Cage -> F64\nfeed = |cage| {\n\tamount = cage.size\n\n\tamount * 2.0\n}")
  expect_block(checks, folder, "{{code Zoo.fenced from \"fenced =\" to \"fenced =\"}}", "# ...\nfenced = 1.0")

  expect_stop(checks, folder, "{{code Zoo.feed from \"nope\" to \"}\"}}", "\"nope\" is not in the definition")
  expect_stop(checks, folder, "{{code Zoo.feed from \"feed =\" to \"nope\"}}", "\"nope\" is not in the definition")
  expect_stop(checks, folder, "{{code Zoo.feed from \"A cage.\" to \"}\"}}", "\"A cage.\" is not in the definition")
  expect_stop(checks, folder, "{{code Zoo.feed from \"amount\" to \"}\"}}", "\"amount\" found 2 times in " .. zoo .. ", at lines 14, 16")
  expect_stop(checks, folder, "{{code Zoo.feed from \"feed =\" to \"amount\"}}", "\"amount\" found 2 times in " .. zoo .. ", at lines 14, 16")
  expect_stop(checks, folder, "{{code Zoo.feed from \"e\" to \"}\"}}", "\"e\" found 12 times in " .. zoo .. ", at lines 10, 10, 11, 11, 12, 12, 12, 13, 13, 13, 14, 14")
  expect_stop(checks, folder, "{{code Zoo.feed from \"amount * 2.0\" to \"feed =\"}}", "\"feed =\" is above \"amount * 2.0\", at line 13 and line 16")
  expect_stop(checks, folder, "{{code Zoo.fenced from \"A fence\" to \"fenced =\"}}", "its text holds a Markdown fence")
  expect_stop(checks, folder, "{{code Zoo.nope from \"a\" to \"b\"}}", "no such name in " .. zoo)

  expect_failure(checks, folder, "bad", BAD_MESSAGE)
  local root = real(".")
  replace(folder .. "/fails/pathy.roc", "app [main!] {}\n\nmain! = |_args| \"" .. root .. "/Some.roc\" + 1\n")
  local pathy = attempt_include(folder, "{{fails pathy}}")
  if not pathy.ok then fail("self_test: {{fails pathy}} stopped: " .. pathy.error) end
  local message = split(read(folder .. "/out/doc.md"), "```\n\n```\n")[2]
  if contains(message, root) or not contains(message, "\"Some.roc\" + 1") then fail("self_test: the checkout's path stayed in [" .. message .. "]") end
  push(checks, "{{fails pathy}}")

  expect_stop(checks, folder, "{{fails clean}}", "roc check finds no error in " .. folder .. "/fails/clean.roc")
  expect_stop(checks, folder, "{{fails warns}}", "roc check finds no error in " .. folder .. "/fails/warns.roc")
  expect_stop(checks, folder, "{{fails gone}}", "no program " .. folder .. "/fails/gone.roc")
  expect_stop(checks, folder, "{{fails fenced}}", "its text holds a Markdown fence")

  local refused = attempt_include(folder, "{{code Broken.x}}")
  if refused.ok or not contains(refused.error, ":3: {{code Broken.x}}: roc-ast refused ") then fail("self_test: Broken.roc gave " .. json_write(refused)) end
  push(checks, "{{code Broken.x}}")

  for bad in {"{{", "{{code}}", "{{code Zoo}}", "{{code Zoo.a.b}}", "{{code zoo.feed}}", "{{cod Zoo.feed}}", "{{ code Zoo.feed }}", " {{code Zoo.feed}}", "{{code Zoo.feed}} ", "see {{code Zoo.feed}}", "{{code Zoo.feed}} and {{code Zoo.bare}}", "{{code Zoo.feed from \"a\"}}", "{{code Zoo.feed to \"a\"}}", "{{code Zoo.feed from \"a\" to \"\"}}", "{{code Zoo.feed from a to b}}", "{{code Zoo.feed from \"a\"b\" to \"c\"}}", "{{fails}}", "{{fails Bad}}", "{{fails a b}}", "{{fails a.b}}", "{{fails ../bad}}", "{{fails bad }}"} do
    expect_stop(checks, folder, bad, NOT_AN_INCLUDE)
  end
  for prose in {"plain", "{ {code Zoo.feed}}", "{code Zoo.feed}", "}}"} do
    expect_prose(checks, folder, prose)
  end

  local no_file = attempt(pinned_roc, folder .. "/no-pin")
  if no_file.ok or no_file.error ~= "tutorial: no " .. folder .. "/no-pin: run from the roc-apps root" then fail("self_test: no pin file gave " .. json_write(no_file)) end
  push(checks, "no pin file")
  replace(folder .. "/pin", "nightly-none\n")
  local no_roc = attempt(pinned_roc, folder .. "/pin")
  if no_roc.ok or not starts_with(no_roc.error, "tutorial: no tools:roc-nightly-none/roc: ") then fail("self_test: no compiler gave " .. json_write(no_roc)) end
  push(checks, "no compiler")
  if not attempt(check_version, "r", "p", "Roc compiler version p\n").ok then fail("self_test: the pin was refused") end
  local wrong = attempt(check_version, "r", "p", "Roc compiler version q\n")
  if wrong.ok or wrong.error ~= "tutorial: r is Roc compiler version q, not p" then fail("self_test: the wrong compiler gave " .. json_write(wrong)) end
  push(checks, "the pinned version, and another")

  remove_tree(folder)
  print("tutorial self_test: PASS, " .. #checks .. " checks")
end

if arg("self_test", "") == "1" then
  self_test()
else
  local expanded = build(SOURCE, OUTPUT, SAFARI)
  print("tutorial: " .. expanded .. " includes expanded into " .. OUTPUT)
end
