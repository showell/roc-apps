-- budget: steps=100000000 arena_bytes=1000000000
-- This builds the safari tutorial. It reads tutorial.md, prose with lines
-- like `{{code Cat.instant_at}}`, and writes build/tutorial.md, where each
-- such line is a fenced roc block holding that definition as the source has
-- it, with its `##` doc comment and its annotation, dedented.
--
--   cd <roc-apps checkout> && shale canvas_apps/safari/tutorial/build.shale
--
-- `{{code Cat.crossing_timeline from "looks:" to "finally: Holds(Collapse),"}}`
-- keeps only the lines from the one holding the first text through the one
-- holding the second. A `# ...` line stands for each cut, at the indent of
-- the kept line beside it. Each text must occur exactly once in the
-- definition, doc comment included, so an edit that removes one stops the
-- build. An anchor can't hold a `"`.
--
-- `{{fails turn_as_bearing}}` becomes two fenced blocks: the program
-- fails/turn_as_bearing.roc, and what `roc check` says of it, from the
-- pinned compiler. A program in which `roc check` finds no error stops the
-- build, because the tutorial's claim is then false. `roc check` runs in
-- fails/, so it names files relative to that folder, and the checkout's own
-- path is cut from anything else that holds it.
--
-- `{{module Clock}}` becomes one fenced block holding all of Clock.roc.
--
-- `{{signatures Sky.dusk_while_up Sky.dusk_after_set}}` becomes one fenced block
-- holding those functions' annotations and nothing else, in the order given. They
-- come from one module, because a block has one title. A name without an
-- annotation stops the build.
--
-- `{{types row Sky.dusk_at Darken the sky}}` becomes a row of a table: the words,
-- the function's name, and its type as its annotation says, on one line. The
-- words may be left out, for a row that goes on with the job of the row above.
--
-- Each block gets a title, which rides on its fence for the book to set over the
-- block: `Cat.roc` for a whole definition, `Cat.roc, in crossing_timeline` for
-- part of one, `Clock.roc, the whole file` for a `{{module ...}}`, and for a
-- `{{fails ...}}` `turn_as_bearing.roc (doesn't compile)` over the program and
-- `roc check on turn_as_bearing.roc` over the message. The source has no copy
-- of a title, so a title can't go stale.
--
-- `Module.name` looks in Module.roc: beside safari's other modules, then in
-- gates/, then in the other folders of canvas_apps, such as lib/ and the widgets.
-- A module in two of those other folders stops the build, and the app's own
-- `web` can be named too, as `{{module web}}`. A block's title spells out the
-- folder of anything not beside the game. In the file, a name is looked for at
-- the top level, and in the block of the type named for the module. The spans
-- come from Roc's parser through roc_tree, so a local in a function body or a
-- member of another type is not found. The tree holds no comments, so the doc
-- comment is the run of `##` lines directly above the definition.
--
-- A ```dot fence is written by hand, so its title is too: a line directly
-- above the fence, with a blank line above that, which isn't a heading, a table
-- row or a sentence ending in `.` or `:`. A diagram without one stops the build.
--
-- An include that can't be expanded stops the build, naming the source's
-- line, and no output is left behind. Any line holding `{{` must be an
-- include, alone on its line, so a mistyped one can't reach the page.
--
-- `{{proof row 1570 A cat frozen in the road}}` becomes a row of a table: the
-- step, the words, and that frame's hash and shape count from
-- gates/proof.expected. A step the file doesn't have stops the build, and so
-- does a step it has that no row shows, once there are any rows.
--
-- Every module beside safari's others has to be named somewhere in the source,
-- as a whole word, in prose, a diagram or an include. A module the book never
-- names stops the build. NOT_NAMED and NOT_NAMED_ENDINGS are the exceptions:
-- the app roots and the package say nothing about the game, and a picture's
-- data or an app's shim is named by what it serves.
--
-- Beside the output goes blocks.jsonl, the note color_roc.shale colors by. It has
-- a line for each ```roc block, in the output's order, giving the block's file
-- and its parts. A part is a run of the file's lines, `from` and `to`, each less
-- its first `indent` bytes, with the last stopping before `end_col`. A part may
-- instead be a `cut`, which holds the `# ...` line as the block shows it. The
-- file and the note together give the block's text exactly.
--
-- `self_test=1` proves both sides of each failure on a module written here,
-- and safari's gate runs it.
const SAFARI = "canvas_apps/safari"
const SOURCE = "canvas_apps/safari/tutorial/tutorial.md"
const OUTPUT = "canvas_apps/safari/tutorial/build/tutorial.md"
const WANT = "roc-pin: roc-apps' pinned nightly, for the tutorial's failing programs"
const INCLUDE = "^\\{\\{code ([A-Z][A-Za-z0-9_]*|web)\\.([A-Za-z_][A-Za-z0-9_]*!?)(?: from \"([^\"]+)\" to \"([^\"]+)\")?\\}\\}$"
const SIGNATURES = "^\\{\\{signatures ([A-Z][A-Za-z0-9_.! ]*[a-zA-Z0-9_!])\\}\\}$"
const SIGNATURE_NAME = "^([A-Z][A-Za-z0-9_]*)\\.([a-z_][A-Za-z0-9_]*!?)$"
const TYPES_ROW = "^\\{\\{types row ([A-Z][A-Za-z0-9_]*)\\.([a-z_][A-Za-z0-9_]*!?)(?: ([^}]+))?\\}\\}$"
const FAILS = "^\\{\\{fails ([a-z][a-z0-9_]*)\\}\\}$"
const WHOLE_MODULE = "^\\{\\{module ([A-Z][A-Za-z0-9_]*|web)\\}\\}$"
const PROOF_ROW = "^\\{\\{proof row ([0-9]+) ([^}]+)\\}\\}$"
const PROOF_HASH = "^RasterFrame ([0-9]+): hash ([0-9a-f]+)$"
const PROOF_SHAPES = "^ShapesFrame ([0-9]+): differ 0 of [0-9]+, triangles [0-9]+, shapes ([0-9]+)$"
const NOT_AN_INCLUDE = "not a line of the form {{code Module.name}}, {{code Module.name from \"text\" to \"text\"}}, {{module Name}}, {{signatures Module.name Module.name}}, {{types row Module.name words}}, {{proof row N words}} or {{fails name}}"
const NO_TITLE = "a diagram needs a title line directly above it"
const CUT = "# ..."
const PROOF_FILE = "/gates/proof.expected"
const NOT_NAMED = {"web", "main", "game"}
const NOT_NAMED_ENDINGS = {"Stills", "App"}

function stop(entry, why)
  fail(entry.source .. ":" .. entry.line .. ": " .. entry.text .. ": " .. why)
end

-- The module's file: the game's, then a gate's, then a folder's beside the game.
-- A name is the game's if it can be, so only the other folders can disagree.
function module_path(entry, folder, module)
  local file = module .. ".roc"
  for near in {folder .. "/" .. file, folder .. "/gates/" .. file} do
    if exists(near) then return near end
  end
  local found = glob(dirname(folder) .. "/*/" .. file)
  if #found == 0 then stop(entry, "no module file " .. folder .. "/" .. file) end
  if #found > 1 then stop(entry, "two modules of that name: " .. join(found, ", ")) end
  return found[1]
end

-- The module's path as a reader finds it, from the game's folder or else from
-- canvas_apps.
function shown_path(folder, path)
  if starts_with(path, folder .. "/") then return sub(path, #folder + 2, #path) end
  return sub(path, #dirname(folder) + 2, #path)
end

-- The names in a signatures include, which all have the module of the first.
function signature_names(entry, list)
  local names = {}
  for word in split(list, " ") do
    local m = re_find(word, SIGNATURE_NAME)
    if m == nil then stop(entry, NOT_AN_INCLUDE) end
    if #names == 0 then entry.module = m.groups[1] end
    if m.groups[1] ~= entry.module then stop(entry, "a block of signatures comes from one module, and this has " .. entry.module .. " and " .. m.groups[1]) end
    push(names, m.groups[2])
  end
  return names
end

-- The source's lines, in order. A code include's entry has its module, its name
-- and its module's path, and its anchors if it has them. A signatures or types
-- include's has its module and path, with its names or its name. A fails
-- include's has its program's path.
function read_entries(source, text, folder)
  local entries = {}
  local number = 0
  for l in split(text, "\n") do
    number = number + 1
    local entry = {source = source, line = number, text = l}
    if contains(l, "{{") then
      local failing = re_find(l, FAILS)
      local whole = re_find(l, WHOLE_MODULE)
      local proof_row = re_find(l, PROOF_ROW)
      local signatures = re_find(l, SIGNATURES)
      local types_row = re_find(l, TYPES_ROW)
      if signatures ~= nil then
        entry.signatures = signature_names(entry, signatures.groups[1])
        entry.path = module_path(entry, folder, entry.module)
      elseif types_row ~= nil then
        entry.module = types_row.groups[1]
        entry.types_name = types_row.groups[2]
        entry.types_words = types_row.groups[3]
        entry.path = module_path(entry, folder, entry.module)
      elseif proof_row ~= nil then
        entry.proof_step = proof_row.groups[1]
        entry.proof_words = proof_row.groups[2]
      elseif failing ~= nil then
        entry.program = dirname(source) .. "/fails/" .. failing.groups[1] .. ".roc"
        if not exists(entry.program) then stop(entry, "no program " .. entry.program) end
      elseif whole ~= nil then
        entry.whole_module = module_path(entry, folder, whole.groups[1])
      else
        local m = re_find(l, INCLUDE)
        if m == nil then stop(entry, NOT_AN_INCLUDE) end
        entry.module = m.groups[1]
        entry.name = m.groups[2]
        if m.groups[3] ~= "" then
          entry.from = m.groups[3]
          entry.to = m.groups[4]
        end
        entry.path = module_path(entry, folder, entry.module)
      end
    end
    push(entries, entry)
  end
  return entries
end

function could_be_title(l)
  local text = trim(l)
  if text == "" or contains(l, "{{") then return false end
  if starts_with(l, "#") or starts_with(l, "|") or starts_with(l, "```") then return false end
  return not ends_with(text, ".") and not ends_with(text, ":")
end

function has_title(entries, fence_at)
  if fence_at == 1 or not could_be_title(entries[fence_at - 1].text) then return false end
  return fence_at == 2 or trim(entries[fence_at - 2].text) == ""
end

function check_titles(entries)
  local fenced = false
  local at = 1
  while at <= #entries do
    local l = entries[at].text
    if starts_with(l, "```") then
      if l == "```dot" and not fenced and not has_title(entries, at) then stop(entries[at], NO_TITLE) end
      fenced = not fenced
    end
    at = at + 1
  end
end

-- One roc-ast run for every module, because a run holds 64 programs and a
-- long tutorial quotes more includes than that.
function parse_modules(entries)
  local paths = {}
  for e in entries do
    if has_key(e, "path") then push(paths, e.path) end
  end
  local trees = {}
  if #paths == 0 then return trees end
  for tree in roc_tree(unique(paths)) do trees[tree.path] = tree end
  return trees
end

function searched_blocks(nodes, module)
  local blocks = {}
  for n in nodes do
    if n.kind == "statements" and n.depth == 1 then push(blocks, n) end
    if n.kind == "associated" and nodes[nodes[n.parent].kids[1]].name == module then push(blocks, n) end
  end
  return blocks
end

function defined_name(nodes, statement)
  if statement.kind == "s-type-anno" then return statement.name end
  if statement.kind == "s-type-decl" then return nodes[statement.kids[1]].name end
  if statement.kind == "s-decl" then return get(nodes[statement.kids[1]], "raw", "") end
  return ""
end

-- Each place `name` is defined. An annotation and the definition under it
-- are one place.
function places_of(nodes, module, name)
  local places = {}
  for block in searched_blocks(nodes, module) do
    local annotated = false
    for k in block.kids do
      local s = nodes[k]
      local here = defined_name(nodes, s) == name
      if here and annotated then
        local place = places[#places]
        place.end_line = s.end_line
        place.end_col = s.end_col
      elseif here then
        push(places, {line = s.line, col = s.col, end_line = s.end_line, end_col = s.end_col})
      end
      annotated = here and s.kind == "s-type-anno"
    end
  end
  return places
end

function whole_lines(kept)
  local shown = {}
  for k in kept do push(shown, k.text) end
  return shown
end

-- The note's part for `kept` from index `first` to `last`, with `least` more
-- bytes taken off each line.
function kept_part(kept, first, last, least)
  local tail = kept[last]
  return {from = kept[first].at, to = tail.at, indent = kept[first].indent + least, end_col = tail.indent + #tail.text + 1}
end

-- The note's part for a block that is a whole file's trimmed text.
function whole_file_part(text)
  local shown = split(text, "\n")
  return {from = 1, to = #shown, indent = 0, end_col = #shown[#shown] + 1}
end

function doc_comment_start(source_lines, line)
  local first = line
  while first > 1 and starts_with(trim(source_lines[first - 1]), "##") do first = first - 1 end
  return first
end

-- The lines from `first` to the end of `place`, dedented, each with its line in
-- the module.
function span_lines(entry, source_lines, first, place)
  local indent = place.col - 1
  local kept = {}
  local at = first
  while at <= place.end_line do
    local l = source_lines[at]
    if at == place.end_line then l = sub(l, 1, place.end_col - 1) end
    if trim(sub(l, 1, indent)) ~= "" then
      stop(entry, entry.path .. ":" .. at .. " is not indented as the definition is")
    end
    push(kept, {at = at, indent = indent, text = sub(l, indent + 1, #l)})
    at = at + 1
  end
  return kept
end

function definition_lines(entry, place)
  local source_lines = split(read(entry.path), "\n")
  return span_lines(entry, source_lines, doc_comment_start(source_lines, place.line), place)
end

-- The lines of the annotation of `name`, dedented, each with its line in the
-- module.
function annotation_kept(entry, tree, name)
  if tree.err ~= "" then stop(entry, "roc-ast refused " .. entry.path .. ": " .. tree.err) end
  local found = {}
  for block in searched_blocks(tree.nodes, entry.module) do
    for k in block.kids do
      local s = tree.nodes[k]
      if s.kind == "s-type-anno" and s.name == name then push(found, s) end
    end
  end
  if #found == 0 then stop(entry, "no annotation of " .. name .. " in " .. entry.path) end
  if #found > 1 then stop(entry, name .. " has " .. #found .. " annotations in " .. entry.path) end
  return span_lines(entry, split(read(entry.path), "\n"), found[1].line, found[1])
end

-- Where in `kept` the one line holding `anchor` is.
function anchor_index(entry, kept, anchor)
  local hits = {}
  local at = {}
  local i = 1
  while i <= #kept do
    for hit in find_all(kept[i].text, anchor) do
      push(hits, i)
      push(at, "" .. kept[i].at)
    end
    i = i + 1
  end
  local quoted = "\"" .. anchor .. "\""
  if #hits == 0 then stop(entry, quoted .. " is not in the definition") end
  if #hits > 1 then
    stop(entry, quoted .. " found " .. #hits .. " times in " .. entry.path .. ", at lines " .. join(at, ", "))
  end
  return hits[1]
end

-- Roc's formatter indents with tabs.
function indent_of(l)
  local n = 0
  while sub(l, n + 1, n + 1) == "\t" do n = n + 1 end
  return n
end

function cut_beside(kept_line, least)
  return sub(kept_line, least + 1, indent_of(kept_line)) .. CUT
end

function elided_block(entry, kept)
  local first = anchor_index(entry, kept, entry.from)
  local last = anchor_index(entry, kept, entry.to)
  if last < first then
    stop(entry, "\"" .. entry.to .. "\" is above \"" .. entry.from .. "\", at line " .. kept[last].at .. " and line " .. kept[first].at)
  end
  local least = indent_of(kept[first].text)
  local i = first
  while i <= last do
    if trim(kept[i].text) ~= "" and indent_of(kept[i].text) < least then least = indent_of(kept[i].text) end
    i = i + 1
  end
  local shown = {}
  local parts = {}
  if first > 1 then
    push(shown, cut_beside(kept[first].text, least))
    push(parts, {cut = shown[1]})
  end
  i = first
  while i <= last do
    push(shown, sub(kept[i].text, least + 1, #kept[i].text))
    i = i + 1
  end
  push(parts, kept_part(kept, first, last, least))
  if last < #kept then
    push(shown, cut_beside(kept[last].text, least))
    push(parts, {cut = shown[#shown]})
  end
  return {shown = shown, parts = parts}
end

function check_quoted(entry, text)
  if contains(text, "```") then stop(entry, "its text holds a Markdown fence") end
end

function titled_block(title, language, text)
  return "```" .. language .. " " .. title .. "\n" .. text .. "\n```"
end

function fenced_definition(entry, tree, folder, notes)
  if tree.err ~= "" then stop(entry, "roc-ast refused " .. entry.path .. ": " .. tree.err) end
  local places = places_of(tree.nodes, entry.module, entry.name)
  if #places == 0 then stop(entry, "no such name in " .. entry.path) end
  if #places > 1 then
    local at = {}
    for p in sort(places, "line") do push(at, "" .. p.line) end
    stop(entry, "found " .. #places .. " times in " .. entry.path .. ", at lines " .. join(at, ", "))
  end
  local kept = definition_lines(entry, places[1])
  local block = {shown = whole_lines(kept), parts = {kept_part(kept, 1, #kept, 0)}}
  local title = shown_path(folder, entry.path)
  if has_key(entry, "from") then
    block = elided_block(entry, kept)
    title = title .. ", in " .. entry.name
  end
  local text = join(block.shown, "\n")
  check_quoted(entry, text)
  push(notes, {path = entry.path, parts = block.parts})
  return titled_block(title, "roc", text)
end

function fenced_module(entry, folder, notes)
  local text = trim(read(entry.whole_module))
  check_quoted(entry, text)
  push(notes, {path = entry.whole_module, parts = {whole_file_part(text)}})
  return titled_block(shown_path(folder, entry.whole_module) .. ", the whole file", "roc", text)
end

-- How many errors `roc check` reports. A clean run says "No errors found", a
-- run with only warnings reports 0, and a crash reports nothing: all are 0.
function errors_reported(said)
  local m = re_find(said, "── ([0-9]+) errors? and ")
  if m == nil then return 0 end
  return tonumber(m.groups[1])
end

function fenced_failure(entry, roc, notes)
  local checked = run({roc, "check", basename(entry.program)},
    {cwd = dirname(entry.program), timeout_ms = 120000, whole = 1000000, want = WANT})
  local said = get(checked, "out", "")
  if errors_reported(said) == 0 then
    stop(entry, "roc check finds no error in " .. entry.program)
  end
  local program = trim(read(entry.program))
  local message = trim(join(split(said, real(".") .. "/"), ""))
  check_quoted(entry, program .. message)
  push(notes, {path = entry.program, parts = {whole_file_part(program)}})
  local file = basename(entry.program)
  return titled_block(file .. " (doesn't compile)", "roc", program) .. "\n\n" .. titled_block("roc check on " .. file, "text", message)
end

function needs_roc(entries)
  for e in entries do
    if has_key(e, "program") then return true end
  end
  return false
end

function fenced_signatures(entry, tree, folder, notes)
  local shown = {}
  local parts = {}
  for name in entry.signatures do
    local kept = annotation_kept(entry, tree, name)
    for l in whole_lines(kept) do push(shown, l) end
    push(parts, kept_part(kept, 1, #kept, 0))
  end
  local text = join(shown, "\n")
  check_quoted(entry, text)
  push(notes, {path = entry.path, parts = parts})
  return titled_block(shown_path(folder, entry.path), "roc", text)
end

function types_table_row(entry, tree)
  local name = entry.types_name
  local pieces = {}
  for l in whole_lines(annotation_kept(entry, tree, name)) do push(pieces, trim(l)) end
  local annotation = join(pieces, " ")
  return "| " .. entry.types_words .. " | `" .. name .. "` | `" .. sub(annotation, #name + 4, #annotation) .. "` |"
end

-- A step as the book writes a number, with a comma past the thousands.
function step_text(step)
  if #step <= 3 then return step end
  return sub(step, 1, #step - 3) .. "," .. sub(step, #step - 2, #step)
end

-- Each step's hash and shape count from a proof file, by step.
function proof_numbers(path)
  local numbers = {}
  for l in lines(read(path)) do
    local hash = re_find(l, PROOF_HASH)
    local shapes = re_find(l, PROOF_SHAPES)
    if hash ~= nil then
      if not has_key(numbers, hash.groups[1]) then numbers[hash.groups[1]] = {} end
      numbers[hash.groups[1]].hash = hash.groups[2]
    elseif shapes ~= nil then
      if not has_key(numbers, shapes.groups[1]) then numbers[shapes.groups[1]] = {} end
      numbers[shapes.groups[1]].shapes = shapes.groups[2]
    end
  end
  return numbers
end

function proof_table_row(entry, numbers)
  if not has_key(numbers, entry.proof_step) then stop(entry, "no step " .. entry.proof_step .. " in the proof file") end
  local step = numbers[entry.proof_step]
  if not has_key(step, "hash") or not has_key(step, "shapes") then stop(entry, "the proof file has only half of step " .. entry.proof_step) end
  return "| " .. step_text(entry.proof_step) .. " | " .. entry.proof_words .. " | `" .. step.hash .. "` | " .. step_text(step.shapes) .. " |"
end

-- Stops the build on a step of the proof file that no row of `entries` shows.
function check_proof_rows(entries, numbers)
  local shown = {}
  for e in entries do
    if has_key(e, "proof_step") then shown[e.proof_step] = true end
  end
  for step in sort(keys(numbers)) do
    if not has_key(shown, step) then fail("tutorial: no row shows step " .. step .. " of the proof file") end
  end
  return nil
end

function needs_proof(entries)
  for e in entries do
    if has_key(e, "proof_step") then return true end
  end
  return false
end

function notes_path(output)
  return dirname(output) .. "/blocks.jsonl"
end

function notes_text(notes)
  local rows = {}
  for note in notes do push(rows, json_write(note) .. "\n") end
  return join(rows, "")
end

-- The number of includes expanded.
function build(source, output, folder)
  if exists(output) then remove(output) end
  if exists(notes_path(output)) then remove(notes_path(output)) end
  local entries = read_entries(source, read(source), folder)
  check_titles(entries)
  local trees = parse_modules(entries)
  local roc = ""
  if needs_roc(entries) then roc = pinned_roc("tutorial") end
  local numbers = {}
  if needs_proof(entries) then
    numbers = proof_numbers(folder .. PROOF_FILE)
    check_proof_rows(entries, numbers)
  end
  local kept = {}
  local notes = {}
  local expanded = 0
  for e in entries do
    if has_key(e, "proof_step") then
      push(kept, proof_table_row(e, numbers))
      expanded = expanded + 1
    elseif has_key(e, "signatures") then
      push(kept, fenced_signatures(e, trees[e.path], folder, notes))
      expanded = expanded + 1
    elseif has_key(e, "types_name") then
      push(kept, types_table_row(e, trees[e.path]))
      expanded = expanded + 1
    elseif has_key(e, "path") then
      push(kept, fenced_definition(e, trees[e.path], folder, notes))
      expanded = expanded + 1
    elseif has_key(e, "program") then
      push(kept, fenced_failure(e, roc, notes))
      expanded = expanded + 1
    elseif has_key(e, "whole_module") then
      push(kept, fenced_module(e, folder, notes))
      expanded = expanded + 1
    else
      push(kept, e.text)
    end
  end
  mkdir(dirname(output))
  replace(output, join(kept, "\n"))
  replace(notes_path(output), notes_text(notes))
  return expanded
end

const ZOO = [=[## The module's doc, which belongs to no definition.
import Other

Zoo :: [].{
	## A cage.
	Cage : {
		size : F64,
	}

	## How much to feed,
	## over two lines.
	feed : Cage -> F64
	feed = |cage| {
		amount = cage.size

		amount * 2.0
	}

	bare = 1.0 # A trailing comment, outside the definition.

	Pen := F64.{
		inside_pen = 1.0
	}

	both = 1.0

	## A fence: ```
	fenced = 1.0
}

Wild :: [].{
	in_wild = 1.0
}

# A plain comment, which isn't a doc comment.
top_function : F64 -> F64
top_function = |x| x

## A constant.
top_constant = 2.0

## A type.
TopType : { a : F64 }

both = 2.0

## A long one.
wide_type :
	F64,
	{ size : F64 } -> F64
wide_type = |a, b| a + b.size

twice : F64
twice : F64

]=]

const TIGHT = "Tight :: [].{ squeezed = 1.0 }\n"

const BAD = [=[app [main!] {}

half : F64 -> F64
half = |x| x / 2.0

main! = |_args| {
	echo!(half("one").to_str())
	Ok({})
}
]=]

const BAD_MESSAGE = [=[── ✗ type mismatch ──────────────────────────────────────────────── bad.roc:7:13

This string literal is being used where a non-string type is needed.

echo!(half("one").to_str())
           ^^^^^

The type was determined to be:

    F64

── 1 error and 0 warnings ────────────────────────────────────────────── bad.roc]=]

const CLEAN = "app [main!] {}\n\nmain! = |_args| Ok({})\n"
const WARNS = "app [main!] {}\n\nmain! = |_args| {\n\tunused = 1.0\n\tOk({})\n}\n"
const FENCED_BAD = "app [main!] {}\n\n# A fence: ```\nmain! = |_args| 1\n"
const DIAGRAM = "```dot\ndigraph x {}\n```"
-- Whether a module needn't be named in the book.
function excused(module)
  for name in NOT_NAMED do
    if module == name then return true end
  end
  for ending in NOT_NAMED_ENDINGS do
    if ends_with(module, ending) then return true end
  end
  return false
end

-- The modules in `folder` that `text` doesn't name as a whole word, sorted.
function unnamed_modules(folder, text)
  local unnamed = {}
  for path in glob(folder .. "/*.roc") do
    local module = sub(basename(path), 1, #basename(path) - 4)
    if not excused(module) and re_find(text, "\\b" .. module .. "\\b") == nil then push(unnamed, module) end
  end
  return sort(unnamed)
end

-- Stops the build on any module that `unnamed_modules` finds.
function check_modules_named(folder, text)
  local unnamed = unnamed_modules(folder, text)
  if #unnamed > 0 then fail("tutorial: the book never names " .. join(unnamed, ", ")) end
  return nil
end

-- The source's include is on its line 3, for the messages to name.
function attempt_include(folder, include)
  replace(folder .. "/doc.md", "prose\n\n" .. include .. "\n")
  replace(folder .. "/out/doc.md", "stale")
  return attempt(build, folder .. "/doc.md", folder .. "/out/doc.md", folder)
end

function expect_block(checks, folder, include, title, block)
  local r = attempt_include(folder, include)
  if not r.ok then fail("self_test: " .. include .. " stopped: " .. r.error) end
  local got = read(folder .. "/out/doc.md")
  local want = "prose\n\n```roc " .. title .. "\n" .. block .. "\n```\n"
  if got ~= want then fail("self_test: " .. include .. " gave [" .. got .. "], not [" .. want .. "]") end
  push(checks, include)
end

-- A failing program's two blocks, the program as written.
function expect_failure(checks, folder, name, message)
  local include = "{{fails " .. name .. "}}"
  local r = attempt_include(folder, include)
  if not r.ok then fail("self_test: " .. include .. " stopped: " .. r.error) end
  local got = read(folder .. "/out/doc.md")
  local want = "prose\n\n```roc " .. name .. ".roc (doesn't compile)\n" .. trim(read(folder .. "/fails/" .. name .. ".roc")) .. "\n```\n\n```text roc check on " .. name .. ".roc\n" .. message .. "\n```\n"
  if got ~= want then fail("self_test: " .. include .. " gave [" .. got .. "], not [" .. want .. "]") end
  push(checks, include)
end

function expect_prose(checks, folder, line)
  local r = attempt_include(folder, line)
  if not r.ok then fail("self_test: [" .. line .. "] stopped: " .. r.error) end
  if r.value ~= 0 then fail("self_test: [" .. line .. "] counted as an include") end
  if read(folder .. "/out/doc.md") ~= "prose\n\n" .. line .. "\n" then fail("self_test: [" .. line .. "] changed") end
  push(checks, line)
end

-- `text` goes in at line 3, and must stop at line `at`, which reads `line`.
function expect_stop_at(checks, folder, text, at, line, why)
  local r = attempt_include(folder, text)
  if r.ok then fail("self_test: " .. text .. " built") end
  local want = folder .. "/doc.md:" .. at .. ": " .. line .. ": " .. why
  if r.class ~= "fail" or r.error ~= want then fail("self_test: " .. text .. " stopped with [" .. r.error .. "], not [" .. want .. "]") end
  if exists(folder .. "/out/doc.md") then fail("self_test: " .. text .. " left an output behind") end
  push(checks, text)
end

function expect_stop(checks, folder, include, why)
  expect_stop_at(checks, folder, include, 3, include, why)
end

-- A document that starts at line 1, with no prose above it.
function attempt_whole(folder, text)
  replace(folder .. "/whole.md", text)
  return attempt(build, folder .. "/whole.md", folder .. "/out/whole.md", folder)
end

function check_title_rule(checks, folder)
  expect_prose(checks, folder, "A title\n" .. DIAGRAM)
  expect_prose(checks, folder, "The modules around `Sky`\n" .. DIAGRAM)
  expect_prose(checks, folder, "A title\n```text\nno diagram\n```\n\nA title\n" .. DIAGRAM)
  expect_stop_at(checks, folder, DIAGRAM, 3, "```dot", NO_TITLE)
  expect_stop_at(checks, folder, "A title\n\n" .. DIAGRAM, 5, "```dot", NO_TITLE)
  expect_stop_at(checks, folder, "more prose\nA title\n" .. DIAGRAM, 5, "```dot", NO_TITLE)
  expect_stop_at(checks, folder, "## A heading\n" .. DIAGRAM, 4, "```dot", NO_TITLE)
  expect_stop_at(checks, folder, "| a table row |\n" .. DIAGRAM, 4, "```dot", NO_TITLE)
  expect_stop_at(checks, folder, "A sentence.\n" .. DIAGRAM, 4, "```dot", NO_TITLE)
  expect_stop_at(checks, folder, "Here it is:\n" .. DIAGRAM, 4, "```dot", NO_TITLE)
  expect_stop_at(checks, folder, "A title\n" .. DIAGRAM .. "\n" .. DIAGRAM, 7, "```dot", NO_TITLE)
  expect_stop_at(checks, folder, "{{code Zoo.bare}}\n" .. DIAGRAM, 4, "```dot", NO_TITLE)

  local first = attempt_whole(folder, DIAGRAM .. "\n")
  if first.ok or first.error ~= folder .. "/whole.md:1: ```dot: " .. NO_TITLE then fail("self_test: a diagram on line 1 gave " .. json_write(first)) end
  push(checks, "a diagram on line 1")
  local second = attempt_whole(folder, "A title\n" .. DIAGRAM .. "\n")
  if not second.ok then fail("self_test: a title on line 1 stopped: " .. second.error) end
  push(checks, "a title on line 1")
end

-- The note says where each kind of block came from, in order, and has no line
-- for anything that isn't a Roc block. One document holds them all, because each
-- document costs programs and a run holds 64.
function check_note_rule(checks, folder)
  local zoo = folder .. "/Zoo.roc"
  local includes = {
    "{{code Zoo.feed}}",
    "{{code Zoo.bare}}",
    "{{code Zoo.feed from \"amount = cage.size\" to \"amount * 2.0\"}}",
    "{{code Zoo.feed from \"amount * 2.0\" to \"}\"}}",
    "{{signatures Zoo.feed Zoo.top_function}}",
    "{{types row Zoo.feed Feed them}}",
    "{{module Tight}}",
    "A title\n" .. DIAGRAM,
    "{{fails bad}}",
  }
  local want = notes_text({
    {path = zoo, parts = {{from = 10, to = 17, indent = 1, end_col = 3}}},
    {path = zoo, parts = {{from = 19, to = 19, indent = 1, end_col = 12}}},
    {path = zoo, parts = {{cut = "# ..."}, {from = 14, to = 16, indent = 2, end_col = 15}, {cut = "# ..."}}},
    {path = zoo, parts = {{cut = "\t# ..."}, {from = 16, to = 17, indent = 1, end_col = 3}}},
    {path = zoo, parts = {{from = 12, to = 12, indent = 1, end_col = 20}, {from = 36, to = 36, indent = 0, end_col = 26}}},
    {path = folder .. "/Tight.roc", parts = {{from = 1, to = 1, indent = 0, end_col = 31}}},
    {path = folder .. "/fails/bad.roc", parts = {{from = 1, to = 9, indent = 0, end_col = 2}}},
  })
  local r = attempt_include(folder, join(includes, "\n\n"))
  if not r.ok then fail("self_test: the note's includes stopped: " .. r.error) end
  local got = read(folder .. "/out/blocks.jsonl")
  if got ~= want then fail("self_test: the note was [" .. got .. "], not [" .. want .. "]") end
  push(checks, "the note of each kind of block")
  return nil
end

-- Both sides of the proof table's rows.
function check_proof_rule(checks, folder)
  mkdir(folder .. "/gates")
  replace(folder .. "/gates/proof.expected", "ok  after 10 steps\nShapesFrame 7: differ 0 of 576000, triangles 40, shapes 2712\nShapesFrame 1570: differ 0 of 576000, triangles 40, shapes 12\nRasterFrame 7: hash 2335ee33\nRasterFrame 1570: hash 9d5d7f8e\n")
  local rows = "{{proof row 7 A start}}\n{{proof row 1570 A cat}}"
  local both = attempt_include(folder, rows)
  if not both.ok then fail("self_test: the proof rows stopped: " .. both.error) end
  local got = read(folder .. "/out/doc.md")
  local want = "prose\n\n| 7 | A start | `2335ee33` | 2,712 |\n| 1,570 | A cat | `9d5d7f8e` | 12 |\n"
  if got ~= want then fail("self_test: the proof rows gave [" .. got .. "], not [" .. want .. "]") end
  push(checks, "the proof rows, from the proof file")

  expect_stop_at(checks, folder, "{{proof row 7 A start}}\n{{proof row 1570 A cat}}\n{{proof row 8 Not there}}", 5, "{{proof row 8 Not there}}", "no step 8 in the proof file")

  local left_out = attempt_include(folder, "{{proof row 7 A start}}")
  if left_out.ok or left_out.error ~= "tutorial: no row shows step 1570 of the proof file" then fail("self_test: a left-out step gave " .. json_write(left_out)) end
  push(checks, "a step no row shows")

  replace(folder .. "/gates/proof.expected", "RasterFrame 7: hash 2335ee33\n")
  expect_stop(checks, folder, "{{proof row 7 A start}}", "the proof file has only half of step 7")
  remove_tree(folder .. "/gates")
  return nil
end

function expect_row(checks, folder, include, row)
  local r = attempt_include(folder, include)
  if not r.ok then fail("self_test: " .. include .. " stopped: " .. r.error) end
  local got = read(folder .. "/out/doc.md")
  if got ~= "prose\n\n" .. row .. "\n" then fail("self_test: " .. include .. " gave [" .. got .. "], not [" .. row .. "]") end
  push(checks, include)
end

-- Both sides of the block of signatures and the table's types.
function check_annotation_rules(checks, folder)
  local zoo = folder .. "/Zoo.roc"
  expect_block(checks, folder, "{{signatures Zoo.feed}}", "Zoo.roc", "feed : Cage -> F64")
  expect_block(checks, folder, "{{signatures Zoo.feed Zoo.top_function}}", "Zoo.roc", "feed : Cage -> F64\ntop_function : F64 -> F64")
  expect_block(checks, folder, "{{signatures Zoo.top_function Zoo.feed}}", "Zoo.roc", "top_function : F64 -> F64\nfeed : Cage -> F64")
  expect_block(checks, folder, "{{signatures Zoo.wide_type Zoo.feed}}", "Zoo.roc", "wide_type :\n\tF64,\n\t{ size : F64 } -> F64\nfeed : Cage -> F64")
  expect_stop(checks, folder, "{{signatures Zoo.bare}}", "no annotation of bare in " .. zoo)
  expect_stop(checks, folder, "{{signatures Zoo.feed Zoo.nope}}", "no annotation of nope in " .. zoo)
  expect_stop(checks, folder, "{{signatures Zoo.twice}}", "twice has 2 annotations in " .. zoo)
  expect_stop(checks, folder, "{{signatures Gone.x}}", "no module file " .. folder .. "/Gone.roc")
  expect_stop(checks, folder, "{{signatures Zoo.feed Wild.x}}", "a block of signatures comes from one module, and this has Zoo and Wild")
  for bad in {"{{signatures}}", "{{signatures Zoo}}", "{{signatures Zoo.Cage}}", "{{signatures zoo.feed}}", "{{signatures Zoo.feed feed}}", "{{signatures Zoo.feed  Zoo.bare}}", "{{signatures Zoo.feed,Zoo.bare}}"} do
    expect_stop(checks, folder, bad, NOT_AN_INCLUDE)
  end

  expect_row(checks, folder, "{{types row Zoo.feed Feed them}}", "| Feed them | `feed` | `Cage -> F64` |")
  expect_row(checks, folder, "{{types row Zoo.feed}}", "|  | `feed` | `Cage -> F64` |")
  expect_row(checks, folder, "{{types row Zoo.wide_type Two lines}}", "| Two lines | `wide_type` | `F64, { size : F64 } -> F64` |")
  expect_stop(checks, folder, "{{types row Zoo.bare Words}}", "no annotation of bare in " .. zoo)
  expect_stop(checks, folder, "{{types row Zoo.nope}}", "no annotation of nope in " .. zoo)
  expect_stop(checks, folder, "{{types row Gone.x}}", "no module file " .. folder .. "/Gone.roc")
  for bad in {"{{types row}}", "{{types row Zoo}}", "{{types row zoo.feed}}", "{{types row Zoo.Cage}}", "{{types  row Zoo.feed}}"} do
    expect_stop(checks, folder, bad, NOT_AN_INCLUDE)
  end
  return nil
end

-- Both sides of where an include finds its module, and how its title says so.
function check_reach_rule(checks, top, folder)
  mkdir(folder .. "/gates")
  for dir in {"lib", "one", "two"} do mkdir(top .. "/" .. dir) end
  replace(folder .. "/gates/Gate.roc", "Gate :: [].{\n\tshut = 1.0\n}\n")
  replace(top .. "/lib/Libbed.roc", "Libbed :: [].{\n\tkept = 1.0\n}\n")
  replace(top .. "/lib/Near.roc", "Near :: [].{\n\tspot = 1.0\n}\n")
  replace(folder .. "/Near.roc", "Near :: [].{\n\tspot = 2.0\n}\n")
  replace(folder .. "/gates/Both.roc", "Both :: [].{\n\tspot = 3.0\n}\n")
  replace(top .. "/one/Both.roc", "Both :: [].{\n\tspot = 4.0\n}\n")
  replace(top .. "/one/Twin.roc", "Twin :: [].{\n\tx = 1.0\n}\n")
  replace(top .. "/two/Twin.roc", "Twin :: [].{\n\tx = 1.0\n}\n")
  replace(folder .. "/web.roc", "app [main!] {}\n\nmain! = |_args| Ok({})\n")
  expect_block(checks, folder, "{{code Gate.shut}}", "gates/Gate.roc", "shut = 1.0")
  expect_block(checks, folder, "{{code Libbed.kept}}", "lib/Libbed.roc", "kept = 1.0")
  expect_block(checks, folder, "{{code Near.spot}}", "Near.roc", "spot = 2.0")
  expect_block(checks, folder, "{{code Both.spot}}", "gates/Both.roc", "spot = 3.0")
  expect_block(checks, folder, "{{code web.main!}}", "web.roc", "main! = |_args| Ok({})")
  expect_block(checks, folder, "{{module Libbed}}", "lib/Libbed.roc, the whole file", "Libbed :: [].{\n\tkept = 1.0\n}")
  expect_block(checks, folder, "{{module web}}", "web.roc, the whole file", "app [main!] {}\n\nmain! = |_args| Ok({})")
  expect_stop(checks, folder, "{{code Twin.x}}", "two modules of that name: " .. top .. "/one/Twin.roc, " .. top .. "/two/Twin.roc")
  expect_stop(checks, folder, "{{module Twin}}", "two modules of that name: " .. top .. "/one/Twin.roc, " .. top .. "/two/Twin.roc")
  remove_tree(folder .. "/gates")
  return nil
end

-- Both sides of the rule that the book names every module.
function check_named_rule(checks, folder)
  local modules = folder .. "/modules"
  mkdir(modules)
  for file in {"Named", "Other", "web", "main", "game", "CatStills", "SafariApp"} do
    replace(modules .. "/" .. file .. ".roc", "")
  end
  if not attempt(check_modules_named, modules, "`Named` beside `Other.go`").ok then fail("self_test: every module named still stopped") end
  push(checks, "every module named, and the exceptions unnamed")
  if not attempt(check_modules_named, modules, "```dot\nNamed -> Other;\n```").ok then fail("self_test: a diagram didn't count as naming") end
  push(checks, "a module named in a diagram")
  local one_missing = attempt(check_modules_named, modules, "`Named` alone")
  if one_missing.ok or one_missing.error ~= "tutorial: the book never names Other" then fail("self_test: a missing module gave " .. json_write(one_missing)) end
  push(checks, "a module the book never names")
  local inside_a_word = attempt(check_modules_named, modules, "`Named` beside Otherwise and NotOther")
  if inside_a_word.ok or inside_a_word.error ~= "tutorial: the book never names Other" then fail("self_test: a name inside a word gave " .. json_write(inside_a_word)) end
  push(checks, "a name only inside a longer word")
  local two_missing = attempt(check_modules_named, modules, "nothing")
  if two_missing.ok or two_missing.error ~= "tutorial: the book never names Named, Other" then fail("self_test: two missing modules gave " .. json_write(two_missing)) end
  push(checks, "two modules the book never names")
  return nil
end

function self_test()
  local top = fresh_dir("scratch:", "safari-tutorial")
  local folder = top .. "/safari"
  mkdir(folder .. "/out")
  replace(folder .. "/Zoo.roc", ZOO)
  replace(folder .. "/Tight.roc", TIGHT)
  replace(folder .. "/Broken.roc", "Broken :: [].{\n\tx = = 1\n")
  mkdir(folder .. "/fails")
  replace(folder .. "/fails/bad.roc", BAD)
  replace(folder .. "/fails/clean.roc", CLEAN)
  replace(folder .. "/fails/warns.roc", WARNS)
  replace(folder .. "/fails/fenced.roc", FENCED_BAD)
  local zoo = folder .. "/Zoo.roc"
  local checks = {}

  expect_block(checks, folder, "{{code Zoo.feed}}", "Zoo.roc", "## How much to feed,\n## over two lines.\nfeed : Cage -> F64\nfeed = |cage| {\n\tamount = cage.size\n\n\tamount * 2.0\n}")
  expect_block(checks, folder, "{{code Zoo.Cage}}", "Zoo.roc", "## A cage.\nCage : {\n\tsize : F64,\n}")
  expect_block(checks, folder, "{{code Zoo.bare}}", "Zoo.roc", "bare = 1.0")
  expect_block(checks, folder, "{{code Zoo.top_function}}", "Zoo.roc", "top_function : F64 -> F64\ntop_function = |x| x")
  expect_block(checks, folder, "{{code Zoo.top_constant}}", "Zoo.roc", "## A constant.\ntop_constant = 2.0")
  expect_block(checks, folder, "{{code Zoo.TopType}}", "Zoo.roc", "## A type.\nTopType : { a : F64 }")

  expect_stop(checks, folder, "{{code Zoo.nope}}", "no such name in " .. zoo)
  expect_stop(checks, folder, "{{code Zoo.amount}}", "no such name in " .. zoo)
  expect_stop(checks, folder, "{{code Zoo.inside_pen}}", "no such name in " .. zoo)
  expect_stop(checks, folder, "{{code Zoo.in_wild}}", "no such name in " .. zoo)
  expect_stop(checks, folder, "{{code Zoo.both}}", "found 2 times in " .. zoo .. ", at lines 25, 45")
  expect_stop(checks, folder, "{{code Gone.feed}}", "no module file " .. folder .. "/Gone.roc")
  expect_stop(checks, folder, "{{module Gone}}", "no module file " .. folder .. "/Gone.roc")
  expect_block(checks, folder, "{{module Tight}}", "Tight.roc, the whole file", trim(TIGHT))
  expect_stop(checks, folder, "{{code Zoo.fenced}}", "its text holds a Markdown fence")
  expect_stop(checks, folder, "{{code Tight.squeezed}}", folder .. "/Tight.roc:1 is not indented as the definition is")

  expect_block(checks, folder, "{{code Zoo.feed from \"amount = cage.size\" to \"amount * 2.0\"}}", "Zoo.roc, in feed", "# ...\namount = cage.size\n\namount * 2.0\n# ...")
  expect_block(checks, folder, "{{code Zoo.feed from \"amount * 2.0\" to \"amount * 2.0\"}}", "Zoo.roc, in feed", "# ...\namount * 2.0\n# ...")
  expect_block(checks, folder, "{{code Zoo.feed from \"feed =\" to \"amount = cage.size\"}}", "Zoo.roc, in feed", "# ...\nfeed = |cage| {\n\tamount = cage.size\n\t# ...")
  expect_block(checks, folder, "{{code Zoo.feed from \"amount * 2.0\" to \"}\"}}", "Zoo.roc, in feed", "\t# ...\n\tamount * 2.0\n}")
  expect_block(checks, folder, "{{code Zoo.feed from \"How much\" to \"feed :\"}}", "Zoo.roc, in feed", "## How much to feed,\n## over two lines.\nfeed : Cage -> F64\n# ...")
  expect_block(checks, folder, "{{code Zoo.feed from \"How much\" to \"}\"}}", "Zoo.roc, in feed", "## How much to feed,\n## over two lines.\nfeed : Cage -> F64\nfeed = |cage| {\n\tamount = cage.size\n\n\tamount * 2.0\n}")
  expect_block(checks, folder, "{{code Zoo.fenced from \"fenced =\" to \"fenced =\"}}", "Zoo.roc, in fenced", "# ...\nfenced = 1.0")

  expect_stop(checks, folder, "{{code Zoo.feed from \"nope\" to \"}\"}}", "\"nope\" is not in the definition")
  expect_stop(checks, folder, "{{code Zoo.feed from \"feed =\" to \"nope\"}}", "\"nope\" is not in the definition")
  expect_stop(checks, folder, "{{code Zoo.feed from \"A cage.\" to \"}\"}}", "\"A cage.\" is not in the definition")
  expect_stop(checks, folder, "{{code Zoo.feed from \"amount\" to \"}\"}}", "\"amount\" found 2 times in " .. zoo .. ", at lines 14, 16")
  expect_stop(checks, folder, "{{code Zoo.feed from \"feed =\" to \"amount\"}}", "\"amount\" found 2 times in " .. zoo .. ", at lines 14, 16")
  expect_stop(checks, folder, "{{code Zoo.feed from \"e\" to \"}\"}}", "\"e\" found 12 times in " .. zoo .. ", at lines 10, 10, 11, 11, 12, 12, 12, 13, 13, 13, 14, 14")
  expect_stop(checks, folder, "{{code Zoo.feed from \"amount * 2.0\" to \"feed =\"}}", "\"feed =\" is above \"amount * 2.0\", at line 13 and line 16")
  expect_stop(checks, folder, "{{code Zoo.fenced from \"A fence\" to \"fenced =\"}}", "its text holds a Markdown fence")
  expect_stop(checks, folder, "{{code Zoo.nope from \"a\" to \"b\"}}", "no such name in " .. zoo)

  expect_failure(checks, folder, "bad", BAD_MESSAGE)
  local root = real(".")
  replace(folder .. "/fails/pathy.roc", "app [main!] {}\n\nmain! = |_args| \"" .. root .. "/Some.roc\" + 1\n")
  local pathy = attempt_include(folder, "{{fails pathy}}")
  if not pathy.ok then fail("self_test: {{fails pathy}} stopped: " .. pathy.error) end
  local message = split(read(folder .. "/out/doc.md"), "```\n\n```text roc check on pathy.roc\n")[2]
  if contains(message, root) or not contains(message, "\"Some.roc\" + 1") then fail("self_test: the checkout's path stayed in [" .. message .. "]") end
  push(checks, "{{fails pathy}}")

  expect_stop(checks, folder, "{{fails clean}}", "roc check finds no error in " .. folder .. "/fails/clean.roc")
  expect_stop(checks, folder, "{{fails warns}}", "roc check finds no error in " .. folder .. "/fails/warns.roc")
  expect_stop(checks, folder, "{{fails gone}}", "no program " .. folder .. "/fails/gone.roc")
  expect_stop(checks, folder, "{{fails fenced}}", "its text holds a Markdown fence")

  local refused = attempt_include(folder, "{{code Broken.x}}")
  if refused.ok or not contains(refused.error, ":3: {{code Broken.x}}: roc-ast refused ") then fail("self_test: Broken.roc gave " .. json_write(refused)) end
  push(checks, "{{code Broken.x}}")

  for bad in {"{{", "{{code}}", "{{code Zoo}}", "{{code Zoo.a.b}}", "{{code zoo.feed}}", "{{cod Zoo.feed}}", "{{ code Zoo.feed }}", " {{code Zoo.feed}}", "{{code Zoo.feed}} ", "see {{code Zoo.feed}}", "{{code Zoo.feed}} and {{code Zoo.bare}}", "{{code Zoo.feed from \"a\"}}", "{{code Zoo.feed to \"a\"}}", "{{code Zoo.feed from \"a\" to \"\"}}", "{{code Zoo.feed from a to b}}", "{{code Zoo.feed from \"a\"b\" to \"c\"}}", "{{fails}}", "{{fails Bad}}", "{{fails a b}}", "{{fails a.b}}", "{{fails ../bad}}", "{{fails bad }}", "🌳 {{code Zoo.feed}}"} do
    expect_stop(checks, folder, bad, NOT_AN_INCLUDE)
  end
  for prose in {"plain", "{ {code Zoo.feed}}", "{code Zoo.feed}", "}}"} do
    expect_prose(checks, folder, prose)
  end

  check_title_rule(checks, folder)
  check_note_rule(checks, folder)
  check_named_rule(checks, folder)
  check_proof_rule(checks, folder)
  check_annotation_rules(checks, folder)
  check_reach_rule(checks, top, folder)

  local no_file = attempt(pinned_roc, "tutorial", folder .. "/no-pin")
  if no_file.ok or no_file.error ~= "tutorial: no " .. folder .. "/no-pin: run from the roc-apps root" then fail("self_test: no pin file gave " .. json_write(no_file)) end
  push(checks, "no pin file")
  replace(folder .. "/pin", "nightly-none\n")
  local no_roc = attempt(pinned_roc, "tutorial", folder .. "/pin")
  if no_roc.ok or not starts_with(no_roc.error, "tutorial: no tools:roc-nightly-none/roc: ") then fail("self_test: no compiler gave " .. json_write(no_roc)) end
  push(checks, "no compiler")
  if not attempt(check_roc_version, "tutorial", "r", "p", "Roc compiler version p\n").ok then fail("self_test: the pin was refused") end
  local wrong = attempt(check_roc_version, "tutorial", "r", "p", "Roc compiler version q\n")
  if wrong.ok or wrong.error ~= "tutorial: r is Roc compiler version q, not p" then fail("self_test: the wrong compiler gave " .. json_write(wrong)) end
  push(checks, "the pinned version, and another")

  remove_tree(top)
  print("tutorial self_test: PASS, " .. #checks .. " checks")
end

if arg("self_test", "") == "1" then
  self_test()
else
  local expanded = build(SOURCE, OUTPUT, SAFARI)
  print("tutorial: " .. expanded .. " includes expanded into " .. OUTPUT)
  -- The book is parked until its chapters are rewritten, so the rule that it
  -- names every module is reported, loudly, but doesn't stop the build.
  local named = attempt(check_modules_named, SAFARI, read(SOURCE))
  if named.ok then
    print("tutorial: the book names every module")
  else
    print(named.error .. ": SKIPPED while the book is parked")
  end
end
