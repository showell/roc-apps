-- budget: steps=100000000 arena_bytes=1000000000 read_bytes=200000000 output_bytes=200000 call_bytes=20000000
-- This builds the Safari Ride book into the dev channel, one page a chapter.
--
--   cd <roc-apps checkout> && nice -n 19 shale canvas_apps/safari/tutorial/book.shale
--
-- It runs on demand and at publish, and never in the fast tier. It expands
-- tutorial.md with build.shale, splits the result at each chapter heading, and
-- draws each ```dot fence with Graphviz, in child runs of this script with
-- `diagrams=1`. A diagram's title is the line above its
-- fence, which goes with the drawing to be set as its caption. A diagram wider
-- than a phone is drawn a second way for a phone, turned and tightened, and
-- book.css shows one of the two. make_book.roc then renders every page in one
-- run, and its fence hook stops the build on a widget with no folder.
-- A chapter's `##` headings become `#`, so a page has one top heading and its
-- sections are level two.
--
-- The book frames each widget's page, so those pages must be release builds. A
-- page is rebuilt unless it carries the stamp of the last commit that touched
-- its inputs, and any other build of it removes the stamp, as build.sh replaces
-- the whole folder.
--
-- The pages are staged beside their widgets and book_check.mjs drives them in a
-- real browser, so the channel's book is replaced only by one that passed. The
-- check leaves a full-page shot of each page in build/book/shots/. Before that,
-- color_roc.shale colors the pages' Roc code, and says how many blocks it left
-- plain.
--
-- `stage=tutorial.mine` builds the book into that folder of the channel and
-- checks it there, for a look at a draft or a change to the book's own tools. It
-- leaves the channel's book and the widgets' builds alone, and it leaves the
-- folder for whoever asked to read and then remove. `looks=1` beside it skips
-- driving the widgets, so a pass over the pages' looks takes a couple of minutes.
const TUTORIAL = "canvas_apps/safari/tutorial"
const WORK = "canvas_apps/safari/tutorial/build/book"
const EXPANDED = "canvas_apps/safari/tutorial/build/tutorial.md"
const NEXT = "build:roc-apps/next"
const STAGE = arg("stage", "")
const LOOKS = arg("looks", "") == "1"
-- `chapters=N` keeps only the first N chapters, for a book that holds just the
-- chapters that have passed the loop in MISSION.md.
const CHAPTERS_ARG = arg("chapters", "")
const CHAPTERS = CHAPTERS_ARG ~= "" and tonumber(CHAPTERS_ARG) or nil
-- A Shale run holds 64 programs, so the widgets' release builds run as a run of
-- their own, and the diagrams are drawn in runs of their own, DIAGRAMS_PER_RUN
-- at a time, as each takes Graphviz once or twice.
const WIDGETS_ONLY = arg("widgets", "") == "1"
const DIAGRAMS_ONLY = arg("diagrams", "") == "1"
const DIAGRAMS_PER_RUN = 30
const STAGED_NAME = STAGE == "" and "tutorial.staging" or STAGE
const STAGING = "build:roc-apps/next/" .. STAGED_NAME
const DEST = "build:roc-apps/next/tutorial"
const CHANNEL_URL = "http://127.0.0.1:9210/" .. STAGED_NAME .. "/"
const CACHE = "build:roc-apps/book-cache"
const STAMP = "BOOK_INPUTS"
const PAGE_MARK = "<!-- book page: "
const COLOR = "canvas_apps/safari/tutorial/color_roc.shale"
const ROC_WANT = "roc-pin: roc-apps' pinned nightly, for the book's page step"
const DOT_WANT = "graphviz: the tutorial's diagrams, drawn at build time"
const PAGE_WANT = "script: canvas_apps/build.sh builds and checks a page, and refuses another Roc"
const CHECK_WANT = "script: book_check.mjs drives the staged pages in headless Chromium"
const PHONE_POINTS = 300
const MOVE_WANT = "move: the staged book takes the channel's place in one rename"
const INPUTS = {"canvas_apps", ":(exclude)canvas_apps/safari/tutorial", ":(exclude)canvas_apps/safari/gates", ":(exclude,glob)**/*.md", "roc-version", "pinned-roc.sh", ".shale/prelude.shale"}

function must(r, what)
  if r.ended ~= "exit" or get(r, "code", -1) ~= 0 then
    print(trim(r.out))
    fail("book: " .. what .. " failed")
  end
  return r
end

function remove_if_there(path)
  if exists(path) then remove_tree(path) end
  return nil
end

-- The drawing of one diagram, ready to sit in a page, and how wide it is in
-- points. Graphviz's comments and titles are dropped, because a title shows as a
-- tooltip on hover.
function drawing(path, options, class)
  local argv = {"dot", "-Tsvg", "-Gfontsize=12", "-Nfontsize=12", "-Efontsize=11", "-Nmargin=0.13,0.06"}
  for option in options do push(argv, option) end
  push(argv, real(path))
  local r = must(run(argv, {timeout_ms = 30000, whole = 2000000, want = DOT_WANT}), "dot on " .. path .. " (Graphviz)")
  local at = find(r.out, "<svg ")
  if at == nil or not starts_with(r.out, "<?xml") then fail("book: dot said more than a drawing for " .. path .. ": " .. r.out) end
  local kept = {}
  for l in lines(sub(r.out, at + 5)) do
    if not starts_with(l, "<!--") and not starts_with(l, "<title>") then push(kept, l) end
  end
  local width = re_find(r.out, "<svg width=\"([0-9]+)pt\"")
  if width == nil then fail("book: no width in the drawing of " .. path) end
  return {svg = "<svg class=\"" .. class .. "\" role=\"img\" " .. join(kept, "\n"), width = tonumber(width.groups[1])}
end

-- A line of a diagram with the list in its label down the page, a name a line.
function label_list_down(l)
  local open = find(l, "label=\"")
  if open == nil then return l end
  local close = find(l, "\"", open + 7)
  if close == nil then return l end
  local label = join(split(sub(l, open + 7, close - 1), ", "), ",\\n")
  return sub(l, 1, open + 6) .. label .. sub(l, close)
end

-- A diagram's source for a phone: a row of boxes runs down the page instead, and
-- a label's list does too. A record's fields are side by side, so a record
-- diagram turns the other way, for `phone_options` to say.
function phone_source(source)
  local kept = {}
  for l in source do
    if trim(l) ~= "rankdir=LR;" then push(kept, label_list_down(l)) end
  end
  return join(kept, "\n") .. "\n"
end

function phone_options(source)
  local options = {"-Gnodesep=0.12", "-Granksep=0.3", "-Nmargin=0.06,0.04"}
  if contains(join(source, "\n"), "shape=record") then push(options, "-Grankdir=LR") end
  return options
end

-- A diagram's drawing, and a phone's beside it if it needs one. The source is
-- the fence's lines, which `manuscript` writes to the diagram's .dot file.
function diagram_svg(id, source)
  local path = WORK .. "/" .. id .. ".dot"
  local plain = drawing(path, {}, "diagram")
  if plain.width <= PHONE_POINTS then return plain.svg end
  local phone_path = WORK .. "/" .. id .. "-phone.dot"
  replace(phone_path, phone_source(source))
  local wide = join(split(plain.svg, "<svg class=\"diagram\""), "<svg class=\"diagram diagram-wide\"")
  return wide .. drawing(phone_path, phone_options(source), "diagram diagram-phone").svg
end

-- The lines of a diagram's .dot file, which ends with the one newline that
-- `manuscript` adds after the fence's last line.
function dot_lines(id)
  local all = split(read(WORK .. "/" .. id .. ".dot"), "\n")
  return take(all, #all - 1)
end

function diagram_id(n)
  return "diagram-" .. n
end

-- The child run's work: draw diagrams `first` to `last` into their .svg files.
function draw_diagrams(first, last)
  for n = first, last do
    local id = diagram_id(n)
    replace(WORK .. "/" .. id .. ".svg", diagram_svg(id, dot_lines(id)))
  end
  return nil
end

-- Each diagram takes Graphviz once or twice, so the drawing runs in child runs
-- of DIAGRAMS_PER_RUN diagrams each, and the book holds any number of them.
-- A child that fails stops the build, and so does a drawing it didn't leave.
function draw_all(diagrams)
  local count = #diagrams
  local first = 1
  while first <= count do
    local last = first + DIAGRAMS_PER_RUN - 1
    if last > count then last = count end
    local argv = {"shale", "--root", ".", TUTORIAL .. "/book.shale", "diagrams=1", "first=" .. first, "last=" .. last}
    must(run(argv, {timeout_ms = 600000, tail = 20, want = DOT_WANT}), "drawing diagrams " .. first .. " to " .. last)
    first = last + 1
  end
  local drawn = {}
  for diagram in diagrams do
    local svg = WORK .. "/" .. diagram.id .. ".svg"
    if not exists(svg) then fail("book: no drawing of " .. diagram.id .. " at " .. svg) end
    push(drawn, {id = diagram.id, title = diagram.title, svg = read(svg)})
  end
  return drawn
end

-- The pages of the expanded tutorial and its diagrams. Each ```dot fence gets
-- an id as its argument, for the Roc hook to find its drawing by, and takes the
-- title line above it along. This reads fences by line, as build.shale writes
-- them, and make_book.roc's checks stop the build if that ever disagrees with
-- the renderer.
function manuscript(text)
  local pages = {}
  local diagrams = {}
  local page = {}
  local in_fence = false
  local dot = nil
  local title = ""
  for l in split(text, "\n") do
    if in_fence then
      if l == "```" then
        in_fence = false
        if dot ~= nil then
          local id = diagram_id(#diagrams + 1)
          replace(WORK .. "/" .. id .. ".dot", join(dot, "\n") .. "\n")
          push(diagrams, {id = id, title = title})
          dot = nil
        end
      elseif dot ~= nil then
        push(dot, l)
      end
      push(page, l)
    elseif l == "```dot" then
      in_fence = true
      dot = {}
      title = page[#page]
      page = take(page, #page - 1)
      push(page, "```dot " .. diagram_id(#diagrams + 1))
    elseif starts_with(l, "```") then
      in_fence = true
      push(page, l)
    elseif starts_with(l, "## ") then
      push(pages, join(page, "\n"))
      page = {sub(l, 2)}
    elseif starts_with(l, "### ") then
      push(page, sub(l, 2))
    else
      push(page, l)
    end
  end
  if in_fence then fail("book: a fence never closes in " .. EXPANDED) end
  push(pages, join(page, "\n"))
  return {pages = pages, diagrams = draw_all(diagrams)}
end

-- The expanded tutorial cut after its first CHAPTERS chapters, or all of it
-- when CHAPTERS is unset. It finds `## ` headings by line outside fences, as
-- manuscript does, since a Roc doc comment starts the same way.
function first_chapters(text)
  if CHAPTERS == nil then return text end
  local kept = {}
  local seen = 0
  local in_fence = false
  for l in split(text, "\n") do
    if starts_with(l, "```") then
      in_fence = not in_fence
    elseif not in_fence and starts_with(l, "## ") then
      seen = seen + 1
    end
    if seen > CHAPTERS then return join(kept, "\n") .. "\n" end
    push(kept, l)
  end
  return text
end

function widget_folders()
  local folders = {"safari"}
  for page in glob("canvas_apps/*_widget/page.html") do push(folders, basename(dirname(page))) end
  return folders
end

function make_book_argv(tool, book, folders)
  local argv = {tool}
  for page in book.pages do
    push(argv, "page")
    push(argv, page)
  end
  for diagram in book.diagrams do
    push(argv, "diagram")
    push(argv, diagram.id)
    push(argv, diagram.title)
    push(argv, diagram.svg)
  end
  for folder in folders do
    push(argv, "widget")
    push(argv, folder)
  end
  if CHAPTERS ~= nil then push(argv, "first_chapters") end
  return argv
end

-- What this build holds, for site/publish.sh to require of a book and fold into
-- its PROVENANCE.
function built_record()
  if CHAPTERS == nil then return "book: every chapter\n" end
  return "book: the first " .. CHAPTERS .. " chapters\n"
end

function write_pages(output)
  remove_if_there(STAGING)
  mkdir(STAGING)
  local files = {}
  local pieces = split(output, PAGE_MARK)
  if trim(pieces[1]) ~= "" then fail("book: make_book said something before its first page: " .. pieces[1]) end
  for piece in drop(pieces, 1) do
    local close = find(piece, " -->\n")
    local file = sub(piece, 1, close - 1)
    local html = sub(piece, close + 5)
    replace(STAGING .. "/" .. file, html)
    push(files, file)
  end
  replace(STAGING .. "/book.css", read(TUTORIAL .. "/book.css"))
  replace(STAGING .. "/embed.js", read("canvas_apps/widget_kit/embed.js"))
  replace(STAGING .. "/BUILT", built_record())
  return files
end

function page_sizes(files)
  local sizes = {}
  for file in files do push(sizes, file .. " " .. (#read(STAGING .. "/" .. file) // 1024) .. " KB") end
  return sizes
end

-- The commit that last touched what a widget's page is built from, or nil when
-- the checkout has changes there, and only a fresh build can be trusted.
function inputs_commit()
  local status = {"git", "status", "--porcelain", "--"}
  local log = {"git", "log", "-1", "--format=%H", "--"}
  for path in INPUTS do
    push(status, path)
    push(log, path)
  end
  if trim(run(status, {timeout_ms = 30000, whole = 100000}).out) ~= "" then return nil end
  return trim(run(log, {timeout_ms = 30000, whole = 1000}).out)
end

function is_release_of(folder, inputs)
  local stamp = NEXT .. "/" .. folder .. "/" .. STAMP
  return inputs ~= nil and exists(stamp) and trim(read(stamp)) == inputs
end

function release_argv(folder)
  if folder == "safari" then return {"nice", "-n", "19", "shale", "--root", ".", "canvas_apps/safari/gates/run.shale", "part=page", "release=1"} end
  return {"nice", "-n", "19", "bash", "canvas_apps/build.sh", folder, "release"}
end

function build_release(folder, inputs)
  must(run(release_argv(folder), {timeout_ms = 900000, tail = 20, want = PAGE_WANT}), folder .. "'s release build")
  if not contains(read(NEXT .. "/" .. folder .. "/BUILT"), "opt speed") then fail("book: " .. folder .. " isn't a release build") end
  if inputs ~= nil then replace(NEXT .. "/" .. folder .. "/" .. STAMP, inputs .. "\n") end
  print("book: built " .. folder .. " for release")
  return nil
end

function build_widgets(folders)
  local inputs = inputs_commit()
  for folder in folders do
    if not is_release_of(folder, inputs) then build_release(folder, inputs) end
  end
  return nil
end

function move_into_place()
  local old = real(NEXT) .. "/tutorial.old"
  local dest = real(NEXT) .. "/tutorial"
  remove_if_there(NEXT .. "/tutorial.old")
  if exists(DEST) then must(run({"mv", dest, old}, {timeout_ms = 10000, whole = 1000, want = MOVE_WANT}), "moving the old book") end
  must(run({"mv", real(STAGING), dest}, {timeout_ms = 10000, whole = 1000, want = MOVE_WANT}), "moving the new book")
  remove_if_there(NEXT .. "/tutorial.old")
  return nil
end

function main()
  local roc = pinned_roc("book")
  mkdir(CACHE)
  local env = {XDG_CACHE_HOME = real(CACHE)}
  print(trim(must(run({"shale", "--root", ".", TUTORIAL .. "/build.shale"}, {timeout_ms = 120000, tail = 20, env = env}), "build.shale").out))

  remove_if_there(WORK)
  mkdir(WORK)
  must(run({"nice", "-n", "19", roc, "test", "make_book.roc"}, {cwd = TUTORIAL, timeout_ms = 120000, tail = 40, env = env, want = ROC_WANT}), "roc test make_book.roc")
  local tool = real(WORK) .. "/make_book"
  local built = run({"nice", "-n", "19", roc, "build", "--opt=dev", "make_book.roc", "--output=" .. tool}, {cwd = TUTORIAL, timeout_ms = 120000, re = "✗|●", head = 40, env = env, want = ROC_WANT})
  if built.matched_lines > 0 or not exists(WORK .. "/make_book") then
    print(trim(built.out))
    fail("book: make_book.roc didn't build")
  end

  local book = manuscript(first_chapters(read(EXPANDED)))
  local folders = widget_folders()
  local rendered = must(run(make_book_argv(tool, book, folders), {timeout_ms = 60000, whole = 20000000, want = ROC_WANT}), "make_book")
  local files = write_pages(rendered.out)
  must(run({"shale", "--root", ".", COLOR, "self_test=1"}, {timeout_ms = 30000, tail = 20}), "color_roc's self test")
  local extent = CHAPTERS == nil and "whole_book" or "first_chapters"
  print(trim(must(run({"shale", "--root", ".", COLOR, "pages=" .. STAGING, "order=" .. join(files, " "), "extent=" .. extent}, {timeout_ms = 30000, tail = 300}), "color_roc").out))
  local sizes = page_sizes(files)

  if STAGE == "" then
    print(trim(must(run({"shale", "--root", ".", TUTORIAL .. "/book.shale", "widgets=1"}, {timeout_ms = 1800000, tail = 20, want = PAGE_WANT}), "the widgets' release builds").out))
  end
  local check = {"nice", "-n", "19", "node", TUTORIAL .. "/book_check.mjs", CHANNEL_URL, real(WORK) .. "/shots"}
  if LOOKS then push(check, "looks") end
  print(trim(must(run(check, {timeout_ms = 600000, tail = 60, want = CHECK_WANT}), "book_check").out))
  if STAGE == "" then move_into_place() end

  for line in sizes do print(line) end
  print("book: " .. #book.pages .. " pages and " .. #book.diagrams .. " diagrams at http://143.244.172.148:9210/" .. (STAGE == "" and "tutorial" or STAGE) .. "/")
  return nil
end

if WIDGETS_ONLY then
  build_widgets(widget_folders())
elseif DIAGRAMS_ONLY then
  draw_diagrams(tonumber(arg("first", "")), tonumber(arg("last", "")))
else
  main()
end
