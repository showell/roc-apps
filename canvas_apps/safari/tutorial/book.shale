-- budget: steps=50000000 arena_bytes=1000000000 read_bytes=200000000 output_bytes=200000 call_bytes=40000000
-- This builds the Safari Ride book with the book builder (book_builder/), into
-- the dev channel's /tutorial/:
--
--   cd <roc-apps checkout> && nice -n 19 shale canvas_apps/safari/tutorial/book.shale
--
-- It runs on demand and at publish (gates/publish.shale), and never in the
-- fast tier. The book is the app app/main.roc on the book platform, which reads
-- the tutorial's folder and prints every page. What needs a program is this
-- script's pre-step, whose results go in build/prepared/, where the app reads
-- them:
--
--   line-N.md      each include of the source's line N that quotes the game's
--                  code through Roc's parser, or runs `roc check` on a failing
--                  program, or reads the proof file: build.shale's `prepare=1`
--   diagram-N.dot  the Nth ```dot fence's source, and diagram-N.svg, its
--   diagram-N.svg  drawing by Graphviz, which draw_diagrams.shale makes
--   widgets.txt    the folders beside the game that hold a widget's page
--   chapters.txt   which chapters the book holds, the line BUILT gets too
--   blocks.txt     which lines of which file each quoted Roc block shows, and
--   sources/       a copy of each such file, for the app's coloring
--
-- Then `roc test` runs the app's expects, the app/ folder's held to exactly
-- APP_TESTS and to its top-level `expect` lines, each passed once; the
-- packages' own are their gates' to hold. Then `zig build` builds the app
-- into book_builder/zig-out/safari, on Roc's dev backend, and the program
-- writes the pages, which go to build/book/ with the book's stylesheet and
-- scripts, and from there to the channel. The Roc code is colored by
-- syntax_color/, each quoted block as it reads in its file (app/QuotedColor.roc).
--
-- The channel's book is replaced only by one that passed. The pages are staged
-- in the channel's /tutorial.staging/, beside the widgets they frame. Then
-- build_widgets.shale makes safari's page and each widget's a release build,
-- unless its stamp says it already is. Then book_check.mjs drives the staged
-- pages in a real browser and leaves a shot of each page in build/shots/ (the
-- pre-publish tier). Then move_stage.shale puts the stage in the place of
-- /tutorial/. A failure at any step stops the run before the move, so the
-- channel's /tutorial/ is left as it was, and the stage is left for a look.
-- Each step's time is printed as it ends.
--
-- `stage=NAME` is the inner loop: the book is built into the channel's folder
-- NAME and book_check.mjs drives it there with no shots, and the widgets'
-- builds and the move are left out. `check=0` beside it skips the browser
-- check too, for a look at the pages alone.
--
-- `chapters=N` builds the first N numbered chapters, as gates/publish.shale
-- does for the chapters that have passed the loop in MISSION.md: the front
-- page, those chapters and all the back matter (the appendices, the index
-- among them, and the credits), and the contents and the lists of chapters
-- hold only those. The builder's `chapters` setting makes the cut
-- (book_builder/builder/Builder.roc, `Extent`): the pre-step, the diagrams and
-- the builder's gates still read the whole manuscript, and the index is built
-- from every chapter, so a reference to a chapter left out is its title or
-- number as plain text.
const TUTORIAL = "canvas_apps/safari/tutorial"
const SOURCE = "canvas_apps/safari/tutorial/tutorial.md"
const PREPARED = "canvas_apps/safari/tutorial/build/prepared"
const OUT = "canvas_apps/safari/tutorial/build/book"
const BUILDER = "book_builder"
const PROGRAM = "book_builder/zig-out/safari/bin/book"
const NEXT = "build:roc-apps/next"
const DEST_NAME = "tutorial"
const STAGE = arg("stage", "")
const CHECK = arg("check", "1") ~= "0"
const STAGED_NAME = STAGE == "" and DEST_NAME .. ".staging" or STAGE
const STAGING = NEXT .. "/" .. STAGED_NAME
const SHOTS = "canvas_apps/safari/tutorial/build/shots"
const DRAW = "canvas_apps/safari/tutorial/draw_diagrams.shale"
const WIDGETS = "canvas_apps/safari/tutorial/build_widgets.shale"
const MOVE = "canvas_apps/safari/tutorial/move_stage.shale"
const CHECK_WANT = "script: book_check.mjs drives the staged pages in headless Chromium"
const CACHE = "build:roc-apps/book-cache"
const PAGE_MARK = "<!-- book page: "
const REPORT_MARK = "<!-- book report -->"
const DOT_WANT = "graphviz: the tutorial's diagrams, drawn at build time"
const BOOK_WANT = "book: the book program book.shale just built, untracked by design"
const APP_TESTS = 55
const CHAPTERS_ARG = arg("chapters", "")
const CHAPTERS = CHAPTERS_ARG ~= "" and tonumber(CHAPTERS_ARG) or nil
-- A stage is a folder of its own: never the published book, the name the move
-- sets the old book aside as, or a path.
if STAGE == DEST_NAME or STAGE == DEST_NAME .. ".replaced" or contains(STAGE, "/") then fail("book: stage=" .. STAGE .. " names the published book's folder or a path, and a stage is a folder of its own") end
if not CHECK and STAGE == "" then fail("book: check=0 builds only a stage=, never the channel's book") end

-- What this build holds, for site/publish.sh to require of a book and fold
-- into its PROVENANCE; the app reads the same line from chapters.txt.
function built_record()
  if CHAPTERS == nil then return "book: every chapter\n" end
  return "book: the first " .. CHAPTERS .. " chapters\n"
end

-- Each ```dot fence's source, written to its diagram-N.dot, as app/Diagrams.roc
-- finds the fences; gives how many there are.
function write_diagram_sources(text)
  local count = 0
  local open = "none"
  local body = {}
  for l in split(text, "\n") do
    if open == "none" then
      if l == "```dot" then
        open = "dot"
        body = {}
      elseif starts_with(l, "```") then
        open = "other"
      end
    elseif l == "```" then
      if open == "dot" then
        count = count + 1
        replace(PREPARED .. "/diagram-" .. count .. ".dot", join(body, "\n") .. "\n")
      end
      open = "none"
    elseif open == "dot" then
      push(body, l)
    end
  end
  if open ~= "none" then fail("book: a fence never closes in " .. SOURCE) end
  return count
end

function widget_folders()
  local folders = {"safari"}
  for page in glob("canvas_apps/*_widget/page.html") do push(folders, basename(dirname(page))) end
  return folders
end

-- The program's pages, written to OUT with the book's own files, and the
-- report after them. The builder ends each page with a newline before the
-- next page's mark, which is its separator and no part of the page.
function write_pages(output)
  if exists(OUT) then remove_tree(OUT) end
  mkdir(OUT)
  local halves = split(output, REPORT_MARK .. "\n")
  if #halves ~= 2 then fail("book: the program's output has no report, or two") end
  local pieces = split(halves[1], PAGE_MARK)
  if pieces[1] ~= "" then fail("book: the program said something before its first page: " .. pieces[1]) end
  local files = {}
  for piece in drop(pieces, 1) do
    local close = find(piece, " -->\n")
    local file = sub(piece, 1, close - 1)
    local html = sub(piece, close + 5)
    if not ends_with(html, "\n") then fail("book: " .. file .. " doesn't end with the builder's newline") end
    replace(OUT .. "/" .. file, sub(html, 1, #html - 1))
    push(files, file)
  end
  copy(TUTORIAL .. "/book.css", OUT .. "/book.css")
  copy(TUTORIAL .. "/book.js", OUT .. "/book.js")
  copy("canvas_apps/widget_kit/embed.js", OUT .. "/embed.js")
  replace(OUT .. "/BUILT", built_record())
  return {files = files, report = halves[2]}
end

-- The app's expects run, and the app/ folder's held to APP_TESTS and to the
-- top-level `expect` lines its files hold, each passed once.
function test_app(env)
  local r = run({pinned_roc("book"), "test", "--verbose", "app/main.roc"}, {cwd = TUTORIAL, timeout_ms = 120000, whole = 2000000, env = env})
  local written = {}
  for path in glob(TUTORIAL .. "/app/*.roc") do
    local n = 0
    for l in lines(read(path)) do
      n = n + 1
      if starts_with(l, "expect") then written["app/" .. basename(path) .. ":" .. n] = true end
    end
  end
  local wrong = {}
  local passed = {}
  for l in lines(r.out) do
    if starts_with(l, "PASS: app/") then
      local at = trim(sub(l, 7))
      if has_key(passed, at) then push(wrong, "passed twice: " .. at) end
      if not has_key(written, at) then push(wrong, "passed, and no top-level expect line is there: " .. at) end
      passed[at] = true
    end
  end
  for at in keys(written) do
    if not has_key(passed, at) then push(wrong, "an expect line that never passed: " .. at) end
  end
  if r.code ~= 0 or #wrong > 0 or #keys(passed) ~= APP_TESTS then
    print(trim(sub(r.out, #r.out - 3000)))
    for w in wrong do print("  " .. w) end
    fail("book: roc test app/main.roc: " .. #keys(passed) .. " of app/'s passed, " .. APP_TESTS .. " expected, exit " .. r.code)
  end
  print("book: roc test app/main.roc, " .. APP_TESTS .. " of app/'s passed, as expected, in " .. r.ms .. " ms")
  return nil
end

-- book_check.mjs on the staged pages: with a shot of each page before a move,
-- the pre-publish tier, and with none for a stage=, the inner loop.
function check_stage()
  local shots = "none"
  if STAGE == "" then
    if exists(SHOTS) then remove_tree(SHOTS) end
    mkdir(SHOTS)
    shots = real(SHOTS)
  end
  local argv = {"nice", "-n", "19", "node", TUTORIAL .. "/book_check.mjs", "http://127.0.0.1:9210/" .. STAGED_NAME .. "/", shots}
  local r = run(argv, {timeout_ms = 900000, tail = 60, want = CHECK_WANT})
  if r.ended ~= "exit" or r.code ~= 0 then
    print(trim(r.out))
    fail("book: book_check failed on " .. STAGING .. ", so " .. DEST_NAME .. " is left as it was")
  end
  for l in lines(r.out) do
    if starts_with(l, "book_check: ") then print(l) end
  end
  print("book: book_check, " .. (shots == "none" and "no shots" or "shots in " .. SHOTS) .. ", took " .. r.ms .. " ms")
  return nil
end

function main()
  mkdir(CACHE)
  local env = {XDG_CACHE_HOME = real(CACHE)}
  if exists(PREPARED) then remove_tree(PREPARED) end
  mkdir(PREPARED)
  local prepared = must(run({"shale", "--root", ".", TUTORIAL .. "/build.shale", "prepare=1"}, {timeout_ms = 300000, tail = 20, env = env}))
  print(trim(prepared.out))
  print("book: the pre-step's includes took " .. prepared.ms .. " ms")
  replace(PREPARED .. "/widgets.txt", join(widget_folders(), "\n") .. "\n")
  replace(PREPARED .. "/chapters.txt", built_record())
  local count = write_diagram_sources(read(SOURCE))
  local drawn = must(run({"shale", "--root", ".", DRAW, "count=" .. count}, {timeout_ms = 600000, tail = 20, want = DOT_WANT}))
  print("book: " .. count .. " diagrams drawn in " .. drawn.ms .. " ms")

  test_app(env)
  if exists(PROGRAM) then remove(PROGRAM) end
  local built = run({"zig", "build", "-Dapp=../" .. TUTORIAL .. "/app/main.roc", "-p", "zig-out/safari"}, {cwd = BUILDER, timeout_ms = 600000, tail = 40, env = env})
  if built.code ~= 0 or #find_all(built.out, "── ✗") + #find_all(built.out, "── ●") > 0 or not exists(PROGRAM) then
    print(built.out)
    fail("book: the book's program didn't build cleanly")
  end
  print("book: the program built in " .. built.ms .. " ms")

  local r = run({real(PROGRAM), TUTORIAL}, {timeout_ms = 120000, whole = 40000000, want = BOOK_WANT})
  if r.code ~= 0 then
    print(r.out)
    fail("book: the book's program stopped, exit " .. r.code)
  end
  print("book: the program ran in " .. r.ms .. " ms")
  local written = write_pages(r.out)
  if exists(STAGING) then remove_tree(STAGING) end
  copy(OUT, STAGING)
  print("book: staged at " .. STAGING)

  if STAGE == "" then
    local widgets = must(run({"shale", "--root", ".", WIDGETS}, {timeout_ms = 3600000, tail = 30}))
    print(trim(widgets.out))
    print("book: the widgets' release builds took " .. widgets.ms .. " ms")
  end
  if CHECK then check_stage() end
  if STAGE == "" then
    local moved = must(run({"shale", "--root", ".", MOVE, "stage=" .. STAGED_NAME, "place=" .. DEST_NAME}, {timeout_ms = 60000, tail = 20}))
    print("book: the move into place took " .. moved.ms .. " ms")
  end

  local words = 0
  for l in lines(written.report) do
    local m = re_find(l, ": ([0-9]+) words of prose$")
    if m ~= nil then words = words + tonumber(m.groups[1]) end
  end
  local place = STAGE == "" and DEST_NAME or STAGED_NAME
  print("book: " .. #written.files .. " pages, " .. words .. " words of prose, " .. trim(sub(built_record(), 7)) .. ", at http://localhost:9210/" .. place .. "/")
  return nil
end

main()
