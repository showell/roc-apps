-- budget: steps=200000000 reads=10 read_bytes=20000000 output_bytes=200000
-- This script counts what the Safari book is made of, chapter by chapter: the
-- lines of Roc code it quotes, the words of its prose, and its diagrams,
-- widgets and images. It reads the built book, so run the tutorial gate
-- first, which writes it with every include expanded:
--
--   cd <roc-apps checkout> && shale canvas_apps/safari/gates/run.shale part=tutorial
--   shale canvas_apps/safari/tutorial/book_stats.shale
--
-- The output is a markdown table, one row per chapter, then a row for the
-- chapters together, one for the appendices together, and one for the whole
-- book.
--
-- What counts as what:
--   code      every line inside a ```roc fence, blank lines left out;
--   prose     the words outside every fence: headings, paragraphs, lists,
--             captions and table cells. A word is a run of characters with a
--             letter or a digit in it, so a lone `|` or `-` is no word;
--   diagram   a ```dot fence;
--   image     a picture the Roc code draws and the reader only looks at: a
--             ```widget fence whose widget tutorial/book_check.mjs marks
--             FIXED_PICTURE, or a markdown image, `![…](…)`, or an `<img`;
--   widget    a ```widget fence the reader works, with the VCR controls or
--             by clicking: every widget book_check.mjs gives a place to click,
--             and `ride`, the ride itself, which runs and takes the keys.
--
-- book_check.mjs is the one home for which widget is which, so a widget the
-- book uses and its table leaves out stops the run.
--
-- Other fences, such as ```text for a compiler's message, count toward none of
-- these. A chapter is a `## ` heading outside a fence. A heading that starts
-- `Appendix` or is `Credits` is an appendix.
--
-- A chapter holds at most MAX_PROSE_WORDS words of prose (Steve, 2026-11-13:
-- the book stays short, and a long chapter gets edited down to its key
-- concepts). The last line names the longest chapter, and the run fails when
-- any chapter is over the limit, naming each one. The tutorial gate runs this
-- after it builds the book.

const BOOK = arg("book", "canvas_apps/safari/tutorial/build/tutorial.md")
const BOOK_CHECK = "canvas_apps/safari/tutorial/book_check.mjs"
const MAX_PROSE_WORDS = 900

-- From book_check.mjs's CLICKED_AT table, each widget's name mapped to true
-- for a fixed picture and false for one the reader works.
function widget_kinds()
  local kinds = {}
  for l in split(read(BOOK_CHECK), "\n") do
    local m = re_find(l, "^  \"\\.\\./([a-z_]+)_widget/\": (.*)$")
    if m ~= nil then kinds[m.groups[1]] = starts_with(m.groups[2], "FIXED_PICTURE") end
  end
  if #keys(kinds) == 0 then fail("book_stats: no widgets in " .. BOOK_CHECK .. "'s CLICKED_AT table") end
  return kinds
end
const WIDGET_KINDS = widget_kinds()

-- The number of words in one line of prose.
function word_count(l)
  local n = 0
  for w in split(l, " ") do
    if re_find(w, "[A-Za-z0-9]") ~= nil then n = n + 1 end
  end
  return n
end

-- The book's chapters in order, each `{title, code, prose, diagrams,
-- widgets, images}`.
function chapters_of(text)
  local found = {}
  local now = {title = "(before the first chapter)", code = 0, prose = 0, diagrams = 0, widgets = 0, images = 0}
  local fence = ""
  for l in split(text, "\n") do
    if starts_with(l, "```") then
      if fence == "" then
        local tag = trim(sub(l, 4))
        fence = tag == "" and "bare" or split(tag, " ")[1]
        if fence == "dot" then now.diagrams = now.diagrams + 1 end
        if fence == "widget" then
          local name = split(tag, " ")[2]
          if name == "ride" then
            now.widgets = now.widgets + 1
          elseif not has_key(WIDGET_KINDS, name) then fail("book_stats: the widget `" .. name .. "` in " .. now.title .. " is missing from " .. BOOK_CHECK .. "'s CLICKED_AT table")
          elseif WIDGET_KINDS[name] then
            now.images = now.images + 1
          else
            now.widgets = now.widgets + 1
          end
        end
      else
        fence = ""
      end
    elseif fence == "roc" then
      if trim(l) ~= "" then now.code = now.code + 1 end
    elseif fence == "" then
      if starts_with(l, "## ") then
        push(found, now)
        now = {title = trim(sub(l, 4)), code = 0, prose = 0, diagrams = 0, widgets = 0, images = 0}
      end
      if re_find(l, "!\\[[^\\]]*\\]\\(|<img") ~= nil then now.images = now.images + 1 end
      if re_find(trim(l), "^\\|?[ :|-]+$") == nil then now.prose = now.prose + word_count(l) end
    end
  end
  push(found, now)
  return found
end

function is_appendix(title)
  return starts_with(title, "Appendix") or title == "Credits"
end

function row(name, c)
  return "| " .. name .. " | " .. c.code .. " | " .. c.prose .. " | " .. c.diagrams .. " | " .. c.widgets .. " | " .. c.images .. " |"
end

function add(total, c)
  total.code = total.code + c.code
  total.prose = total.prose + c.prose
  total.diagrams = total.diagrams + c.diagrams
  total.widgets = total.widgets + c.widgets
  total.images = total.images + c.images
end

if not exists(BOOK) then fail("book_stats: no " .. BOOK .. ": run the tutorial gate first, which builds it") end
const ALL = chapters_of(read(BOOK))
const CHAPTERS = {code = 0, prose = 0, diagrams = 0, widgets = 0, images = 0}
const APPENDICES = {code = 0, prose = 0, diagrams = 0, widgets = 0, images = 0}
const BOOK_TOTAL = {code = 0, prose = 0, diagrams = 0, widgets = 0, images = 0}
local number = 0
local longest = {title = "", prose = 0}
local too_long = {}
print("| Chapter | Roc lines | Prose words | Diagrams | Widgets | Images |")
print("|---|---|---|---|---|---|")
for c in ALL do
  if is_appendix(c.title) then
    add(APPENDICES, c)
    print(row(c.title, c))
  elseif c.title ~= "(before the first chapter)" then
    number = number + 1
    add(CHAPTERS, c)
    print(row(number .. ". " .. c.title, c))
    if c.prose > longest.prose then longest = c end
    if c.prose > MAX_PROSE_WORDS then push(too_long, c.title .. " (" .. c.prose .. ")") end
  end
  add(BOOK_TOTAL, c)
end
print(row("**The " .. number .. " chapters**", CHAPTERS))
print(row("**The appendices**", APPENDICES))
print(row("**The whole book**", BOOK_TOTAL))
if #too_long > 0 then
  fail("book_stats: " .. #too_long .. " chapters over " .. MAX_PROSE_WORDS .. " prose words: " .. join(too_long, ", "))
end
print("book_stats: every chapter within " .. MAX_PROSE_WORDS .. " prose words; the longest is " .. longest.title .. ", at " .. longest.prose)
