-- budget: steps=200000000 arena_bytes=1500000000 read_bytes=400000000 output_bytes=200000 call_bytes=40000000
-- This holds the book the book builder makes (build_next.shale) to the book
-- book.shale makes today, page by page, and its last line is the verdict.
--
--   cd <roc-apps checkout> && shale canvas_apps/safari/tutorial/compare_books.shale
--
-- It builds both first: book.shale with `stage=tutorial.old check=0`, into the
-- dev channel's /tutorial.old/, and build_next.shale, which publishes into
-- /tutorial.next/ once its stage has passed the browser check.
-- `build=0` compares the two folders as they stand. `chapters=N` builds both
-- with `chapters=N`, the first N chapters and the back matter. book.shale then
-- draws only the diagrams of the chapters it keeps, numbered over them, and
-- build_next.shale draws every diagram, so each of book.shale's drawings is
-- held to the builder's of the same name, and the builder's others are
-- counted apart.
--
-- Every file of either folder is compared: each page, the front page (the
-- contents) and the index appendix among them, and book.css, book.js and
-- embed.js. Each diagram's drawing is compared too, as each build wrote it
-- (build/book/diagram-N.svg and build/prepared/diagram-N.svg), besides its
-- place in its page.
--
-- Today's pages have their Roc code colored by color_roc.shale, and the
-- builder's book has it plain until the book names a colorer, so the
-- comparison takes the coloring away on both sides: inside each
-- `<code class="language-roc">` up to its `</code>`, every `<span
-- class="syn-NAME">` and every `</span>` is dropped, NAME being lowercase
-- letters. color_roc puts nothing else there, and its own check holds a
-- page's text the same once those spans are gone. Nothing else is
-- normalized, and that comparison is the verdict.
--
-- The builder's book colors its Roc code too, with syntax_color/ through
-- app/QuotedColor.roc, so a second report holds each Roc block's coloring to
-- today's, byte for byte, and names every block that differs, by page and by
-- its place among the page's Roc blocks. It is a report beside the verdict:
-- syntax_color's oracle/known_mismatches.txt lists the blocks whose coloring
-- the package changed on purpose.
const OLD = "build:roc-apps/next/tutorial.old"
const NEW = "build:roc-apps/next/tutorial.next"
const OLD_DRAWINGS = "canvas_apps/safari/tutorial/build/book"
const NEW_DRAWINGS = "canvas_apps/safari/tutorial/build/prepared"
const CHAPTERS = arg("chapters", "")
const ROC_CODE = "<code class=\"language-roc\">"
const OUR_SPANS = "<span class=\"syn-[a-z]+\">|</span>"

-- The page with its Roc code's coloring taken away.
function uncolored(html)
  local pieces = split(html, ROC_CODE)
  local kept = {pieces[1]}
  for piece in drop(pieces, 1) do
    local close = find(piece, "</code>")
    if close == nil then fail("compare_books: a Roc code block with no end") end
    push(kept, re_replace(sub(piece, 1, close - 1), OUR_SPANS, "") .. sub(piece, close))
  end
  return join(kept, ROC_CODE)
end

-- The Roc blocks of a page, colored, in order.
function roc_blocks(html)
  local blocks = {}
  for piece in drop(split(html, ROC_CODE), 1) do push(blocks, sub(piece, 1, find(piece, "</code>") - 1)) end
  return blocks
end

-- Where two texts first differ, as a line of each, numbered.
function first_difference(a, b)
  local left = split(a, "\n")
  local right = split(b, "\n")
  local i = 1
  while i <= #left and i <= #right and left[i] == right[i] do i = i + 1 end
  local was = "(none)"
  local now = "(none)"
  if i <= #left then was = sub(left[i], 1, 300) end
  if i <= #right then now = sub(right[i], 1, 300) end
  return "line " .. i .. "\n    today:   " .. was .. "\n    builder: " .. now
end

function names_in(folder)
  local names = {}
  for e in walk(folder, {kind = "file"}) do push(names, sub(e.path, #folder + 2)) end
  return sort(names)
end

function build_both()
  local old_argv = {"shale", "--root", ".", "canvas_apps/safari/tutorial/book.shale", "stage=tutorial.old", "check=0"}
  local new_argv = {"shale", "--root", ".", "canvas_apps/safari/tutorial/build_next.shale"}
  if CHAPTERS ~= "" then
    push(old_argv, "chapters=" .. CHAPTERS)
    push(new_argv, "chapters=" .. CHAPTERS)
  end
  local old = must(run(old_argv, {timeout_ms = 600000, tail = 5}))
  print("compare_books: today's build took " .. old.ms .. " ms")
  local new = must(run(new_argv, {timeout_ms = 3600000, tail = 16}))
  print(trim(new.out))
  print("compare_books: the builder's build took " .. new.ms .. " ms")
  return nil
end

if arg("build", "1") ~= "0" then build_both() end

local old_names = names_in(OLD)
local new_names = names_in(NEW)
local differ = {}
local same = 0
for name in old_names do
  if not has_item(new_names, name) then
    push(differ, name .. ": only in today's book")
  elseif uncolored(read(OLD .. "/" .. name)) == uncolored(read(NEW .. "/" .. name)) then
    same = same + 1
  else
    push(differ, name .. ": differs at " .. first_difference(uncolored(read(OLD .. "/" .. name)), uncolored(read(NEW .. "/" .. name))))
  end
end
for name in new_names do
  if not has_item(old_names, name) then push(differ, name .. ": only in the builder's book") end
end

local drawings = 0
for path in glob(OLD_DRAWINGS .. "/diagram-*.svg") do
  local name = basename(path)
  if not exists(NEW_DRAWINGS .. "/" .. name) then
    push(differ, "drawing " .. name .. ": only in today's build")
  elseif read(path) ~= read(NEW_DRAWINGS .. "/" .. name) then
    push(differ, "drawing " .. name .. ": differs")
  else
    drawings = drawings + 1
  end
end
local drawn_apart = #glob(NEW_DRAWINGS .. "/diagram-*.svg") - #glob(OLD_DRAWINGS .. "/diagram-*.svg")
if CHAPTERS == "" and drawn_apart ~= 0 then push(differ, "the builds drew different numbers of diagrams") end
if CHAPTERS ~= "" then
  if drawn_apart < 0 then push(differ, "today's build drew more diagrams than the builder's") end
  print("compare_books: the builder drew " .. drawn_apart .. " more diagrams, of chapters the cut leaves out")
end

local colored_blocks = 0
local colored_same = 0
local colored_pages = 0
for name in old_names do
  if ends_with(name, ".html") and has_item(new_names, name) then
    local old_html = read(OLD .. "/" .. name)
    local new_html = read(NEW .. "/" .. name)
    if old_html == new_html then colored_pages = colored_pages + 1 end
    local old_blocks = roc_blocks(old_html)
    local new_blocks = roc_blocks(new_html)
    for k = 1, #old_blocks do
      colored_blocks = colored_blocks + 1
      if k <= #new_blocks and old_blocks[k] == new_blocks[k] then
        colored_same = colored_same + 1
      elseif k <= #new_blocks then
        print("COLOR " .. name .. ", Roc block " .. k .. ": " .. first_difference(old_blocks[k], new_blocks[k]))
      end
    end
  end
end
print("compare_books: colored, " .. colored_pages .. " pages the same byte for byte, " .. colored_same .. " of " .. colored_blocks .. " Roc blocks colored the same")

for d in differ do print("DIFF " .. d) end
local verdict = "PASS"
if #differ > 0 then verdict = "FAIL" end
print("compare_books: " .. verdict .. ", " .. same .. " of " .. #old_names .. " files the same once coloring is stripped, " .. drawings .. " drawings the same, " .. #differ .. " differences")
if #differ > 0 then fail("compare_books: the books differ") end
