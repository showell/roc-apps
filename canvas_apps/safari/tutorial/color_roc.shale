-- budget: steps=500000000 arena_bytes=1500000000 reads=20000 read_bytes=400000000 output_bytes=200000 call_entries=4000000
-- This colors the Roc code in the book's rendered pages, and book.shale runs it
-- on the staged pages. The renderer knows nothing of Roc: a ```roc fence reaches
-- this as a <pre><code class="language-roc"> holding escaped text, and each one
-- comes out with spans around what it colors, and book.css says what they look
-- like. A page's text must stay the same byte for byte once the spans are taken
-- away, or the build stops.
--
--   cd <roc-apps checkout> && shale canvas_apps/safari/tutorial/color_roc.shale
--
-- A block is often part of a definition, which Roc can't parse alone. Every
-- block comes from a file, though, so the file is parsed whole. build.shale
-- leaves a note, build/blocks.jsonl, that says which lines of which file each
-- block shows, in the order of the expanded source. `order=` names the pages in
-- book order, so the pages' blocks come in the note's order. The file and the
-- note give each block's text, and a block that doesn't read that way stops the
-- build, as does a count of blocks that differs from the note's.
--
-- Roc's tree places strings, numbers, type names, tags and top-level names
-- exactly. It holds no comments and no keywords, so those are read from the text
-- the tree doesn't claim, where a `#` can only start a comment.
--
-- A block of a file roc-ast refuses comes out plain, and so does one whose tree
-- contradicts itself. The last line of the run says how many did, with one line
-- for each.
--
-- `self_test=1` proves both sides of each rule on a module written here.
const PAGES = "build:roc-apps/next/tutorial.staging"
const NOTES = "canvas_apps/safari/tutorial/build/blocks.jsonl"
const OPEN = "<pre><code class=\"language-roc\">"
const CLOSE = "</code></pre>"
const CUT = "# ..."
const KEYWORD = "\\b(?:and|as|break|crash|dbg|else|expect|exposing|for|if|import|in|match|or|return|var|where|while)\\b"
const OUR_SPANS = "<span class=\"syn-[a-z]+\">|</span>"

function escaped(text)
  local s = join(split(text, "&"), "&amp;")
  s = join(split(s, "<"), "&lt;")
  s = join(split(s, ">"), "&gt;")
  s = join(split(s, "\""), "&quot;")
  return join(split(s, "'"), "&#39;")
end

function unescaped(html)
  local s = join(split(html, "&lt;"), "<")
  s = join(split(s, "&gt;"), ">")
  s = join(split(s, "&quot;"), "\"")
  s = join(split(s, "&#39;"), "'")
  return join(split(s, "&amp;"), "&")
end

-- A span that touches the last one, of the same class, extends it.
function add_token(tokens, from, to, class)
  if to <= from then return nil end
  if #tokens > 0 then
    local before = tokens[#tokens]
    if before.to == from and before.class == class then
      before.to = to
      return nil
    end
  end
  push(tokens, {from = from, to = to, class = class})
  return nil
end

-- An empty string part, as a string ending in `${...}` has, marks nothing.
function mark(spans, line, from, to, class)
  if to > from then push(spans[line], {from = from, to = to, class = class}) end
  return nil
end

-- A name that the tree gives by its text and where it starts. A tree's span can
-- run past the name, as a tag's runs over its payload.
function mark_name(spans, lines_of, line, col, name, class)
  if sub(lines_of[line], col, col + #name - 1) == name then mark(spans, line, col, col + #name, class) end
  return nil
end

function mark_whole(spans, node, class)
  if node.line == node.end_line then mark(spans, node.line, node.col, node.end_col, class) end
  return nil
end

function mark_quotes(spans, node)
  mark(spans, node.line, node.col, node.col + 1, "syn-string")
  mark(spans, node.end_line, node.end_col - 1, node.end_col, "syn-string")
  return nil
end

-- A multi-line string's text starts two bytes later, after its `\\`.
function mark_string_part(spans, lines_of, nodes, node)
  local from = node.col
  if nodes[node.parent].kind == "e-multiline-string" and trim(sub(lines_of[node.line], 1, from - 3)) == "" then from = from - 2 end
  mark(spans, node.line, from, node.end_col, "syn-string")
  return nil
end

-- `Clock.to_f64` starts with a type, and `to_f64` starts with nothing.
function mark_qualifier(spans, lines_of, node)
  local m = re_find(node.raw, "^([A-Z][A-Za-z0-9_.]*)\\.")
  if m ~= nil then mark_name(spans, lines_of, node.line, node.col, m.groups[1], "syn-type") end
  return nil
end

function mark_import(spans, lines_of, node)
  local line = lines_of[node.line]
  local at = find(line, node.raw)
  local module = re_find(node.raw, "[A-Z][A-Za-z0-9_]*$")
  if at ~= nil and module ~= nil then
    local from = at + module.at - 1
    mark(spans, node.line, from, from + #module.text, "syn-type")
  end
  return nil
end

function is_top_level(nodes, i)
  local block = nodes[nodes[i].parent]
  return block.kind == "associated" or (block.kind == "statements" and nodes[block.parent].kind == "file")
end

function mark_definition(spans, lines_of, nodes, i)
  local target = nodes[nodes[i].kids[1]]
  if target.kind == "p-ident" and is_top_level(nodes, i) then
    mark_name(spans, lines_of, target.line, target.col, target.raw, "syn-name")
  end
  return nil
end

function mark_node(spans, lines_of, nodes, i)
  local node = nodes[i]
  local kind = node.kind
  if kind == "e-string" or kind == "p-string" then
    mark_quotes(spans, node)
  elseif kind == "e-string-part" then
    mark_string_part(spans, lines_of, nodes, node)
  elseif kind == "p-string-text" or kind == "e-single-quote" or kind == "p-single-quote" then
    mark_whole(spans, node, "syn-string")
  elseif kind == "e-int" or kind == "e-frac" or kind == "p-int" or kind == "e-typed-int" or kind == "e-typed-frac" then
    mark_whole(spans, node, "syn-number")
  elseif kind == "e-tag" or kind == "p-tag" then
    mark_name(spans, lines_of, node.line, node.col, node.raw, "syn-type")
  elseif kind == "ty" or kind == "header" then
    mark_name(spans, lines_of, node.line, node.col, node.name, "syn-type")
  elseif kind == "exposed-upper-ident" then
    mark_name(spans, lines_of, node.line, node.col, node.text, "syn-type")
  elseif kind == "e-ident" then
    mark_qualifier(spans, lines_of, node)
  elseif kind == "s-import" then
    mark_import(spans, lines_of, node)
  elseif kind == "s-type-anno" then
    mark_name(spans, lines_of, node.line, node.col, node.name, "syn-name")
  elseif kind == "s-decl" then
    mark_definition(spans, lines_of, nodes, i)
  elseif kind == "app" or kind == "package" or kind == "platform" then
    mark_name(spans, lines_of, node.line, node.col, kind, "syn-keyword")
  end
  return nil
end

-- What the tree says of each line of a file: a list of spans for each.
function tree_spans(lines_of, nodes)
  local spans = {}
  for l in lines_of do push(spans, {}) end
  local i = 1
  while i <= #nodes do
    mark_node(spans, lines_of, nodes, i)
    i = i + 1
  end
  return spans
end

-- The keywords and any comment in text the tree doesn't claim. It says whether
-- a comment started, which runs to the end of the line.
function gap_tokens(text, from, to, tokens)
  local gap = sub(text, from, to)
  local hash = find(gap, "#")
  local code = gap
  if hash ~= nil then code = sub(gap, 1, hash - 1) end
  for word in re_find_all(code, KEYWORD) do
    local at = from + word.at - 1
    local before = ""
    if at > 1 then before = sub(text, at - 1, at - 1) end
    if before ~= "." and before ~= "$" then add_token(tokens, at, at + #word.text, "syn-keyword") end
  end
  if hash ~= nil then add_token(tokens, from + hash - 1, #text + 1, "syn-comment") end
  return hash ~= nil
end

-- A line's tokens in order, or nil if the tree's spans contradict each other or
-- a comment.
function line_tokens(file, number)
  local text = file.lines[number]
  local tokens = {}
  local at = 1
  for span in sort(file.spans[number], "from") do
    if span.from < at then return nil end
    if gap_tokens(text, at, span.from - 1, tokens) then return nil end
    add_token(tokens, span.from, span.to, span.class)
    at = span.to
  end
  gap_tokens(text, at, #text, tokens)
  return tokens
end

-- A line of a block in HTML, from its file line's tokens. The block's line sits
-- `indent` bytes along the file's, and may stop before it does.
function colored_line(shown, tokens, indent)
  local pieces = {}
  local at = 1
  for token in tokens do
    local from = token.from - indent
    local to = token.to - indent
    if to > #shown + 1 then to = #shown + 1 end
    if from <= #shown then
      push(pieces, escaped(sub(shown, at, from - 1)))
      push(pieces, "<span class=\"" .. token.class .. "\">" .. escaped(sub(shown, from, to - 1)) .. "</span>")
      at = to
    end
  end
  push(pieces, escaped(sub(shown, at, #shown)))
  return join(pieces, "")
end

function cut_line(shown)
  local at = find(shown, CUT)
  return escaped(sub(shown, 1, at - 1)) .. "<span class=\"syn-comment\">" .. CUT .. "</span>"
end

-- What a note says its block shows, a line each. A cut holds its text alone, and
-- any other line says where it sits in the file.
function noted_lines(file, note)
  local shown = {}
  for part in note.parts do
    if has_key(part, "cut") then
      push(shown, {text = part.cut})
    else
      local number = part.from
      while number <= part.to do
        local line = file.lines[number]
        local last = #line
        if number == part.to then last = part.end_col - 1 end
        push(shown, {text = sub(line, part.indent + 1, last), number = number, indent = part.indent})
        number = number + 1
      end
    end
  end
  return shown
end

function check_block(text, shown, note, page)
  local noted = {}
  for line in shown do push(noted, line.text) end
  if join(noted, "\n") .. "\n" ~= text then
    fail("color_roc: " .. page .. " disagrees with the note for " .. note.path .. ": it has [" .. sub(text, 1, 40) .. "], and the note gives [" .. sub(join(noted, "\n"), 1, 40) .. "]")
  end
  return nil
end

-- The block's HTML, or nil with its reason in `tally`.
function colored_block(body, note, files, tally, page)
  local file = files[note.path]
  local shown = noted_lines(file, note)
  check_block(unescaped(body), shown, note, page)
  if file.err ~= "" then
    push(tally.plain, page .. ": " .. file.err)
    return nil
  end
  local html = {}
  for line in shown do
    if has_key(line, "number") then
      local tokens = line_tokens(file, line.number)
      if tokens == nil then
        push(tally.plain, page .. ": the tree contradicts itself at " .. note.path .. ":" .. line.number)
        return nil
      end
      push(html, colored_line(line.text, tokens, line.indent))
    else
      push(html, cut_line(line.text))
    end
  end
  return join(html, "\n") .. "\n"
end

-- The page with its blocks colored, each taking the next note.
function colored_page(page, notes, files, tally)
  local pieces = split(read(page), OPEN)
  local out = {pieces[1]}
  local i = 2
  while i <= #pieces do
    local piece = pieces[i]
    local close = find(piece, CLOSE)
    if close == nil then fail("color_roc: a block with no end in " .. page) end
    if tally.noted == #notes then fail("color_roc: " .. page .. " has a block past the note's last, of " .. #notes) end
    tally.noted = tally.noted + 1
    local html = colored_block(sub(piece, 1, close - 1), notes[tally.noted], files, tally, basename(page))
    if html == nil then
      push(out, piece)
    else
      tally.colored = tally.colored + 1
      push(out, html .. sub(piece, close, #piece))
    end
    i = i + 1
  end
  return join(out, OPEN)
end

function without_our_spans(html)
  return re_replace(html, OUR_SPANS, "")
end

function check_text(page, before, after)
  if without_our_spans(before) ~= without_our_spans(after) then fail("color_roc: coloring changed the text of " .. page) end
  return nil
end

-- Each file the notes name, parsed in one run of roc-ast.
function parsed_files(notes)
  local paths = {}
  for note in notes do push(paths, note.path) end
  local files = {}
  if #paths == 0 then return files end
  for tree in roc_tree(unique(paths)) do
    local lines_of = split(read(tree.path), "\n")
    if tree.err == "" then
      files[tree.path] = {err = "", lines = lines_of, spans = tree_spans(lines_of, tree.nodes)}
    else
      files[tree.path] = {err = tree.err, lines = lines_of}
    end
  end
  return files
end

function read_notes(text)
  local notes = {}
  for l in lines(text) do push(notes, json_read(l)) end
  return notes
end

-- Colors the pages named in `order`, in `folder`, and gives the count of each
-- outcome.
function color_pages(folder, order, notes)
  local files = parsed_files(notes)
  local tally = {colored = 0, plain = {}, noted = 0}
  for name in order do
    local page = folder .. "/" .. name
    local before = read(page)
    if contains(before, OPEN) then
      local after = colored_page(page, notes, files, tally)
      check_text(page, before, after)
      replace(page, after)
    end
  end
  if tally.noted ~= #notes then fail("color_roc: the note has " .. #notes .. " blocks, and the pages " .. tally.noted) end
  return tally
end

const ZOO = [=[## A "quoted" doc: it's fine.
import pf.Stdout
import Other exposing [Thing]

Zoo :: [].{
	## A cage.
	Cage : { size : F64, name : Str }

	## How much to feed.
	feed : Cage -> F64
	feed = |cage| {
		amount = cage.size # never "quoted" here
		iffy = amount < 2.0 and amount > 1.0
		label = "a # b ${cage.name} & 'c' if"
		Clock.seconds(amount)
		if iffy { Fed(0x10) } else { Hungry }
	}

	bare = 1 # A trailing comment.

	wide = ("é", 3, Cage.(4))

	tail = |x| ["${x}", "b ${x}", "c ${Inner.show(x)}"]

	long = |x| {
		note =
			\\one # two
			\\three ${x}
		note
	}
}
]=]

const WRAPPED = "<p>prose</p>\n"

function page_with(title, block)
  return WRAPPED .. title .. OPEN .. escaped(block) .. "\n" .. CLOSE .. "\n<p>after</p>\n"
end

function caption(title)
  return "<figure class=\"listing\"><figcaption>" .. title .. "</figcaption>"
end

function color_one(folder, title, block, parts)
  replace(folder .. "/page.html", page_with(title, block))
  local tally = color_pages(folder, {"page.html"}, {{path = folder .. "/Zoo.roc", parts = parts}})
  return {tally = tally, html = read(folder .. "/page.html")}
end

function span(class, text)
  return "<span class=\"syn-" .. class .. "\">" .. text .. "</span>"
end

-- The lines of ZOO from `from` through `to`, whole, less `indent` bytes each.
function zoo_part(from, to, indent)
  return {from = from, to = to, indent = indent, end_col = #split(ZOO, "\n")[to] + 1}
end

function expect_block(checks, folder, what, parts, block, want)
  local got = color_one(folder, caption("Zoo.roc"), block, parts)
  local page = WRAPPED .. caption("Zoo.roc") .. OPEN .. want .. "\n" .. CLOSE .. "\n<p>after</p>\n"
  if got.tally.colored ~= 1 or #got.tally.plain ~= 0 then fail("self_test: " .. what .. " came out plain: " .. join(got.tally.plain, ", ")) end
  if got.html ~= page then fail("self_test: " .. what .. " gave [" .. got.html .. "], not [" .. page .. "]") end
  push(checks, what)
  return nil
end

-- A block the note doesn't describe stops the run, and leaves its page alone.
function expect_stop(checks, folder, what, block, parts, why)
  local got = attempt(color_one, folder, caption("Zoo.roc"), block, parts)
  if got.ok or not contains(got.error, why) then fail("self_test: " .. what .. " gave " .. json_write(got)) end
  if read(folder .. "/page.html") ~= page_with(caption("Zoo.roc"), block) then fail("self_test: " .. what .. " changed the page") end
  push(checks, what)
  return nil
end

function check_counts(checks, folder)
  local note = {path = folder .. "/Zoo.roc", parts = {{from = 19, to = 19, indent = 1, end_col = 10}}}
  replace(folder .. "/page.html", page_with(caption("Zoo.roc"), "bare = 1"))
  local too_few = attempt(color_pages, folder, {"page.html"}, {note, note})
  if too_few.ok or too_few.error ~= "color_roc: the note has 2 blocks, and the pages 1" then fail("self_test: a note with a block too many gave " .. json_write(too_few)) end
  push(checks, "a note with a block the pages lack")

  replace(folder .. "/page.html", page_with(caption("Zoo.roc"), "bare = 1") .. page_with(caption("Zoo.roc"), "bare = 1"))
  local too_many = attempt(color_pages, folder, {"page.html"}, {note})
  if too_many.ok or not contains(too_many.error, "has a block past the note's last, of 1") then fail("self_test: a page with a block too many gave " .. json_write(too_many)) end
  push(checks, "a page with a block the note lacks")

  replace(folder .. "/other.html", page_with(caption("Zoo.roc"), "bare = 1"))
  replace(folder .. "/page.html", page_with(caption("Zoo.roc"), "wide"))
  local misordered = attempt(color_pages, folder, {"page.html", "other.html"}, {note, {path = note.path, parts = {{from = 21, to = 21, indent = 1, end_col = 6}}}})
  if misordered.ok or not contains(misordered.error, "page.html disagrees with the note for") then fail("self_test: pages out of order gave " .. json_write(misordered)) end
  push(checks, "pages out of the note's order")
  remove(folder .. "/other.html")
  return nil
end

function self_test()
  local folder = fresh_dir("scratch:", "color-roc")
  replace(folder .. "/Zoo.roc", ZOO)
  replace(folder .. "/Broken.roc", "Broken :: [].{\n\tx = = 1\n")
  local checks = {}

  expect_block(checks, folder, "a `#` in a string, and a quote in a comment", {zoo_part(12, 14, 2)},
    "amount = cage.size # never \"quoted\" here\niffy = amount < 2.0 and amount > 1.0\nlabel = \"a # b ${cage.name} & 'c' if\"",
    "amount = cage.size " .. span("comment", "# never &quot;quoted&quot; here") .. "\n"
    .. "iffy = amount &lt; " .. span("number", "2.0") .. " " .. span("keyword", "and") .. " amount &gt; " .. span("number", "1.0") .. "\n"
    .. "label = " .. span("string", "&quot;a # b ") .. "${cage.name}" .. span("string", " &amp; &#39;c&#39; if&quot;"))

  expect_block(checks, folder, "a fragment that can't parse alone, with its cuts", {{cut = "\t# ..."}, zoo_part(15, 17, 1)},
    "\t# ...\n\tClock.seconds(amount)\n\tif iffy { Fed(0x10) } else { Hungry }\n}",
    "\t" .. span("comment", "# ...") .. "\n"
    .. "\t" .. span("type", "Clock") .. ".seconds(amount)\n"
    .. "\t" .. span("keyword", "if") .. " iffy { " .. span("type", "Fed") .. "(" .. span("number", "0x10") .. ") } " .. span("keyword", "else") .. " { " .. span("type", "Hungry") .. " }\n}")

  expect_block(checks, folder, "a whole definition, its doc and its name", {zoo_part(9, 11, 1), {cut = "\t# ..."}},
    "## How much to feed.\nfeed : Cage -> F64\nfeed = |cage| {\n\t# ...",
    span("comment", "## How much to feed.") .. "\n"
    .. span("name", "feed") .. " : " .. span("type", "Cage") .. " -&gt; " .. span("type", "F64") .. "\n"
    .. span("name", "feed") .. " = |cage| {\n\t" .. span("comment", "# ..."))

  expect_block(checks, folder, "a definition cut before its line ends", {{from = 19, to = 19, indent = 1, end_col = 10}},
    "bare = 1", span("name", "bare") .. " = " .. span("number", "1"))

  expect_block(checks, folder, "a multi-line string, and a local that is no definition", {zoo_part(26, 29, 2)},
    "note =\n\t\\\\one # two\n\t\\\\three ${x}\nnote",
    "note =\n\t" .. span("string", "\\\\one # two") .. "\n\t" .. span("string", "\\\\three ") .. "${x}\nnote")

  expect_block(checks, folder, "a comment's quote opens no string, and imports name a type", {zoo_part(1, 3, 0)},
    "## A \"quoted\" doc: it's fine.\nimport pf.Stdout\nimport Other exposing [Thing]",
    span("comment", "## A &quot;quoted&quot; doc: it&#39;s fine.") .. "\n"
    .. span("keyword", "import") .. " pf." .. span("type", "Stdout") .. "\n"
    .. span("keyword", "import") .. " " .. span("type", "Other") .. " " .. span("keyword", "exposing") .. " [" .. span("type", "Thing") .. "]")

  expect_block(checks, folder, "columns count bytes, and a wrapped value names its type", {zoo_part(21, 21, 1)},
    "wide = (\"é\", 3, Cage.(4))",
    span("name", "wide") .. " = (" .. span("string", "&quot;é&quot;") .. ", " .. span("number", "3") .. ", " .. span("type", "Cage") .. ".(" .. span("number", "4") .. "))")

  expect_block(checks, folder, "strings that end in an interpolation", {zoo_part(23, 23, 1)},
    "tail = |x| [\"${x}\", \"b ${x}\", \"c ${Inner.show(x)}\"]",
    span("name", "tail") .. " = |x| [" .. span("string", "&quot;") .. "${x}" .. span("string", "&quot;") .. ", "
    .. span("string", "&quot;b ") .. "${x}" .. span("string", "&quot;") .. ", "
    .. span("string", "&quot;c ") .. "${" .. span("type", "Inner") .. ".show(x)}" .. span("string", "&quot;") .. "]")

  expect_block(checks, folder, "lines from around the file, each run placed alone",
    {zoo_part(10, 10, 1), {from = 19, to = 19, indent = 1, end_col = 10}, zoo_part(26, 27, 2)},
    "feed : Cage -> F64\nbare = 1\nnote =\n\t\\\\one # two",
    span("name", "feed") .. " : " .. span("type", "Cage") .. " -&gt; " .. span("type", "F64") .. "\n"
    .. span("name", "bare") .. " = " .. span("number", "1") .. "\n"
    .. "note =\n\t" .. span("string", "\\\\one # two"))

  expect_stop(checks, folder, "a block that isn't where the note says", "gone = 1", {zoo_part(19, 19, 1)}, "disagrees with the note")
  expect_stop(checks, folder, "a block with one line that isn't", "bare = 1\ngone = 1", {{from = 19, to = 19, indent = 1, end_col = 10}, zoo_part(21, 21, 1)}, "disagrees with the note")
  expect_stop(checks, folder, "a block longer than its note", "bare = 1\nmore", {{from = 19, to = 19, indent = 1, end_col = 10}}, "disagrees with the note")
  expect_stop(checks, folder, "a block shorter than its note", "bare = 1", {{from = 19, to = 19, indent = 1, end_col = 10}, {cut = "# ..."}}, "disagrees with the note")
  expect_stop(checks, folder, "a note whose end column is off", "bare = 1", {{from = 19, to = 19, indent = 1, end_col = 9}}, "disagrees with the note")
  expect_stop(checks, folder, "a note whose indent is off", "bare = 1", {{from = 19, to = 19, indent = 0, end_col = 10}}, "disagrees with the note")
  check_counts(checks, folder)

  replace(folder .. "/page.html", page_with(caption("Broken.roc"), "x = = 1"))
  local refused = color_pages(folder, {"page.html"}, {{path = folder .. "/Broken.roc", parts = {{from = 2, to = 2, indent = 1, end_col = 9}}}})
  if refused.colored ~= 0 or #refused.plain ~= 1 or not contains(refused.plain[1], "parse problem") then fail("self_test: a file roc-ast refuses counted " .. json_write(refused)) end
  if read(folder .. "/page.html") ~= page_with(caption("Broken.roc"), "x = = 1") then fail("self_test: a file roc-ast refuses changed the page") end
  push(checks, "a file roc-ast refuses")

  replace(folder .. "/page.html", caption("Zoo.roc") .. "<pre><code class=\"language-zig\">bare = 1\n</code></pre>\n")
  local other = color_pages(folder, {"page.html"}, {})
  if other.colored ~= 0 or #other.plain ~= 0 or not contains(read(folder .. "/page.html"), ">bare = 1\n<") then fail("self_test: a Zig block was touched") end
  push(checks, "a block in another language")

  local same = "<p>a " .. span("type", "B") .. " c</p>"
  if not attempt(check_text, "p", "<p>a B c</p>", same).ok then fail("self_test: added spans changed the text") end
  local changed = attempt(check_text, "p", "<p>a B c</p>", "<p>a " .. span("type", "B") .. " d</p>")
  if changed.ok or changed.error ~= "color_roc: coloring changed the text of p" then fail("self_test: changed text gave " .. json_write(changed)) end
  local lost = attempt(check_text, "p", "<p>&lt;</p>", "<p>" .. span("type", "<") .. "</p>")
  if lost.ok then fail("self_test: a lost escape passed") end
  push(checks, "the text check, both sides")

  remove_tree(folder)
  print("color_roc self_test: PASS, " .. #checks .. " checks")
  return nil
end

if arg("self_test", "") == "1" then
  self_test()
else
  local order = arg("order", "")
  if order == "" then fail("color_roc: order= names the pages, in book order") end
  local tally = color_pages(arg("pages", PAGES), split(order, " "), read_notes(read(NOTES)))
  for line in tally.plain do print("color_roc: plain, " .. line) end
  print("color_roc: " .. tally.colored .. " blocks colored, " .. #tally.plain .. " plain")
end
