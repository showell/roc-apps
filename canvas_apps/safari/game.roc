# The game's modules that the gates and the tutorial's widgets read, as a
# package. The gate programs in gates/ reach this as `game: "../game.roc"` and
# say `import game.Tour`.
package
	[
		Across,
		Along,
		Angle,
		Animation,
		BirdFlight,
		BirdSighting,
		Cat,
		CatDraw,
		CatSighting,
		CatStills,
		Clock,
		CritterSighting,
		CrossingReaction,
		DepthSort,
		Distance,
		Fraction,
		Frame,
		Geom,
		Ground,
		GroundSighting,
		RailSighting,
		Render,
		RideInstant,
		Rider,
		RocBird,
		SafariShapes,
		Scenery,
		Screen,
		Sky,
		Speed,
		Tour,
		TowerSighting,
		TreeSighting,
		Truck,
		TruckSighting,
		VehicleLimits,
		World,
	]
	{
		lib: "../lib/main.roc",
	}
