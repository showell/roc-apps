# The game's modules that the gates and the tutorial's widgets read, as a
# package. The gate programs in gates/ reach this as `game: "../game.roc"` and
# say `import game.Tour`.
package
	[
		Across,
		Along,
		Angle,
		Animation,
		Backdrop,
		BirdFlight,
		BirdSighting,
		Camera,
		Cat,
		CatDraw,
		CatSighting,
		CatStills,
		Chain,
		Clock,
		CrossingReaction,
		CutoutSighting,
		DepthSort,
		Distance,
		Fraction,
		Geom,
		Ground,
		GroundSighting,
		Lens,
		Paint,
		RailSighting,
		RideInstant,
		Rider,
		RocBird,
		Scene,
		SceneDraw,
		Scenery,
		Screen,
		Sky,
		Speed,
		Steps,
		Tour,
		Tower,
		TowerSighting,
		TreeDraw,
		TreeSighting,
		Truck,
		TruckSighting,
		VehicleLimits,
		World,
	]
	{ lib: "../lib/main.roc" }
