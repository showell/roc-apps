# The game's modules that the gates and the tutorial's widgets read, as a
# package. The gate programs in gates/ reach this as `game: "../game.roc"` and
# say `import game.Tour`.
package
	[
		Acceleration,
		Across,
		Along,
		Angle,
		Animation,
		Backdrop,
		BendView,
		Bike,
		BirdDraw,
		BirdFlight,
		BirdSighting,
		BirdStills,
		Camera,
		Cat,
		CatDraw,
		CatSighting,
		CatStills,
		Chain,
		Clock,
		Coast,
		Conifer,
		CrossingReaction,
		CutoutSighting,
		DepthSort,
		Detail,
		Distance,
		Fraction,
		Gaze,
		Geom,
		Ground,
		GroundSighting,
		LeanSearch,
		Lens,
		Mountains,
		Pigs,
		Pixels,
		Polygon,
		RailSighting,
		RideFocal,
		RideInstant,
		Rider,
		RiderState,
		SafariApp,
		Scene,
		SceneDraw,
		Scenery,
		Screen,
		Sky,
		Speed,
		Steps,
		StillDraw,
		Stills,
		Sun,
		Tour,
		Tower,
		TowerSighting,
		TreeDraw,
		TreeSighting,
		Trees,
		Truck,
		TruckSighting,
		VehicleLimits,
		ViewYaw,
		World,
	]
	{ lib: "../lib/main.roc" }
