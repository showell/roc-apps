-- This is roc-apps' prelude: every Shale script run from the repository's
-- root has its functions. It holds the one home of roc-apps' compiler for
-- Shale, as pinned-roc.sh is for bash: the nightly named in roc-version,
-- installed side by side at tools:roc-<pin>/roc (~/tools/ on the box,
-- CLAUDE.md §2). A missing pin file, a missing binary and a binary whose
-- `roc version` isn't the pin each stop the run, named for `who`.

-- The pinned Roc's real path. `pin_file` names another pin file, for a
-- self-test of these refusals.
function pinned_roc(who, pin_file?)
  local file = "roc-version"
  if pin_file ~= nil then file = pin_file end
  if not exists(file) then fail(who .. ": no " .. file .. ": run from the roc-apps root") end
  local pin = trim(read(file))
  local roc = "tools:roc-" .. pin .. "/roc"
  if not exists(roc) then fail(who .. ": no " .. roc .. ": install roc-apps' pinned nightly " .. pin .. " at ~/tools/roc-" .. pin .. "/") end
  local said = run({real(roc), "version"}, {timeout_ms = 30000, whole = 4000, want = "roc-pin: roc-apps' pinned nightly"})
  check_roc_version(who, roc, pin, said.out)
  return real(roc)
end

-- The text of a piece of HTML: its tags dropped and the entities it uses
-- decoded, `&amp;` last so a decoded `&` never starts another. The tutorial's
-- scripts read the official Roc tutorial with it.
function plain_text(html)
  local text = re_replace(html, "<[^>]+>", "")
  for pair in {{"&lt;", "<"}, {"&gt;", ">"}, {"&quot;", "\""}, {"&#39;", "'"}, {"&#x27;", "'"}, {"&amp;", "&"}} do
    text = re_replace(text, pair[1], pair[2])
  end
  return text
end

-- The files the Roc program a cookbook recipe launches is built from, by
-- their real paths, or none for a recipe that launches no Roc. A launcher
-- (cookbook/roc/find_unclear_names.shale) names its program in a line
-- `const SCRIPT = "<path from the Shale checkout>"` and runs it through
-- roc_platform/run.shale in the checkout its cookbook is in, which builds it
-- with that checkout's platform and links it with a host compiled from the
-- checkout's C Shale. So the files are the program and every file git
-- tracks in roc_platform/ and c/, prose (`.md`) aside. tools/quality.shale's
-- keys and safari's lints' rules both read it. A launcher with no `const
-- SCRIPT` line, and a named file that isn't there, stop the run, named for
-- `who`.
function roc_launch_files(who, recipe)
  local launches = false
  local script = nil
  for l in lines(read(recipe)) do
    local t = trim(l)
    if not starts_with(t, "--") then
      if find(t, "roc_platform/run.shale") ~= nil then launches = true end
      local m = re_find(t, "^const SCRIPT = \"([^\"]+)\"")
      if m ~= nil then script = m.group end
    end
  end
  if not launches then return {} end
  if script == nil then fail(who .. ": " .. recipe .. " runs roc_platform/run.shale and names no program (`const SCRIPT = \"...\"`)") end
  local checkout = dirname(dirname(real("cookbook:README.md")))
  local files = {checkout .. "/" .. script}
  local tracked = must(run({"git", "-C", checkout, "ls-files", "--", "roc_platform", "c"}, {timeout_ms = 30000, whole = 1000000}))
  for f in lines(trim(tracked.out)) do
    if not ends_with(f, ".md") then push(files, checkout .. "/" .. f) end
  end
  local hashed = run({"git", "hash-object", "--no-filters", "--stdin-paths"}, {timeout_ms = 60000, tail = 5, stdin = join(files, "\n") .. "\n"})
  if hashed.ended ~= "exit" or hashed.code ~= 0 then fail(who .. ": " .. recipe .. " builds from a file that isn't there: " .. trim(hashed.out)) end
  return files
end

-- Nothing, or a stop when `said`, what `roc version` printed, isn't the pin.
function check_roc_version(who, roc, pin, said)
  if trim(said) ~= "Roc compiler version " .. pin then
    fail(who .. ": " .. roc .. " is " .. trim(said) .. ", not " .. pin)
  end
  return nil
end
