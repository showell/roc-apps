-- basic-run built and timed, for basic/controls.shale and
-- basic/pathological.shale: `use("./basic_runs.shale")`. Counting its
-- allocations is tools/alloc_ladder.shale's.
--
-- basic-run is built with the pinned Roc (`pinned_roc`, in
-- .shale/prelude.shale) into build:roc-apps/gen/basic-controls/<checkout>/<opt>/,
-- each checkout its own, `opt` being `speed` (the release build) or `dev`.

const WANT_ROC = "roc-pin: roc-apps' pinned nightly, and basic-run, which it builds"
const WANT_TIME = "basic-time: basic-run, built here with the pinned Roc"
-- **THE ONE WARNING A RELEASE BUILD IS ALLOWED.** basic-run reports the
-- statements it ran on stderr with `dbg`, the default platform's only way
-- there, and `--opt=speed` warns of a `dbg`. Any other warning fails.
const DBG_WARNING = "`dbg` in optimized build"
const DBG_LINE = "BasicRun.roc:24:2"

-- This checkout's folder of built things.
function gen_dir()
  return "build:roc-apps/gen/basic-controls/" .. basename(real("."))
end

-- Where this checkout's basic-run of `opt` is built.
function out_dir(opt)
  return gen_dir() .. "/" .. opt
end

-- Whether a build's output holds an error, or a warning but the release
-- build's `dbg`.
function build_went_wrong(out, opt)
  if contains(out, "✗") then return true end
  local warnings = 0
  for l in lines(out) do
    if contains(l, "●") then
      if not (opt == "speed" and contains(l, DBG_WARNING) and contains(l, DBG_LINE)) then warnings = warnings + 1 end
    end
  end
  return warnings > 0
end

-- basic-run built from basic/roc/BasicRun.roc with `--opt=<opt>`.
-- **THE ROC COMPILER EXITS NON-ZERO FOR A WARNING**, so its exit code is not
-- the verdict: an error is marked ✗ and a warning ●, and a failed build
-- leaves no executable.
function build_basic_run(who, opt)
  if opt ~= "speed" and opt ~= "dev" then fail(who .. ": opt is speed or dev, not " .. opt) end
  local roc = pinned_roc(who)
  local dir = out_dir(opt)
  mkdir(dir)
  local exe = dir .. "/basic-run"
  if exists(exe) then remove(exe) end
  local r = run({roc, "build", "BasicRun.roc", "--opt=" .. opt, "--output=" .. real(dir) .. "/basic-run"},
    {cwd = "basic/roc", timeout_ms = 1800000, tail = 40, nice = 19, want = WANT_ROC})
  if build_went_wrong(r.out, opt) or not exists(exe) then
    print(trim(r.out))
    fail(who .. ": the " .. opt .. " build of basic-run failed")
  end
  print("built basic-run --opt=" .. opt .. ": " .. (r.ms // 1000) .. " s")
end

-- The built basic-run of `opt`, by its real path.
function built_basic_run(who, opt)
  local exe = out_dir(opt) .. "/basic-run"
  if not exists(exe) then fail(who .. ": no basic-run built for " .. opt .. ": run without build=0") end
  return real(exe)
end

-- One run of basic-run `bin`, timed: `{ms, out}`. `args` are basic-run's.
function timed_basic_run(who, bin, stage, args, limit_ms)
  local argv = {bin}
  for a in args do push(argv, a) end
  local r = run(argv, {timeout_ms = limit_ms, tail = 3, want = WANT_TIME, cpu_budget_ms = limit_ms, stage = stage})
  if r.ended ~= "exit" or r.code ~= 0 then fail(who .. ": " .. stage .. ": basic-run ended " .. r.ended .. " " .. get(r, "code", "") .. ": " .. r.out) end
  return {ms = r.ms, out = r.out}
end
