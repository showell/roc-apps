-- The pathological programs (basic/pathological/*.bas) through basic-run:
-- for each, the process's time (the best of three), then each one's
-- allocations and reallocations, counted by tools/alloc_ladder.shale as a
-- report. A statement that allocates per execution shows as a count in the
-- tens or hundreds of thousands. Nothing is held. Run it with nothing else
-- on the box.
--
--   cd <roc-apps checkout> && shale basic/pathological.shale            the release build (--opt=speed)
--   cd <roc-apps checkout> && shale basic/pathological.shale opt=dev
--
-- budget: steps=50000000

use("./basic_runs.shale")

const WHO = "basic/pathological.shale"
-- A program's one run may take this long.
const RUN_MS = 20000
const TRIES = 3

const OPT = arg("opt", "speed")

-- The last 40 bytes of what a run printed, `dbg`'s line on stderr left out.
function transcript_end(out)
  local kept = {}
  for l in lines(out) do
    if not starts_with(l, "[dbg]") then push(kept, trim(l)) end
  end
  return sub(join(kept, " "), -40)
end

function main()
  local bin = basic_run(WHO, OPT)
  local rows = {}
  local controls = {}
  for f in glob("basic/pathological/*.bas") do
    local n = strip_suffix(basename(f), ".bas")
    local args = {"micro", read(f), ""}
    local best = nil
    local out = ""
    local k = 0
    while k < TRIES do
      local t = timed_basic_run(WHO, bin, n, args, RUN_MS)
      if best == nil or t.ms < best then best = t.ms end
      out = t.out
      k = k + 1
    end
    push(rows, {program = n, ms = best, prints = transcript_end(out)})
    push(controls, {name = n, small_argv = {bin, "micro", read(f), ""}, big_argv = {}})
  end
  print(table(rows, {"program", "ms", "prints"}))
  print("--opt=" .. OPT .. ", the best of " .. TRIES .. " runs")
  local plan_path = gen_dir() .. "/plan-pathological-" .. OPT .. ".json"
  if exists(plan_path) then remove(plan_path) end
  create(plan_path, json_write({who = WHO, gen = gen_dir(), expected = "", small = 1, big = 1, limit_ms = RUN_MS * 10, hold = false, controls = controls}))
  print(trim(must(run({"shale", "--root", ".", "tools/alloc_ladder.shale", "plan=" .. plan_path}, {timeout_ms = 1800000, tail = 40})).out))
end

main()
