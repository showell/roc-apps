-- BASIC's controls (basic/controls/*.bas): the smallest programs, each
-- adding one thing to the one before, run through basic-run at 1,000 and at
-- 10,000 iterations on tools/alloc_ladder.shale, which counts what one more
-- iteration allocates and holds each control to its expected file.
--
--   cd <roc-apps checkout> && shale basic/controls.shale              the release build (--opt=speed)
--   cd <roc-apps checkout> && shale basic/controls.shale opt=dev      the dev build
--   cd <roc-apps checkout> && shale basic/controls.shale only=16-poke the controls whose names start so
--
-- **A CONTROL THAT STARTS ALLOCATING NAMES THE FEATURE THAT DID IT**, which
-- is the point: read them in order, and the first one off is the change's.
--
-- The release build is the one held: basic/controls/expected.txt. The dev
-- build (--opt=dev, which lowers closures and the like to boxes, as
-- `--specialize=no`) allocates where the release build doesn't, and is held
-- to basic/controls/expected-dev.txt. `only=` holds nothing: a part of the
-- ladder is a report.
--
-- The release build takes about 90 s of compiling and its counting about
-- 20 s; the dev build about 5 s and 60 s. A build of inputs already built
-- is reused (tools/roc_build.shale), so a second run compiles nothing.
--
-- budget: steps=50000000

use("./basic_runs.shale")

const SMALL = 1000
const BIG = 10000
const RUN_MS = 120000
const WHO = "basic/controls.shale"

const OPT = arg("opt", "speed")
const ONLY = arg("only", "")

function rep_list(x, n)
  local out = {}
  local i = 0
  while i < n do
    push(out, x)
    i = i + 1
  end
  return out
end

-- basic-run's command line for a control at `iterations`. A control with an
-- INPUT gets one reply line, 7, an iteration.
function argv_for(bin, src, iterations)
  local replies = ""
  if contains(src, "INPUT") then replies = join(rep_list("7", iterations), "\n") end
  return {bin, "micro", substitute(src, "@N@", tostring(iterations), {missing_ok = true}), replies}
end

function main()
  local bin = basic_run(WHO, OPT)
  local controls = {}
  for f in glob("basic/controls/*.bas") do
    local n = strip_suffix(basename(f), ".bas")
    if ONLY == "" or starts_with(n, ONLY) then
      local src = read(f)
      local big = {}
      if contains(src, "@N@") then big = argv_for(bin, src, BIG) end
      push(controls, {name = n, small_argv = argv_for(bin, src, SMALL), big_argv = big})
    end
  end
  if #controls == 0 then fail(WHO .. ": no control is named " .. ONLY) end
  local file = "basic/controls/expected.txt"
  if OPT == "dev" then file = "basic/controls/expected-dev.txt" end
  local plan = {who = WHO .. " opt=" .. OPT, gen = gen_dir(), expected = file, small = SMALL, big = BIG,
    limit_ms = RUN_MS, hold = ONLY == "", controls = controls}
  if ONLY ~= "" then plan.expected = "" end
  local plan_path = gen_dir() .. "/plan-" .. OPT .. ".json"
  if exists(plan_path) then remove(plan_path) end
  create(plan_path, json_write(plan))
  local r = run({"shale", "--root", ".", "tools/alloc_ladder.shale", "plan=" .. plan_path}, {timeout_ms = 1800000, tail = 80})
  print(trim(r.out))
  if r.code ~= 0 then fail(WHO .. ": the ladder failed, --opt=" .. OPT) end
end

main()
