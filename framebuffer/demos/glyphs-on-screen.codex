Section: Drawing

 A glyph's coverage pixel by pixel, where it is not zero: the plain render as
 chalk, the anti-aliased one as a grey as bright as its coverage.

  zoom : Integer = 3

  put-glyph-row : List Integer, Integer, Integer, Integer, Integer, Integer, Boolean, Integer, Integer -> Integer
  put-glyph-row (px) (gw) (stride) (rows) (x0) (y0) (aa) (y) (x) =
    if x >= gw then 0
    else let v = list-at px (y * gw + x)
    in let grey = (if v > 255 then 255 else v) * 65793
    in let d = if v <= 0 then 0 else gop-fill-rect fb-base stride rows (x0 + x * zoom) (y0 + y * zoom) zoom zoom (if aa then grey else chalk)
    in put-glyph-row px gw stride rows x0 y0 aa y (x + 1)

  put-glyph-rows : List Integer, Integer, Integer, Integer, Integer, Integer, Integer, Boolean, Integer -> Integer
  put-glyph-rows (px) (gw) (gh) (stride) (rows) (x0) (y0) (aa) (y) =
    if y >= gh then 0
    else let d = put-glyph-row px gw stride rows x0 y0 aa y 0
    in put-glyph-rows px gw gh stride rows x0 y0 aa (y + 1)

  put-glyph : RasterGlyph, Integer, Integer, Integer, Integer, Boolean -> Integer
  put-glyph (rg) (stride) (rows) (x0) (y0) (aa) = put-glyph-rows (rg.rg-pixels) (rg.rg-width) (rg.rg-height) stride rows x0 y0 aa 0

  size-text : RasterGlyph -> Text
  size-text (rg) = show (rg.rg-width) & " x " & show (rg.rg-height)

Section: Entry

  opening : [Console] Nothing = act
    let w = peek-32 cell-width 0
    in let h = peek-32 cell-height 0
    in let stride = peek-32 cell-stride 0
    in let bg = gop-fill-rect fb-base stride h 0 0 w h paper
    in let font = ttf-parse test-font-bytes
    in let p16 = gr-render-glyph font 65 16
    in let p24 = gr-render-glyph font 65 24
    in let p32 = gr-render-glyph font 65 32
    in let a16 = gr-render-glyph-aa font 65 16
    in let a24 = gr-render-glyph-aa font 65 24
    in let a32 = gr-render-glyph-aa font 65 32
    in let d1 = put-glyph p16 stride h 10 10 False
    in let d2 = put-glyph p24 stride h 70 10 False
    in let d3 = put-glyph p32 stride h 156 10 False
    in let d4 = put-glyph a16 stride h 10 125 True
    in let d5 = put-glyph a24 stride h 70 125 True
    in let d6 = put-glyph a32 stride h 156 125 True
    in act
      print-line-uni ("plain       : " & size-text p16 & ", " & size-text p24 & ", " & size-text p32)
      print-line-uni ("anti-aliased: " & size-text a16 & ", " & size-text a24 & ", " & size-text a32)
    end
  end
