# Cobblestone Roc Projects on this box: one Caddy, a path per app, a port per
# channel. Run by the roc-site user service (ops/roc-site.service). Prod is
# https://roc.lynrummy.com, on the prod droplet (ops/roc.lynrummy.com.caddy).
#
#   :9210  dev      ~/build/roc-apps/next/, what the build scripts last wrote
#   :9200  staging  roc-apps/site/live/, what site/publish.sh last moved there
#
# The ports announced before the site answer with redirects, 302 so that a
# later change of target reaches a browser that followed one before: :9201
# (Safari) to prod's safari/; :9203 (the old preview) to prod for basic/ and to
# dev at the same path for the rest; :9204 and :9205 (the gallery and the
# games, never announced) to staging's gpu/ and games/.
#
# Every response is no-store, because a cached module looks exactly like a
# build that changed nothing, and asks for cross-origin isolation, because the
# framebuffer page shares memory with its Web Worker through a
# SharedArrayBuffer, which a browser gives only an isolated page.
{
	persist_config off
}

(roc) {
	header Cache-Control "no-store, must-revalidate"
	header Cross-Origin-Opener-Policy same-origin
	header Cross-Origin-Embedder-Policy require-corp
	file_server
}

:9200 {
	root * {$HOME}/showell_repos/roc-apps/site/live
	import roc
}

:9210 {
	root * {$HOME}/build/roc-apps/next
	import roc
}

:9201 {
	redir https://roc.lynrummy.com/safari/ 302
}

:9203 {
	@basic path /basic /basic/*
	redir @basic https://roc.lynrummy.com{uri} 302
	redir http://{host}:9210{uri} 302
}

:9204 {
	redir / http://{host}:9200/gpu/gallery.html 302
	redir http://{host}:9200/gpu{uri} 302
}

:9205 {
	redir / http://{host}:9200/ 302
	redir http://{host}:9200/games{uri} 302
}
