# Cobblestone Roc Projects in prod, https://roc.lynrummy.com. The prod droplet's
# Caddyfile (angry-gopher's deploy/Caddyfile) imports /etc/caddy/sites/*.caddy,
# where site/deploy.sh installs this file beside lynrummy.com's site block.
# It serves /srv/roc-site/, which site/deploy.sh copies verbatim from staging.
#
# no-cache where staging has no-store: a browser keeps a module and asks
# whether it changed, so it never runs a stale one and a repeat visit
# downloads nothing. Cross-origin isolation as on dev and staging, for the
# framebuffer page's SharedArrayBuffer. The security headers are
# lynrummy.com's.
roc.lynrummy.com {
	root * /srv/roc-site
	encode zstd gzip
	header {
		Cache-Control "no-cache"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}
	file_server
}
