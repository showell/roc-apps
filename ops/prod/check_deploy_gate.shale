-- ops/prod/check_deploy_gate.shale: deploy-gate.sh held to the commands the
-- two deploys send, on this box, with no prod. Each command is built here as
-- site/deploy.shale and roc-chat's tools/deploy.shale build it (a change to
-- either changes this file and deploy-gate.sh in the same commit), and
-- `deploy-gate.sh --check` must say `allowed` for each; then a list of
-- near misses and plain attacks must each say `refused`. From roc-apps' root:
--
--   shale ops/prod/check_deploy_gate.shale
--
-- The deploy user's home is a made-up /home/deploy, and roc-chat's staging
-- folder a made-up mktemp name in it.
-- budget: programs=200

const GATE = "ops/prod/deploy-gate.sh"
const HOME = "/home/deploy"
const STAGE = "/home/deploy/roc-chat-deploy.Ab3dE6gH"

function said(cmd)
  local r = must(run({GATE, "--check"}, {timeout_ms = 10000, tail = 2, env = {SSH_ORIGINAL_COMMAND = cmd, HOME = HOME}}))
  return trim(r.out)
end

-- ── site/deploy.shale's commands ──
const DIR = "/srv/roc-site"
const BLOCK = "roc.lynrummy.com.caddy"
local site = {
  "grep -qxF 'import /etc/caddy/sites/*.caddy' /etc/caddy/Caddyfile",
  "grep -q '^(access_log) {' /etc/caddy/Caddyfile",
  "sudo install -d -o \"$(id -un)\" -g \"$(id -un)\" -m 755 " .. DIR,
  "cd " .. DIR .. " && find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum",
  "cd " .. DIR .. " && find . ! -type f ! -type d -print",
  "cmp -s - /etc/caddy/sites/" .. BLOCK,
  "rsync --server -rlte.iLsfxCIvu --delete --chmod=D755,F644 . /srv/roc-site/",
  "scp -t /tmp/" .. BLOCK,
}
local B = "/etc/caddy/sites/" .. BLOCK
local T = "/tmp/" .. BLOCK
push(site, "set -e\n"
    .. "sudo install -d -m 755 /etc/caddy/sites\n"
    .. "# The block's access log, Caddy's before validate: validate runs as root\n"
    .. "# and would make it root's, and the reload would then fail.\n"
    .. "[ -f /var/log/caddy/roc-access.log ] || sudo install -o caddy -g caddy -m 640 /dev/null /var/log/caddy/roc-access.log\n"
    .. "[ -f " .. B .. " ] && sudo cp " .. B .. " " .. T .. ".old || sudo rm -f " .. T .. ".old\n"
    .. "sudo install -m 644 " .. T .. " " .. B .. "\n"
    .. "if ! sudo caddy validate --adapter caddyfile --config /etc/caddy/Caddyfile >" .. T .. ".validate 2>&1; then\n"
    .. "  tail -5 " .. T .. ".validate\n"
    .. "  if [ -f " .. T .. ".old ]; then sudo install -m 644 " .. T .. ".old " .. B .. "; else sudo rm -f " .. B .. "; fi\n"
    .. "  echo 'the new block did not validate; the old one is back'; exit 1\n"
    .. "fi\n"
    .. "sudo systemctl reload caddy\n"
    .. "# sudo cp made the .old root's, and /tmp is sticky, so only root removes it.\n"
    .. "rm -f " .. T .. " " .. T .. ".validate\n"
    .. "sudo rm -f " .. T .. ".old")

-- ── roc-chat's tools/deploy.shale's commands ──
const CHOME = "/var/lib/roc-chat"
const DATA = "/var/lib/roc-chat/data"
const PORT = "9611"
const UNIT = "roc-chat.service"
const CBLOCK = "chat.lynrummy.com.caddy"
const LOG = "/var/log/caddy/chat-access.log"
local chat = {
  "grep -qxF 'import /etc/caddy/sites/*.caddy' /etc/caddy/Caddyfile",
  "grep -q '^(access_log) {' /etc/caddy/Caddyfile",
  "set -e\n"
    .. "id rocchat >/dev/null 2>&1 || sudo useradd --system --home-dir " .. CHOME .. " --no-create-home --shell /usr/sbin/nologin rocchat\n"
    .. "sudo install -d -o root -g root -m 755 /opt/roc-chat\n"
    .. "sudo install -d -o rocchat -g rocchat -m 700 " .. CHOME .. " " .. DATA,
  "mktemp -d -p \"$HOME\" roc-chat-deploy.XXXXXXXX",
  "sudo install -d -o root -g root -m 755 /opt/roc-chat/admin",
  "[ -f /etc/systemd/system/" .. UNIT .. " ] && cmp -s " .. STAGE .. "/" .. UNIT .. " /etc/systemd/system/" .. UNIT,
  "set -e\nsudo install -o root -g root -m 644 " .. STAGE .. "/" .. UNIT .. " /etc/systemd/system/" .. UNIT .. "\nsudo systemctl daemon-reload\nsudo systemctl enable roc-chat",
  "rm -f " .. STAGE .. "/" .. UNIT,
  "set -e\nsudo systemctl restart roc-chat\n"
    .. "for _ in $(seq 1 50); do curl -fsS -o /dev/null http://127.0.0.1:" .. PORT .. "/login 2>/dev/null && break; sleep 0.1; done\n"
    .. "systemctl is-active roc-chat\n"
    .. "curl -fsS -o /dev/null http://127.0.0.1:" .. PORT .. "/login",
  "[ -f /etc/caddy/sites/" .. CBLOCK .. " ] && cmp -s " .. STAGE .. "/" .. CBLOCK .. " /etc/caddy/sites/" .. CBLOCK,
  "set -e\n"
    .. "sudo install -d -m 755 /etc/caddy/sites\n"
    .. "# The log is made Caddy's before validate, which runs as root and would make it root's.\n"
    .. "[ -f " .. LOG .. " ] || sudo install -o caddy -g caddy -m 640 /dev/null " .. LOG .. "\n"
    .. "if [ -f /etc/caddy/sites/" .. CBLOCK .. " ]; then sudo cp /etc/caddy/sites/" .. CBLOCK .. " " .. STAGE .. "/" .. CBLOCK .. ".old; else rm -f " .. STAGE .. "/" .. CBLOCK .. ".old; fi\n"
    .. "sudo install -m 644 " .. STAGE .. "/" .. CBLOCK .. " /etc/caddy/sites/" .. CBLOCK .. "\n"
    .. "if ! sudo caddy validate --adapter caddyfile --config /etc/caddy/Caddyfile >" .. STAGE .. "/" .. CBLOCK .. ".validate 2>&1; then\n"
    .. "  tail -5 " .. STAGE .. "/" .. CBLOCK .. ".validate\n"
    .. "  if [ -f " .. STAGE .. "/" .. CBLOCK .. ".old ]; then sudo install -m 644 " .. STAGE .. "/" .. CBLOCK .. ".old /etc/caddy/sites/" .. CBLOCK .. "; else sudo rm -f /etc/caddy/sites/" .. CBLOCK .. "; fi\n"
    .. "  echo 'the new block did not validate; the old one is back'; exit 1\n"
    .. "fi\n"
    .. "sudo systemctl reload caddy\n"
    .. "rm -f " .. STAGE .. "/" .. CBLOCK .. ".old " .. STAGE .. "/" .. CBLOCK .. ".validate",
  "rm -f " .. STAGE .. "/" .. CBLOCK,
  "rm -rf " .. STAGE,
  "scp -t " .. STAGE .. "/" .. UNIT,
  "scp -t " .. STAGE .. "/" .. CBLOCK,
}
for name in {".github-client-id", ".github-client-secret", "auth/1/name", "auth/next-id.txt", "chat/channel/general.channel", ".session-secret", "auth/1/github-id"} do
  push(chat, "sudo test -s " .. DATA .. "/" .. name)
end
-- install_on_prod: the binaries, then the admin files.
local installs = {{"roc-chat", "/opt/roc-chat/roc-chat", "755"}, {"shale", "/opt/roc-chat/shale", "755"}}
for f in {"chat_data.shale", "user_footprint.shale", "remove_user.shale", "read.mounts", "write.mounts"} do
  push(installs, {f, "/opt/roc-chat/admin/" .. f, "644"})
end
for i in installs do
  local staged = STAGE .. "/" .. i[1] .. ".new"
  push(chat, "scp -t " .. staged)
  push(chat, "sha256sum " .. staged)
  push(chat, "set -e\nsudo install -o root -g root -m " .. i[3] .. " " .. staged .. " " .. i[2] .. ".new\nsudo mv -f " .. i[2] .. ".new " .. i[2] .. "\nrm -f " .. staged)
end

local bad = {}
local n = 0
for cmd in site do
  n = n + 1
  if said(cmd) ~= "allowed" then push(bad, "refused site/deploy.shale's: " .. cmd) end
end
for cmd in chat do
  n = n + 1
  if said(cmd) ~= "allowed" then push(bad, "refused roc-chat's deploy's: " .. cmd) end
end

-- Near misses and plain attacks.
local refused = {
  "", "bash", "sh -i", "sftp", "internal-sftp", "/usr/lib/openssh/sftp-server", "sudo -i", "sudo bash",
  "grep -q x /etc/shadow", "cat ~/.ssh/authorized_keys",
  "grep -qxF 'import /etc/caddy/sites/*.caddy' /etc/caddy/Caddyfile; id",
  "cd " .. DIR .. " && find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum; rm -rf ~",
  "rsync --server --sender -rlte.iLsfxCIvu . /etc/",
  "rsync --server -rlte.iLsfxCIvu --delete --chmod=D755,F644 . /etc/",
  "scp -f /etc/shadow", "scp -t /etc/passwd", "scp -t /tmp/other.caddy", "scp -r -t " .. STAGE,
  "scp -t " .. STAGE .. "/../.ssh/authorized_keys", "scp -t /home/deploy/roc-chat-deploy.short/roc-chat.new",
  "rm -rf /home/deploy", "rm -rf " .. STAGE .. "/..", "rm -rf /home/deploy/roc-chat-deploy.Ab3dE6gH /etc",
  "sha256sum /etc/shadow", "sudo test -s /etc/shadow",
  "set -e\nsudo install -o root -g root -m 4755 " .. STAGE .. "/shale.new /opt/roc-chat/shale.new\nsudo mv -f /opt/roc-chat/shale.new /opt/roc-chat/shale\nrm -f " .. STAGE .. "/shale.new",
  "set -e\nsudo install -o root -g root -m 755 " .. STAGE .. "/roc-chat.new /usr/bin/sudo.new\nsudo mv -f /usr/bin/sudo.new /usr/bin/sudo\nrm -f " .. STAGE .. "/roc-chat.new",
}
for cmd in refused do
  n = n + 1
  if said(cmd) ~= "refused" then push(bad, "allowed: " .. cmd) end
end
if #bad > 0 then fail("check_deploy_gate: " .. #bad .. " of " .. n .. " answered wrong:\n" .. join(bad, "\n")) end
print("PASS check_deploy_gate: " .. (#site + #chat) .. " deploy commands allowed, " .. #refused .. " others refused")
