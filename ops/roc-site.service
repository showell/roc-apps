[Unit]
Description=Cobblestone Roc Projects: dev on 9210, staging on 9200 (Caddy, ops/Caddyfile)

[Service]
ExecStart=%h/build/caddy/caddy run --config %h/showell_repos/roc-apps/ops/Caddyfile --adapter caddyfile
ExecReload=%h/build/caddy/caddy reload --config %h/showell_repos/roc-apps/ops/Caddyfile --adapter caddyfile
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
