-- This script holds every hand-written Roc file in roc-apps to the bar that
-- CLAUDE.md §3 sets: `roc fmt --check` passes over all of them, and
-- `roc check` finds no errors and no warnings in any app. It runs the
-- pinned compiler (`roc-version`, installed at tools:roc-<pin>/roc, found
-- by the repository's prelude, `.shale/prelude.shale`) and
-- prints a line for each app that fails, then one verdict line.
--
--   cd <roc-apps checkout> && shale check.shale
--
-- Each app is checked from its own folder, so it reports every module it
-- imports. The apps are held exactly by apps.txt, one app's path a line,
-- sorted, so an app that stops being found fails the run as surely as one
-- that stops compiling; add or remove an app, and add or remove its line.
-- The list is checked first, before anything slow, and a difference fails
-- the run naming each app missing from the tree or missing from the file.
-- A list, not a count: two branches that each add an app each add a line,
-- and git merges them to the right list (or conflicts where they collide),
-- where two edits of one count from N to N+1 merged silently to one short.
--
-- It also fails when a Roc on Shale page under site/web/roc-on-shale/ (the
-- index, and a page for each recipe and shared package) isn't what
-- site/build_roc_on_shale.shale would write now, or a file it quotes from
-- the shale checkout has moved since its lock, site/roc_on_shale.quotes,
-- which needs the shale and roc-syntax-color checkouts beside this one; when
-- the chess toys' code page, site/web/chess/code/index.html, isn't what
-- site/build_chess_code.shale would write from the sources as they stand;
-- when the security idioms page, site/web/security-idioms/index.html, isn't
-- what site/build_security_idioms.shale would write from its prose and the
-- roc-chat code it quotes by name, or that code has moved on roc-chat's
-- `main` since its lock, site/security_idioms.quotes, which needs the
-- roc-chat checkout beside this one (both builders quote through
-- tools/quote_code.shale); and when the RC1 article,
-- site/web/release-candidate-compiles/index.html, isn't what
-- site/build_rc1_article.shale would write from its prose, the stats TSV,
-- its reduced programs and the commits it quotes, which needs the
-- roc-screensaver checkout beside this one. It runs
-- site/deploy_test.shale, the prod deploy's refusals before it reaches prod,
-- which needs a shale with `run`'s `secret_args` and asks 1.1.1.1 for
-- roc.lynrummy.com. And it runs js/oracle.shale, which grades the JavaScript
-- subset's interpreter against node on every program in js/tests/, and
-- js/canvas.shale, which holds each canvas sample in js/canvas/ to its
-- golden log of effects.
--
-- `shale check.shale basic=1` is the BASIC tier instead, kept out of the
-- default run for its time (about a minute and a half, half of it the
-- release build's compiling, the rest the counting; under a minute when
-- tools/roc_build.shale already holds both builds of these inputs): basic/controls.shale holds the release build's
-- allocations to basic/controls/expected.txt and the dev build's to
-- expected-dev.txt.
--
-- `shale check.shale js=1` is the JavaScript subset's allocation tier, kept
-- out of the default run for its time (11 to 17 minutes when the release
-- build compiles, most of that RC1's SpecConstr pass, tag
-- rc1-slow-release-build; seconds when tools/roc_build.shale
-- already holds both builds of these inputs): js/controls.shale holds the release
-- build's allocations a pass to js/controls/expected.txt and the dev
-- build's to expected-dev.txt.
--
-- `shale check.shale copy_shapes=1` is the copy shapes' tier, also kept out
-- of the default run (about half a minute, 18 s with its builds reused): tools/copy_shapes/copy_shapes.shale
-- holds what one more write allocates in each way of writing into a list, a
-- record or a dict to its expected file, in the release, dev and boxy
-- (`--specialize=no`) builds, so docs/roc-notes.md, "Speed and copying",
-- says only what they show.
--
-- A few places are left out, each for the reason beside it in EXCEPTIONS.
-- Each is a debt, named here and nowhere else.
--
-- budget: steps=200000000

const APPS_LIST = "apps.txt"
const CHUNK = 50
const SELF_PATH = "check.shale"
const WANT = "roc-pin: the repository's pinned nightly"

const EXCEPTIONS = {
  {prefix = "canvas_apps/safari/tutorial/fails/", why = "programs that fail on purpose: the tutorial's builder checks that they do"},
  {prefix = "site/", why = "the published site's copies, built from the trees checked here"},
}

function excepted(path)
  for e in EXCEPTIONS do
    if starts_with(path, e.prefix) then return true end
  end
  return false
end

-- The tracked Roc files that aren't excepted; with `apps_only`, the apps.
function roc_files(apps_only)
  local argv = {"git", "ls-files", "*.roc"}
  if apps_only then argv = {"git", "grep", "-l", "-E", "^app \\[", "--", "*.roc"} end
  local r = run(argv, {timeout_ms = 30000, whole = 4000000})
  local kept = {}
  for f in lines(trim(r.out)) do
    if not excepted(f) then push(kept, f) end
  end
  return kept
end

function copy_list(l)
  local out = {}
  for x in l do push(out, x) end
  return out
end

-- What is wrong with apps.txt against the apps found, one line each: a
-- blank line, a repeat or a line out of order in the file, then each app it
-- names that isn't in the tree, then each app in the tree it doesn't name.
function app_list_wrongs(apps)
  local wrongs = {}
  local listed = lines(trim(read(APPS_LIST)))
  local seen = {}
  local n = 0
  for l in listed do
    n = n + 1
    if trim(l) == "" then push(wrongs, APPS_LIST .. ":" .. n .. " is blank")
    elseif has_key(seen, l) then push(wrongs, APPS_LIST .. ":" .. n .. ": " .. l .. " is listed twice")
    else seen[l] = true end
  end
  local in_order = copy_list(listed)
  sort(in_order)
  local i = 1
  while i <= #listed do
    if listed[i] ~= in_order[i] then
      push(wrongs, APPS_LIST .. ":" .. i .. ": " .. listed[i] .. " is out of order (sorted, line " .. i .. " is " .. in_order[i] .. ")")
      i = #listed
    end
    i = i + 1
  end
  local found = set_of(apps)
  for l in listed do
    if trim(l) ~= "" and not has_key(found, l) then push(wrongs, l .. " is in " .. APPS_LIST .. " but is no app in the tree") end
  end
  for a in apps do
    if not has_key(seen, a) then push(wrongs, a .. " is an app missing from " .. APPS_LIST) end
  end
  return wrongs
end


-- One app's check: nil when clean, else why not.
function check_app(roc, path)
  local m = re_find(path, "^(.*)/([^/]+)$")
  local r = run({"nice", "-n", "19", roc, "check", m.groups[2]}, {cwd = m.groups[1], timeout_ms = 120000, whole = 4000000, want = WANT})
  if not has_key(r, "code") then return "no answer in 120 s" end
  if r.code == 0 and contains(r.out, "No errors found") then return nil end
  local summary = "exit " .. r.code
  for l in lines(r.out) do
    if contains(l, "errors and") then summary = trim(l) end
  end
  return summary
end

-- One chunk of the apps, run as a child so each child has its own budget of
-- programs.
function part(k)
  local roc = pinned_roc("check")
  local apps = roc_files(true)
  local bad = 0
  local first = (k - 1) * CHUNK + 1
  local last = k * CHUNK
  if last > #apps then last = #apps end
  local i = first
  while i <= last do
    local why = check_app(roc, apps[i])
    if why ~= nil then
      print("FAIL " .. apps[i] .. ": " .. why)
      bad = bad + 1
    end
    i = i + 1
  end
  print("part " .. k .. ": " .. (last - first + 1) .. " apps, " .. bad .. " failed")
  if bad > 0 then fail("check: part " .. k .. " failed") end
end

function all()
  local apps = roc_files(true)
  local wrongs = app_list_wrongs(apps)
  for w in wrongs do print("FAIL apps: " .. w) end
  if #wrongs > 0 then fail("check: the apps found differ from " .. APPS_LIST .. " (" .. #wrongs .. " above); add or remove its lines") end
  print("apps: " .. #apps .. " found, each listed in " .. APPS_LIST)
  local failed = {}
  -- The Roc on Shale page is written from the shale and roc-syntax-color
  -- checkouts beside this one; a missing one fails here, named.
  local page = run({"shale", "--root", ".", "site/build_roc_on_shale.shale", "check=1"}, {timeout_ms = 300000, tail = 10})
  print(trim(page.out))
  if page.code ~= 0 then push(failed, "the Roc on Shale pages") end
  local chess = run({"shale", "--root", ".", "site/build_chess_code.shale", "check=1"}, {timeout_ms = 300000, tail = 10})
  print(trim(chess.out))
  if chess.code ~= 0 then push(failed, "the chess code page") end
  local idioms = run({"shale", "--root", ".", "site/build_security_idioms.shale", "check=1"}, {timeout_ms = 300000, tail = 10})
  print(trim(idioms.out))
  if idioms.code ~= 0 then push(failed, "the security idioms page") end
  local rc1 = run({"shale", "--root", ".", "site/build_rc1_article.shale", "check=1"}, {timeout_ms = 300000, tail = 10})
  print(trim(rc1.out))
  if rc1.code ~= 0 then push(failed, "the RC1 article") end
  local deploy = run({"shale", "--root", ".", "site/deploy_test.shale"}, {timeout_ms = 300000, tail = 40})
  print(trim(deploy.out))
  if deploy.code ~= 0 then push(failed, "the deploy's refusals") end
  local js = run({"shale", "--root", ".", "js/oracle.shale"}, {timeout_ms = 600000, tail = 80, not_re = "^PASS "})
  print(trim(js.out))
  if js.code ~= 0 then push(failed, "the JavaScript subset against node") end
  local canvas = run({"shale", "--root", ".", "js/canvas.shale"}, {timeout_ms = 600000, tail = 20, not_re = "^PASS "})
  print(trim(canvas.out))
  if canvas.code ~= 0 then push(failed, "the canvas samples against their logs") end
  local roc = pinned_roc("check")
  local files = roc_files(false)
  local fmt = {roc, "fmt", "--check"}
  for f in files do push(fmt, f) end
  local f = run(fmt, {timeout_ms = 600000, whole = 4000000, want = WANT})
  if f.code ~= 0 then
    print("FAIL roc fmt --check: " .. trim(f.out))
    push(failed, "fmt")
  else
    print("roc fmt: " .. #files .. " files clean")
  end
  local parts = (#apps + CHUNK - 1) // CHUNK
  local k = 1
  while k <= parts do
    local r = run({"shale", "--root", ".", SELF_PATH, "part=" .. k}, {timeout_ms = 3600000, tail = 60})
    print(trim(r.out))
    if r.code ~= 0 then push(failed, "part " .. k) end
    k = k + 1
  end
  for e in EXCEPTIONS do print("left out: " .. e.prefix .. " (" .. e.why .. ")") end
  if #failed > 0 then fail("check: " .. join(failed, ", ") .. " failed") end
  print("check: " .. #apps .. " apps without errors or warnings, " .. #files .. " files formatted")
end

-- One run of a tier's script, its output's last 60 lines printed, and above
-- them each line tools/roc_build.shale wrote (`built ...` or `reused ...`),
-- so the tier says what it compiled however long the ladder's output.
function tier_run(script, opt)
  local r = run({"shale", "--root", ".", script, "opt=" .. opt}, {timeout_ms = 1800000, whole = 4000000})
  local all = lines(trim(r.out))
  local cut = #all - 60
  for i = 1, cut do
    if re_match(all[i], "^(built|reused) ") then print(all[i]) end
  end
  print(join(last(all, 60), "\n"))
  return r
end

-- The BASIC tier: the controls in the release build, then in the dev build.
function basic_tier()
  local failed = {}
  for opt in {"speed", "dev"} do
    local r = tier_run("basic/controls.shale", opt)
    if r.code ~= 0 then push(failed, "the BASIC controls, --opt=" .. opt) end
  end
  if #failed > 0 then fail("check: " .. join(failed, ", ") .. " failed") end
  print("check basic=1: the BASIC controls hold in both builds")
end

-- The JavaScript tier: the controls in the release build, then in the dev
-- build.
function js_tier()
  local failed = {}
  for opt in {"speed", "dev"} do
    local r = tier_run("js/controls.shale", opt)
    if r.code ~= 0 then push(failed, "the JavaScript controls, --opt=" .. opt) end
  end
  if #failed > 0 then fail("check: " .. join(failed, ", ") .. " failed") end
  print("check js=1: the JavaScript controls hold in both builds")
end

-- The copy shapes' tier: the release, dev and boxy builds, each held to its
-- expected file.
function copy_shapes_tier()
  local failed = {}
  for opt in {"speed", "dev", "boxy"} do
    local r = tier_run("tools/copy_shapes/copy_shapes.shale", opt)
    if r.code ~= 0 then push(failed, "the copy shapes, opt=" .. opt) end
  end
  if #failed > 0 then fail("check: " .. join(failed, ", ") .. " failed") end
  print("check copy_shapes=1: the copy shapes hold in all three builds")
end

const PART = arg("part", "")
const BASIC = arg("basic", false)
const JS = arg("js", false)
const COPY_SHAPES = arg("copy_shapes", false)
if BASIC then
  basic_tier()
elseif JS then
  js_tier()
elseif COPY_SHAPES then
  copy_shapes_tier()
elseif PART == "" then
  all()
else
  part(tonumber(PART))
end
