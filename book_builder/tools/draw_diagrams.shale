-- budget: steps=50000000 arena_bytes=1000000000 read_bytes=200000000 call_bytes=40000000
-- This draws a book's diagrams with Graphviz, for a book's pre-step. A diagram
-- is a ```dot fence of the manuscript, as book_builder/builder/Diagrams.roc
-- finds them; this writes the Nth one's source to diagram-N.dot in the book's
-- folder of prepared files, and its drawing beside it as diagram-N.svg, ready
-- to sit in a page:
--
--   cd <roc-apps checkout> && shale book_builder/tools/draw_diagrams.shale source=<manuscript> prepared=<folder>
--
-- It prints how many it drew. The Safari tutorial's book.shale and the books
-- book's book.shale run it.
--
-- Graphviz's comments and titles are dropped from a drawing, because a title
-- shows as a tooltip on hover. A diagram wider than a phone is drawn a second
-- way for a phone, turned and tightened, and book.css shows one of the two.
--
-- Each diagram takes Graphviz once or twice, and a run has a budget of
-- programs, so the diagrams are drawn in child runs of this script, each given
-- `first=` and `last=`, DIAGRAMS_PER_RUN at a time. A child that fails stops the
-- run, and so does a drawing it didn't leave.
const PREPARED = arg("prepared", "")
const SELF = "book_builder/tools/draw_diagrams.shale"
const DIAGRAMS_PER_RUN = 30
const PHONE_POINTS = 300
const DOT_WANT = "graphviz: a book's diagrams, drawn at build time"

-- Each ```dot fence's source, written to its diagram-N.dot, as Diagrams.roc
-- finds the fences; gives how many there are.
function write_diagram_sources(source)
  local count = 0
  local open = "none"
  local body = {}
  for l in split(read(source), "\n") do
    if open == "none" then
      if l == "```dot" then
        open = "dot"
        body = {}
      elseif starts_with(l, "```") then
        open = "other"
      end
    elseif l == "```" then
      if open == "dot" then
        count = count + 1
        replace(PREPARED .. "/diagram-" .. count .. ".dot", join(body, "\n") .. "\n")
      end
      open = "none"
    elseif open == "dot" then
      push(body, l)
    end
  end
  if open ~= "none" then fail("draw_diagrams: a fence never closes in " .. source) end
  return count
end

-- The drawing of one diagram, and how wide it is in points.
function drawing(path, options, class)
  local argv = {"dot", "-Tsvg", "-Gfontsize=12", "-Nfontsize=12", "-Efontsize=11", "-Nmargin=0.13,0.06"}
  for option in options do push(argv, option) end
  push(argv, real(path))
  local r = must(run(argv, {timeout_ms = 30000, whole = 2000000, want = DOT_WANT}))
  local at = find(r.out, "<svg ")
  if at == nil or not starts_with(r.out, "<?xml") then fail("draw_diagrams: dot said more than a drawing for " .. path .. ": " .. r.out) end
  local kept = {}
  for l in lines(sub(r.out, at + 5)) do
    if not starts_with(l, "<!--") and not starts_with(l, "<title>") then push(kept, l) end
  end
  local width = re_find(r.out, "<svg width=\"([0-9]+)pt\"")
  if width == nil then fail("draw_diagrams: no width in the drawing of " .. path) end
  return {svg = "<svg class=\"" .. class .. "\" role=\"img\" " .. join(kept, "\n"), width = tonumber(width.groups[1])}
end

-- A line of a diagram with the list in its label down the page, a name a line.
function label_list_down(l)
  local open = find(l, "label=\"")
  if open == nil then return l end
  local close = find(l, "\"", open + 7)
  if close == nil then return l end
  local label = join(split(sub(l, open + 7, close - 1), ", "), ",\\n")
  return sub(l, 1, open + 6) .. label .. sub(l, close)
end

-- A diagram's source for a phone: a row of boxes runs down the page instead, and
-- a label's list does too. A record's fields are side by side, so a record
-- diagram turns the other way, for `phone_options` to say.
function phone_source(source)
  local kept = {}
  for l in source do
    if trim(l) ~= "rankdir=LR;" then push(kept, label_list_down(l)) end
  end
  return join(kept, "\n") .. "\n"
end

function phone_options(source)
  local options = {"-Gnodesep=0.12", "-Granksep=0.3", "-Nmargin=0.06,0.04"}
  if contains(join(source, "\n"), "shape=record") then push(options, "-Grankdir=LR") end
  return options
end

-- A diagram's drawing, and a phone's beside it if it needs one. The .dot file
-- ends with the one newline write_diagram_sources adds after the fence's last
-- line.
function diagram_svg(id)
  local path = PREPARED .. "/" .. id .. ".dot"
  local all = split(read(path), "\n")
  local source = take(all, #all - 1)
  local plain = drawing(path, {}, "diagram")
  if plain.width <= PHONE_POINTS then return plain.svg end
  local phone_path = PREPARED .. "/" .. id .. "-phone.dot"
  replace(phone_path, phone_source(source))
  local wide = join(split(plain.svg, "<svg class=\"diagram\""), "<svg class=\"diagram diagram-wide\"")
  return wide .. drawing(phone_path, phone_options(source), "diagram diagram-phone").svg
end

-- A child run's work: diagrams `first` to `last` drawn into their .svg files.
function draw_some(first, last)
  for n = first, last do
    local id = "diagram-" .. n
    replace(PREPARED .. "/" .. id .. ".svg", diagram_svg(id))
  end
  return nil
end

function draw_all(count)
  local first = 1
  while first <= count do
    local last = first + DIAGRAMS_PER_RUN - 1
    if last > count then last = count end
    must(run({"shale", "--root", ".", SELF, "prepared=" .. PREPARED, "first=" .. first, "last=" .. last}, {timeout_ms = 300000, tail = 20, want = DOT_WANT}))
    first = last + 1
  end
  for n = 1, count do
    if not exists(PREPARED .. "/diagram-" .. n .. ".svg") then fail("draw_diagrams: no drawing of diagram-" .. n) end
  end
  return nil
end

const SOURCE = arg("source", "")
const FIRST = arg("first", "")
const LAST = arg("last", "")
if PREPARED == "" or not exists(PREPARED) then fail("draw_diagrams: prepared= names the book's folder of prepared files, which is there") end
if SOURCE ~= "" then
  local count = write_diagram_sources(SOURCE)
  draw_all(count)
  print("draw_diagrams: " .. count .. " diagrams drawn")
elseif FIRST ~= "" and LAST ~= "" then
  draw_some(tonumber(FIRST), tonumber(LAST))
else
  fail("draw_diagrams: source= draws a manuscript's diagrams; first= and last= are a child run's")
end
