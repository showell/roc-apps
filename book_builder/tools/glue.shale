-- Regenerates roc glue's snapshot of the book platform's seam,
-- book_builder/host/glue/platform_abi.zig, which host/abi_test.zig holds
-- host/abi.zig to. Run it from the roc-apps root after any change to
-- book_builder/platform/:
--   shale book_builder/tools/glue.shale
-- It runs `roc glue` with roc-apps' pinned compiler (roc-version, found by
-- the repository's prelude) and Roc's Zig glue spec, which the compiler does
-- not ship, into book_builder/.zig-cache/roc-glue, then `zig fmt`, then
-- writes the snapshot, saying whether it changed.
--
-- With `check=1` it writes nothing, and fails when the snapshot is not what
-- glue makes of the platform now; the gate (tools/verify.shale) runs it so.
--
-- The spec is read from a Roc source checkout at the pin's commit,
-- ~/tools/roc-<commit>, as roc-screensaver's tools/glue.shale reads it.

const checking = arg("check", 0) == 1
const here = "book_builder"
const out_dir = "book_builder/.zig-cache/roc-glue"
const snapshot = "book_builder/host/glue/platform_abi.zig"

if not exists(here .. "/platform/main.roc") then
  fail("glue: run it from the roc-apps root (no book_builder/platform/main.roc here)")
end

const roc = pinned_roc("glue")
const pin = trim(read("roc-version"))
local parts = split(pin, "-")
local commit = parts[#parts]
local spec = "tools:roc-" .. commit .. "/src/glue/src/ZigGlue.roc"
if not exists(spec) then
  fail("glue: no glue spec at " .. spec .. ": check out roc-lang/roc at " .. commit .. " as ~/tools/roc-" .. commit)
end

if exists(out_dir) then remove_tree(out_dir) end
mkdir(out_dir)
must(run({roc, "glue", real(spec), real(out_dir), "platform/main.roc"}, {cwd = here, timeout_ms = 60000, tail = 20}))
const made = out_dir .. "/roc_platform_abi.zig"
must(run({"zig", "fmt", real(made)}, {timeout_ms = 30000, tail = 20}))

local after = read(made)
if exists(snapshot) and read(snapshot) == after then
  print("glue: " .. snapshot .. " unchanged (roc " .. pin .. ")")
elseif checking then
  fail("glue: " .. snapshot .. " is not what roc glue makes of book_builder/platform/: run shale book_builder/tools/glue.shale")
else
  if not exists(here .. "/host/glue") then mkdir(here .. "/host/glue") end
  replace(snapshot, after)
  print("glue: " .. snapshot .. " written (roc " .. pin .. "): `zig build test` holds host/abi.zig to it")
end
