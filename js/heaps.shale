-- This script measures what the JavaScript subset's VM holds at the end of
-- a run, for every corpus program in js/tests/ and the garbage-making
-- programs in js/heaps/: the steps it ran, the heap's cells, the cells still
-- live and the collections run (js-vm's `--counts` line), and the process's
-- peak memory. The collector frees the cells a program no longer reaches,
-- so the heap stays the size of what the program keeps.
--
--   cd <roc-apps checkout> && shale js/heaps.shale             build js-vm --opt=speed, then measure
--   cd <roc-apps checkout> && shale js/heaps.shale opt=dev     the dev build
--
-- The peak is GNU time's maximum resident set size, in KiB.
--
-- budget: steps=50000000

use("./js_builds.shale")

const WHO = "js/heaps.shale"
const WANT_TIME = "js-heaps: GNU time reads js-vm's peak memory, which Shale's run doesn't report"
const OPT = arg("opt", "speed")
-- js-vm's counts line, its four numbers in order, and their column names.
const COUNTS = "js-vm: steps ([0-9]+) cells ([0-9]+) live ([0-9]+) collections ([0-9]+)"
const COLUMNS = {"steps", "cells", "live", "collections"}

function measured(exe, label, src)
  local argv = {"/usr/bin/time", "-f", "peak %M", exe, src, "--counts"}
  local r = run(argv, {timeout_ms = 300000, tail = 4, want = WANT_TIME})
  -- A program that ends in a throw nothing catches exits 1, as node does,
  -- and still prints its counts first.
  if r.ended ~= "exit" or r.code > 1 then fail(WHO .. ": " .. label .. " ended " .. r.ended .. " " .. get(r, "code", "") .. ": " .. r.out) end
  local m = re_find(r.out, COUNTS)
  local k = re_find(r.out, "peak ([0-9]+)")
  if m == nil or k == nil then fail(WHO .. ": " .. label .. ": no counts or no peak in " .. r.out) end
  local row = pad(label, 36)
  for i = 1, 4 do row = row .. pad(m.groups[i], -12) end
  print(row .. pad(k.group, -10) .. "   " .. r.cpu_ms)
end

function main()
  local exe = js_build(WHO, "js-vm", "JsVm.roc", OPT)
  local head = pad("program", 36)
  for c in COLUMNS do head = head .. pad(c, -12) end
  print(head .. pad("peak KiB", -10) .. "   CPU ms")
  for f in glob("js/tests/*.js") do measured(exe, basename(f), read(f)) end
  for f in glob("js/heaps/*.js") do measured(exe, "heaps/" .. basename(f), read(f)) end
end

main()
