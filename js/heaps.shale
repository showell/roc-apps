-- This script measures what the JavaScript subset's interpreter holds at
-- the end of a run: the heap's cells, the scopes alive and the process's
-- peak memory, for every corpus program in js/tests/ and the garbage-making
-- programs in js/heaps/. Cells are never freed, so a program that makes an
-- object a pass holds every one of them at its end.
--
--   cd <roc-apps checkout> && shale js/heaps.shale             build js-count --opt=speed, then measure
--   cd <roc-apps checkout> && shale js/heaps.shale build=0     the js-count already built
--
-- The peak is GNU time's maximum resident set size, in KiB.
--
-- budget: steps=50000000

use("./js_builds.shale")

const WHO = "js/heaps.shale"
const WANT_TIME = "js-heaps: GNU time reads js-count's peak memory, which Shale's run doesn't report"

const BUILD = arg("build", true)

function measured(exe, label, src)
  local r = run({"/usr/bin/time", "-f", "peak %M", exe, src}, {timeout_ms = 300000, tail = 4, want = WANT_TIME})
  if r.ended ~= "exit" or r.code ~= 0 then fail(WHO .. ": " .. label .. " ended " .. r.ended .. " " .. get(r, "code", "") .. ": " .. r.out) end
  local m = re_find(r.out, "js-count: steps ([0-9]+) cells ([0-9]+) scopes ([0-9]+)")
  local k = re_find(r.out, "peak ([0-9]+)")
  if m == nil or k == nil then fail(WHO .. ": " .. label .. ": no counts or no peak in " .. r.out) end
  print(pad(label, 36) .. pad(m.groups[1], -10) .. pad(m.groups[2], -10) .. pad(m.groups[3], -10) .. pad(k.group, -10) .. "   " .. r.cpu_ms)
end

function main()
  if BUILD then build_js(WHO, "js-count", "JsCount.roc", "speed") end
  local exe = built_js(WHO, "js-count", "speed")
  print(pad("program", 36) .. pad("steps", -10) .. pad("cells", -10) .. pad("scopes", -10) .. pad("peak KiB", -10) .. "   CPU ms")
  for f in glob("js/tests/*.js") do measured(exe, basename(f), read(f)) end
  for f in glob("js/heaps/*.js") do measured(exe, "heaps/" .. basename(f), read(f)) end
end

main()
