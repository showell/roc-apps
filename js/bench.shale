-- This script times the JavaScript subset's interpreter on the programs in
-- js/bench/, in the dev build and the release build, each run three times,
-- the fastest kept. Times are js-run's CPU time, so a busy box slows them
-- less than wall time, but they are still rough: each run prints which
-- other heavy programs were running beside it.
--
--   cd <roc-apps checkout> && shale js/bench.shale             build both, then time
--   cd <roc-apps checkout> && shale js/bench.shale opt=dev     the dev build alone
--
-- budget: steps=20000000

use("./js_builds.shale")

const WANT_RUN = "js-run: the interpreter timed, built here"
const WHO = "js/bench.shale"
const TRIES = 3

const OPT = arg("opt", "both")

-- The heavy programs running beside the bench, which slow its times.
function busy()
  local seen = {}
  for p in procs() do
    for name in {"basic-run", "js-run", "count_allocs", "roc", "zig", "node", "cc", "gcc", "chrome", "firefox", "tcc"} do
      if p.name == name then seen[name] = true end
    end
  end
  local names = keys(seen)
  sort(names)
  if #names == 0 then return "nothing else heavy running" end
  return "running beside: " .. join(names, ", ")
end

-- The fastest of TRIES runs' CPU time, in ms.
function fastest_ms(exe, src)
  local best = -1
  local i = 0
  while i < TRIES do
    local r = run({exe, src}, {timeout_ms = 120000, tail = 3, want = WANT_RUN})
    if r.ended ~= "exit" or r.code ~= 0 then fail(WHO .. ": js-run ended " .. r.ended .. " " .. get(r, "code", "") .. ": " .. r.out) end
    if best < 0 or r.cpu_ms < best then best = r.cpu_ms end
    i = i + 1
  end
  return best
end

function main()
  local opts = {"dev", "speed"}
  if OPT ~= "both" then opts = {OPT} end
  local exes = {}
  for opt in opts do exes[opt] = js_build(WHO, "js-run", "JsRun.roc", opt) end
  print(busy())
  for f in glob("js/bench/*.js") do
    local src = read(f)
    local cells = {}
    for opt in opts do push(cells, opt .. " " .. fastest_ms(exes[opt], src) .. " ms") end
    print(pad(strip_suffix(basename(f), ".js"), 10) .. "  " .. join(cells, "   "))
  end
  print(busy())
end

main()
