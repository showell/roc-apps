-- The JavaScript subset's commands, for js/oracle.shale, js/canvas.shale,
-- js/probes.shale, js/controls.shale, js/bench.shale and js/heaps.shale:
-- `use("./js_builds.shale")`.
--
-- Each command (`js-run` from js/roc/JsRun.roc, `js-count` from
-- js/roc/JsCount.roc, `js-canvas` from js/roc/JsCanvas.roc) comes from
-- tools/roc_build.shale through the prelude's built_roc, `opt` being `dev`
-- (the dev backend) or `speed` (the release build, through LLVM): built only
-- when its cache holds no build of these inputs, so a second run of
-- unchanged code compiles nothing. Its line, built or reused, is printed.

-- This checkout's folder for the plans a script writes for `opt`, made if
-- it isn't there.
function js_out_dir(opt)
  local dir = "build:roc-apps/gen/js/" .. basename(real(".")) .. "/" .. opt
  mkdir(dir)
  return dir
end

-- The command `name` built from js/roc/<source> in `opt`, by its real path.
function js_build(who, name, source, opt)
  return built_roc(who, "js/roc/" .. source, name, opt)
end
