-- This script holds each canvas sample in js/canvas/ to its golden log: the
-- sample run by js-canvas, the recording host (js/roc/JsCanvas.roc), whose
-- every effect and read, in the order the program made them, must be
-- js/canvas/<name>.log byte for byte, its exit code included.
--
--   cd <roc-apps checkout> && shale js/canvas.shale            build js-canvas, then grade
--   cd <roc-apps checkout> && shale js/canvas.shale freeze=4-starfield
--                                  write that sample's log anew from what it does now
--
-- js/canvas/goldens.txt names each sample, one a line: its name, the frames
-- to record, the keys down in each (`-` for none) and the clicks before
-- them (js-canvas's header says how both are written), the last two left
-- out when there are none. Every sample there is graded and every sample file must be
-- named there: none is skipped, and the run fails unless all of them pass.
-- Each program in js/canvas/rails/ must stop: its first line, `// stops:
-- <text>`, is what js-canvas's last line (`js: <why>`) must hold, after three
-- frames at most, and js-canvas must exit 1; each line `// before: <line>`
-- must be a line it printed first, so what a program drew before its stop
-- stays drawn. And js-run, on the core library, must not know a canvas
-- builtin: `forward(10)` is a ReferenceError there, as in node.
--
-- A canvas builtin is ours, not node's, so these logs are the canvas's
-- oracle, as node is the language's (js/oracle.shale). A log moves only by
-- `freeze=`, for a change whose every moved line the commit explains.
--
-- budget: steps=50000000

const WANT_CANVAS = "js-canvas: the recording host under test, built here"
const RUN_MS = 60000

const FREEZE = arg("freeze", "")

use("./js_builds.shale")

-- What a sample printed and how it ended, as one text.
function recorded(exe, entry)
  local argv = {exe, entry.frames, read("js/canvas/" .. entry.name .. ".js")}
  if entry.keys ~= "" or entry.clicks ~= "" then push(argv, entry.keys) end
  if entry.clicks ~= "" then push(argv, entry.clicks) end
  local r = run(argv, {timeout_ms = RUN_MS, whole = 8000000, want = WANT_CANVAS})
  if r.ended ~= "exit" then return r.out .. "[ended: " .. r.ended .. "]\n" end
  return r.out .. "[exit " .. r.code .. "]\n"
end

function entries()
  local out = {}
  for l in lines(trim(read("js/canvas/goldens.txt"))) do
    local w = words(l)
    if #w < 2 or #w > 4 then fail("js/canvas.shale: goldens.txt: `" .. l .. "` is not `<name> <frames> [<keys>|-] [<clicks>]`") end
    local keys = get(w, 3, "")
    if keys == "-" then keys = "" end
    push(out, {name = w[1], frames = w[2], keys = keys, clicks = get(w, 4, "")})
  end
  local named = {}
  for e in out do
    if not exists("js/canvas/" .. e.name .. ".js") then fail("js/canvas.shale: goldens.txt names " .. e.name .. ", which has no js/canvas/" .. e.name .. ".js") end
    named[e.name] = true
  end
  for f in glob("js/canvas/*.js") do
    local name = sub(basename(f), 1, #basename(f) - 3)
    if not has_key(named, name) then fail("js/canvas.shale: " .. f .. " is named in no line of goldens.txt") end
  end
  return out
end

-- The first line where two logs differ, both sides shown.
function first_difference(want, got)
  local a = lines(want)
  local b = lines(got)
  local i = 1
  while i <= #a or i <= #b do
    local x = get(a, i, "<none>")
    local y = get(b, i, "<none>")
    if x ~= y then return "line " .. i .. ": the log `" .. x .. "`, js-canvas `" .. y .. "`" end
    i = i + 1
  end
  return "the same lines"
end

function grade_rails(exe)
  local n = 0
  local bad = 0
  for f in glob("js/canvas/rails/*.js") do
    n = n + 1
    local src = read(f)
    local m = re_find(lines(src)[1], "^// stops: (.+)$")
    if m == nil then fail("js/canvas.shale: " .. f .. " has no first line `// stops: <text>`") end
    local r = run({exe, "3", src}, {timeout_ms = RUN_MS, whole = 8000000, want = WANT_CANVAS})
    local said = lines(trim(r.out))
    local last = get(said, #said, "")
    local why = ""
    if not (r.ended == "exit" and r.code == 1 and last == "js: " .. m.group) then why = "wanted `js: " .. m.group .. "`, it said `" .. last .. "`" end
    for l in lines(src) do
      local b = re_find(l, "^// before: (.+)$")
      if b ~= nil and why == "" and not has_item(slice(said, 1, #said - 1), b.group) then why = "printed no `" .. b.group .. "` before its stop" end
    end
    if why == "" then
      print("PASS rails/" .. basename(f))
    else
      bad = bad + 1
      print("FAIL rails/" .. basename(f) .. ": " .. why)
    end
  end
  return {n = n, bad = bad}
end

function main()
  local exe = js_build("js/canvas.shale", "js-canvas", "JsCanvas.roc", "dev")
  local all = entries()
  local bad = 0
  local frozen = false
  for e in all do
    local got = recorded(exe, e)
    local log = "js/canvas/" .. e.name .. ".log"
    if e.name == FREEZE then
      if exists(log) then remove(log) end
      create(log, got)
      print("FROZE " .. e.name .. ": " .. #lines(got) .. " lines")
      frozen = true
    elseif not exists(log) then
      bad = bad + 1
      print("FAIL " .. e.name .. ": no " .. log .. " (freeze=" .. e.name .. " writes it)")
    elseif read(log) == got then
      print("PASS " .. e.name .. ": " .. #lines(got) .. " lines")
    else
      bad = bad + 1
      print("FAIL " .. e.name .. ": " .. first_difference(read(log), got))
    end
  end
  if FREEZE ~= "" and not frozen then fail("js/canvas.shale: no sample is named " .. FREEZE) end
  local rails = grade_rails(exe)
  local core = run({js_build("js/canvas.shale", "js-run", "JsRun.roc", "dev"), "forward(10);"}, {timeout_ms = RUN_MS, whole = 4000, want = WANT_CANVAS})
  local core_ok = core.code == 1 and contains(core.out, "Uncaught ReferenceError: forward is not defined")
  if core_ok then print("PASS js-run knows no canvas builtin") else print("FAIL js-run on `forward(10);` said `" .. trim(core.out) .. "`") end
  print("js canvas: " .. (#all - bad) .. " of " .. #all .. " samples match their logs; " .. (rails.n - rails.bad) .. " of " .. rails.n .. " rails stop as they must; js-run's core library has no canvas: " .. tostring(core_ok))
  if bad + rails.bad > 0 or not core_ok then fail("js/canvas.shale: " .. (bad + rails.bad) .. " samples or rails failed, core " .. tostring(core_ok)) end
end

main()
