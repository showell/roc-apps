-- This script builds the JavaScript playground's page into the dev channel:
-- js/roc/JsApp.roc into a wasm32 archive with the pinned Roc on the dev
-- backend, linked by Zig with the host js/wasm/host.zig into js.wasm, beside
-- the page's files from js/web/ and js_samples.js, which it writes from the
-- canvas samples in js/canvas/ and the console samples in js/console/ (each
-- sample's first line, a `// ` comment, is its title) and the featured
-- console samples, "all features", "garbage collection" and "classes",
-- which are the corpus programs js/tests/54-big-daddy.js, 55-garbage.js and
-- 61-classes-tour.js, so node holds them. The page is replaced only by
-- a build that js/page_check.mjs passed.
--
-- **EVERY FILE BUT index.html IS NAMED BY ITS BYTES**, as roc-chat names its
-- scripts: `js_page.<hash>.js`, `js.<hash>.wasm`, the hash the first 16 hex
-- digits of the file's sha256. Each file's references to the others are
-- rewritten to their hashed names before it is hashed itself, leaves first
-- (the wasm, js_runner.js, js_samples.js and js_memory.js, then js_painter.js, which
-- imports js_runner.js, then js_page.js, then index.html), so a changed
-- file changes the name of every file that leads to it. A browser that kept
-- an old script can't run it beside a new page: the new page names new
-- files. index.html, the one fixed name, is what the site's `Cache-Control:
-- no-cache` makes the browser ask about each visit.
--
--   cd <roc-apps checkout> && shale js/build.shale
--
-- It lands at build:roc-apps/next/js/, served on :9210 by roc-site. It is
-- built into a staging folder beside it, which takes its place at the end,
-- so a failed build leaves the page as it was: the page is replaced only
-- after the check, by a copy. Nothing is published.
--
-- budget: steps=20000000

const WANT_ROC = "roc-pin: roc-apps' pinned nightly"
const WANT_ZIG = "zig: the wasm host's linker"
const WANT_NODE = "js-page: page_check.mjs drives the built page under node"

-- The console samples taken from the corpus, in the page's order.
const FEATURED = {
  {title = "all features", file = "js/tests/54-big-daddy.js"},
  {title = "garbage collection", file = "js/tests/55-garbage.js"},
  {title = "classes", file = "js/tests/61-classes-tour.js"},
}

-- The samples of one folder as the items of a list, in their files' order,
-- each titled by its first line, `// <title>`.
function titled_samples(folder)
  local items = {}
  for f in glob(folder .. "/*.js") do
    local source = read(f)
    local first = lines(source)[1]
    if not starts_with(first, "// ") then fail("js/build.shale: " .. f .. " has no first line `// <title>`") end
    push(items, "  { title: " .. json_write(sub(first, 4, #first)) .. ", source: " .. json_write(source) .. " },")
  end
  return items
end

-- The canvas samples and the console samples as a module the page imports,
-- each folder in its files' order, and the featured console samples beside
-- them.
function samples_module()
  local items = titled_samples("js/canvas")
  local console = titled_samples("js/console")
  local featured = {}
  local files = {}
  for s in FEATURED do
    push(featured, "  { title: " .. json_write(s.title) .. ", source: " .. json_write(read(s.file)) .. " },")
    push(files, s.file)
  end
  return "// Written by js/build.shale from js/canvas/*.js, js/console/*.js, " .. join(files, " and ") .. "; not checked in.\nexport const CANVAS_SAMPLES = [\n" .. join(items, "\n") .. "\n];\nexport const CONSOLE_SAMPLES = [\n" .. join(console, "\n") .. "\n];\nexport const FEATURED_SAMPLES = [\n" .. join(featured, "\n") .. "\n];\n"
end

-- The first 16 hex digits of the file's sha256.
function hash_of(path)
  local r = must(run({"sha256sum", real(path)}, {timeout_ms = 60000, whole = 400}))
  return sub(r.out, 1, 16)
end

-- `text` with its one `old` made `new`: a reference that isn't there, or is
-- there twice, stops the build rather than leave a name unrewritten.
function swapped(text, old, new, who)
  local n = #find_all(text, old)
  if n ~= 1 then fail("js/build.shale: " .. who .. " names " .. old .. " " .. n .. " times, not once") end
  return substitute(text, old, new)
end

-- `name.ext` in `dir` renamed by its bytes, `name.<hash>.ext`; answers the new name.
function named_by_bytes(dir, name, ext)
  local from = dir .. "/" .. name .. "." .. ext
  local to = name .. "." .. hash_of(from) .. "." .. ext
  copy(from, dir .. "/" .. to)
  remove(from)
  return to
end

-- `"./<file>"`, as a module imports it.
function import_of(file)
  return "\"./" .. file .. "\""
end

-- The page's text files written into `dir` under their hashed names, each
-- with its references rewritten; the wasm is already there as js.wasm.
function write_hashed(dir)
  local wasm = named_by_bytes(dir, "js", "wasm")
  create(dir .. "/js_runner.js", read("js/web/js_runner.js"))
  local runner = named_by_bytes(dir, "js_runner", "js")
  create(dir .. "/js_samples.js", samples_module())
  local samples = named_by_bytes(dir, "js_samples", "js")
  create(dir .. "/js_memory.js", read("js/web/js_memory.js"))
  local memory = named_by_bytes(dir, "js_memory", "js")
  create(dir .. "/js_painter.js", swapped(read("js/web/js_painter.js"), import_of("js_runner.js"), import_of(runner), "js_painter.js"))
  local painter = named_by_bytes(dir, "js_painter", "js")
  local page = read("js/web/js_page.js")
  page = swapped(page, import_of("js_runner.js"), import_of(runner), "js_page.js")
  page = swapped(page, import_of("js_painter.js"), import_of(painter), "js_page.js")
  page = swapped(page, import_of("js_samples.js"), import_of(samples), "js_page.js")
  page = swapped(page, import_of("js_memory.js"), import_of(memory), "js_page.js")
  page = swapped(page, "fetch(\"js.wasm\")", "fetch(\"" .. wasm .. "\")", "js_page.js")
  create(dir .. "/js_page.js", page)
  local entry = named_by_bytes(dir, "js_page", "js")
  create(dir .. "/index.html", swapped(read("js/web/index.html"), "src=\"js_page.js\"", "src=\"" .. entry .. "\"", "index.html"))
  print("hashed: " .. join({entry, runner, painter, samples, memory, wasm}, ", "))
end

function main()
  local roc = pinned_roc("js/build.shale")
  local dest = "build:roc-apps/next/js"
  local staging = "build:roc-apps/next/js.staging"
  if exists(staging) then remove_tree(staging) end
  mkdir(staging)
  local out = real(staging)
  local r = run({roc, "build", "JsApp.roc", "--target=wasm32", "--opt=dev", "--output=" .. out .. "/js.a"},
    {cwd = "js/roc", timeout_ms = 600000, tail = 40, nice = 19, want = WANT_ROC})
  if contains(r.out, "✗") or contains(r.out, "●") or not exists(staging .. "/js.a") then
    print(trim(r.out))
    fail("js/build.shale: the Roc build of JsApp.roc failed")
  end
  print("roc build JsApp.roc --target=wasm32 --opt=dev: " .. r.ms .. " ms")
  mkdir("build:roc-apps/zig-cache")
  mkdir("build:zig-global")
  local z = run({real("zig016:zig"), "build-exe", "js/wasm/host.zig", out .. "/js.a",
    "-target", "wasm32-freestanding", "-fno-entry", "-rdynamic", "-O", "ReleaseSmall",
    "--stack", "16777216", "--name", "js", "-femit-bin=" .. out .. "/js.wasm",
    "--cache-dir", real("build:roc-apps/zig-cache"), "--global-cache-dir", real("build:zig-global")},
    {timeout_ms = 600000, tail = 40, nice = 19, want = WANT_ZIG})
  if z.code ~= 0 or not exists(staging .. "/js.wasm") then
    print(trim(z.out))
    fail("js/build.shale: linking js.wasm failed")
  end
  print("zig build-exe js.wasm: " .. z.ms .. " ms")
  remove(staging .. "/js.a")
  write_hashed(staging)
  local c = run({"node", "js/page_check.mjs", out, "js/tests", "js/canvas"}, {timeout_ms = 300000, tail = 40, want = WANT_NODE})
  print(trim(c.out))
  if c.code ~= 0 then fail("js/build.shale: the page check failed") end
  if exists(dest) then remove_tree(dest) end
  copy(staging, dest)
  remove_tree(staging)
  print("dev: http://localhost:9210/js/")
end

main()
