-- This script grades the JavaScript subset against node, its oracle. Every
-- program in js/tests/ is real JavaScript, so node runs it too: each runs
-- through node and through js-run, and the two outputs (stdout and the exit
-- code) must match byte for byte, but for node's report of a throw nothing
-- caught, which js-run writes as one line (`uncaught_as_one_line`, below).
-- Each program in js/tests/refused/ is one
-- the subset must refuse: its first line, `// refused: <text>`, is what
-- js-run's last line (`js: <why>`) must hold, and js-run must exit 1.
--
--   cd <roc-apps checkout> && shale js/oracle.shale            build js-run, then grade
--   cd <roc-apps checkout> && shale js/oracle.shale only=11    the programs whose names start so
--   cd <roc-apps checkout> && shale js/oracle.shale engine=vm  build js-vm, the bytecode VM, then grade it
--
-- It takes js-run from js/roc/JsRun.roc (js-vm from js/roc/JsVm.roc) on
-- the dev backend from tools/roc_build.shale (js/js_builds.shale), which
-- builds it with the pinned Roc when its cache holds no build of these
-- inputs, and fails on an error or a warning, whatever Roc's exit code.
-- Every program found is graded; none is skipped, and the run fails unless
-- all of them pass. A program the VM refuses (`js: unsupported (vm): ...`)
-- fails as a wrong answer does, and the last line counts the two apart.
--
-- budget: steps=50000000

const WANT_RUN = "js-run: the interpreter under test, built here"
const WANT_NODE = "js-oracle: node is the subset's oracle"
const RUN_MS = 20000

const ONLY = arg("only", "")
const ENGINE = arg("engine", "walker")

-- The command under test and its name in the lines below.
function engine_command()
  if ENGINE == "walker" then return {name = "js-run", source = "JsRun.roc"} end
  if ENGINE == "vm" then return {name = "js-vm", source = "JsVm.roc"} end
  fail("js/oracle.shale: engine= is walker or vm, not " .. ENGINE)
end

const COMMAND = engine_command()

-- Whether a transcript ends in the VM's refusal of what it doesn't run yet.
function is_vm_refusal(out)
  local said = lines(trim(out))
  return starts_with(get(said, #said, ""), "js: unsupported (vm): ")
end

use("./js_builds.shale")

-- What a program printed and how it ended, as one text to compare.
function transcript(r)
  if r.ended ~= "exit" then return r.out .. "\n[ended: " .. r.ended .. "]" end
  return r.out .. "\n[exit " .. r.code .. "]"
end

-- node's output with its report of a throw nothing caught as js-run writes
-- it. node writes the report on stderr, after all the program printed: a
-- line `<path>:<n>`, the line of the throw, a caret under it, then what was
-- thrown (past a blank line when it is an error: `TypeError: ...`) and the
-- stack, and a blank line before it all when what was thrown is no error.
-- js-run writes one line, `Uncaught <the first line of what was thrown>
-- (line <n>)`, so this keeps that much of node's and drops the rest. A
-- program that prints a blank line just before it throws what is no error
-- loses that line here, and so fails; none does.
function uncaught_as_one_line(out, path)
  local all = lines(out)
  local start = 0
  local at = ""
  for i = 1, #all do
    local m = re_find(all[i], ":([0-9]+)$")
    if m ~= nil and all[i] == path .. ":" .. m.group then
      start = i
      at = m.group
    end
  end
  if start == 0 then return out end
  local thrown = ""
  local j = start + 3
  while j <= #all and thrown == "" do
    thrown = all[j]
    j = j + 1
  end
  local kept = {}
  local last = start - 1
  if last >= 1 and all[last] == "" then last = last - 1 end
  for i = 1, last do push(kept, all[i]) end
  push(kept, "Uncaught " .. thrown .. " (line " .. at .. ")")
  return join(kept, "\n") .. "\n"
end

-- The first line where two transcripts differ, both sides shown.
function first_difference(want, got)
  local a = lines(want)
  local b = lines(got)
  local i = 1
  while i <= #a or i <= #b do
    local x = get(a, i, "<none>")
    local y = get(b, i, "<none>")
    if x ~= y then return "line " .. i .. ": node `" .. x .. "`, " .. COMMAND.name .. " `" .. y .. "`" end
    i = i + 1
  end
  return "the same lines"
end

-- The command under test, js-run or js-vm, on one program's text.
function js_run(exe, src)
  return run({exe, src}, {timeout_ms = RUN_MS, whole = 4000000, want = WANT_RUN})
end

function grade_oracle(exe)
  local n = 0
  local bad = 0
  local refused = 0
  for f in glob("js/tests/*.js") do
    if ONLY == "" or starts_with(basename(f), ONLY) then
      n = n + 1
      local node = run({"node", real(f)}, {timeout_ms = RUN_MS, whole = 4000000, want = WANT_NODE})
      local mine = js_run(exe, read(f))
      node.out = uncaught_as_one_line(node.out, real(f))
      local want = transcript(node)
      local got = transcript(mine)
      if want == got then
        print("PASS " .. basename(f))
      else
        bad = bad + 1
        if is_vm_refusal(mine.out) then refused = refused + 1 end
        print("FAIL " .. basename(f) .. ": " .. first_difference(want, got))
      end
    end
  end
  return {n = n, bad = bad, refused = refused}
end

function grade_refused(exe)
  local n = 0
  local bad = 0
  local refused = 0
  for f in glob("js/tests/refused/*.js") do
    if ONLY == "" or starts_with(basename(f), ONLY) then
      n = n + 1
      local src = read(f)
      local first = lines(src)[1]
      local m = re_find(first, "^// refused: (.+)$")
      if m == nil then fail("js/oracle.shale: " .. f .. " has no first line `// refused: <text>`") end
      local mine = js_run(exe, src)
      local said = lines(trim(mine.out))
      local last = get(said, #said, "")
      if mine.ended == "exit" and mine.code == 1 and starts_with(last, "js: ") and contains(last, m.group) then
        print("PASS refused/" .. basename(f))
      else
        bad = bad + 1
        if is_vm_refusal(mine.out) then refused = refused + 1 end
        print("FAIL refused/" .. basename(f) .. ": wanted `" .. m.group .. "`, " .. COMMAND.name .. " said `" .. last .. "` (" .. mine.ended .. " " .. get(mine, "code", "") .. ")")
      end
    end
  end
  return {n = n, bad = bad, refused = refused}
end

function main()
  local exe = js_build("js/oracle.shale", COMMAND.name, COMMAND.source, "dev")
  local o = grade_oracle(exe)
  local r = grade_refused(exe)
  if o.n + r.n == 0 then fail("js/oracle.shale: no program is named " .. ONLY) end
  if ENGINE == "walker" then
    print("js oracle: " .. (o.n - o.bad) .. " of " .. o.n .. " match node; " .. (r.n - r.bad) .. " of " .. r.n .. " refused as they must be")
  else
    print("js oracle (" .. ENGINE .. "): " .. (o.n - o.bad) .. " of " .. o.n .. " match node (" .. o.refused .. " refused by the VM, " .. (o.bad - o.refused) .. " wrong); "
      .. (r.n - r.bad) .. " of " .. r.n .. " refused as they must be (" .. r.refused .. " refused by the VM for another reason, " .. (r.bad - r.refused) .. " wrong)")
  end
  if o.bad + r.bad > 0 then fail("js/oracle.shale: " .. (o.bad + r.bad) .. " programs failed") end
end

main()
