-- budget: programs=100 steps=100000000 read_bytes=200000000
-- This script publishes the Nibble playground, cook-levin-riff's puzzle page
-- for its four-opcode machine, to staging at site/live/nibble/, as
-- site/publish_roc_js.shale does for roc-js-interpreter's pages. The page is
-- unlisted: no card on the landing page links it.
--
--   cd <roc-apps checkout> && shale site/publish_nibble.shale
--   cd <roc-apps checkout> && shale site/publish_nibble.shale dry=1
--
-- The source stays in cook-levin-riff (repos:cook-levin). The script refuses
-- that checkout when it has changes of any kind (an untracked file included)
-- or its HEAD is on no branch of GitHub's, so what is published is always a
-- commit anyone can fetch. It builds there with the repository's own
-- web/build.shale, which builds the Roc port's two machines
-- (roc/NibbleWasm.roc and roc/PlusWasm.roc) into the pages' wasm, writes the
-- pages into its out/web/site/ and checks it in headless Chromium. A build that
-- leaves the checkout changed is refused.
--
-- The built folder is copied over site/live/nibble/ whole, with a
-- PROVENANCE: the cook-levin-riff commit and a hash of each wasm. Then it
-- checks what it copied: exactly the three pages, index.html (the puzzles),
-- sandbox.html and plus.html (the Nibble++ sandbox), and the files web/build.shale names by their bytes, and no
-- `src`, `href`, `fetch` or
-- `url()` URL starting with `/` or naming a network scheme. A failed check
-- stops before git, leaving site/live/ changed and uncommitted. The folder is
-- committed alone, with the PROVENANCE in the message, and pushed with
-- git_push. site/deploy.shale takes it to prod with the rest.
--
-- Option, for a proof that touches no staging:
--
--   dry=1    build, copy into build:roc-apps/publish_nibble.dry/ (replaced
--            each run, left for reading), write the PROVENANCE and check,
--            then compare with today's site/live/nibble/ file by file,
--            PROVENANCE aside, and stop before git

const CL = "repos:cook-levin"
const REPO_URL = "https://github.com/showell/cook-levin-riff"
const DRY = arg("dry", 0) == 1
const LIVE = "site/live"
const DRY_DIR = "build:roc-apps/publish_nibble.dry"
const BUILT = CL .. "/out/web/site"
const STAGING = "http://localhost:9200/"
-- The three pages, named as they are, and the files web/build.shale names by
-- their bytes, `<name>.<16 hex digits>.<ext>`.
const PAGES = {"index.html", "sandbox.html", "plus.html"}
const PAGE_HASHED = {"nibble.js", "sandbox.js", "plus.js", "machine.js", "nibble.css", "nibble.wasm", "plus.wasm", "plus_names.bin", "puzzles.json"}

-- Stops the publish when cook-levin-riff has a change of any kind.
function refuse_changes(when)
  if not git_is_clean(CL) then
    for s in git_status(CL) do print(s.code .. " " .. s.path) end
    fail("publish_nibble: cook-levin-riff has changes " .. when .. "; commit and push them first")
  end
  return nil
end

-- The cook-levin-riff commit to publish, its full hash: clean, and on a
-- branch of origin.
function cl_commit()
  if not exists(CL .. "/web/build.shale") then fail("publish_nibble: no cook-levin-riff checkout at " .. CL) end
  refuse_changes("before the build")
  git_fetch(CL)
  local head = trim(must(run({"git", "rev-parse", "HEAD"}, {cwd = CL, timeout_ms = 10000, tail = 2})).out)
  local on = must(run({"git", "branch", "-r", "--contains", head}, {cwd = CL, timeout_ms = 10000, tail = 20}))
  if trim(on.out) == "" then fail("publish_nibble: cook-levin-riff's HEAD " .. sub(head, 1, 7) .. " is on no branch of origin; push it first") end
  return head
end

-- Every file below `dir`, by its name under it, sorted.
function files_under(dir)
  local names = {}
  for e in walk_all(dir, {kind = "file"}) do push(names, sub(e.path, #dir + 2, #e.path)) end
  sort(names)
  return names
end

-- Each file's sha256 below `dir`, by its name under it, PROVENANCE aside.
function sums_under(dir)
  local names = {}
  local argv = {"sha256sum"}
  for f in files_under(dir) do
    if f ~= "PROVENANCE" then
      push(names, f)
      push(argv, real(dir .. "/" .. f))
    end
  end
  local sums = {}
  if #names == 0 then return sums end
  local said = lines(trim(must(run(argv, {timeout_ms = 60000, whole = 200000})).out))
  for i = 1, #names do sums[names[i]] = sub(said[i], 1, 64) end
  return sums
end

-- Every wasm the page holds, sorted; a page with none stops the publish.
function page_wasms(page)
  local out = {}
  for f in files_under(page) do
    if ends_with(f, ".wasm") then push(out, f) end
  end
  if #out == 0 then fail("publish_nibble: " .. page .. " holds no wasm") end
  return out
end

function provenance(head, page)
  local stamp = trim(must(run({"date", "-u", "+%Y-%m-%dT%H:%M:%SZ"}, {timeout_ms = 5000, tail = 2})).out)
  local text = "published " .. stamp .. "\n"
  text = text .. "cook-levin-riff " .. sub(head, 1, 8) .. " " .. REPO_URL .. "/commit/" .. head .. " (its web/build.shale)\n"
  for w in page_wasms(page) do
    local sum = trim(must(run({"sha256sum", real(page .. "/" .. w)}, {timeout_ms = 30000, tail = 2})).out)
    text = text .. "sha256 " .. sub(sum, 1, 16) .. "  " .. stat(page .. "/" .. w).size .. " bytes  " .. w .. "\n"
  end
  return text
end

-- One check's line; a failed one stops the publish.
function check_line(name, ok, detail)
  local verdict = "PASS"
  if not ok then verdict = "FAIL" end
  print(verdict .. "  " .. name .. ": " .. detail)
  if not ok then fail("publish_nibble: the check of " .. name .. " failed; the copy is changed and not committed") end
  return nil
end

-- The page holds PROVENANCE, the PAGES and each of PAGE_HASHED once, by
-- its hashed name, and nothing else.
function check_page_files(page)
  local found = files_under(page)
  local left = {}
  for f in found do
    if f ~= "PROVENANCE" and not has_item(PAGES, f) then push(left, f) end
  end
  local named = 0
  for want in PAGE_HASHED do
    local dot = find(want, ".")
    local pattern = "^" .. sub(want, 1, dot - 1) .. "\\.[0-9a-f]{16}\\." .. sub(want, dot + 1, #want) .. "$"
    local hits = 0
    for f in left do
      if re_find(f, pattern) ~= nil then hits = hits + 1 end
    end
    if hits == 1 then named = named + 1 end
  end
  local pages = 0
  for p in PAGES do
    if has_item(found, p) then pages = pages + 1 end
  end
  local ok = has_item(found, "PROVENANCE") and pages == #PAGES and #left == #PAGE_HASHED and named == #PAGE_HASHED
  check_line("files", ok, page .. " holds " .. join(found, " ") .. "; expected PROVENANCE, " .. join(PAGES, " and ") .. ", and " .. join(PAGE_HASHED, ", ") .. ", each named by its bytes")
  return nil
end

-- No resource of the page's text files is rooted at `/`, and none but an
-- `<a>`'s href names a network scheme (`<scheme>://`).
function check_relative(dir)
  local rooted = 0
  local schemed = 0
  local files = 0
  for f in files_under(dir) do
    if ends_with(f, ".html") or ends_with(f, ".js") or ends_with(f, ".css") then
      files = files + 1
      local text = read(dir .. "/" .. f)
      rooted = rooted + #re_find_all(text, [=[(?:src|href)\s*=\s*["']?/|fetch(?:ed)?\(\s*["'`]/|url\(\s*["']?/]=])
      schemed = schemed + #re_find_all(text, [=[src\s*=\s*["']?[a-z]+://|<link[^>]*href\s*=\s*["']?[a-z]+://|fetch(?:ed)?\(\s*["'`][a-z]+://|url\(\s*["']?[a-z]+://]=])
    end
  end
  check_line("relative URLs", rooted + schemed == 0, dir .. ": " .. rooted .. " src, href, fetch or url() URLs in its " .. files .. " text files start with /, and " .. schemed .. " resources name a network scheme")
  return nil
end

-- A dry run's folder beside today's staging, file by file, PROVENANCE aside.
function compare(built, live)
  local a = sums_under(built)
  local b = {}
  if exists(live) then b = sums_under(live) end
  local names = {}
  for k in keys(a) do push(names, k) end
  for k in keys(b) do
    if not has_key(a, k) then push(names, k) end
  end
  sort(names)
  local same = 0
  local differ = 0
  for f in names do
    if not has_key(b, f) then
      differ = differ + 1
      print("  only in the build: nibble/" .. f)
    elseif not has_key(a, f) then
      differ = differ + 1
      print("  only in site/live: nibble/" .. f)
    elseif a[f] ~= b[f] then
      differ = differ + 1
      print("  differs: nibble/" .. f)
    else
      same = same + 1
    end
  end
  if differ == 0 then
    print("SAME  nibble: " .. same .. " files equal site/live/nibble's, PROVENANCE aside")
  else
    print("DIFF  nibble: " .. differ .. " files differ from site/live/nibble's, " .. same .. " equal, PROVENANCE aside")
  end
  return differ
end

function main()
  local head = cl_commit()
  print("cook-levin-riff " .. sub(head, 1, 8) .. ", clean and on origin")
  if not DRY then
    local staged = run({"git", "diff", "--cached", "--quiet"}, {timeout_ms = 10000, tail = 5})
    if staged.code ~= 0 then fail("publish_nibble: roc-apps' index already holds staged changes; commit or unstage them first") end
  end

  local b = run({"shale", "web/build.shale"}, {cwd = CL, timeout_ms = 600000, tail = 30, nice = 19})
  print(trim(b.out))
  if b.code ~= 0 then fail("publish_nibble: cook-levin-riff's web/build.shale failed") end
  refuse_changes("after the build (it rewrote a tracked file or left an untracked one)")

  local root = LIVE
  if DRY then
    if exists(DRY_DIR) then remove_tree(DRY_DIR) end
    mkdir(DRY_DIR)
    root = DRY_DIR
  end
  local page = root .. "/nibble"
  if exists(page) then remove_tree(page) end
  copy(BUILT, page)
  local text = provenance(head, page)
  create(page .. "/PROVENANCE", text)
  print("nibble/PROVENANCE:\n" .. trim(text))

  check_page_files(page)
  check_relative(page)

  if DRY then
    compare(page, LIVE .. "/nibble")
    print("dry run: nothing committed; the copy is at " .. DRY_DIR)
    return nil
  end

  must(run({"git", "add", "-A", "--", page}, {timeout_ms = 30000, tail = 5}))
  local same = run({"git", "diff", "--cached", "--quiet", "--", page}, {timeout_ms = 10000, tail = 5})
  if same.code == 0 then
    print("staging already has this page; nothing to publish")
    return nil
  end
  local msg = "site: publish nibble (cook-levin-riff's Nibble playground) to staging\n\nnibble/PROVENANCE:\n" .. text
  must(run({"git", "commit", "-q", "-F", "-", "--", page}, {timeout_ms = 60000, tail = 10, stdin = msg}))
  git_push(".")
  print("published nibble to staging: " .. STAGING .. "nibble/")
  return nil
end

main()
