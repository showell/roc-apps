-- budget: steps=20000000 read_bytes=100000000
-- This script publishes roc-screensaver's lanterns page to staging, at
-- welcome-to-roc/, as site/publish.sh does for an app of this repository.
-- The landing page does not link to it; the address is handed out on its own.
--
--   cd <roc-apps checkout> && shale site/publish_lanterns.shale
--
-- The page's sources stay in roc-screensaver (repos:roc-screensaver), and the
-- script refuses that checkout when it has changes of any kind or its HEAD is
-- on no branch of GitHub's, so what is published is always a commit anyone
-- can fetch. It builds the page there with roc-screensaver's own
-- tools/web_build.shale, the release wasm, into the dev channel's
-- welcome-to-roc/ (http://143.244.172.148:9210/welcome-to-roc/), copies that
-- over site/live/welcome-to-roc/ whole, and writes a PROVENANCE beside it:
-- the compiler and the opt from the build's BUILT, the roc-screensaver
-- commit, and a hash of the wasm.
--
-- Then it checks the published page before committing it. The folder must
-- hold exactly PUBLISHED_FILES, the page's URLs must be relative, the
-- landing page (site/web/ and site/live/) must not name the folder, staging
-- must serve the checkout's index.html, and roc-screensaver's
-- tools/web_shots.mjs must pass on the staging page: its first frame under the
-- warming-up pill, the ride, and the skin's help and links. A failed check
-- stops before git, leaving the new files in site/live/ uncommitted. Last, it
-- commits site/live/welcome-to-roc/ alone, with the PROVENANCE in the
-- message, and pushes. site/deploy.sh takes it to prod with the rest.

const FOLDER = "welcome-to-roc"
const SAVER = "repos:roc-screensaver"
const NEXT = "build:roc-apps/next/welcome-to-roc"
const LIVE = "site/live/welcome-to-roc"
const STAGING_URL = "http://143.244.172.148:9200/welcome-to-roc/"
const PUBLISHED_FILES = {"PROVENANCE", "canvas_app_runner.js", "index.html", "lanterns.wasm", "roc_glue.js", "shapes_canvas.js"}
const LANDING_PAGES = {"site/web/index.html", "site/live/index.html"}
const NODE_WANT = "web-shots: roc-screensaver's headless Chromium check of a live page"

-- The roc-screensaver commit to publish, its full hash. A checkout with any
-- change, or whose HEAD no GitHub branch holds, stops the publish.
function saver_commit()
  if not exists(SAVER .. "/tools/web_build.shale") then fail("publish_lanterns: no roc-screensaver checkout at " .. SAVER) end
  if not git_is_clean(SAVER) then
    for s in git_status(SAVER) do print(s.code .. " " .. s.path) end
    fail("publish_lanterns: roc-screensaver has uncommitted changes; commit and push them first")
  end
  git_fetch(SAVER)
  local head = trim(must(run({"git", "rev-parse", "HEAD"}, {cwd = SAVER, timeout_ms = 10000, tail = 2})).out)
  local on = must(run({"git", "branch", "-r", "--contains", head}, {cwd = SAVER, timeout_ms = 10000, tail = 20}))
  if trim(on.out) == "" then fail("publish_lanterns: roc-screensaver's HEAD " .. sub(head, 1, 7) .. " is on no branch of origin; push it first") end
  return head
end

-- Every file below `dir`, by its name under it, sorted.
function files_under(dir)
  local names = {}
  for e in walk_all(dir, {kind = "file"}) do push(names, sub(e.path, #dir + 2, #e.path)) end
  sort(names)
  return names
end

-- The first 16 hex digits of a file's sha256.
function sha256_16(p)
  local r = must(run({"sha256sum", real(p)}, {timeout_ms = 10000, tail = 2}))
  return sub(trim(r.out), 1, 16)
end

-- The PROVENANCE for the page in LIVE, built from roc-screensaver at `head`.
function provenance(head)
  local stamp = trim(must(run({"date", "-u", "+%Y-%m-%dT%H:%M:%SZ"}, {timeout_ms = 5000, tail = 2})).out)
  local text = "published " .. stamp .. "\n"
  text = text .. trim(read(LIVE .. "/BUILT")) .. "\n"
  text = text .. "roc-screensaver " .. sub(head, 1, 7) .. " https://github.com/showell/roc-screensaver/commit/" .. head .. "\n"
  local wasm = LIVE .. "/lanterns.wasm"
  text = text .. "sha256 " .. sha256_16(wasm) .. "  " .. stat(wasm).size .. " bytes  lanterns.wasm\n"
  return text
end

-- One check's line; a failed one stops the publish.
function check_line(name, ok, detail)
  local verdict = "PASS"
  if not ok then verdict = "FAIL" end
  print(verdict .. "  " .. name .. ": " .. detail)
  if not ok then fail("publish_lanterns: the check of " .. name .. " failed; site/live/ is changed and not committed") end
  return nil
end

-- The published page, checked in the checkout and as staging serves it.
function check_published()
  local found = files_under(LIVE)
  check_line("files", join(found, " ") == join(PUBLISHED_FILES, " "), LIVE .. " holds " .. join(found, " ") .. "; expected " .. join(PUBLISHED_FILES, " "))

  local page = read(LIVE .. "/index.html")
  local absolute = re_find_all(page, [=[(?:src|href)\s*=\s*["'](?:/|[a-z]+://)]=])
  check_line("relative URLs", #absolute == 0, #absolute .. " src or href in index.html start with / or a scheme")

  local named = {}
  for p in LANDING_PAGES do
    if #grep(p, FOLDER) > 0 then push(named, p) end
  end
  check_line("not on the landing page", #named == 0, "the landing pages naming " .. FOLDER .. ": " .. #named .. " (" .. join(named, ", ") .. ")")

  local served = http_get(STAGING_URL, {timeout_ms = 10000})
  check_line("staging serves it", served.status == 200 and served.body == page, STAGING_URL .. " answered " .. served.status .. ", " .. #served.body .. " bytes, the checkout's index.html is " .. #page)

  local shots = fresh_dir("scratch:", "welcome-to-roc-shots")
  local r = run({"node", real(SAVER .. "/tools/web_shots.mjs"), STAGING_URL, real(shots), "1300", "2800"},
    {timeout_ms = 60000, tail = 20, want = NODE_WANT})
  local moved = exists(shots .. "/at_01300ms.png") and exists(shots .. "/at_02800ms.png") and read(shots .. "/at_01300ms.png") ~= read(shots .. "/at_02800ms.png")
  remove_tree(shots)
  print(trim(r.out))
  local seen = "do not differ"
  if moved then seen = "differ" end
  -- roc-screensaver's verify holds the skin's lines exactly; here a page
  -- that lost its skin (a "none") is enough to stop.
  local dressed = contains(r.out, "\nskin help: ") and contains(r.out, "\nskin links: ") and not contains(r.out, "skin help: none") and not contains(r.out, "skin links: none")
  if not dressed then seen = seen .. ", and the skin's help or links are missing" end
  check_line("web_shots.mjs on staging", r.code == 0 and moved and dressed, "exit " .. r.code .. ", the shots 1.5 s apart " .. seen)
  return nil
end

function main()
  local head = saver_commit()
  print("roc-screensaver " .. sub(head, 1, 7) .. ", clean and on origin")

  local b = run({"shale", "--root", ".", "tools/web_build.shale", "dest=" .. FOLDER}, {cwd = SAVER, timeout_ms = 300000, tail = 30})
  print(trim(b.out))
  if b.code ~= 0 then fail("publish_lanterns: roc-screensaver's web build failed") end
  if not contains(read(NEXT .. "/BUILT"), "\nopt speed\n") then fail("publish_lanterns: " .. NEXT .. " is not a release build") end

  if exists(LIVE) then remove_tree(LIVE) end
  copy(NEXT, LIVE)
  create(LIVE .. "/PROVENANCE", provenance(head))
  -- Folded into PROVENANCE, as site/publish.sh does: one record, not two.
  remove(LIVE .. "/BUILT")
  print(read(LIVE .. "/PROVENANCE"))

  check_published()

  local staged = run({"git", "diff", "--cached", "--quiet"}, {timeout_ms = 10000, tail = 5})
  if staged.code ~= 0 then fail("publish_lanterns: roc-apps' index already holds staged changes; commit or unstage them first") end
  must(run({"git", "add", "-A", "--", LIVE}, {timeout_ms = 30000, tail = 5}))
  local msg = "site: publish " .. FOLDER .. " (roc-screensaver's lanterns) to staging\n\n" .. read(LIVE .. "/PROVENANCE")
  git_commit("", msg)
  git_push("")
  print("published " .. FOLDER .. " to staging: " .. STAGING_URL)
  return nil
end

main()
