// The Roc-on-Shale page's drawing: a Roc program's effects pass through
// Shale's rules on their way out. site/build_roc_on_shale.shale renders it
// with Graphviz and puts the SVG in the page.
digraph platform {
  graph [rankdir=TB, bgcolor="transparent", nodesep=0.25, ranksep=0.45, fontname="sans-serif", fontsize=12];
  node [shape=box, style="rounded", fontname="sans-serif", fontsize=12, margin="0.14,0.08"];
  edge [fontname="sans-serif", fontsize=11, arrowsize=0.7];

  subgraph cluster_roc {
    label="Roc"; style="rounded,dashed";
    program [label="the program\npure functions, expects"];
    api [label="Shale.roc\nthe platform's functions"];
  }

  rules [label="Shale's runtime, the host\nbudgets · root · rules · timeouts", style="rounded,bold"];

  files [label="files and folders"];
  programs [label="other programs"];
  parser [label="Roc's parser, regex"];

  program -> api [label="calls"];
  api -> rules [label="each effect"];
  rules -> files;
  rules -> programs;
  rules -> parser;
}
