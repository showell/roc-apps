	sysfont_row! : Mem.Mem, SystemFont.SysFont, I64, I64 => (Mem.Mem, I64)
	sysfont_row! = |mem, sf, unicode, row| ({
		idx = (unicode - sysfont_first)
		(if (idx < 0) { (mem, 0) } else { (if (idx >= sysfont_count) { (mem, 0) } else { (if (row < 0) { (mem, 0) } else { (if (row >= sysfont_glyph_h) { (mem, 0) } else { Mem.load!(mem, sf.sf_base, ((idx * sysfont_glyph_h) + row), 1) }) }) }) })
	})
}
