	ico_merge_sets : Icon.IconSet, Icon.IconSet -> Icon.IconSet
	ico_merge_sets = |a, b| ico_merge_loop(a, b.is_icons, 0, b.is_count)

	ico_merge_loop : Icon.IconSet, List(Icon.Icon), I64, I64 -> Icon.IconSet
	ico_merge_loop = |acc, icons, i, n| (if (i >= n) { acc } else { ico_merge_loop(icon_set_add(acc, (List.get(icons, I64.to_u64_wrap(i)) ?? crash("list-at out of range"))), icons, (i + 1), n) })

	format_icon : Icon.Icon -> Str
	format_icon = |ico| Str.concat(Str.concat(Str.concat(Str.concat(ico.ico_name, " "), I64.to_str(ico.ico_width)), "x"), I64.to_str(ico.ico_height))
}
