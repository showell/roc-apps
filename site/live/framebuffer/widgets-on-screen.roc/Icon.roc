# Icon -- emitted from Codex by rocemit (rust-codex-compiler). Do not edit.
import MathLib
import Maybe
import Rasterizer

Icon :: [].{
	Icon : { ico_name : Str, ico_width : I64, ico_height : I64, ico_pixels : List(I64) }
	IconSet : { is_icons : List(Icon.Icon), is_count : I64 }

	icon_new : Str, I64, I64, List(I64) -> Icon.Icon
	icon_new = |name, w, h, pixels| { ico_name: name, ico_width: w, ico_height: h, ico_pixels: pixels }

	icon_set_new : Icon.IconSet
	icon_set_new = { is_icons: [], is_count: 0 }

	icon_set_add : Icon.IconSet, Icon.Icon -> Icon.IconSet
	icon_set_add = |iset, ico| { is_icons: List.append(iset.is_icons, ico), is_count: (iset.is_count + 1) }

	icon_set_find : Icon.IconSet, Str -> Maybe.Maybe(Icon.Icon)
	icon_set_find = |iset, name| ico_find_loop(iset.is_icons, name, 0, iset.is_count)

	ico_find_loop : List(Icon.Icon), Str, I64, I64 -> Maybe.Maybe(Icon.Icon)
	ico_find_loop = |icons, name, i, n| (if (i >= n) { None } else { ({
		ico = (List.get(icons, I64.to_u64_wrap(i)) ?? crash("list-at out of range"))
		(if (ico.ico_name == name) { Just(ico) } else { ico_find_loop(icons, name, (i + 1), n) })
	}) })

	icon_set_find_sized : Icon.IconSet, Str, I64 -> Maybe.Maybe(Icon.Icon)
	icon_set_find_sized = |iset, name, size| ico_find_sized_loop(iset.is_icons, name, size, 0, iset.is_count, None, 99999)

	ico_find_sized_loop : List(Icon.Icon), Str, I64, I64, I64, Maybe.Maybe(Icon.Icon), I64 -> Maybe.Maybe(Icon.Icon)
	ico_find_sized_loop = |icons, name, size, i, n, best, best_dist| (if (i >= n) { best } else { ({
		ico = (List.get(icons, I64.to_u64_wrap(i)) ?? crash("list-at out of range"))
		(if (ico.ico_name == name) { ({
			dist = MathLib.math_abs((ico.ico_width - size))
			(if (dist == 0) { Just(ico) } else { (if (dist < best_dist) { ico_find_sized_loop(icons, name, size, (i + 1), n, Just(ico), dist) } else { ico_find_sized_loop(icons, name, size, (i + 1), n, best, best_dist) }) })
		}) } else { ico_find_sized_loop(icons, name, size, (i + 1), n, best, best_dist) })
	}) })

	icon_get : Icon.Icon, I64, I64 -> I64
	icon_get = |ico, x, y| (if (x < 0) { 0 } else { (if (y < 0) { 0 } else { (if (x >= ico.ico_width) { 0 } else { (if (y >= ico.ico_height) { 0 } else { (List.get(ico.ico_pixels, I64.to_u64_wrap(((y * ico.ico_width) + x))) ?? crash("list-at out of range")) }) }) }) })

	icon_scale : Icon.Icon, I64, I64 -> Icon.Icon
	icon_scale = |src, tw, th| ({
		pixels = ico_scale_build(src, tw, th, 0, 0, [])
		{ ico_name: src.ico_name, ico_width: tw, ico_height: th, ico_pixels: pixels }
	})

	ico_scale_build : Icon.Icon, I64, I64, I64, I64, List(I64) -> List(I64)
	ico_scale_build = |src, tw, th, tx, ty, acc| (if (ty >= th) { acc } else { (if (tx >= tw) { ico_scale_build(src, tw, th, 0, (ty + 1), acc) } else { ({
		sx = I64.div_trunc_by((tx * src.ico_width), tw)
		sy = I64.div_trunc_by((ty * src.ico_height), th)
		pixel = icon_get(src, sx, sy)
		ico_scale_build(src, tw, th, (tx + 1), ty, List.append(acc, pixel))
	}) }) })

	icon_blit : Rasterizer.Framebuf, Icon.Icon, I64, I64, I64, I64 -> Rasterizer.Framebuf
	icon_blit = |fb, ico, dx, dy, fg, bg| ico_blit_loop(fb, ico, dx, dy, fg, bg, 0, 0)

	ico_blit_loop : Rasterizer.Framebuf, Icon.Icon, I64, I64, I64, I64, I64, I64 -> Rasterizer.Framebuf
	ico_blit_loop = |fb, ico, dx, dy, fg, bg, sx, sy| (if (sy >= ico.ico_height) { fb } else { (if (sx >= ico.ico_width) { ico_blit_loop(fb, ico, dx, dy, fg, bg, 0, (sy + 1)) } else { ({
		pixel = icon_get(ico, sx, sy)
		color = (if (pixel > 0) { fg } else { bg })
		fb2 = (if (bg == 0) { (if (pixel > 0) { Rasterizer.fb_set(fb, (dx + sx), (dy + sy), fg) } else { fb }) } else { Rasterizer.fb_set(fb, (dx + sx), (dy + sy), color) })
		ico_blit_loop(fb2, ico, dx, dy, fg, bg, (sx + 1), sy)
	}) }) })

	icon_blit_keyed : Rasterizer.Framebuf, Icon.Icon, I64, I64, I64 -> Rasterizer.Framebuf
	icon_blit_keyed = |fb, ico, dx, dy, fg| ico_blit_key_loop(fb, ico, dx, dy, fg, 0, 0)

	ico_blit_key_loop : Rasterizer.Framebuf, Icon.Icon, I64, I64, I64, I64, I64 -> Rasterizer.Framebuf
	ico_blit_key_loop = |fb, ico, dx, dy, fg, sx, sy| (if (sy >= ico.ico_height) { fb } else { (if (sx >= ico.ico_width) { ico_blit_key_loop(fb, ico, dx, dy, fg, 0, (sy + 1)) } else { ({
		pixel = icon_get(ico, sx, sy)
		fb2 = (if (pixel > 0) { Rasterizer.fb_set(fb, (dx + sx), (dy + sy), fg) } else { fb })
		ico_blit_key_loop(fb2, ico, dx, dy, fg, (sx + 1), sy)
	}) }) })

	icon_blit_scaled : Rasterizer.Framebuf, Icon.Icon, I64, I64, I64, I64, I64 -> Rasterizer.Framebuf
	icon_blit_scaled = |fb, ico, dx, dy, size, fg, bg| ({
		scaled = icon_scale(ico, size, size)
		icon_blit(fb, scaled, dx, dy, fg, bg)
	})

