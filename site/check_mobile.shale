-- This script checks that a page of the site fits a phone, the landing page
-- unless `page=` names another by its path under the site (`roc-on-shale/`).
-- It runs site/check_mobile.mjs, which loads the page in headless Chromium
-- at 320, 360, 390 and 414 px wide with mobile emulation and names
-- everything wider than the screen or any picture that didn't load, then
-- prints one verdict line. It fails when any width scrolls sideways, has an
-- element or a run of text past the edge, or has an <img> that didn't load
-- (a card's shot.png missing from its folder), named by its src.
--
--   cd <roc-apps checkout> && shale site/check_mobile.shale               # staging, :9200
--   cd <roc-apps checkout> && shale site/check_mobile.shale channel=dev   # dev, :9210, after site/build.sh
--   cd <roc-apps checkout> && shale site/check_mobile.shale channel=dev page=roc-on-shale/
--
-- Run it on dev after changing a page in site/web/, and on staging after
-- `site/publish.sh home`. The shots it takes (each width's whole page and
-- first screen, and the page at 1280 px) go to a fresh folder under
-- ~/build/roc-apps/, which it names; delete it once you've looked.

const URLS = {dev = "http://localhost:9210/", staging = "http://localhost:9200/"}
const WANT = "script: check_mobile.mjs drives the page in headless Chromium"

local channel = arg("channel", "staging")
local page = arg("page", "")
if not has_key(URLS, channel) then fail("check_mobile: channel is dev or staging, not " .. channel) end
if re_find(page, "^([a-z0-9-]+/)*$") == nil then fail("check_mobile: page is a folder's path under the site, like roc-on-shale/, not " .. page) end
local what = "landing page"
if page ~= "" then what = "page " .. page end
local shots = fresh_dir("build:roc-apps", "mobile-shots")
local r = run({"node", "site/check_mobile.mjs", URLS[channel] .. page, real(shots), "desktop"},
  {timeout_ms = 120000, tail = 60, want = WANT})
print(trim(r.out))
if r.code ~= 0 then fail("check_mobile: the " .. channel .. " " .. what .. " doesn't fit a phone or lost a picture (exit " .. r.code .. ")") end
print("check_mobile: the " .. channel .. " " .. what .. " fits a phone at every width, every picture loaded")
