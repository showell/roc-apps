-- This script writes the Roc on Shale pages under site/web/roc-on-shale/:
-- recipes from Shale's cookbook ported to Roc on Shale's Roc platform. The
-- index, roc-on-shale/index.html, says what the platform is and lists the
-- recipes by section, each with its description and facts. Each recipe has a
-- page of its own, roc-on-shale/<recipe>/index.html, that shows its Roc and
-- then its Shale original, both colored by roc-syntax-color; each shared
-- package the recipes import has one too, roc-on-shale/<package>/. Each
-- recipe keeps its anchor on the index (`roc-on-shale/#<recipe>`), so a link
-- into the old single page lands on its entry there. The index's drawing is
-- also written alone, roc-on-shale/platform.svg, for the landing page's card.
--
-- The examples come from shale's cookbook/roc/EXAMPLES.txt (LIST, whose
-- header says the format: sections, each a heading and a sentence, and
-- under each its examples, a name, Roc root, Shale original, commit and
-- description, tab-separated), shown in its order, and everything else on
-- the pages comes from the shale checkout's git history:
--
--   - an example's Roc is its app's root and the modules it imports bare,
--     each read at the last commit that touched any of them, so a page
--     moves only when the Roc does;
--   - its Shale original is the path its line names, in the parent of the
--     commit its line records, with the libraries it loads (`use("./x")`
--     and `use("cookbook:x")`) named, linked and counted;
--   - its effects are the `Shale.x!` calls its Roc makes.
--
-- Every file shown is quoted through tools/quote_code.shale, which every
-- page that shows code shares. A build writes the lock,
-- site/roc_on_shale.quotes, each file's commit and its text's hash; the
-- check works out each file's commit again and fails, naming each file whose
-- text has moved since the lock was written, then holds every page to what
-- the build would write. Uncommitted changes in the shale checkout never
-- reach a page. The coloring is tools/color_code, built here with the
-- pinned Roc from the roc-syntax-color checkout beside this one, as the
-- books import it.
--
--   cd <roc-apps checkout> && shale site/build_roc_on_shale.shale            # writes the pages and the lock
--   cd <roc-apps checkout> && shale site/build_roc_on_shale.shale check=1    # fails if a page is stale
--
-- `shale=` names the shale checkout (`repos:shale` unset), through a mount.
-- A folder under roc-on-shale/ that no recipe or package has is removed by a
-- build and fails the check. Then site/build.sh copies the pages into the dev
-- channel.
--
-- budget: steps=200000000 arena_bytes=1000000000 output_bytes=200000

const LIST = "cookbook/roc/EXAMPLES.txt"
const PAGE_DIR = "site/web/roc-on-shale"
const LOCK = "site/roc_on_shale.quotes"
const QUOTE_CODE = "tools/quote_code.shale"
const GITHUB = "https://github.com/showell/shale/blob/"
const MARK = "<!-- color_code answer -->\n"
const WANT_ROC = "roc-pin: roc-apps' pinned nightly"
const WANT_TOOL = "color-code: tools/color_code, roc-apps' own coloring app, built by this run"

const SHALE = arg("shale", "repos:shale")
const CHECK = arg("check", "0") == "1"

function escaped(s)
  local t = join(split(s, "&"), "&amp;")
  t = join(split(t, "<"), "&lt;")
  t = join(split(t, ">"), "&gt;")
  return join(split(t, "\""), "&quot;")
end

-- Escaped text with each matched pair of backticks made a <code>; a lone
-- backtick stays as it is.
function with_code(html)
  return re_replace(html, "`([^`]+)`", "<code>\\1</code>")
end

-- Nothing, or a stop naming the sibling checkout this page needs and lacks.
function require_siblings()
  if not exists(SHALE) then fail("build_roc_on_shale: no shale checkout at " .. SHALE .. ": clone github.com/showell/shale beside roc-apps (or name one with shale=)") end
  local colorer = dirname(real(".")) .. "/roc-syntax-color"
  local r = run({"git", "-C", colorer, "rev-parse", "--show-toplevel"}, {timeout_ms = 30000, tail = 3})
  if r.code ~= 0 then fail("build_roc_on_shale: no roc-syntax-color checkout beside roc-apps: clone github.com/showell/roc-syntax-color there; tools/color_code imports it") end
  return nil
end

function git_out(argv)
  local full = {"git"}
  for a in argv do push(full, a) end
  return trim(must(run(full, {cwd = SHALE, timeout_ms = 30000, whole = 8000000})).out)
end

function full_hash(rev)
  return git_out({"rev-parse", "--verify", rev .. "^{commit}"})
end

-- The list's sections, as shale's HEAD has them, in order: each {heading,
-- intro, examples}, each example {name, roc, original, commit, description}.
function read_list()
  local sections = {}
  local n = 0
  for l in lines(git_show(SHALE, "HEAD:" .. LIST)) do
    n = n + 1
    local at = LIST .. ":" .. n
    if starts_with(l, "## ") then
      local f = split(sub(l, 4), "\t")
      if #f ~= 2 then fail("build_roc_on_shale: " .. at .. " is a section line with " .. #f .. " tab-separated fields, not 2 (heading, intro)") end
      push(sections, {heading = trim(f[1]), intro = trim(f[2]), examples = {}, line = n})
    elseif trim(l) ~= "" and not starts_with(l, "#") then
      local f = split(l, "\t")
      if #f ~= 5 then fail("build_roc_on_shale: " .. at .. " has " .. #f .. " tab-separated fields, not 5 (name, roc, original, commit, description)") end
      if #sections == 0 then fail("build_roc_on_shale: " .. at .. " names an example before the first section line (`## heading<TAB>intro`)") end
      if re_find(f[1], "^[a-z0-9_]+$") == nil then fail("build_roc_on_shale: " .. at .. ": the name " .. f[1] .. " is its page's folder, so it is lower case, digits and `_` alone") end
      push(sections[#sections].examples, {name = f[1], roc = f[2], original = f[3], commit = f[4], description = trim(f[5])})
    end
  end
  if #sections == 0 then fail("build_roc_on_shale: " .. LIST .. " has no section") end
  for s in sections do
    if #s.examples == 0 then fail("build_roc_on_shale: " .. LIST .. ":" .. s.line .. ": the section " .. s.heading .. " has no example") end
  end
  return sections
end

-- A text without its leading and trailing hyphens.
function trim_hyphens(s)
  local t = s
  while starts_with(t, "-") do t = sub(t, 2) end
  while ends_with(t, "-") do t = sub(t, 1, #t - 1) end
  return t
end

-- A section's anchor: its heading in lower case, each run of other
-- characters a hyphen.
function section_id(heading)
  return "section-" .. trim_hyphens(re_replace(lower(heading), "[^a-z0-9]+", "-"))
end

-- The app's root and the modules it reaches by bare imports, root first,
-- then each module as the files before it first import it, as HEAD has them.
function roc_files(root)
  local files = {root}
  local seen = {}
  seen[root] = true
  local i = 1
  while i <= #files do
    local text = git_show(SHALE, "HEAD:" .. files[i])
    for m in re_lines(text, "^import ([A-Z][A-Za-z0-9_]*)[ \t]*$") do
      local module = dirname(files[i]) .. "/" .. trim(sub(m.text, 8)) .. ".roc"
      if not has_key(seen, module) then
        seen[module] = true
        push(files, module)
      end
    end
    i = i + 1
  end
  return files
end

-- The cookbook's shared Roc packages, each shown once on a page of its own:
-- the name an app's header gives it (`import name.X`), its folder, its
-- page's folder (also its anchor on the index), heading and sentence. An
-- example that imports a package this table lacks stops the run.
const PACKAGES = {
  {name = "lib", dir = "cookbook/roc/lib", id = "shared-library", heading = "The shared Roc library",
    intro = "The modules the ports over Roc code share, as a package each app names in its header and imports as `lib.X`: Roc's parse tree read into records, a file's lines and words, a module's declarations, and a finding's line."},
  {name = "items", dir = "cookbook/c/items", id = "c-splitter", heading = "The C splitter",
    intro = "The package the programs over Shale's C share, imported as `items.X`: it blanks strings and comments, then splits a file into its top-level items, each with its kind, name, lines, head and body."},
}

-- The packages `files` import, as HEAD has them: each {package, names}, in
-- the table's order, its module names sorted; a module the package lacks,
-- or a package the table lacks, stops the run.
function package_imports(files)
  local found = {}
  for p in files do
    for m in re_lines(git_show(SHALE, "HEAD:" .. p), "^import [a-z][a-z0-9_]*\\.[A-Z][A-Za-z0-9_]*[ \t]*$") do
      local parts = split(trim(sub(m.text, 8)), ".")
      if not has_key(found, parts[1]) then found[parts[1]] = {} end
      push(found[parts[1]], parts[2])
    end
  end
  local out = {}
  local known = {pf = true}
  for pkg in PACKAGES do
    known[pkg.name] = true
    if has_key(found, pkg.name) then
      local names = unique(found[pkg.name])
      sort(names)
      for n in names do
        if git_out({"ls-tree", "--name-only", "HEAD", pkg.dir .. "/" .. n .. ".roc"}) == "" then fail("build_roc_on_shale: an example imports " .. pkg.name .. "." .. n .. ", and " .. pkg.dir .. " has no " .. n .. ".roc") end
      end
      push(out, {package = pkg, names = names})
    end
  end
  for name in keys(found) do
    if not has_key(known, name) then fail("build_roc_on_shale: an example imports the package `" .. name .. "`, which PACKAGES doesn't name: add its folder, anchor, heading and sentence") end
  end
  return out
end

-- A package's files as HEAD has them, each {path}, main.roc last, and the
-- last commit that touched its folder, which they are quoted at.
function package_plan(pkg)
  local paths = {}
  local main = ""
  for p in lines(git_out({"ls-tree", "--name-only", "HEAD", pkg.dir .. "/"})) do
    if ends_with(p, "/main.roc") then main = p elseif ends_with(p, ".roc") then push(paths, p) end
  end
  sort(paths)
  if main ~= "" then push(paths, main) end
  if #paths == 0 then fail("build_roc_on_shale: " .. pkg.dir .. " holds no Roc at HEAD") end
  local rev = full_hash(git_log(SHALE, {n = 1, paths = {pkg.dir}})[1].hash)
  local files = {}
  for p in paths do push(files, {path = p}) end
  return {package = pkg, rev = rev, files = files}
end

function sorted_unique(list)
  local u = unique(list)
  sort(u)
  return u
end

-- What one example quotes, and where: its Roc files at the last commit that
-- touched any of them, its Shale original at the parent of its commit, and
-- the libraries that original loads, counted there.
function example_plan(e)
  local files = roc_files(e.roc)
  local roc_rev = full_hash(git_log(SHALE, {n = 1, paths = files})[1].hash)
  local roc = {}
  for p in files do push(roc, {path = p}) end
  local commit = full_hash(e.commit)
  local parent = full_hash(commit .. "^")
  local path = e.original
  local libraries = {}
  local library_lines = 0
  for m in re_lines(git_show(SHALE, parent .. ":" .. path), "^use\\(\"(\\./|cookbook:)[^\"]+\"\\)") do
    local u = re_find(m.text, "\"(\\./|cookbook:)([^\"]+)\"")
    local lib = "cookbook/" .. u.groups[2]
    if u.groups[1] == "./" then lib = dirname(path) .. "/" .. u.groups[2] end
    local n = #lines(git_show(SHALE, parent .. ":" .. lib))
    push(libraries, {path = lib, lines = n})
    library_lines = library_lines + n
  end
  return {
    name = e.name, description = e.description, roc = roc, roc_rev = roc_rev,
    packages = package_imports(files),
    shale = {path = path, rev = parent, libraries = libraries, library_lines = library_lines},
  }
end

-- A child run's output less the runner's own report (its budget, step and
-- time lines and the calls that led to a stop), its stop line kept, so the
-- stop's why is what is left.
function stop_of(out)
  local kept = {}
  for l in lines(out) do
    local report = starts_with(l, "── ") and not starts_with(l, "── stopped at ")
    if not report and not starts_with(trim(l), "called from ") then push(kept, l) end
  end
  return trim(join(kept, "\n"))
end

-- Each `{id, path, rev}` file's text, from one run of tools/quote_code.shale,
-- set on it as `text` and `lines`, with `rev` the commit it was quoted at: a
-- build quotes at each rev and writes the lock, a check holds the quotes to
-- it and quotes at the lock's commits.
function quote_files(files)
  local quotes = {}
  local seen = {}
  for f in files do
    if has_key(seen, f.id) then fail("build_roc_on_shale: two quotes are named " .. f.id) end
    seen[f.id] = true
    push(quotes, {id = f.id, kind = "file", repo = SHALE, path = f.path, rev = f.rev})
  end
  local work = fresh_dir("build:roc-apps", "roc-on-shale-quotes")
  replace(work .. "/quotes.json", json_write(quotes))
  local mode = "write"
  if CHECK then mode = "check" end
  local r = run({"shale", "--root", ".", QUOTE_CODE, "quotes=" .. work .. "/quotes.json", "answers=" .. work .. "/answers.json", "lock=" .. LOCK, "mode=" .. mode}, {timeout_ms = 300000, tail = 40})
  if r.ended ~= "exit" or r.code ~= 0 then
    remove_tree(work)
    fail("build_roc_on_shale: " .. QUOTE_CODE .. " mode=" .. mode .. " failed: " .. stop_of(r.out))
  end
  local answers = json_read(read(work .. "/answers.json"))
  remove_tree(work)
  for i = 1, #files do
    files[i].text = answers[i].text
    files[i].lines = #lines(answers[i].text)
    files[i].rev = answers[i].rev
  end
  return nil
end

-- The colored HTML of each {language, text}, in order, from one run of
-- tools/color_code.
function colored(requests)
  local roc = pinned_roc("build_roc_on_shale")
  local work = fresh_dir("build:roc-apps", "color-code")
  local tool = real(work) .. "/color_code"
  must(run({roc, "build", "--opt=dev", "main.roc", "--output=" .. tool}, {cwd = "tools/color_code", timeout_ms = 300000, tail = 20, nice = 19, want = WANT_ROC}))
  local argv = {tool}
  for r in requests do
    push(argv, r.language)
    push(argv, r.text)
  end
  local r = must(run(argv, {timeout_ms = 60000, whole = 20000000, want = WANT_TOOL}))
  remove_tree(work)
  local pieces = split(r.out, MARK)
  if pieces[1] ~= "" then fail("build_roc_on_shale: color_code printed something before its first answer") end
  if #pieces - 1 ~= #requests then fail("build_roc_on_shale: " .. #requests .. " texts got " .. (#pieces - 1) .. " answers") end
  return drop(pieces, 1)
end

-- A count as the site writes one, a comma between each three digits.
function grouped(n)
  local s = "" .. n
  local out = ""
  while #s > 3 do
    out = "," .. sub(s, #s - 2, #s) .. out
    s = sub(s, 1, #s - 3)
  end
  return s .. out
end

function plural(n, one, many)
  if n == 1 then return "1 " .. one end
  return grouped(n) .. " " .. many
end

-- What the facts line says of the libraries a Shale original loads.
function shared_libraries(s)
  if #s.libraries == 0 then return "" end
  local which = "the library it loads"
  if #s.libraries > 1 then which = "the " .. #s.libraries .. " libraries it loads" end
  return ", plus " .. plural(s.library_lines, "line", "lines") .. " in " .. which .. ", which other recipes share"
end

function file_link(rev, path)
  return "<a href=\"" .. GITHUB .. rev .. "/" .. path .. "\"><code>" .. escaped(path) .. "</code></a>"
end

function code_block(html)
  return "<pre><code>" .. html .. "</code></pre>"
end

-- The links at the top and end of an example's page: the one before it, its
-- place on the index and the one after it, each where there is one.
function step_links(examples, i)
  local links = {}
  if i > 1 then push(links, "<a href=\"../" .. examples[i - 1].name .. "/\">← previous</a>") end
  push(links, "<a href=\"../#" .. examples[i].name .. "\">Roc on Shale</a>")
  if i < #examples then push(links, "<a href=\"../" .. examples[i + 1].name .. "/\">next →</a>") end
  return "<nav class=\"steps\">" .. join(links, " · ") .. "</nav>"
end

-- A part's opening on the index: its heading, and the sentence saying what
-- is in it.
function part_head(s)
  local id = section_id(s.heading)
  return "<h2 class=\"part\" id=\"" .. id .. "\"><a href=\"#" .. id .. "\">" .. escaped(s.heading) .. "</a></h2>\n<p class=\"part-intro\">" ..
    with_code(escaped(s.intro)) .. "</p>"
end

-- An example's entry on the index: its name, linked to its page, what it
-- does, and its facts.
function entry_html(x)
  local out = {}
  push(out, "<section class=\"entry\" id=\"" .. x.name .. "\">")
  push(out, "<h3><a href=\"" .. x.name .. "/\">" .. escaped(x.name) .. "</a></h3>")
  push(out, "<p>" .. with_code(escaped(x.description)) .. "</p>")
  local effects = {}
  for f in x.effects do push(effects, "<code>" .. escaped(f) .. "</code>") end
  push(out, "<p class=\"facts\">Its effects: " .. join(effects, ", ") .. ".<br>Roc: " .. plural(x.roc_lines, "line", "lines") ..
    " in " .. plural(#x.roc, "file", "files") .. ". Shale original: " .. plural(x.shale.lines, "line", "lines") .. shared_libraries(x.shale) .. ".</p>")
  push(out, "</section>")
  return join(out, "\n")
end

-- An example's page body: its Roc, then its Shale original, each file
-- colored.
function example_body(x, html, steps)
  local out = {}
  push(out, steps)
  push(out, "<h1>" .. escaped(x.name) .. "</h1>")
  push(out, "<h2 class=\"code\">Roc</h2>")
  for used in x.packages do
    local names = {}
    for n in used.names do push(names, "<code>" .. n .. "</code>") end
    push(out, "<p class=\"file\">It also imports " .. join(names, ", ") .. " from <a href=\"../" .. used.package.id .. "/\">" .. escaped(lower(sub(used.package.heading, 1, 1)) .. sub(used.package.heading, 2)) .. "</a>.</p>")
  end
  for i = 1, #x.roc do
    push(out, "<p class=\"file\">" .. file_link(x.roc[i].rev, x.roc[i].path) .. ", " .. plural(x.roc[i].lines, "line", "lines") .. "</p>")
    push(out, code_block(html.roc[i]))
  end
  push(out, "<h2 class=\"code\">Shale original</h2>")
  push(out, "<p class=\"file\">" .. file_link(x.shale.rev, x.shale.path) .. ", " .. plural(x.shale.lines, "line", "lines") ..
    ", at <code>" .. sub(x.shale.rev, 1, 8) .. "</code></p>")
  if #x.shale.libraries > 0 then
    local libs = {}
    for l in x.shale.libraries do push(libs, file_link(x.shale.rev, l.path) .. " (" .. plural(l.lines, "line", "lines") .. ")") end
    push(out, "<p class=\"file\">The libraries it loads: " .. join(libs, ", ") .. ".</p>")
  end
  push(out, code_block(html.shale))
  push(out, steps)
  return join(out, "\n")
end

-- A package's page body: its files, each colored, between links to its
-- place on the index.
function package_body(shown, answers, at)
  local pkg = shown.package
  local back = "<nav class=\"steps\"><a href=\"../#" .. pkg.id .. "\">Roc on Shale</a></nav>"
  local out = {back, "<h1>" .. escaped(pkg.heading) .. "</h1>"}
  for i = 1, #shown.files do
    local f = shown.files[i]
    push(out, "<p class=\"file\">" .. file_link(f.rev, f.path) .. ", " .. plural(f.lines, "line", "lines") .. "</p>")
    push(out, code_block(answers[at + i - 1]))
  end
  push(out, back)
  return join(out, "\n")
end

const STYLE = [=[<style>
  :root { color-scheme: light dark; --bg: #f7f5f0; --fg: #1d1d1b; --muted: #6b6860; --edge: #d9d4c8; --pane: #ffffff; --link: #1f5fa8; --accent: #5b3ea8; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #1b1b1a; --fg: #e8e6e0; --muted: #9a968c; --edge: #3a3934; --pane: #242422; --link: #8ab4f0; --accent: #a68cf0; }
  }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.55 system-ui, sans-serif; }
  main { max-width: 960px; margin: 0 auto; padding: 36px 16px 48px; }
  @media (max-width: 640px) { main { padding: 24px 12px 36px; } }
  .top { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 14px; margin: 0 0 14px; }
  h1 { font-size: 28px; margin: 0 0 6px; overflow-wrap: anywhere; }
  .lede { margin: 0 0 10px; max-width: 70ch; }
  ul.lede { padding-left: 22px; }
  ul.lede li { margin: 0 0 4px; }
  h2.intro { font-size: 20px; margin: 30px 0 6px; }
  h3.intro { font-size: 16px; margin: 18px 0 4px; }
  /* The drawing is Graphviz's SVG, inline, so its lines and words take the
     page's colors in either theme. */
  .diagram { margin: 14px 0 18px; }
  .diagram svg { max-width: 100%; height: auto; }
  .diagram text { fill: var(--fg); }
  .diagram path, .diagram polygon { stroke: var(--fg); }
  .diagram .edge polygon { fill: var(--fg); }
  h2.part { font-size: 25px; margin: 64px 0 4px; padding-top: 20px; border-top: 3px solid var(--accent); }
  .part-intro { margin: 0 0 8px; }
  h3 { font-size: 19px; margin: 10px 0 4px; overflow-wrap: anywhere; }
  h2.part a { color: inherit; text-decoration: none; }
  h2.code { font-size: 16px; margin: 36px 0 4px; color: var(--accent); }
  p { max-width: 70ch; }
  a { color: var(--link); }
  code { font: 13px ui-monospace, Menlo, Consolas, monospace; }
  .contents { padding-left: 20px; }
  .contents ul { padding-left: 20px; margin: 2px 0 8px; }
  .contents a { overflow-wrap: anywhere; }
  .facts { font-size: 14px; color: var(--muted); }
  .file { font-size: 13px; color: var(--muted); margin: 20px 0 0; overflow-wrap: anywhere; }
  .entry { margin-top: 28px; padding-top: 14px; border-top: 1px solid var(--edge); }
  .steps { font-size: 13px; margin: 0 0 8px; }
  main > .steps:last-child { margin: 28px 0 0; }
  /* Every block shows its file whole; a line wider than the block scrolls
     sideways inside it, so the code keeps its indentation. */
  pre { margin: 6px 0 12px; padding: 12px 14px; border-radius: 5px; background: #2b2733; color: #e8e6e0;
        font: 12px/1.45 ui-monospace, Menlo, Consolas, monospace; overflow-x: auto; tab-size: 4; }
  pre code { font: inherit; }
  .syn-keyword { color: #c792ea; }
  .syn-type { color: #82aaff; }
  .syn-string { color: #c3e88d; }
  .syn-number { color: #f78c6c; }
  .syn-comment { color: #8a8494; font-style: italic; }
  .syn-name { color: #ffcb6b; }
  footer { margin-top: 36px; color: var(--muted); font-size: 13px; }
</style>
]=]

-- A page's opening, to its <main>: its title, its description, the way to
-- the site's shared script (`../` for the index, `../../` below it) and the
-- style every page shares.
function page_head(title, description, up)
  return "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n" ..
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n" ..
    "<meta name=\"description\" content=\"" .. escaped(description) .. "\">\n" ..
    "<title>" .. escaped(title) .. "</title>\n" ..
    "<script src=\"" .. up .. "shared/home.js\"></script>\n" ..
    "<!-- site/build_roc_on_shale.shale writes this page from the shale repository's\n" ..
    "     history; run it again rather than editing here. The code is colored by\n" ..
    "     roc-syntax-color (SyntaxColor.html). -->\n" ..
    STYLE .. "</head>\n<body>\n<main>\n"
end

const INDEX_DESCRIPTION = "Recipes from Shale's cookbook written in Roc, on a Roc platform whose host is Shale's own runtime, each on a page of its own followed by the Shale script it replaced."

const INTRO = [=[<div class="top"><a href="../">Steve's Roc Work</a><a href="../syntax-color/">roc-syntax-color</a><a href="https://github.com/showell/shale">Shale on GitHub</a></div>
<h1>Roc on Shale</h1>
<p class="lede">The programs listed here are written in Roc and run on
<a href="https://github.com/showell/shale">Shale</a>, a runtime for programs that work with files, folders and
other programs. Each is a check or a report we run on our own code, and each has a page of its own that shows it in
full.</p>
<h2 class="intro">What Roc brings</h2>
<p class="lede">Roc is a fast, friendly, functional language.</p>
<ul class="lede">
<li><strong>Fast.</strong> Roc compiles to machine code.</li>
<li><strong>Checked.</strong> The type checker infers every type, so a program needs few annotations and still has
every call checked before it runs.</li>
<li><strong>Pure by default.</strong> A function that reads a file is marked by its name and its type. Everything
else is plain computation that a test can call directly.</li>
<li><strong>Tested in place.</strong> Tests are <code>expect</code>s, written beside the code they test.</li>
</ul>
<h2 class="intro">Effects come from a platform</h2>
<p class="lede">Every Roc application runs on a <em>platform</em>, which supplies its effects: reading files,
reaching the network and the rest. A program has only the effects its platform offers.
<a href="https://github.com/roc-lang/basic-cli">basic-cli</a>,
Roc's standard platform for command-line programs, offers a wide set: files and folders, the network, environment
variables, the clock and more. The platform these examples use offers a narrower set, adds a few things of its own,
and has Shale's runtime as its host, so each effect is a call into Shale, held to the limits Shale sets for the run.
Everything else is plain Roc.</p>
<!-- the diagram -->
<h3 class="intro">What it offers</h3>
<ul class="lede">
<li><strong>Files:</strong> read and write a file, ask whether one exists, list, make and remove a folder, glob and
grep.</li>
<li><strong>Programs:</strong> run one, with a timeout, keeping the head, the tail or the whole of its output.</li>
<li><strong>The rest:</strong> print, stop with a message, and read the script's arguments.</li>
</ul>
<h3 class="intro">What it adds</h3>
<ul class="lede">
<li><strong>Roc's parse tree.</strong> <code>roc_tree!</code> hands a program Roc's own parse of a file, so a check
reads Roc code as Roc reads it.</li>
<li><strong>Regular expressions,</strong> supplied by the host.</li>
<li><strong>Shale's limits on every effect:</strong> budgets for a run's steps, reads and output; reads only beneath
the run's root and its named mounts; a program run only when Shale's rules allow it; and a timeout on each one.</li>
</ul>
<h3 class="intro">Beyond this platform</h3>
<p class="lede">basic-cli also offers the network, environment variables, standard input and the clock. The
programs here need only what's listed above.
<a href="https://github.com/showell/shale/blob/master/roc_platform/README.md">The platform's README</a> explains how
it works.</p>
<h2 class="intro">The examples</h2>
<p class="lede">The examples are in sections. The first holds programs that find flaws in Roc code, and one that
fixes them too: Roc reading Roc, most of them through Roc's own parser. After it come programs that read Shale itself, then reports on Roc
projects, then smaller programs over Zig. The shared packages the examples import are listed at the end, and each
is shown once, on a page of its own.</p>
<h2 class="intro">Shale's own language</h2>
<p class="lede">Shale is also a scripting language of its own, and each example began as a Shale script. Each
example's page shows its Roc program, then the Shale script it was ported from, with both files colored by
<a href="../syntax-color/">roc-syntax-color</a>. Each port was checked against its original's output. The links at
the top and end of each example's page go to the one before or after it, and back to its place here.</p>
<h2 class="intro">How the runtime is built</h2>
<p class="lede">Shale's runtime is written in C, in
<a href="https://github.com/showell/shale/tree/master/c">its repository's <code>c/</code> folder</a>, and needs only
Linux on x86-64, GCC and TCC.</p>
<ul class="lede">
<li><strong>One translation unit.</strong> <code>c/shale.c</code> takes in the whole runtime, so GCC sees every
function at once and the release build is a single <code>gcc -O2</code>.</li>
<li><strong>Two compilers.</strong> TCC compiles the whole program in a fraction of GCC's time, for the edit loop. GCC
builds every binary we ship, with no LLVM involved.</li>
<li><strong>Two tiers of checks.</strong> The fast tier runs every C test in seconds, on each edit. The full tier adds
the release build, every test under ASan and UBSan, a <code>-Werror</code> build at <code>-O2</code>, and the
cookbook's own tests, including the goldens behind the examples below. It runs on GitHub, before every merge.
Each test was also proven once, by a planted fault, to be able to fail.</li>
<li><strong>The builds are Shale scripts.</strong> A new machine builds its first <code>shale</code> by hand with
TCC and GCC, and from then on Shale builds itself.</li>
</ul>
<p class="lede">The Roc platform's host is that same C, with a small driver added. It's compiled once with
<code>gcc -O2</code> into an object and cached. Each Roc script is built by the pinned Roc compiler into an archive
and linked with that object, and the program is cached by a hash of every file it's built from. The Roc runs on a
stack of its own, takes its memory from an arena held to the run's budget, and has a CPU budget for its own
computation.</p>
]=]

const INDEX_FOOT = [=[
<footer><a href="../">Steve's Roc Work</a> · <a href="../syntax-color/">roc-syntax-color</a> · <a href="https://github.com/showell/shale">Shale on GitHub</a></footer>
</main>
</body>
</html>
]=]

const PAGE_FOOT = [=[
</main>
</body>
</html>
]=]

-- The contents, a list of the sections, each with its examples, then the
-- packages shown, each linked to its place on the index.
function contents_html(parts, packages)
  local items = {}
  for s in parts do
    local names = {}
    for x in s.examples do push(names, "<li><a href=\"#" .. x.name .. "\">" .. escaped(x.name) .. "</a></li>") end
    push(items, "<li><a href=\"#" .. section_id(s.heading) .. "\">" .. escaped(s.heading) .. "</a>\n<ul>\n" .. join(names, "\n") .. "\n</ul></li>")
  end
  for shown in packages do push(items, "<li><a href=\"#" .. shown.package.id .. "\">" .. escaped(shown.package.heading) .. "</a></li>") end
  return "<ul class=\"contents\" id=\"contents\">\n" .. join(items, "\n") .. "\n</ul>"
end

-- Graphviz's SVG of DIAGRAM_SOURCE, whole. The index inlines it, and the
-- landing page's card shows it as DIAGRAM_FILE, an image of its own.
const DIAGRAM_SOURCE = "site/roc_on_shale_platform.dot"
const DIAGRAM_FILE = PAGE_DIR .. "/platform.svg"
function diagram_svg()
  return must(run({"dot", "-Tsvg", DIAGRAM_SOURCE}, {timeout_ms = 30000, whole = 1000000})).out
end

-- The opening with its drawing in place of DIAGRAM_MARK: the SVG from its
-- `<svg` on, so the page's CSS colors it.
const DIAGRAM_MARK = "<!-- the diagram -->"
function with_diagram(head, svg)
  local at = find(head, DIAGRAM_MARK)
  if not at then fail("build_roc_on_shale: the opening has no `" .. DIAGRAM_MARK .. "`") end
  local start = find(svg, "<svg")
  if not start then fail("build_roc_on_shale: dot gave no <svg> for " .. DIAGRAM_SOURCE) end
  return sub(head, 1, at - 1) .. "<div class=\"diagram\">\n" .. trim(sub(svg, start, #svg)) .. "\n</div>" ..
    sub(head, at + #DIAGRAM_MARK, #head)
end

-- Every page, each {path, text}: the index first, then each example's page
-- in the list's order, then each package's. The previous and next links
-- walk every example in that order, across the sections.
function pages()
  local parts = {}
  local examples = {}
  for s in read_list() do
    local part = {heading = s.heading, intro = s.intro, examples = {}}
    for e in s.examples do
      local x = example_plan(e)
      push(part.examples, x)
      push(examples, x)
    end
    push(parts, part)
  end
  -- Each package an example imports, in the table's order.
  local packages = {}
  for pkg in PACKAGES do
    local used = false
    for x in examples do
      for u in x.packages do
        if u.package.name == pkg.name then used = true end
      end
    end
    if used then push(packages, package_plan(pkg)) end
  end
  local folders = {}
  for x in examples do push(folders, x.name) end
  for shown in packages do push(folders, shown.package.id) end
  if #unique(folders) ~= #folders then fail("build_roc_on_shale: a recipe and a package, or two recipes, share a page's folder: " .. join(folders, ", ")) end
  -- Every file shown, quoted in one run, in the order it is colored.
  local files = {}
  for x in examples do
    for f in x.roc do
      f.id = x.name .. "/roc/" .. f.path
      f.rev = x.roc_rev
      push(files, f)
    end
    x.shale.id = x.name .. "/shale/" .. x.shale.path
    push(files, x.shale)
  end
  for shown in packages do
    for f in shown.files do
      f.id = shown.package.id .. "/" .. f.path
      f.rev = shown.rev
      push(files, f)
    end
  end
  quote_files(files)
  local requests = {}
  for x in examples do
    x.roc_lines = 0
    local effects = {}
    for f in x.roc do
      x.roc_lines = x.roc_lines + f.lines
      for m in re_find_all(f.text, "Shale\\.([a-z_]+!)") do push(effects, "Shale." .. m.group) end
      push(requests, {language = "roc", text = f.text})
    end
    x.effects = sorted_unique(effects)
    push(requests, {language = "shale", text = x.shale.text})
  end
  for shown in packages do
    for f in shown.files do push(requests, {language = "roc", text = f.text}) end
  end
  local answers = colored(requests)
  local svg = diagram_svg()
  local index = {page_head("Roc on Shale", INDEX_DESCRIPTION, "../") .. with_diagram(INTRO, svg), contents_html(parts, packages)}
  for s in parts do
    push(index, "<div class=\"group\">")
    push(index, part_head(s))
    for x in s.examples do push(index, entry_html(x)) end
    push(index, "</div>")
  end
  for shown in packages do
    local pkg = shown.package
    push(index, "<div class=\"group\">")
    push(index, "<h2 class=\"part\" id=\"" .. pkg.id .. "\"><a href=\"#" .. pkg.id .. "\">" .. escaped(pkg.heading) .. "</a></h2>\n<p class=\"part-intro\">" ..
      with_code(escaped(pkg.intro)) .. " Each example that imports it names the modules it uses.</p>")
    push(index, "<p class=\"file\"><a href=\"" .. pkg.id .. "/\">" .. escaped(pkg.heading) .. ": " .. plural(#shown.files, "file", "files") .. "</a></p>")
    push(index, "</div>")
  end
  local out = {{path = PAGE_DIR .. "/index.html", text = join(index, "\n") .. INDEX_FOOT}, {path = DIAGRAM_FILE, text = svg}}
  local at = 1
  for i = 1, #examples do
    local x = examples[i]
    local html = {roc = {}}
    for f in x.roc do
      push(html.roc, answers[at])
      at = at + 1
    end
    html.shale = answers[at]
    at = at + 1
    local text = page_head(x.name .. " · Roc on Shale", x.description, "../../") .. example_body(x, html, step_links(examples, i)) .. PAGE_FOOT
    push(out, {path = PAGE_DIR .. "/" .. x.name .. "/index.html", text = text})
  end
  for shown in packages do
    local text = page_head(shown.package.heading .. " · Roc on Shale", shown.package.intro, "../../") .. package_body(shown, answers, at) .. PAGE_FOOT
    at = at + #shown.files
    push(out, {path = PAGE_DIR .. "/" .. shown.package.id .. "/index.html", text = text})
  end
  return out
end

-- The folders under PAGE_DIR that no page is written in.
function stray_folders(written)
  local wanted = {}
  for p in written do wanted[dirname(p.path)] = true end
  local strays = {}
  if not exists(PAGE_DIR) then return strays end
  for name in ls(PAGE_DIR) do
    local dir = PAGE_DIR .. "/" .. name
    if stat(dir).kind == "directory" and not has_key(wanted, dir) then push(strays, dir) end
  end
  return strays
end

require_siblings()
local written = pages()
local strays = stray_folders(written)
if CHECK then
  local stale = {}
  for p in written do
    if not exists(p.path) or read(p.path) ~= p.text then push(stale, p.path) end
  end
  for d in strays do push(stale, d .. " (no recipe or package has it)") end
  if #stale > 0 then fail("build_roc_on_shale: " .. #stale .. " of " .. #written .. " pages are stale: " .. join(stale, ", ") .. ": run shale site/build_roc_on_shale.shale") end
  print("build_roc_on_shale: " .. #written .. " pages under " .. PAGE_DIR .. " are up to date, their quotes unmoved since " .. LOCK)
else
  local bytes = 0
  for p in written do
    mkdir(dirname(p.path))
    if exists(p.path) then replace(p.path, p.text) else create(p.path, p.text) end
    bytes = bytes + #p.text
  end
  for d in strays do remove_tree(d) end
  print("build_roc_on_shale: wrote " .. #written .. " pages under " .. PAGE_DIR .. ", " .. grouped(bytes) .. " bytes, and " .. LOCK .. "; removed " .. #strays .. " stray folders")
end
