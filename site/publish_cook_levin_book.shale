-- budget: programs=100 steps=100000000 read_bytes=200000000
-- This script publishes cook-levin-riff's book, A riff on Cook-Levin, to
-- staging at site/live/cook-levin/, as site/publish_roc_js.shale does for
-- roc-js-interpreter's book. The page is unlisted: no card on the landing
-- page links it.
--
--   cd <roc-apps checkout> && shale site/publish_cook_levin_book.shale
--   cd <roc-apps checkout> && shale site/publish_cook_levin_book.shale dry=1
--
-- The source stays in cook-levin-riff (repos:cook-levin). The script refuses
-- that checkout when it has changes of any kind (an untracked file included)
-- or its HEAD is on no branch of GitHub's, so what is published is always a
-- commit anyone can fetch. It builds there with the repository's own
-- book/book.shale, which writes the book into the dev channel's
-- build:roc-apps/next/cook-levin/ (built by the book builder of the roc-apps
-- checkout at repos:roc-apps). A build that leaves the checkout changed is
-- refused.
--
-- The dev folder is copied over its staging folder whole, with a PROVENANCE:
-- the Roc compiler and the cook-levin-riff commit. Then it checks what it
-- copied: the book holds only pages, its stylesheet and copy.js, and no
-- `src`, `href`, `fetch` or `url()` URL may start with `/`, and none but an
-- `<a>`'s href may name a network scheme (`https://`), so the book's links
-- out stay. A failed check stops before git, leaving site/live/ changed and
-- uncommitted. The folder is committed alone, with the PROVENANCE in the
-- message, and pushed with git_push. site/deploy.shale takes it to prod with
-- the rest.
--
-- Option, for a proof that touches no staging:
--
--   dry=1    build, copy into build:roc-apps/publish_cook_levin_book.dry/
--            (replaced each run, left for reading), write the PROVENANCE and
--            check, then compare the folder with today's site/live/ file by
--            file, PROVENANCE aside, and stop before git

const CL = "repos:cook-levin"
const REPO_URL = "https://github.com/showell/cook-levin-riff"
const DRY = arg("dry", 0) == 1
const LIVE = "site/live"
const DRY_DIR = "build:roc-apps/publish_cook_levin_book.dry"
const NEXT = "build:roc-apps/next"
const NAME = "cook-levin"
const STAGING = "http://localhost:9200/"
const BOOK_FIXED = {"book.css", "copy.js", "index.html"}

-- Stops the publish when cook-levin-riff has a change of any kind.
function refuse_changes(when)
  if not git_is_clean(CL) then
    for s in git_status(CL) do print(s.code .. " " .. s.path) end
    fail("publish_cook_levin_book: cook-levin-riff has changes " .. when .. "; commit and push them first")
  end
  return nil
end

-- The cook-levin-riff commit to publish, its full hash: clean, and on a
-- branch of origin.
function cl_commit()
  if not exists(CL .. "/book/book.shale") then fail("publish_cook_levin_book: no book/book.shale in the cook-levin-riff checkout at " .. CL) end
  refuse_changes("before the build")
  git_fetch(CL)
  local head = trim(must(run({"git", "rev-parse", "HEAD"}, {cwd = CL, timeout_ms = 10000, tail = 2})).out)
  local on = must(run({"git", "branch", "-r", "--contains", head}, {cwd = CL, timeout_ms = 10000, tail = 20}))
  if trim(on.out) == "" then fail("publish_cook_levin_book: cook-levin-riff's HEAD " .. sub(head, 1, 7) .. " is on no branch of origin; push it first") end
  return head
end

-- The book builder's pin, roc-apps' own, checked against what its
-- `roc version` says.
function builder_roc_pin()
  local pin = trim(read("repos:roc-apps/roc-version"))
  local roc = "tools:roc-" .. pin .. "/roc"
  if not exists(roc) then fail("publish_cook_levin_book: no " .. roc .. ": install roc-apps' pin " .. pin .. " at ~/tools/roc-" .. pin .. "/") end
  local said = trim(must(run({real(roc), "version"}, {timeout_ms = 30000, tail = 2, want = "roc-pin: the book builder's pinned compiler"})).out)
  if said ~= "Roc compiler version " .. pin then fail("publish_cook_levin_book: " .. roc .. " is " .. said .. ", not " .. pin) end
  return pin
end

-- Every file below `dir`, by its name under it, sorted.
function files_under(dir)
  local names = {}
  for e in walk_all(dir, {kind = "file"}) do push(names, sub(e.path, #dir + 2, #e.path)) end
  sort(names)
  return names
end

-- Each file's sha256 below `dir`, by its name under it, PROVENANCE aside.
function sums_under(dir)
  local names = {}
  local argv = {"sha256sum"}
  for f in files_under(dir) do
    if f ~= "PROVENANCE" then
      push(names, f)
      push(argv, real(dir .. "/" .. f))
    end
  end
  local sums = {}
  if #names == 0 then return sums end
  local said = lines(trim(must(run(argv, {timeout_ms = 60000, whole = 200000})).out))
  for i = 1, #names do sums[names[i]] = sub(said[i], 1, 64) end
  return sums
end

function provenance(head, pin)
  local stamp = trim(must(run({"date", "-u", "+%Y-%m-%dT%H:%M:%SZ"}, {timeout_ms = 5000, tail = 2})).out)
  local text = "published " .. stamp .. "\n"
  text = text .. "roc " .. pin .. "\n"
  text = text .. "cook-levin-riff " .. sub(head, 1, 8) .. " " .. REPO_URL .. "/commit/" .. head .. " (its book/book.shale)\n"
  return text
end

-- One check's line; a failed one stops the publish.
function check_line(name, ok, detail)
  local verdict = "PASS"
  if not ok then verdict = "FAIL" end
  print(verdict .. "  " .. name .. ": " .. detail)
  if not ok then fail("publish_cook_levin_book: the check of " .. name .. " failed; the copy is changed and not committed") end
  return nil
end

-- The book holds PROVENANCE, BOOK_FIXED and pages (`.html`), and nothing else.
function check_book_files(book)
  local found = files_under(book)
  local other = {}
  local pages = 0
  for f in found do
    if ends_with(f, ".html") then
      pages = pages + 1
    elseif f ~= "PROVENANCE" and not has_item(BOOK_FIXED, f) then
      push(other, f)
    end
  end
  local missing = {}
  for f in BOOK_FIXED do
    if not has_item(found, f) then push(missing, f) end
  end
  if not has_item(found, "PROVENANCE") then push(missing, "PROVENANCE") end
  check_line("files", #other == 0 and #missing == 0, book .. " holds " .. pages .. " pages; missing: " .. join(missing, " ") .. "; unexpected: " .. join(other, " "))
  return nil
end

-- No resource of the text files below `dir` is rooted at `/`, and none but
-- an `<a>`'s href names a network scheme (`<scheme>://`).
function check_relative(dir)
  local rooted = 0
  local schemed = 0
  local files = 0
  for f in files_under(dir) do
    if ends_with(f, ".html") or ends_with(f, ".js") or ends_with(f, ".css") then
      files = files + 1
      local text = read(dir .. "/" .. f)
      rooted = rooted + #re_find_all(text, [=[(?:src|href)\s*=\s*["']?/|fetch(?:ed)?\(\s*["'`]/|url\(\s*["']?/]=])
      schemed = schemed + #re_find_all(text, [=[src\s*=\s*["']?[a-z]+://|<link[^>]*href\s*=\s*["']?[a-z]+://|fetch(?:ed)?\(\s*["'`][a-z]+://|url\(\s*["']?[a-z]+://]=])
    end
  end
  check_line("relative URLs", rooted + schemed == 0, dir .. ": " .. rooted .. " src, href, fetch or url() URLs in its " .. files .. " text files start with /, and " .. schemed .. " resources name a network scheme")
  return nil
end

-- The essay surface adds its book review widget to a staged book's pages as
-- it sends them (essay-surface's books.go), each part marked with
-- REVIEW_MARK. No published file may hold the mark.
const REVIEW_MARK = "data-essay-book-review"
function check_no_review_widget(dir)
  local hits = grep_tree(dir, REVIEW_MARK, {}).hits
  for h in hits do print("  " .. h.path .. ":" .. h.line) end
  check_line("no review widget", #hits == 0, dir .. ": " .. #hits .. " lines hold " .. REVIEW_MARK)
  return nil
end

-- A dry run's folder beside today's staging, file by file, PROVENANCE
-- aside: each file only one side has, and each whose bytes differ.
function compare(built, live)
  local a = sums_under(built)
  local b = {}
  if exists(live) then b = sums_under(live) end
  local names = {}
  for k in keys(a) do push(names, k) end
  for k in keys(b) do
    if not has_key(a, k) then push(names, k) end
  end
  sort(names)
  local same = 0
  local differ = 0
  for f in names do
    if not has_key(b, f) then
      differ = differ + 1
      print("  only in the build: " .. NAME .. "/" .. f)
    elseif not has_key(a, f) then
      differ = differ + 1
      print("  only in site/live: " .. NAME .. "/" .. f)
    elseif a[f] ~= b[f] then
      differ = differ + 1
      print("  differs: " .. NAME .. "/" .. f)
    else
      same = same + 1
    end
  end
  if differ == 0 then
    print("SAME  " .. NAME .. ": " .. same .. " files equal site/live/" .. NAME .. "'s, PROVENANCE aside")
  else
    print("DIFF  " .. NAME .. ": " .. differ .. " files differ from site/live/" .. NAME .. "'s, " .. same .. " equal, PROVENANCE aside")
  end
  return differ
end

function main()
  local head = cl_commit()
  local pin = builder_roc_pin()
  print("cook-levin-riff " .. sub(head, 1, 8) .. ", clean and on origin; roc " .. pin)
  if not DRY then
    local staged = run({"git", "diff", "--cached", "--quiet"}, {timeout_ms = 10000, tail = 5})
    if staged.code ~= 0 then fail("publish_cook_levin_book: roc-apps' index already holds staged changes; commit or unstage them first") end
  end

  local b = run({"shale", "book/book.shale"}, {cwd = CL, timeout_ms = 1800000, tail = 30, nice = 19})
  print(trim(b.out))
  if b.code ~= 0 then fail("publish_cook_levin_book: cook-levin-riff's book/book.shale failed") end
  refuse_changes("after the build (it rewrote a tracked file or left an untracked one)")

  local root = LIVE
  if DRY then
    if exists(DRY_DIR) then remove_tree(DRY_DIR) end
    mkdir(DRY_DIR)
    root = DRY_DIR
  end
  local book = root .. "/" .. NAME
  if exists(book) then remove_tree(book) end
  copy(NEXT .. "/" .. NAME, book)
  local text = provenance(head, pin)
  create(book .. "/PROVENANCE", text)
  print(NAME .. "/PROVENANCE:\n" .. trim(text))

  check_book_files(book)
  check_relative(book)
  check_no_review_widget(book)

  if DRY then
    compare(book, LIVE .. "/" .. NAME)
    print("dry run: nothing committed; the copy is at " .. DRY_DIR)
    return nil
  end

  must(run({"git", "add", "-A", "--", book}, {timeout_ms = 30000, tail = 5}))
  local same = run({"git", "diff", "--cached", "--quiet", "--", book}, {timeout_ms = 10000, tail = 5})
  if same.code == 0 then
    print("staging already has this book; nothing to publish")
    return nil
  end
  local msg = "site: publish cook-levin (cook-levin-riff's book, A riff on Cook-Levin) to staging\n\n" .. NAME .. "/PROVENANCE:\n" .. text
  must(run({"git", "commit", "-q", "-F", "-", "--", book}, {timeout_ms = 60000, tail = 10, stdin = msg}))
  git_push(".")
  print("published the book to staging: " .. STAGING .. NAME .. "/")
  return nil
end

main()
