-- This script runs Shale's Roc code-quality recipes (the `cookbook:` mount's
-- roc/ folder) over the Roc files of roc-apps, and fails only when a recipe
-- can't run on them: a file roc-ast refuses, an app roc-types can't type, a
-- recipe that stops before its counts, or a count this script can't match
-- to the recipe's own lines. Those are tool gaps. What the recipes find is
-- counted and printed per app, and doesn't fail the run yet: the counts are
-- held in `tools/quality_baseline.tsv`, so a later change can hold the tree
-- to "no new findings".
--
--   cd <roc-apps checkout> && shale tools/quality.shale                  # the fast tier
--   cd <roc-apps checkout> && shale tools/quality.shale tier=full        # every app
--   cd <roc-apps checkout> && shale tools/quality.shale tier=full baseline=write
--
-- The fast tier reads the .roc files changed since `since=` (master by
-- default: the commits since the branch left it and the uncommitted
-- changes, of tracked files alone), each file in a run of its own, and prints their
-- findings: about half a second a file (20 files in 9.7 s, 2026-11-16). A
-- check that reads across files (a twin type, a function's callers) can't
-- be judged from one file, so the fast tier leaves it to the full tier and
-- says which it left. It runs no typed stage.
--
-- The full tier runs every parse recipe over every project, roc-types on
-- every app (TYPED_EXCEPTIONS names the tree it leaves out), and
-- `rewrite_method_calls trials=0` on every file the types reach, which
-- counts the old-style calls the types prove could be method calls
-- (`rewritable`), with no trial compile: a proven call the compiler would
-- refuse is counted, and the recipe's header says which those are. The
-- baseline is its cache ("The full tier's keys"): each app's counts carry
-- the key they were measured at, and a run measures again only the apps
-- whose key moved, with the apps their counts depend on; `fresh=1` measures
-- every app. Each stage runs two at a time ("Two at a time"), and every
-- file a run makes (a copy of the tree, each app's types) is in a folder of
-- its own, removed at its end. The apps fall in six groups (`groups_of`):
-- basic, delivery, dog-park, fasttrack and glue each alone, and the 36
-- others together, as every canvas app reaches canvas_apps/lib or web and
-- Safari reaches book_builder and syntax_color. On 2026-11-18, on a box
-- with other work running (load about 2), a cold run (`fresh=1`) took 254 s
-- (roc-types 203 s of CPU over the 56 apps, the parse recipes 41 s, the
-- count 7 s), a run with nothing changed 2.4 s (13 s when the tools'
-- binaries had left the page cache: hashing roc-types' 190 MB is most of
-- it), and one with a file of dog-park changed 11 s. A change in the
-- group of 36 measures that group, most of a cold run.
-- The parse recipes read a copy of the tracked files
-- (`tracked_tree`), so a build's ignored output never enters a count. It
-- needs the cookbook's rewrite recipe to take `trials=0` and `types_from=`;
-- an older one can't run, and says so. A project is a top-level folder.
-- Each recipe reads a whole project at once, so a check across files sees
-- the project's own files and no other app's. The findings are counted per
-- app: a folder under canvas_apps/, else the top-level folder. Each finding
-- line of the apps measured goes to FINDINGS_LOG, the count's own too (each call it leaves or leaves
-- unsettled, with its reason), and the counts are compared with the baseline, each moved
-- count printed. `baseline=write` writes the counts and their keys as the
-- new baseline.
--
-- An app's own tables and exemptions are its lints', asked of the lint
-- scripts in SETTINGS_SOURCES (Safari's first: its name_types.txt, its
-- drawing data that check_stacking skips, lib's stack_dictated.txt). A
-- recipe with settings for a folder runs over that folder on its own, with
-- them, and its run over the folder's project leaves that folder's
-- findings out, so the folder's counts are those its own lints hold. The
-- fast tier passes a file its folder's tables and skips a file its folder
-- skips; a `dictated=` table names files a one-file run can't find, so it
-- is the full tier's alone.
--
-- A stage's time goes in `cookbook:times.shale`'s book `roc-apps-quality`
-- when it ran every item, and its CPU is held to the budget beside it, so a
-- slowdown shows.
--
-- budget: steps=4000000000 read_bytes=8000000000 arena_bytes=2000000000 output_bytes=4000000 call_depth=200 kept_bytes=64000000 changes=100000 change_bytes=4000000000

use("cookbook:times.shale")
use("cookbook:roc/types.shale")

const SELF_PATH = "tools/quality.shale"
const BASELINE = "tools/quality_baseline.tsv"
const BASELINE_HEADER = "app\trecipe\tcheck\tcount"
const FINDINGS_LOG = "build:roc-apps/quality-findings.txt"
const BOOK = "roc-apps-quality"
const TIER = arg("tier", "fast")
const SINCE = arg("since", "master")
const BASELINE_ARG = arg("baseline", "")
const PART = arg("part", "")
const WORK_ARG = arg("work", "")
const TREE_ARG = arg("tree", "")
const SCRATCH_ARG = arg("scratch", "")
const FRESH = arg("fresh", 0) == 1

-- The recipes that only parse. `checks` pairs each count's name in the
-- recipe's summary with the name its finding lines give; `args` are the
-- recipe's own arguments, as the style guide runs it (docs/roc-style.md,
-- "Testing and enforcement": a call four deep); `cross` names the
-- checks that read across files, which the fast tier can't judge;
-- `fails_on_findings` marks a recipe that exits nonzero on any finding;
-- `summary_once` one that prints its summary once, after its findings,
-- where the others print it before them and again after. `quiet` names
-- checks the fast tier counts and doesn't print line by line:
-- check_stacking's `wide string` is a line Roc has no short way to split.
-- `cpu_budget_ms` is about three times what the recipe's runs over every
-- project took on 2026-11-16 (`cpu_measured_ms`): each run on one project is
-- held to it, and the parse stage to their sum, so a slowdown of that size
-- stops the run. `cpu_measured_ms` also weighs a run when the stage is split
-- in two.
--
-- check_vocabulary is left out: it needs a project's own file of decided
-- words, and only safari has one, which safari's gates/lints.shale holds at
-- zero.
const PARSE_RECIPES = {
  {recipe = "hunt_names", short = "names", fails_on_findings = false, cpu_measured_ms = 2144, cpu_budget_ms = 8000, checks = {
    {"state_effect", "state_effect"}, {"question", "question"}, {"vague", "vague"}, {"name_type", "name_type"},
    {"negative", "negative"}, {"noun_effect", "noun_effect"}, {"command_tense", "command_tense"},
    {"mixed_tense", "mixed_tense"}, {"container", "container"}, {"preposition_split", "preposition_split"},
    {"short_name", "short_name"}, {"worker_name", "worker_name"}, {"stacked_preposition", "stacked_preposition"},
    {"taken_word", "taken_word"}, {"bare_participle", "bare_participle"}, {"phrase_name", "phrase_name"},
    {"singular_list", "singular_list"}, {"world_verb", "world_verb"}, {"where_name", "where_name"},
  }, cross = {"command_tense", "mixed_tense"}},
  {recipe = "check_stacking", short = "stack", fails_on_findings = false, cpu_measured_ms = 4969, cpu_budget_ms = 16000, checks = {
    {"to stack", "stack"}, {"to unstack", "unstack"}, {"long", "long"}, {"wide string", "wide string"},
  }, cross = {}, quiet = {"wide string"}},
  {recipe = "find_extra_parens", short = "parens", fails_on_findings = false, cpu_measured_ms = 1987, cpu_budget_ms = 8000, checks = {
    {"paren_if", "paren_if"}, {"wrapped_body", "wrapped_body"}, {"else_block", "else_block"}, {"lambda_if", "lambda_if"},
  }, cross = {}},
  {recipe = "check_errors", short = "errors", fails_on_findings = false, cpu_measured_ms = 2719, cpu_budget_ms = 9000, checks = {
    {"error_alias", "error_alias"}, {"optional_tag", "optional_tag"}, {"set_fallback", "set_fallback"},
    {"placeholder", "placeholder"}, {"number_fallback", "number_fallback"},
  }, cross = {"error_alias", "optional_tag"}},
  {recipe = "find_deep_calls", short = "deep", args = {"min=4"}, fails_on_findings = false, cpu_measured_ms = 1669, cpu_budget_ms = 7000, checks = {
    {"nested", "nested"},
  }, cross = {}},
  {recipe = "find_unused_imports", short = "imports", fails_on_findings = true, cpu_measured_ms = 1938, cpu_budget_ms = 7000, checks = {
    {"unused_import", "unused_import"},
  }, cross = {}},
  {recipe = "check_name_types", short = "types", fails_on_findings = true, cpu_measured_ms = 1906, cpu_budget_ms = 7000, checks = {
    {"name_type", "name_type"}, {"bare_beside_unit", "bare_beside_unit"}, {"no_value", "no_value"},
  }, cross = {"bare_beside_unit"}},
  {recipe = "check_families", short = "family", fails_on_findings = true, cpu_measured_ms = 1832, cpu_budget_ms = 7000, checks = {
    {"family", "family"}, {"twin_name", "twin_name"},
  }, cross = {"family", "twin_name"}},
  {recipe = "find_unclear_names", short = "unclear", fails_on_findings = true, cpu_measured_ms = 1778, cpu_budget_ms = 7000, checks = {
    {"pure_mutator", "pure_mutator"}, {"abbreviation", "abbreviation"}, {"module_doc", "module_doc"},
  }, cross = {}},
  {recipe = "check_boundaries", short = "bounds", fails_on_findings = false, summary_once = true, cpu_measured_ms = 3081, cpu_budget_ms = 10000, checks = {
    {"single", "single"}, {"fixed", "fixed"}, {"entry", "entry"}, {"constant", "constant"}, {"bool_param", "bool_param"},
    {"dead", "dead"}, {"unused_api", "unused_api"}, {"same_branches", "same_branches"},
  }, cross = {"single", "fixed", "entry", "constant", "dead", "unused_api"}},
}

-- What a recipe's run looks like from here.
const RECIPE_TIMEOUT_MS = 600000
const RECIPE_KEEP = 30000000
const RECIPE_STEPS = "steps=40000000000"
const FINDING_RE = "^([^ :]+\\.roc):[0-9]+(?::[0-9]+)?: ([a-z_]+(?: [a-z_]+)?): "

-- ── Where a file belongs ────────────────────────────────────────────────

-- The project a tracked path is read with: its top-level folder.
function project_of(path)
  return split(path, "/")[1]
end

-- The app a finding is counted under: a folder of canvas_apps/, else the
-- top-level folder.
function app_of(path)
  local parts = split(path, "/")
  if #parts > 2 and parts[1] == "canvas_apps" then return parts[1] .. "/" .. parts[2] end
  return parts[1]
end

function tracked_roc_files()
  local r = must(run({"git", "ls-files", "*.roc"}, {timeout_ms = 30000, whole = 4000000}))
  return lines(trim(r.out))
end

-- Each project, with how many tracked .roc files it holds.
function projects_of(files)
  local by = {}
  for f in files do incr(by, project_of(f)) end
  local out = {}
  for k in sort(keys(by)) do push(out, {name = k, files = by[k]}) end
  return out
end

-- ── One recipe's run, and whether it ran ────────────────────────────────

function recipe_argv(rc, glob, extra?)
  local argv = {"shale", "--budget", RECIPE_STEPS, real("cookbook:roc/" .. rc.recipe .. ".shale"), "glob=" .. glob}
  for a in get(rc, "args", {}) do push(argv, a) end
  for a in extra or {} do push(argv, a) end
  return argv
end

-- The recipe's own lines: not Shale's `──` reports or the `called from`
-- lines under a stop.
function own_lines(out)
  local kept = {}
  for l in lines(out) do
    if not starts_with(l, "──") and not starts_with(l, "   ") and trim(l) ~= "" then push(kept, l) end
  end
  return kept
end

function stop_line(out)
  for l in lines(out) do
    if starts_with(l, "── stopped at ") then return l end
  end
  return nil
end

-- The number a summary gives for a check: "check N", or "N check" for
-- check_stacking's "N to stack". Nil when the summary doesn't name it.
function count_in_summary(summary, label)
  local after = re_find(summary, "(?:^|[;:,] )" .. label .. " ([0-9]+)")
  if after ~= nil then return tonumber(after.group) end
  local before = re_find(summary, "(?:^|[;:,] )([0-9]+) " .. label .. "(?:,|$)")
  if before ~= nil then return tonumber(before.group) end
  return nil
end

-- The last lines of a run, for a failure's message.
function tail_of(out, n)
  local ls = lines(trim(out))
  if #ls <= n then return join(ls, " | ") end
  return join(last(ls, n), " | ")
end

-- `{ok, why, summary, findings}` for `r`, the run of `rc` over `files`
-- files. `findings` is each finding's `{path, check, line}`. It is not ok
-- when the recipe didn't run to its counts, read fewer or more files than
-- it was given, refused a file, or printed counts its lines don't bear out.
function verdict_of(rc, r, files)
  local who = rc.recipe
  if r.ended ~= "exit" then return {ok = false, why = who .. " " .. r.ended .. " after " .. r.ms .. " ms: " .. tail_of(r.out, 4)} end
  local own = own_lines(r.out)
  if #own == 0 then return {ok = false, why = who .. " printed nothing of its own: " .. tail_of(r.out, 4)} end
  local summary = own[#own]
  if re_find(summary, FINDING_RE) ~= nil then return {ok = false, why = who .. " ended on a finding, not its summary: " .. tail_of(r.out, 4)} end
  for l in own do
    if starts_with(l, "refused: ") or starts_with(l, "not reached by ") then return {ok = false, why = who .. ": " .. l} end
  end
  if not get(rc, "summary_once", false) and own[1] ~= summary then return {ok = false, why = who .. " stopped before its last summary: " .. tail_of(r.out, 4)} end
  local read = re_find(summary, "([0-9]+) files")
  if read == nil then return {ok = false, why = who .. ": no file count in its summary: " .. summary} end
  if tonumber(read.group) ~= files then return {ok = false, why = who .. " read " .. read.group .. " files where git tracks " .. files .. ": " .. summary} end
  if r.code ~= 0 then
    local stop = stop_line(r.out)
    local findings_stop = stop ~= nil and contains(stop, ": fail: " .. summary .. " (")
    if not (rc.fails_on_findings and findings_stop) then return {ok = false, why = who .. " exited " .. r.code .. ": " .. (stop or tail_of(r.out, 4))} end
  end
  local labels = {}
  for c in rc.checks do labels[c[2]] = c[1] end
  local by_label = {}
  local findings = {}
  for l in own do
    local m = re_find(l, FINDING_RE)
    if m ~= nil then
      local label = m.groups[2]
      if not has_key(labels, label) then return {ok = false, why = who .. ": a finding of a check this gate doesn't know, `" .. label .. "`: " .. sub(l, 1, 200)} end
      incr(by_label, label)
      push(findings, {path = m.groups[1], check = label, line = l})
    end
  end
  for c in rc.checks do
    local said = count_in_summary(summary, c[1])
    if said == nil then return {ok = false, why = who .. ": its summary has no count of " .. c[1] .. ": " .. summary} end
    local seen = get(by_label, c[2], 0)
    if said ~= seen then return {ok = false, why = who .. ": its summary counts " .. said .. " " .. c[1] .. ", and it printed " .. seen .. " such lines"} end
  end
  if r.code ~= 0 and #findings == 0 then return {ok = false, why = who .. " exited " .. r.code .. " with no findings"} end
  return {ok = true, why = "", summary = summary, findings = findings}
end


-- ── A project's own tables and exemptions ───────────────────────────────

-- The lint scripts that hold an app's own settings for the recipes, each
-- asked with `reads=settings`: Safari's first, as its lints are held at
-- zero. Each prints `SETTING<tab>recipe<tab>folder<tab>arg` lines, paths
-- from the checkout's root, and stays the one home of what it prints.
const SETTINGS_SOURCES = {"canvas_apps/safari/gates/lints.shale"}

-- Each folder's settings for a recipe this script runs, as `{recipe,
-- folder, args, skip, files}`: `args` the arguments to pass, `skip` the
-- files a `skip=` leaves out, `files` the tables the arguments name.
-- A recipe run over a project that holds such a folder leaves that
-- folder's findings to a run of its own, with its settings, so the
-- folder's counts are its own lints' counts. A setting of a recipe this
-- script doesn't run is named and left.
function project_settings()
  local runs = {}
  for rc in PARSE_RECIPES do runs[rc.recipe] = true end
  local by = {}
  local order = {}
  local unused = {}
  for src in SETTINGS_SOURCES do
    local r = run({"shale", "--root", ".", src, "reads=settings"}, {timeout_ms = 60000, whole = 100000})
    if r.ended ~= "exit" or r.code ~= 0 then fail("quality: " .. src .. " reads=settings: " .. tail_of(r.out, 4)) end
    for l in lines(r.out) do
      if starts_with(l, "SETTING\t") then
        local f = split(l, "\t")
        if #f ~= 4 then fail("quality: " .. src .. " printed a setting that is not four fields: " .. l) end
        if not has_key(runs, f[2]) then
          unused[f[2]] = true
        else
          local k = f[2] .. "@" .. f[3]
          if not has_key(by, k) then
            by[k] = {recipe = f[2], folder = f[3], args = {}, skip = {}, files = {}}
            push(order, k)
          end
          local s = by[k]
          push(s.args, f[4])
          local m = re_find(f[4], "^([a-z]+)=(.+)$")
          if m == nil then fail("quality: " .. src .. " printed a setting that is not name=value: " .. l) end
          if m.groups[1] == "skip" then
            for x in split(m.groups[2], ",") do push(s.skip, x) end
          else
            if not exists(m.groups[2]) then fail("quality: " .. src .. " names a table that isn't here: " .. m.groups[2]) end
            push(s.files, m.groups[2])
          end
        end
      end
    end
  end
  local out = {}
  for k in order do push(out, by[k]) end
  if #keys(unused) > 0 then print("settings of recipes this doesn't run, left: " .. join(sort(keys(unused)), ", ")) end
  return out
end

-- The folders of `settings` that judge `recipe` in runs of their own.
function settings_folders(settings, recipe)
  local out = {}
  for s in settings do
    if s.recipe == recipe then push(out, s.folder) end
  end
  return out
end

function is_under_any(path, folders)
  for f in folders do
    if starts_with(path, f .. "/") then return true end
  end
  return false
end

-- ── The counts and the baseline ────────────────────────────────────────

function key_of(app, recipe, check)
  return app .. "\t" .. recipe .. "\t" .. check
end

-- The baseline as `{counts, keys}`: each count by `key_of`, and each app's
-- key row (`KEY_ROW` in its second field) as `{folders, text, hash}`, `text`
-- the folders as the row writes them.
const KEY_ROW = "key"

function read_baseline()
  local out = {counts = {}, keys = {}}
  if not exists(BASELINE) then return out end
  local all = lines(read(BASELINE))
  if #all == 0 or all[1] ~= BASELINE_HEADER then fail("quality: " .. BASELINE .. " does not start with its header") end
  for i = 2, #all do
    local f = split(all[i], "\t")
    if #f ~= 4 then fail("quality: " .. BASELINE .. ":" .. i .. " is not four fields") end
    if f[2] == KEY_ROW then
      out.keys[f[1]] = {folders = split(f[3], ","), text = f[3], hash = f[4]}
    else
      out.counts[key_of(f[1], f[2], f[3])] = tonumber(f[4])
    end
  end
  return out
end

-- Writes the counts and each app's key row, every line sorted, so an app's
-- rows stay together.
function write_baseline(counts, key_rows)
  local ls = {}
  for k in keys(counts) do push(ls, k .. "\t" .. counts[k]) end
  for app in keys(key_rows) do push(ls, app .. "\t" .. KEY_ROW .. "\t" .. key_rows[app].text .. "\t" .. key_rows[app].hash) end
  replace(BASELINE, BASELINE_HEADER .. "\n" .. join(sort(ls), "\n") .. "\n")
  return nil
end

-- Each count that differs from the baseline, as a line.
function moved_counts(was, now)
  local all = {}
  for k in keys(was) do all[k] = true end
  for k in keys(now) do all[k] = true end
  local out = {}
  for k in sort(keys(all)) do
    local a = get(was, k, 0)
    local b = get(now, k, 0)
    if a ~= b then
      local f = split(k, "\t")
      push(out, (b > a and "up " or "down ") .. f[1] .. ": " .. f[2] .. " " .. f[3] .. " " .. a .. " to " .. b)
    end
  end
  return out
end

function count_finding(st, app, recipe, check, n)
  if n == 0 then return nil end
  incr(st.counts, key_of(app, recipe, check), n)
  return nil
end

-- ── The full tier's keys ────────────────────────────────────────────────

-- The baseline is the full tier's cache: beside each app's counts it holds
-- the key they were measured at, a row `app<tab>key<tab>folders<tab>hash`.
-- The folders, separated by commas, are every folder the counts read; the
-- hash is git's hash of the tools' identity (`tools_identity`) and each
-- folder's content (`folder_id`). A run measures again only the apps whose
-- key moved, and takes every other app's counts from the baseline as they
-- stand, so an app's counts are a function of what its key names. Apps are
-- measured in groups (`groups_of`), and the apps of a group share its key.

-- Git's hash of a text, as a blob.
function blob_hash(text)
  return trim(must(run({"git", "hash-object", "--stdin"}, {timeout_ms = 30000, whole = 1000, stdin = text})).out)
end

-- The git blob hash of each file at an OS path, by path, from one program;
-- nil when git can't hash one of them.
function hashes_of(os_paths)
  local out = {}
  if #os_paths == 0 then return out end
  local r = run({"git", "hash-object", "--no-filters", "--stdin-paths"}, {timeout_ms = 120000, whole = 64000000, stdin = join(os_paths, "\n") .. "\n"})
  if r.ended ~= "exit" or r.code ~= 0 then return nil end
  local hs = lines(trim(r.out))
  if #hs ~= #os_paths then return nil end
  for i = 1, #os_paths do out[os_paths[i]] = hs[i] end
  return out
end

-- The files a recipe is made of: the recipe and each library it loads, in
-- turn (`use("cookbook:...")`), each once.
function recipe_closure(path, seen, out)
  if has_key(seen, path) then return nil end
  seen[path] = true
  push(out, path)
  for g in grep(path, "use(\"cookbook:") do
    local m = re_find(g.text, "use\\(\"(cookbook:[^\"]+)\"\\)")
    if m ~= nil then recipe_closure(m.group, seen, out) end
  end
  return nil
end

-- The git hash of this script's code alone, its comment lines left out, so
-- a change to its prose leaves every key as it was.
function code_hash(path)
  local kept = {}
  for l in lines(read(path)) do
    if not starts_with(trim(l), "--") then push(kept, l) end
  end
  return blob_hash(join(kept, "\n") .. "\n")
end

-- The `shale` this run's children run: the PATH's, through its link.
function shale_binary()
  local w = trim(must(run({"which", "shale"}, {timeout_ms = 5000, whole = 4000})).out)
  return trim(must(run({"readlink", "-f", w}, {timeout_ms = 5000, whole = 4000})).out)
end

-- One hash for every tool that makes a count: the Roc pin, `shale` (its
-- builtins and preludes run every recipe), roc-ast, roc-types, the repo's
-- prelude (which finds the pinned Roc), this script's code (`code_hash`),
-- and every file of each recipe's closure and of the types library this
-- script reads roc-types with.
function tools_identity(roc)
  local named = {
    {"shale", shale_binary()},
    {"roc-ast", real("tools:roc-ast/bin/roc-ast")},
    {"roc-types", real(roc_types_exe(roc))},
    {"prelude", real(".shale/prelude.shale")},
  }
  local seen = {}
  local libs = {}
  for rc in PARSE_RECIPES do recipe_closure("cookbook:roc/" .. rc.recipe .. ".shale", seen, libs) end
  recipe_closure("cookbook:roc/rewrite_method_calls.shale", seen, libs)
  recipe_closure("cookbook:roc/types.shale", seen, libs)
  for p in libs do push(named, {p, real(p)}) end
  local paths = {}
  for n in named do push(paths, n[2]) end
  local h = hashes_of(unique(paths))
  if h == nil then fail("quality: git couldn't hash the tools and recipes: " .. join(unique(paths), ", ")) end
  local ls = {"pin\t" .. trim(read("roc-version")), "self\t" .. code_hash(SELF_PATH)}
  for n in named do push(ls, n[1] .. "\t" .. h[n[2]]) end
  return blob_hash(join(ls, "\n") .. "\n")
end

-- The git tree of each folder as the run reads it: the tracked files as
-- the working copy has them, so an edit counts before it is committed and
-- an untracked file never does. A fresh index of this run's (`read-tree
-- HEAD`, then `add -u`, which hashes the checkout's thousand tracked files
-- in under half a second) is written as a tree, whose folders are listed at
-- the top and under canvas_apps/. Gives each folder's tree hash by path.
function folder_trees(scratch)
  local env = {GIT_INDEX_FILE = real(scratch) .. "/index"}
  must(run({"git", "read-tree", "HEAD"}, {timeout_ms = 60000, whole = 4000, env = env}))
  must(run({"git", "add", "-u", "--", "."}, {timeout_ms = 120000, whole = 4000, env = env}))
  local tree = trim(must(run({"git", "write-tree"}, {timeout_ms = 60000, whole = 4000, env = env})).out)
  local out = {}
  for below in {"", "canvas_apps/"} do
    local argv = {"git", "ls-tree", "-d", tree}
    if below ~= "" then push(argv, below) end
    for l in lines(trim(must(run(argv, {timeout_ms = 60000, whole = 400000})).out)) do
      -- `040000 tree <hash><tab><path>`
      local tab = find(l, "\t")
      if tab ~= nil then out[sub(l, tab + 1)] = split(sub(l, 1, tab - 1), " ")[3] end
    end
  end
  return out
end

-- The name a key gives a folder outside the checkout that an app reaches,
-- from its OS path, the same from every checkout on the box: a sibling
-- repo's folder (roc-ray's platform, roc-markdown's package, which a lane's
-- worktree reaches through a link) by its real path under the `repos:`
-- mount, and a folder of Roc's own cache as `roc-cache:` and its path there.
function outside_name(st, dir)
  if has_key(st.outside_names, dir) then return st.outside_names[dir] end
  local canon = trim(must(run({"readlink", "-f", dir}, {timeout_ms = 5000, whole = 4000})).out)
  local repos = real("repos:") .. "/"
  local name = ""
  if starts_with(canon, repos) then
    name = "repos:" .. sub(canon, #repos + 1)
  else
    local at = find(canon, "/.cache/roc/")
    if at == nil then fail("quality: an app reaches " .. canon .. ", which is outside the checkout, the repos: mount and Roc's cache, so no key can name it") end
    name = "roc-cache:" .. sub(canon, at + #"/.cache/roc/")
  end
  st.outside_names[dir] = name
  return name
end

-- A folder outside the checkout, as `outside_name` names it. A sibling
-- repo's is keyed by the git hash of its .roc files; one of Roc's cache by
-- its name alone, as Roc names such a folder by the hash of what it holds.
function outside_folder_id(folder)
  if starts_with(folder, "roc-cache:") then return "named" end
  if not exists(folder) then return "gone" end
  local paths = {}
  for n in sort(ls(folder)) do
    if ends_with(n, ".roc") then push(paths, real(folder .. "/" .. n)) end
  end
  local h = hashes_of(paths)
  if h == nil then fail("quality: git couldn't hash the .roc files of " .. folder) end
  local ls_ = {}
  for q in paths do push(ls_, basename(q) .. " " .. h[q]) end
  return blob_hash(join(ls_, "\n") .. "\n")
end

function folder_id(st, folder)
  if contains(folder, ":") then
    if not has_key(st.outside, folder) then st.outside[folder] = outside_folder_id(folder) end
    return st.outside[folder]
  end
  return get(st.trees, folder, "gone")
end

function key_hash(st, folders)
  local ls = {"tools\t" .. st.tools}
  for f in folders do push(ls, f .. "\t" .. folder_id(st, f)) end
  return blob_hash(join(ls, "\n") .. "\n")
end

-- ── The apps to measure, and their groups ───────────────────────────────

function unit_project(app)
  return split(app, "/")[1]
end

-- The apps whose counts this run measures: with `fresh=1` every app, else
-- each whose key row is missing or no longer matches, and each the
-- baseline holds that has no tracked file now (its counts go to zero).
function stale_apps(st, names, base)
  local out = {}
  local said = {}
  for u in names do
    if FRESH or not has_key(base.keys, u) then
      out[u] = true
    else
      local k = base.keys[u]
      if not has_key(said, k.text) then said[k.text] = key_hash(st, k.folders) end
      if said[k.text] ~= k.hash then out[u] = true end
    end
  end
  for k in keys(base.counts) do
    local u = split(k, "\t")[1]
    if not has_key(st.units, u) then out[u] = true end
  end
  for u in keys(base.keys) do
    if not has_key(st.units, u) then out[u] = true end
  end
  return out
end

-- Adds to `m` each app that must be measured beside one already there: an
-- app of the same project, as each parse recipe reads a project whole, and
-- an app of the same recorded group, whose key is theirs.
function close_over(m, names, base)
  local grew = true
  while grew do
    grew = false
    local projects = {}
    local groups = {}
    for u in keys(m) do
      projects[unit_project(u)] = true
      if has_key(base.keys, u) then groups[base.keys[u].text] = true end
    end
    for u in names do
      if not has_key(m, u) then
        local recorded = has_key(base.keys, u) and has_key(groups, base.keys[u].text)
        if has_key(projects, unit_project(u)) or recorded then
          m[u] = true
          grew = true
        end
      end
    end
  end
  return nil
end

-- The groups of the apps measured, as `{members, folders}`. Two apps are
-- in one group when they share a project, as a parse recipe's checks across
-- files read the project whole, or when one's app reaches the other's
-- folder: the reached folder's counts of the typed checks are judged on the
-- apps that reach it (a file no app reaches is `unreached`, and a file's
-- calls are counted on one app that reaches it), and the app's own read
-- the reached folder's types. A group's folders are its apps' own and each
-- folder outside the checkout they reach.
function groups_of(st, m)
  local label = {}
  for u in keys(m) do
    if has_key(st.units, u) then label[u] = u end
  end
  local pairs_ = {}
  local first_of = {}
  for u in sort(keys(label)) do
    local p = unit_project(u)
    if has_key(first_of, p) then pairs_[first_of[p] .. "\t" .. u] = true else first_of[p] = u end
  end
  for app in keys(st.reach) do
    for f in st.reach[app] do
      local v = app_of(f)
      if not has_key(label, v) then fail("quality: " .. app .. " reaches " .. f .. ", of an app this run didn't measure") end
      if v ~= app_of(app) then pairs_[app_of(app) .. "\t" .. v] = true end
    end
  end
  local edges = {}
  for k in keys(pairs_) do push(edges, split(k, "\t")) end
  local moved = true
  while moved do
    moved = false
    for e in edges do
      local a = label[e[1]]
      local b = label[e[2]]
      if a ~= b then
        local low = a < b and a or b
        label[e[1]] = low
        label[e[2]] = low
        moved = true
      end
    end
  end
  local by = {}
  for u in keys(label) do push_at(by, label[u], u) end
  local outside_of = {}
  for app in keys(st.outside_reach) do
    for d in st.outside_reach[app] do
      if not has_key(outside_of, label[app_of(app)]) then outside_of[label[app_of(app)]] = {} end
      outside_of[label[app_of(app)]][d] = true
    end
  end
  local out = {}
  for l in sort(keys(by)) do
    local members = sort(by[l])
    local folders = {}
    for u in members do push(folders, u) end
    for d in sort(keys(get(outside_of, l, {}))) do push(folders, d) end
    push(out, {members = members, folders = folders})
  end
  return out
end

-- ── Two at a time ───────────────────────────────────────────────────────

-- The box has two cores, and each stage's items are independent and CPU
-- bound, so a stage keeps two runs going at once, each a job: this script's
-- `part=` child on a work file of a chunk of items, a new chunk started as
-- soon as a run ends, so neither core waits on the other's last item. The
-- costliest items go first, by the estimate the stage gives, and cheap
-- items share a chunk of about CHUNK_MS, so a stage of small items starts
-- few children. A child runs each item with a CPU cap of its own and prints,
-- last, `CPU<tab>ms`, what its programs took, which a job can't report.
const WORKERS = 2
const CHUNK_MS = 2000

function clock_ms()
  return tonumber(trim(must(run({"date", "+%s%3N"}, {timeout_ms = 5000, whole = 100})).out))
end

-- `items` (`{part, name, cost}`), costliest first, as chunks `{part,
-- names}` of one part each: an item costing CHUNK_MS or more is a chunk
-- alone, and cheaper ones of a part are packed until their costs reach it.
function chunks_of(items)
  local out = {}
  local open = {}
  for it in sort(items, "cost", "desc") do
    if not has_key(open, it.part) then open[it.part] = {part = it.part, names = {}, load = 0} end
    local c = open[it.part]
    push(c.names, it.name)
    c.load = c.load + it.cost
    if c.load >= CHUNK_MS then
      push(out, c)
      open[it.part] = {part = it.part, names = {}, load = 0}
    end
  end
  for part in sort(keys(open)) do
    if #open[part].names > 0 then push(out, open[part]) end
  end
  return out
end

-- Takes one run's output into `res`: its lines, its `CANT` lines as
-- failures, and its CPU under its part.
function take_run(res, c, i, ended, code, out)
  local cpu = nil
  for l in lines(out) do
    if starts_with(l, "CPU\t") then cpu = tonumber(sub(l, 5)) end
    if starts_with(l, "CANT\t") then push(res.cant, sub(l, 6)) end
  end
  if ended ~= "exited" or code ~= 0 or cpu == nil then
    push(res.cant, c.part .. " run " .. i .. " " .. ended .. " " .. code .. ": " .. tail_of(out, 4))
  end
  incr(res.cpu, c.part, cpu or 0)
  res.out = res.out .. out .. "\n"
  return nil
end

-- Runs `part=<part>` on each item's chunk, WORKERS at once, in a folder of
-- `scratch`, `extra[part]` its further arguments. Gives `{out, cpu, ms,
-- cant}`: every run's output, their programs' CPU by part, the wall time
-- and each failure.
function run_items(scratch, name, items, extra)
  local dir = scratch .. "/work/" .. name
  mkdir(dir)
  local chunks = chunks_of(items)
  local t0 = clock_ms()
  local res = {out = "", cpu = {}, ms = 0, cant = {}}
  local next = 1
  local running = {}
  while next <= #chunks or #running > 0 do
    while #running < WORKERS and next <= #chunks do
      local c = chunks[next]
      local work = dir .. "/" .. next .. ".txt"
      replace(work, join(c.names, "\n") .. "\n")
      local argv = {"shale", "--root", ".", SELF_PATH, "part=" .. c.part, "work=" .. work}
      for a in get(extra, c.part, {}) do push(argv, a) end
      local log = dir .. "/" .. next .. ".log"
      push(running, {job = job_start(argv, {log = log}), log = log, i = next, chunk = c})
      next = next + 1
    end
    -- A short look at each run, so a core freed waits little for its next
    -- chunk.
    local still = {}
    for j in running do
      local w = job_wait(j.job, {timeout_ms = 20})
      if w.ended == "timeout" then
        push(still, j)
      else
        take_run(res, j.chunk, j.i, w.ended, get(w, "code", -1), read(j.log))
      end
    end
    running = still
  end
  res.ms = clock_ms() - t0
  return res
end

-- Says how a stage ran, and holds its CPU to `budget_ms`. Its time is kept
-- in the book only when the run measured every app, as a run of a few says
-- nothing of the stage's speed.
function note_stage(st, stage, cpu, ms, runs, whole, budget_ms)
  print(stage .. ": " .. runs .. " runs, cpu " .. times_seconds(cpu))
  if whole and runs > 0 and #st.cant == 0 then
    if not exists("build:times") then mkdir("build:times") end
    local change = times_note(times_path(BOOK), stage, {ended = "exit", code = 0, cpu_ms = cpu, ms = ms})
    if change ~= "" then print(change) end
  end
  if cpu > budget_ms then push(st.over, stage .. " took " .. times_seconds(cpu) .. " of CPU, past its budget of " .. times_seconds(budget_ms)) end
  return nil
end

-- ── The full tier's parse recipes ───────────────────────────────────────

-- A copy of the tracked .roc files `files`, as the working tree has them, at
-- their own paths in a folder of this run's. Most recipes take one glob,
-- and a glob over the checkout also finds what git ignores or doesn't
-- track (a tutorial build's prepared sources, 76 files under
-- canvas_apps/safari/tutorial/build/); in the copy a glob finds only what
-- git tracks. Each recipe's count of the files it read is still held to
-- git's.
function tracked_tree(scratch, files)
  local tree = fresh_dir(scratch, "tree")
  for f in files do
    local dest = tree .. "/" .. f
    local dir = dirname(dest)
    if not exists(dir) then mkdir(dir) end
    replace(dest, read(f))
  end
  return tree
end

function parse_recipe(name)
  for c in PARSE_RECIPES do
    if c.recipe == name then return c end
  end
  fail("quality: no parse recipe " .. name)
end

-- One run, `recipe<tab>unit<tab>args<tab>files`: the unit a project or a
-- folder with settings of its own, `args` those settings separated by
-- spaces (`-` for none), and `files` how many files the run must read.
function parse_one(item, tree)
  local f = split(item, "\t")
  local rc = parse_recipe(f[1])
  local extra = f[3] == "-" and {} or split(f[3], " ")
  local r = run(recipe_argv(rc, f[2] .. "/**/*.roc", extra), {timeout_ms = RECIPE_TIMEOUT_MS, whole = RECIPE_KEEP, cwd = tree, cpu_budget_ms = rc.cpu_budget_ms, stage = rc.recipe .. " on " .. f[2]})
  local v = verdict_of(rc, r, tonumber(f[4]))
  if not v.ok then
    print("CANT\t" .. rc.recipe .. " in " .. f[2] .. ": " .. v.why)
  else
    for x in v.findings do print("F\t" .. rc.recipe .. "\t" .. f[2] .. "\t" .. x.check .. "\t" .. x.line) end
  end
  return r.cpu_ms
end

-- A child run: each `recipe<tab>project` of the work file, in
-- `tracked_tree`'s copy `tree`. It prints a line a finding,
-- `F<tab>recipe<tab>project<tab>check<tab>line`, and a line a failure,
-- `CANT<tab>why`.
function parse_part(work, tree)
  if tree == "" then fail("quality: part=parse needs tree=, the copy of the tracked files") end
  local cpu = 0
  for item in lines(trim(read(work))) do
    cpu = cpu + parse_one(item, tree)
    yield()
  end
  print("CPU\t" .. cpu)
  return nil
end

-- A finding of `rc`'s run over `unit`. A project's run leaves out what it
-- finds in a folder with settings of its own, whose own run counts it.
function take_parse_finding(st, rc, unit, check, line)
  local path = re_find(line, "^([^ :]+\\.roc):").group
  if not has_key(st.setting_units, rc.recipe .. "@" .. unit) and is_under_any(path, settings_folders(st.settings, rc.recipe)) then return nil end
  count_finding(st, app_of(path), rc.recipe, check, 1)
  push(st.log, line)
  return nil
end

-- The parse runs of the projects `todo`: each recipe over each project, and
-- over each folder there with settings of its own (`project_settings`).
-- Gives `{items, copy}`: the items for `run_items`, and the files their
-- tree holds.
function parse_plan(st, files, todo)
  local count_of = {}
  for f in files do
    if has_key(todo, project_of(f)) then incr(count_of, project_of(f)) end
  end
  local runs = {}
  for rc in PARSE_RECIPES do
    for p in sort(keys(count_of)) do push(runs, {rc = rc, unit = p, args = "-", files = count_of[p]}) end
  end
  local tables = {}
  for s in st.settings do
    if has_key(todo, project_of(s.folder .. "/x.roc")) then
      local n = 0
      for f in files do
        if starts_with(f, s.folder .. "/") then n = n + 1 end
      end
      if n == 0 then fail("quality: settings for " .. s.recipe .. " in " .. s.folder .. ", which holds no tracked .roc file") end
      st.setting_units[s.recipe .. "@" .. s.folder] = true
      push(runs, {rc = parse_recipe(s.recipe), unit = s.folder, args = join(s.args, " "), files = n - #s.skip})
      for t in s.files do tables[t] = true end
    end
  end
  local plan = {items = {}, copy = {}}
  -- A run's cost grows with its unit's files; each also starts a recipe and
  -- roc-ast.
  for u in runs do
    push(plan.items, {part = "parse", name = u.rc.recipe .. "\t" .. u.unit .. "\t" .. u.args .. "\t" .. u.files, cost = u.rc.cpu_measured_ms * u.files // #files + 150})
  end
  for f in files do
    if has_key(todo, project_of(f)) then push(plan.copy, f) end
  end
  for t in sort(keys(tables)) do push(plan.copy, t) end
  return plan
end

-- The parse runs' findings in `res`, counted. Gives how many.
function parse_take(st, res)
  local found = 0
  for l in lines(res.out) do
    if starts_with(l, "F\t") then
      local f = split(l, "\t")
      take_parse_finding(st, parse_recipe(f[2]), f[3], f[4], join(drop(f, 4), "\t"))
      found = found + 1
    end
  end
  return found
end

-- ── The full tier's typed stages ────────────────────────────────────────

-- The typed stages' CPU budgets, and each program's own cap, past the
-- largest of them. On 2026-11-17 roc-types took 155 to 195 s of CPU over the
-- 63 apps with Roc's own allocator, and about 300 s with the safe one it
-- was built on before, so the budget holds either; the
-- count took 6 to 9 s.
const TYPES_CPU_BUDGET_MS = 400000
const TYPES_APP_CPU_MS = 60000
const COUNT_CPU_BUDGET_MS = 30000
const COUNT_JOB_CPU_MS = 20000

-- What roc-types may print for one app before this refuses it as cut: far
-- past the largest app's (WidgetExpects', about 20 MB, 2026-11-17).
const TYPES_KEEP = 400000000

-- The apps that roc-types and the method rewrite leave out, each for its
-- reason. check.shale leaves them out of `roc check` too.
const TYPED_EXCEPTIONS = {
  {prefix = "canvas_apps/safari/tutorial/fails/", why = "programs that fail to type on purpose: the tutorial's builder checks that they do"},
}

function typed_excepted(path)
  for e in TYPED_EXCEPTIONS do
    if starts_with(path, e.prefix) then return true end
  end
  return false
end

-- Every app the typed stages read, as check.shale finds them.
function typed_apps()
  local r = run({"git", "grep", "-l", "-E", "^app \\[", "--", "*.roc"}, {timeout_ms = 30000, whole = 4000000})
  local out = {}
  for f in lines(trim(r.out)) do
    if f ~= "" and not typed_excepted(f) then push(out, f) end
  end
  return out
end

function flat_name(s)
  local n = re_replace(s, "[/:]", "__")
  if starts_with(n, "__") then n = sub(n, 3) end
  return n
end

-- Where an app's types are kept for the count, in this run's folder:
-- roc-types' own format, every module's `== ` line, and the records of the
-- modules in this checkout alone, as no other module's calls are counted.
function types_file_of(scratch, app)
  return scratch .. "/types/" .. flat_name(app) .. ".types"
end

function type_one_app(exe, app, want_head, scratch)
  local here = real(".") .. "/"
  local t = run({exe, real(app)}, {timeout_ms = 300000, whole = TYPES_KEEP, cpu_budget_ms = TYPES_APP_CPU_MS, stage = "roc-types " .. app})
  local text = t.out
  local nl = find(text, "\n")
  local head = nl == nil and text or sub(text, 1, nl - 1)
  if t.ended ~= "exit" or t.code ~= 0 then
    local said = {}
    for l in lines(text) do
      if not starts_with(l, "t\t") then push(said, l) end
    end
    print("CANT\troc-types on " .. app .. ": roc-types " .. t.ended .. " " .. get(t, "code", -1) .. ": " .. join(last(said, 8), " | "))
    return t.cpu_ms
  end
  if head ~= want_head then
    print("CANT\troc-types on " .. app .. ": roc-types' first line is `" .. head .. "`, not `" .. want_head .. "`")
    return t.cpu_ms
  end
  if #text >= TYPES_KEEP - 1000 then
    print("CANT\troc-types on " .. app .. ": roc-types printed " .. #text .. " bytes, past what this keeps")
    return t.cpu_ms
  end
  local k = roc_types_keeping(text, {under = here})
  for path in k.paths do print("MOD\t" .. app .. "\t" .. path) end
  if #k.paths == 0 then
    print("CANT\troc-types on " .. app .. ": roc-types named no module")
    return t.cpu_ms
  end
  replace(types_file_of(scratch, app), k.text)
  print("APP\t" .. app)
  return t.cpu_ms
end

-- A child run: roc-types on each app of the work file, the checker of the
-- tree's pin. It prints `MOD<tab>app<tab>path` for each module the app
-- reaches (its real path), then `APP<tab>app`, or `CANT<tab>why` for an app
-- it couldn't type, and keeps each app's types (`types_file_of`).
function types_part(work, scratch)
  if scratch == "" then fail("quality: part=types needs scratch=, the run's folder") end
  local roc = pinned_roc("quality")
  local exe = roc_types_exe(roc)
  if not exists(exe) then
    print("CANT\troc-types: no " .. exe .. ": `shale install.shale` in a checkout of https://github.com/showell/roc-types installs it")
    print("CPU\t0")
    return nil
  end
  local want_head = "roc-types " .. ROC_TYPES_FORMAT .. " " .. trim(read("roc-version"))
  local cpu = 0
  for app in lines(trim(read(work))) do
    cpu = cpu + type_one_app(real(exe), app, want_head, scratch)
    yield()
  end
  print("CPU\t" .. cpu)
  return nil
end

-- The roc-types runs' answers in `res`: each app typed, the tracked files
-- of the checkout it reaches (`st.reach`), and the folders outside it that
-- it reaches (`st.outside_reach`). A file of the checkout git doesn't track
-- (a build's output) is named in `st.untracked`: no key holds it.
function types_take(st, res, tracked)
  local here = real(".") .. "/"
  local reach = {}
  local outside = {}
  for l in lines(res.out) do
    if starts_with(l, "MOD\t") then
      local f = split(l, "\t")
      if starts_with(f[3], here) then
        local rel = sub(f[3], #here + 1)
        if has_key(tracked, rel) then push_at(reach, f[2], rel) else st.untracked[rel] = true end
      else
        if not has_key(outside, f[2]) then outside[f[2]] = {} end
        outside[f[2]][outside_name(st, dirname(f[3]))] = true
      end
    elseif starts_with(l, "APP\t") then
      st.typed[sub(l, 5)] = true
    end
  end
  local out = {}
  for app in keys(reach) do
    if has_key(st.typed, app) then
      st.reach[app] = reach[app]
      st.outside_reach[app] = sort(keys(get(outside, app, {})))
      push(out, app)
    end
  end
  return out
end

-- The count's runs. Each file is judged once, on one app that reaches it:
-- an app in the file's own folder (`app_of`) if one does, else the app that
-- reaches the most files. An app's files are run a folder at a time, so
-- each run's count belongs to one folder.
function rewrite_jobs(reach)
  local roots_of = {}
  for a in keys(reach) do
    for f in reach[a] do push_at(roots_of, f, a) end
  end
  local by = {}
  for f in sort(keys(roots_of)) do
    local best = ""
    local best_key = ""
    for r in roots_of[f] do
      -- Its own folder first, then the most files, then by name.
      local k = (app_of(r) == app_of(f) and "0" or "1") .. "\t" .. (1000000 - #reach[r]) .. "\t" .. r
      if best == "" or k < best_key then
        best = r
        best_key = k
      end
    end
    push_at(by, best .. "\t" .. app_of(f), f)
  end
  local jobs = {}
  for k in sort(keys(by)) do
    local parts = split(k, "\t")
    push(jobs, {root = parts[1], unit = parts[2], files = by[k]})
  end
  return jobs
end

function count_one(item)
  local f = split(item, "\t")
  local files = split(f[3], ",")
  local r = run({"shale", "--budget", RECIPE_STEPS, real("cookbook:roc/rewrite_method_calls.shale"), "glob=" .. f[3], "root=" .. f[2], "trials=0", "types_from=" .. f[4]},
    {timeout_ms = 600000, whole = 4000000, cpu_budget_ms = COUNT_JOB_CPU_MS, stage = "count " .. f[1] .. " on " .. f[2]})
  local own = own_lines(r.out)
  local summary = #own > 0 and own[#own] or ""
  local m = re_find(summary, "^count: files ([0-9]+), candidates [0-9]+, proven ([0-9]+), unsettled ([0-9]+), left ([0-9]+)")
  local why = ""
  if r.ended ~= "exit" or r.code ~= 0 then
    why = "exited " .. get(r, "code", -1) .. ": " .. (stop_line(r.out) or tail_of(r.out, 4))
  elseif m == nil then
    why = "no `count: files N, ...` summary (a cookbook older than trials=0?): " .. sub(summary, 1, 200)
  elseif tonumber(m.groups[1]) ~= #files then
    why = "read " .. m.groups[1] .. " of its " .. #files .. " files"
  end
  if why ~= "" then
    print("CANT\t" .. f[1] .. " on " .. f[2] .. ": rewrite_method_calls " .. why)
  else
    print("RW\t" .. f[1] .. "\t" .. f[2] .. "\t" .. m.groups[1] .. "\t" .. m.groups[2] .. "\t" .. m.groups[3] .. "\t" .. m.groups[4])
    -- Each call the run leaves or leaves unsettled, `path:line: Module.fn:
    -- why`, for the findings log.
    for l in own do
      if re_find(l, "^[^ :]+\\.roc:[0-9]+: ") ~= nil then print("RWF\t" .. f[1] .. "\t" .. f[2] .. "\t" .. l) end
    end
  end
  return r.cpu_ms
end

-- A child run: `rewrite_method_calls trials=0` on each
-- `unit<tab>root<tab>files<tab>types file` of the work file, the root's
-- types read from the file the types stage kept. It prints
-- `RW<tab>unit<tab>root<tab>files<tab>proven<tab>unsettled<tab>left` a run,
-- then `RWF<tab>unit<tab>root<tab>line` for each call it lists, and
-- `CANT<tab>why` for one that couldn't run.
function count_part(work)
  local cpu = 0
  for item in lines(trim(read(work))) do
    cpu = cpu + count_one(item)
    yield()
  end
  print("CPU\t" .. cpu)
  return nil
end

-- The old-style calls the types prove could be method calls, in every file
-- the apps measured reach: `rewrite_method_calls trials=0`, a run a job,
-- each reading its root's types from this run's folder.
function full_count(st, scratch, whole)
  local jobs = rewrite_jobs(st.reach)
  if #jobs == 0 then return nil end
  local items = {}
  for j in jobs do
    -- A count's run costs about a twentieth of a second a file.
    push(items, {part = "count", name = j.unit .. "\t" .. j.root .. "\t" .. join(j.files, ",") .. "\t" .. types_file_of(scratch, j.root), cost = 50 * #j.files + 100})
  end
  local res = run_items(scratch, "count", items, {})
  for c in res.cant do push(st.cant, c) end
  print("rewrite_method_calls count: " .. #jobs .. " runs " .. WORKERS .. " at once in " .. times_seconds(res.ms))
  note_stage(st, "rewrite_method_calls count", get(res.cpu, "count", 0), res.ms, #jobs, whole, COUNT_CPU_BUDGET_MS)
  local found = {}
  local call_lines = {}
  for l in lines(res.out) do
    if starts_with(l, "RWF\t") then push(call_lines, l) elseif starts_with(l, "RW\t") then push(found, l) end
  end
  local files = 0
  local proven = 0
  local unsettled = 0
  for l in sort(found) do
    local f = split(l, "\t")
    count_finding(st, f[2], "rewrite_method_calls", "rewritable", tonumber(f[5]))
    push(st.log, "rewrite " .. f[2] .. " on " .. f[3] .. ": " .. f[4] .. " files, " .. f[5] .. " calls the types prove, " .. f[6] .. " unsettled, " .. f[7] .. " left")
    files = files + tonumber(f[4])
    proven = proven + tonumber(f[5])
    unsettled = unsettled + tonumber(f[6])
  end
  for l in sort(call_lines) do
    local f = split(l, "\t")
    push(st.log, join(drop(f, 3), "\t"))
  end
  print("rewrite_method_calls: " .. proven .. " calls the types prove could be method calls, in " .. files .. " files, " .. #jobs .. " runs; " .. unsettled .. " the types leave unsettled, and no trial decides them")
  return nil
end

-- Each tracked file of an app measured that no app reaches is counted,
-- `roc-types unreached`: no typed check reads it. Every app that could
-- reach it was typed, as an app reaching a folder is in its group.
function count_unreached(st, files, m)
  local reached = {}
  for app in keys(st.reach) do
    for f in st.reach[app] do reached[f] = true end
  end
  local n = 0
  for f in files do
    if has_key(m, app_of(f)) and not typed_excepted(f) and not has_key(reached, f) then
      count_finding(st, app_of(f), "roc-types", "unreached", 1)
      push(st.log, f .. ":1: unreached: no app's types reach it, so no typed check reads it")
      n = n + 1
    end
  end
  print("roc-types: " .. #keys(st.typed) .. " apps typed, " .. #keys(reached) .. " files reached, " .. n .. " reached by none")
  for e in TYPED_EXCEPTIONS do print("left out of the typed stages: " .. e.prefix .. " (" .. e.why .. ")") end
  return nil
end

-- ── The full tier ───────────────────────────────────────────────────────

-- Measures the apps of `m` and every app that joins them (`close_over`, and
-- an app whose folder a typed app reaches): the parse recipes over each of
-- their projects and roc-types on each of their apps, one pool for both, a
-- round at a time until no app joins.
function measure(st, scratch, files, m, names, base, whole)
  local tracked = set_of(files)
  local parsed = {}
  local typed_units = {}
  local parse_cpu = 0
  local parse_ms = 0
  local parse_runs = 0
  local types_cpu = 0
  local types_ms = 0
  local types_runs = 0
  local found = 0
  local round = 0
  while true do
    local todo_p = {}
    local todo_u = {}
    for u in keys(m) do
      if not has_key(parsed, unit_project(u)) then todo_p[unit_project(u)] = true end
      if not has_key(typed_units, u) then todo_u[u] = true end
    end
    if #keys(todo_p) == 0 and #keys(todo_u) == 0 then break end
    round = round + 1
    local pp = parse_plan(st, files, todo_p)
    local items = {}
    for it in pp.items do push(items, it) end
    local types_n = 0
    for app in st.apps do
      if has_key(todo_u, app_of(app)) then
        -- A guess at its cost: an app under canvas_apps/ reaches its
        -- platform's hundred modules, and costs the most.
        push(items, {part = "types", name = app, cost = starts_with(app, "canvas_apps/") and 4000 or 1000})
        types_n = types_n + 1
      end
    end
    for p in keys(todo_p) do parsed[p] = true end
    for u in keys(todo_u) do typed_units[u] = true end
    if #items > 0 then
      local tree = #pp.items > 0 and tracked_tree(scratch, pp.copy) or ""
      local res = run_items(scratch, "round-" .. round, items, {parse = {"tree=" .. tree}, types = {"scratch=" .. scratch}})
      if tree ~= "" then remove_tree(tree) end
      for c in res.cant do push(st.cant, c) end
      print("round " .. round .. ": " .. #pp.items .. " parse runs and roc-types on " .. types_n .. " apps, " .. WORKERS .. " at once in " .. times_seconds(res.ms))
      found = found + parse_take(st, res)
      parse_cpu = parse_cpu + get(res.cpu, "parse", 0)
      types_cpu = types_cpu + get(res.cpu, "types", 0)
      parse_ms = parse_ms + res.ms
      types_ms = types_ms + res.ms
      parse_runs = parse_runs + #pp.items
      types_runs = types_runs + types_n
      -- An app whose folder a typed app now reaches joins the apps measured:
      -- its typed counts are judged on the apps that reach it.
      for app in types_take(st, res, tracked) do
        for f in st.reach[app] do
          if not has_key(m, app_of(f)) then
            print("measured too: " .. app_of(f) .. ", which " .. app .. " reaches")
            m[app_of(f)] = true
          end
        end
      end
      close_over(m, names, base)
    end
  end
  local budget = 0
  for rc in PARSE_RECIPES do budget = budget + rc.cpu_budget_ms end
  note_stage(st, "parse recipes", parse_cpu, parse_ms, parse_runs, whole, budget)
  print("parse recipes: " .. found .. " findings")
  note_stage(st, "roc-types every app", types_cpu, types_ms, types_runs, whole, TYPES_CPU_BUDGET_MS)
  count_unreached(st, files, m)
  full_count(st, scratch, whole)
  return nil
end

function full()
  local files = tracked_roc_files()
  local units = {}
  for f in files do push_at(units, app_of(f), f) end
  local names = sort(keys(units))
  print("quality, full: " .. #files .. " files in " .. #names .. " apps")
  local scratch = fresh_dir("build:roc-apps", "quality-run")
  mkdir(scratch .. "/types")
  local st = {cant = {}, over = {}, counts = {}, log = {}, settings = {}, setting_units = {}, units = units,
    reach = {}, outside_reach = {}, typed = {}, untracked = {}, outside = {}, outside_names = {}, apps = typed_apps(),
    trees = folder_trees(scratch), tools = tools_identity(pinned_roc("quality"))}
  local base = read_baseline()
  local m = stale_apps(st, names, base)
  close_over(m, names, base)
  local kept = 0
  for u in names do
    if not has_key(m, u) then kept = kept + 1 end
  end
  print("keys: " .. kept .. " of " .. #names .. " apps as " .. BASELINE .. " holds them" .. (FRESH and " (fresh=1 measures every app)" or "") .. ", " .. (#names - kept) .. " to measure")
  local whole = kept == 0
  if kept < #names then
    st.settings = project_settings()
    for s in st.settings do print("settings: " .. s.recipe .. " in " .. s.folder .. ", run on its own: " .. join(s.args, " ")) end
    measure(st, scratch, files, m, names, base, whole)
  end
  if #keys(st.untracked) > 0 then print("reached and not tracked, so in no key: " .. #keys(st.untracked) .. " files, " .. join(take(sort(keys(st.untracked)), 5), ", ")) end
  -- The counts: the measured apps' own, and every other app's from the
  -- baseline.
  local counts = {}
  for k in keys(base.counts) do
    if not has_key(m, split(k, "\t")[1]) then counts[k] = base.counts[k] end
  end
  for k in keys(st.counts) do counts[k] = st.counts[k] end
  local key_rows = {}
  for u in names do
    if not has_key(m, u) then key_rows[u] = base.keys[u] end
  end
  local groups = groups_of(st, m)
  for g in groups do
    local k = {folders = g.folders, text = join(g.folders, ","), hash = key_hash(st, g.folders)}
    for u in g.members do key_rows[u] = k end
    if #g.members > 1 then print("group of " .. #g.members .. ": " .. join(g.members, " ")) end
  end
  remove_tree(scratch)
  replace(FINDINGS_LOG, join(st.log, "\n") .. "\n")
  local rows = {}
  local cols = {"app"}
  local short_of = {}
  short_of["roc-types"] = "untyped"
  short_of["rewrite_method_calls"] = "methods"
  for rc in PARSE_RECIPES do
    push(cols, rc.short)
    short_of[rc.recipe] = rc.short
  end
  push(cols, "untyped")
  push(cols, "methods")
  local by_app = {}
  for k in keys(counts) do
    local f = split(k, "\t")
    if not has_key(by_app, f[1]) then by_app[f[1]] = {} end
    incr(by_app[f[1]], short_of[f[2]], counts[k])
  end
  for app in sort(keys(by_app)) do
    local row = {app = app}
    for c in drop(cols, 1) do row[c] = get(by_app[app], c, 0) end
    push(rows, row)
  end
  print(table(rows, cols))
  print("the findings of the " .. (#names - kept) .. " apps measured: " .. real(FINDINGS_LOG))
  local moved = moved_counts(base.counts, counts)
  for x in moved do print("moved " .. x) end
  if BASELINE_ARG == "write" then
    if #st.cant > 0 or #st.over > 0 then
      for c in st.cant do print("CAN'T RUN " .. c) end
      for c in st.over do print("OVER BUDGET " .. c) end
      fail("quality: no baseline written, since a recipe couldn't run or a stage went over its budget")
    end
    write_baseline(counts, key_rows)
    print("baseline written: " .. BASELINE .. ", " .. #keys(counts) .. " counts and " .. #keys(key_rows) .. " keys (" .. #moved .. " counts moved)")
  else
    print("against " .. BASELINE .. ": " .. #moved .. " counts moved; report mode, so none fails the run, and the keys stay as they were")
  end
  for c in st.cant do print("CAN'T RUN " .. c) end
  for c in st.over do print("OVER BUDGET " .. c) end
  if #st.cant > 0 then fail("quality: " .. #st.cant .. " runs couldn't run (named above): a tool gap") end
  if #st.over > 0 then fail("quality: " .. #st.over .. " stages went over their CPU budgets (named above): find which phase took the time") end
  print("quality, full: every recipe ran on every project measured, roc-types on each of its apps")
  return nil
end

-- ── The fast tier ───────────────────────────────────────────────────────

-- The tracked .roc files changed since the branch left `since`: committed
-- or not. A new file counts once it is added (`git add`), so a build's
-- output, ignored or merely untracked, never enters.
function changed_roc_files(since)
  not_option("quality", "since", since)
  local base = trim(must(run({"git", "merge-base", since, "HEAD"}, {timeout_ms = 30000, whole = 1000})).out)
  local seen = {}
  local out = {}
  local diff = must(run({"git", "diff", "--name-only", base, "--", "*.roc"}, {timeout_ms = 30000, whole = 1000000})).out
  local tracked = set_of(tracked_roc_files())
  for f in lines(trim(diff)) do
    if f ~= "" and not has_key(seen, f) and has_key(tracked, f) and exists(f) then
      seen[f] = true
      push(out, f)
    end
  end
  return sort(out)
end

-- A file's settings for one recipe in the fast tier, `{skip, args}`: a file
-- its folder's `skip=` names isn't run, and a table (`table=`, `words=`)
-- is passed. A `dictated=` table names files a one-file glob doesn't find,
-- so the fast tier leaves it to the full tier, as Safari's own lints do.
function fast_settings(settings, recipe, path)
  local out = {skip = false, args = {}}
  for s in settings do
    if s.recipe == recipe and starts_with(path, s.folder .. "/") then
      if has_item(s.skip, path) then out.skip = true end
      for a in s.args do
        if starts_with(a, "table=") or starts_with(a, "words=") then push(out.args, a) end
      end
    end
  end
  return out
end

function fast()
  local files = changed_roc_files(SINCE)
  print("quality, fast: " .. #files .. " .roc files changed since " .. SINCE)
  local cant = {}
  local shown = 0
  local left = {}
  for rc in PARSE_RECIPES do
    for c in rc.cross do push(left, rc.recipe .. " " .. c) end
  end
  local settings = #files > 0 and project_settings() or {}
  for f in files do
    local parts = {}
    local cant_here = 0
    for rc in PARSE_RECIPES do
      local own = fast_settings(settings, rc.recipe, f)
      local r = own.skip and nil or run(recipe_argv(rc, f, own.args), {timeout_ms = RECIPE_TIMEOUT_MS, whole = RECIPE_KEEP, cpu_budget_ms = 10000, stage = rc.recipe .. " " .. f})
      local v = own.skip and {ok = true, findings = {}} or verdict_of(rc, r, 1)
      if own.skip then
        push(parts, rc.short .. " skipped, as its folder's settings say")
      elseif not v.ok then
        push(cant, f .. ": " .. v.why)
        cant_here = cant_here + 1
      else
        local n = 0
        for x in v.findings do
          if not has_item(rc.cross, x.check) then
            if not has_item(get(rc, "quiet", {}), x.check) then print(x.line) end
            n = n + 1
          end
        end
        if n > 0 then push(parts, rc.short .. " " .. n) end
        shown = shown + n
      end
      yield()
    end
    if cant_here > 0 then push(parts, cant_here .. " recipes couldn't run") end
    print(f .. ": " .. (#parts == 0 and "no findings" or join(parts, ", ")))
  end
  print("left to the full tier, as they read across files: " .. join(left, ", "))
  for c in cant do print("CAN'T RUN " .. c) end
  if #cant > 0 then fail("quality, fast: " .. #cant .. " recipe runs couldn't run (named above): a tool gap") end
  print("quality, fast: " .. #files .. " files, " .. shown .. " findings; report mode, so none fails the run")
  return nil
end

if PART == "parse" then
  parse_part(WORK_ARG, TREE_ARG)
elseif PART == "types" then
  types_part(WORK_ARG, SCRATCH_ARG)
elseif PART == "count" then
  count_part(WORK_ARG)
elseif PART ~= "" then
  fail("quality: part=" .. PART .. " is not a part")
elseif TIER == "fast" then
  fast()
elseif TIER == "full" then
  full()
else
  fail("quality: tier=" .. TIER .. ": the tiers are fast and full")
end
