-- The copy oracle: where a Roc program copies, read from the program
-- itself, with no compiler fork. roc-alloc-trace's `where` mode
-- (tools/alloc_trace.shale builds it from its sibling checkout) counts each
-- run's allocations by breakpoints and puts each down to the builtin it
-- came through (list_set, list_replace, the appends, ...) and the Roc
-- procedure that entered it, named by the executable's debug information
-- (`roc build --debug`). It knows nothing of the program: the caller builds
-- it and hands this script a plan, as tools/alloc_ladder.shale's callers
-- do.
--
--   cd <roc-apps checkout> && shale tools/copy_oracle.shale plan=<plan.json>
--
-- The plan is `{who, gen, small, big, limit_ms, runs}`: `gen` a writable
-- folder, `small` and `big` two iteration counts, `limit_ms` one run's
-- limit, and `runs` a list of `{name, small_argv, big_argv}`, `big_argv`
-- empty for a run with no loop. Every argv runs the same executable, built
-- with `--debug`.
--
-- **A COPY IS AN ALLOCATION MADE INSIDE A WRITING BUILTIN.** RC1 writes in
-- place when the refcount is 1 and copies otherwise, and the copy is a
-- roc_alloc made inside the builtin; growing a unique list in place is a
-- roc_realloc, counted apart. For a run with a loop, a site is said for
-- what one more iteration allocates through it (at least 0.5), so the
-- setup's allocations drop out; for a run without one, every site that
-- allocated through a writing builtin is said with its count.
--
-- It prints, for each run, what one more iteration allocates in all, then
-- a line a site: `<run>: <builtin> <count> of <bytes> bytes from
-- <procedure> (<module>:<line>)`, the bytes each allocation asked for on
-- average (a copy asks for the whole list; a list made afresh, a few), the
-- procedure by the debug information's name for the Roc code
-- (`Devices.poked`), and the line of its call site when the line table has
-- one. The same rows go to <gen>/copies.tsv.
--
-- budget: steps=50000000

use("./alloc_trace.shale")

const PLAN = arg("plan", "")

function main()
  if PLAN == "" then fail("tools/copy_oracle.shale: no plan= given") end
  local p = json_read(read(PLAN))
  local who = p.who
  local tool = build_alloc_trace(who, p.gen)
  local check = p.gen .. "/oracle.check"
  write_check_file(check, p, p.runs, {}, {})
  local tsv = p.gen .. "/copies.tsv"
  if exists(tsv) then remove(tsv) end
  local r = run({tool, "where", "--tsv", real(p.gen) .. "/copies.tsv", real(check)}, {timeout_ms = 1800000, tail = 400, want = ALLOC_TRACE_WANT})
  print(trim(r.out))
  if r.ended ~= "exit" or r.code ~= 0 then fail(who .. ": roc-alloc-trace where ended " .. r.ended .. " " .. get(r, "code", "")) end
  print("the rows in " .. tsv)
end

main()
