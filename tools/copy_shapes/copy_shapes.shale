-- The copy shapes (tools/copy_shapes/CopyShapes.roc): each way of writing
-- into a list, a record or a dict that docs/roc-notes.md, "Speed and
-- copying", names, run at 1,000 and at 10,000 writes into a list of 1,000
-- on tools/alloc_ladder.shale, which counts what one more write allocates
-- and holds each shape to its expected file. A write in place allocates
-- nothing; a copy allocates the list again, so a shape that copies is held
-- to its real count, a documented cliff, and one that doesn't to 0.
--
--   cd <roc-apps checkout> && shale tools/copy_shapes/copy_shapes.shale              the release build (--opt=speed)
--   cd <roc-apps checkout> && shale tools/copy_shapes/copy_shapes.shale opt=dev      the dev build
--   cd <roc-apps checkout> && shale tools/copy_shapes/copy_shapes.shale opt=boxy     --opt=speed --specialize=no
--   cd <roc-apps checkout> && shale tools/copy_shapes/copy_shapes.shale only=dict    the shapes whose names start so
--   cd <roc-apps checkout> && shale tools/copy_shapes/copy_shapes.shale oracle=1     where each shape copies (tools/copy_oracle.shale)
--
-- The shapes are the names CopyShapes.roc's `run_shape` matches, read from
-- it, so a shape added there is a control here. Each build is held to its
-- own file: expected.txt (speed), expected-dev.txt and expected-boxy.txt.
-- `only=` holds nothing: a part of the ladder is a report. `oracle=1`
-- builds copy-shapes with `--debug` as well and hands the same shapes to
-- tools/copy_oracle.shale, which says through which builtin and from which
-- Roc procedure each copy is made: a report, held to nothing.
--
-- Each build takes a few seconds to compile, and its counting about 10 s.
-- tools/roc_build.shale builds copy-shapes, and a build of inputs already
-- built is reused, so a second run compiles nothing.
--
-- budget: steps=50000000

const SMALL = 1000
const BIG = 10000
-- Entries in each list the shapes write into.
const SIZE = 1000
const RUN_MS = 60000
const WHO = "tools/copy_shapes/copy_shapes.shale"
const SOURCE = "tools/copy_shapes/CopyShapes.roc"

const OPT = arg("opt", "speed")
const ONLY = arg("only", "")
const ORACLE = arg("oracle", false)

-- The file each build (tools/roc_build.shale's modes) is held to.
const EXPECTED = {
  speed = "tools/copy_shapes/expected.txt",
  dev = "tools/copy_shapes/expected-dev.txt",
  boxy = "tools/copy_shapes/expected-boxy.txt",
}

-- This checkout's folder of plans, made when missing.
function gen_dir()
  local dir = "build:roc-apps/gen/copy-shapes/" .. basename(real("."))
  mkdir(dir)
  return dir
end

-- The shapes `run_shape` matches, in its order.
function shapes()
  local out = {}
  for l in lines(read(SOURCE)) do
    local m = re_find(l, "^\t\t\"([a-z-]+)\" =>")
    if m ~= nil then push(out, m.group) end
  end
  if #out == 0 then fail(WHO .. ": " .. SOURCE .. "'s run_shape matches no shape") end
  return out
end

-- The command line for a shape at `steps`. `host-args-list` writes into the
-- command line itself, so it carries SIZE entries, its size given as 0.
function argv_for(bin, shape, steps)
  if shape ~= "host-args-list" then return {bin, shape, tostring(SIZE), tostring(steps)} end
  local a = {bin, shape, "0", tostring(steps)}
  while #a - 1 < SIZE do push(a, "a") end
  return a
end

function main()
  if not has_key(EXPECTED, OPT) then fail(WHO .. ": opt is speed, dev or boxy, not " .. OPT) end
  local opts = {}
  if ORACLE then opts = {flags = {"--debug"}} end
  local bin = built_roc(WHO, SOURCE, "copy-shapes", OPT, opts)
  local controls = {}
  for s in shapes() do
    if ONLY == "" or starts_with(s, ONLY) then
      push(controls, {name = s, small_argv = argv_for(bin, s, SMALL), big_argv = argv_for(bin, s, BIG)})
    end
  end
  if #controls == 0 then fail(WHO .. ": no shape is named " .. ONLY) end
  if ORACLE then
    local oracle_plan = gen_dir() .. "/oracle-" .. OPT .. ".json"
    if exists(oracle_plan) then remove(oracle_plan) end
    create(oracle_plan, json_write({who = WHO .. " oracle opt=" .. OPT, gen = gen_dir() .. "/oracle-" .. OPT, small = SMALL, big = BIG,
      limit_ms = RUN_MS * 4, runs = controls}))
    local o = run({"shale", "--root", ".", "tools/copy_oracle.shale", "plan=" .. oracle_plan}, {timeout_ms = 1800000, tail = 120})
    print(trim(o.out))
    if o.code ~= 0 then fail(WHO .. ": the oracle failed, " .. OPT) end
    return nil
  end
  local plan = {who = WHO .. " opt=" .. OPT, gen = gen_dir(), expected = EXPECTED[OPT], small = SMALL, big = BIG,
    limit_ms = RUN_MS, hold = ONLY == "", controls = controls}
  if ONLY ~= "" then plan.expected = "" end
  local plan_path = gen_dir() .. "/plan-" .. OPT .. ".json"
  if exists(plan_path) then remove(plan_path) end
  create(plan_path, json_write(plan))
  local r = run({"shale", "--root", ".", "tools/alloc_ladder.shale", "plan=" .. plan_path}, {timeout_ms = 1800000, tail = 80})
  print(trim(r.out))
  if r.code ~= 0 then fail(WHO .. ": the ladder failed, " .. OPT) end
end

main()
