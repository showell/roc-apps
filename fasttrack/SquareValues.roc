		# the bullseye
		4100,
	]

	## Square `s` to a piece of color `c` (its place in the color order).
	points : U64, U64 -> I64
	points = |c, s|
		match values.get(Board.relative(c, s)) {
			Ok(worth) => worth
			Err(OutOfBounds) => crash "SquareValues.points: Board.relative answers a square of the table"
		}
}
