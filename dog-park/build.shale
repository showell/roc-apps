-- Dog Park's gate, then its page into the dev channel. Each check prints a
-- line with what it ran; any failure stops the run, naming the check, and
-- the page in the dev channel stays as it was.
--
--   cd <roc-apps checkout> && shale dog-park/build.shale
--
-- The checks, in order:
-- - `zig build check`: zig fmt over the Zig and the generated .zon; the
--   physics' Zig tests natively and on wasm32-wasi; the page's node tests
--   (tools/test_*.mjs) on the Debug wasm and on the served one; Roc's
--   expects and `roc fmt --check roc`; and roc-fresh, each file the Roc
--   prints compared with the checked-in one. The Zig and Roc counts are
--   read from its output and held exactly (ZIG_TESTS, ROC_EXPECTS).
-- - the page's node tests once more, each held to its exact count
--   (NODE_TESTS), with none failed, skipped or left to do.
-- - `zig build walk-judge`: every pixel-tick of the bench's drags, the
--   Roc's walk against the plain Zig reference (src/walk_reference.zig).
-- - tools/new_kind.shale: sheep, a new kind made in Roc alone.
-- Then the page: web/ and the ReleaseSafe physics.wasm into
-- build:roc-apps/next/dog-park.staging/, played there in headless Chromium
-- by tools/page_check.mjs (a drag kept, a reload picking it up, storage
-- blocked), and only then swapped in whole as
-- build:roc-apps/next/dog-park/, the dev channel's /dog-park/, with a
-- BUILT file naming the Roc and the commit. The shots page_check takes
-- are in build:roc-apps/gen/dog-park/shots/. Before the swap,
-- tools/card_shot.mjs takes the landing page's picture of the staged page,
-- and site/squeeze_png.mjs makes it the page's shot.png. The critters are
-- emoji, so a box with no colour emoji font (fc-list) stops the run there:
-- a picture without them would be published otherwise.
--
-- A count that moves goes with the change that moved it, and its commit
-- says why. `zig build slow` (the full fuzz, the wasm tests in
-- ReleaseSafe) and `zig build physics-bench` are in no gate.
--
-- budget: steps=20000000

const HERE = "dog-park"
const ZIG_TESTS = 60
-- print_world.roc's, Rules.roc's, Wish.roc's, Walk.roc's and print_page.roc's
-- `roc test`s, each with the expects of what it imports.
const ROC_RUNS = 5
const ROC_EXPECTS = 134
const DEST = "build:roc-apps/next/dog-park"
const STAGING = "build:roc-apps/next/dog-park.staging"
const WANT_NODE = "node-tests: the page's node:test files"

function zig_build(roc, step, keep)
  local r = run({"zig", "build", "-Droc=" .. roc, step, "--summary", "all"}, {cwd = HERE, timeout_ms = 900000, whole = keep})
  if r.code ~= 0 then
    local out = r.out
    if #out > 6000 then out = sub(out, #out - 6000, #out) end
    print(out)
    fail("dog-park: `zig build " .. step .. "` failed")
  end
  return r
end

-- The Zig tests' count and the Roc expects' runs and sum in `zig build
-- check`'s output.
function counts(out)
  local zig = -1
  local roc_runs = 0
  local roc = 0
  for l in lines(out) do
    local z = re_find(l, "Build Summary: .*; (\\d+)/(\\d+) tests passed")
    if z ~= nil then
      if z.groups[1] ~= z.groups[2] then fail("dog-park: " .. trim(l)) end
      zig = tonumber(z.groups[1])
    end
    local e = re_find(l, "^All \\((\\d+)\\) tests passed")
    if e ~= nil then
      roc_runs = roc_runs + 1
      roc = roc + tonumber(e.groups[1])
    end
  end
  return {zig = zig, roc_runs = roc_runs, roc = roc}
end

-- One node test file on the served wasm: its pass count, none failed,
-- skipped or left to do.
function node_test(file)
  local r = run({"node", file}, {cwd = HERE, timeout_ms = 120000, whole = 2000000, want = WANT_NODE})
  local said = {}
  for l in lines(r.out) do
    local m = re_find(l, "^# (pass|fail|skipped|todo|cancelled) (\\d+)$")
    if m ~= nil then said[m.groups[1]] = tonumber(m.groups[2]) end
  end
  for k in {"pass", "fail", "skipped", "todo", "cancelled"} do
    if not has_key(said, k) then
      print(r.out)
      fail("dog-park: " .. file .. " printed no `# " .. k .. "` line")
    end
  end
  if r.code ~= 0 or said.fail ~= 0 or said.skipped ~= 0 or said.todo ~= 0 or said.cancelled ~= 0 then
    print(r.out)
    fail("dog-park: " .. file .. " exited " .. r.code .. ": " .. said.pass .. " passed, " .. said.fail .. " failed, " .. said.skipped .. " skipped, " .. said.todo .. " to do")
  end
  return said.pass
end

local roc = pinned_roc("dog-park/build.shale")

local check = zig_build(roc, "check", 4000000)
local c = counts(check.out)
if c.zig ~= ZIG_TESTS then fail("dog-park: " .. c.zig .. " Zig tests ran, held at " .. ZIG_TESTS) end
if c.roc_runs ~= ROC_RUNS or c.roc ~= ROC_EXPECTS then fail("dog-park: " .. c.roc_runs .. " roc test runs, " .. c.roc .. " expects; held at " .. ROC_RUNS .. " and " .. ROC_EXPECTS) end
print("PASS zig build check: " .. c.zig .. "/" .. ZIG_TESTS .. " Zig tests (natively and on wasm32-wasi), " .. c.roc .. " Roc expects in " .. c.roc_runs .. " runs, roc fmt, roc-fresh, zig fmt")

local node = {{file = "tools/test_page_modules.mjs", held = 42}, {file = "tools/test_engine.mjs", held = 11}}
for n in node do
  local passed = node_test(n.file)
  if passed ~= n.held then fail("dog-park: " .. n.file .. ": " .. passed .. " passed, held at " .. n.held) end
  print("PASS " .. n.file .. ": " .. passed .. "/" .. n.held)
end

zig_build(roc, "walk-judge", 200000)
print("PASS zig build walk-judge: every walk of the bench's drags matches walk_reference.zig")

local kind = run({"shale", "dog-park/tools/new_kind.shale"}, {timeout_ms = 1500000, tail = 40})
if kind.code ~= 0 then
  print(kind.out)
  fail("dog-park: tools/new_kind.shale failed")
end
local verdict = ""
for l in lines(kind.out) do if starts_with(l, "new_kind: ") then verdict = l end end
if verdict == "" then
  print(kind.out)
  fail("dog-park: tools/new_kind.shale printed no verdict")
end
print("PASS " .. verdict)

-- The page, built by the check above (zig-out/web/physics.wasm, ReleaseSafe).
if exists(STAGING) then remove_tree(STAGING) end
mkdir(STAGING)
local files = 0
for p in glob(HERE .. "/web/*") do
  copy(p, STAGING .. "/" .. basename(p))
  files = files + 1
end
copy(HERE .. "/zig-out/web/physics.wasm", STAGING .. "/physics.wasm")
local head = git_head("")
if not git_is_clean("") then head = head .. "+dirty" end
replace(STAGING .. "/BUILT", "roc " .. trim(read("roc-version")) .. "\ncommit " .. head .. "\n")
-- The dev channel serves the staging folder too, at /dog-park.staging/.
local played = run({"node", HERE .. "/tools/page_check.mjs", "http://localhost:9210/dog-park.staging/", real("build:roc-apps/gen/dog-park/shots")}, {timeout_ms = 120000, tail = 30, want = WANT_NODE})
if played.code ~= 0 then
  print(played.out)
  fail("dog-park: tools/page_check.mjs failed on the staged page; the dev channel's /dog-park/ is as it was")
end
local checks = 0
for l in lines(played.out) do if starts_with(l, "PASS ") then checks = checks + 1 end end
print("PASS tools/page_check.mjs: " .. checks .. " checks in headless Chromium")
local fonts = must(run({"fc-list", ":color=true", "family"}, {timeout_ms = 30000, whole = 100000})).out
if not contains(fonts, "Emoji") then fail("dog-park: no colour emoji font (fc-list :color=true): the landing page's picture would show no critters; README, \"The landing page's picture\", says how to install one") end
local raw = real("build:roc-apps/gen/dog-park") .. "/card-raw.png"
must(run({"node", HERE .. "/tools/card_shot.mjs", "http://localhost:9210/dog-park.staging/", raw}, {timeout_ms = 120000, tail = 10, want = WANT_NODE}))
must(run({"node", "site/squeeze_png.mjs", raw, real(STAGING) .. "/shot.png"}, {timeout_ms = 60000, tail = 5, want = "script: site/squeeze_png.mjs recompresses the landing page's picture"}))
files = files + 1
print("PASS tools/card_shot.mjs: the landing page's picture, " .. stat(STAGING .. "/shot.png").size .. " bytes, its colour emoji from " .. trim(fonts))
if exists(DEST) then remove_tree(DEST) end
must(run({"mv", real(STAGING), real(DEST)}, {timeout_ms = 10000, tail = 5}))
print("dev: " .. (files + 2) .. " files in build:roc-apps/next/dog-park/ (commit " .. head .. "), http://localhost:9210/dog-park/")
